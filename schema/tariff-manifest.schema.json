{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urpx.org/tariffs/schema/tariff-manifest.schema.json",
  "title": "URPX Tariff Filing Manifest",
  "description": "Per-filing manifest accompanying each URPX rate-plan JSON-LD in the tariffs corpus. Captures provenance, extraction, validation, and review metadata that does not belong inside the URPX serialization itself.",
  "type": "object",
  "required": ["utility", "schedule", "effective_date", "source"],
  "additionalProperties": false,
  "properties": {
    "utility": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Short utility identifier matching the directory name (e.g. 'pge', 'cpau')."
    },
    "schedule": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Short schedule identifier matching the directory name (e.g. 'e-tou-c', 'ev2')."
    },
    "effective_date": {
      "type": "string",
      "format": "date",
      "description": "ISO 8601 date this filing becomes effective. Matches the directory name."
    },

    "source": {
      "type": "object",
      "required": ["url", "sha256", "retrieved_on"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "format": "uri", "description": "Canonical URL of the source document." },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "retrieved_on": { "type": "string", "format": "date" },
        "media_type": { "type": "string", "default": "application/pdf" },
        "filing_type": {
          "type": "string",
          "enum": ["advice-letter", "application", "resolution", "ordinance", "rate-case-decision", "unknown"]
        },
        "filing_id": { "type": "string", "description": "Filing reference number if known (e.g. 'PGE-AL-7234-E')." }
      }
    },

    "regulator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authority": {
          "type": "string",
          "enum": ["cpuc", "ferc", "city-council", "board", "none", "unknown"]
        },
        "docket": { "type": "string" }
      }
    },

    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": { "type": "string", "description": "e.g. 'mineru', 'manual', 'pdfplumber'." },
        "tool_version": { "type": "string" },
        "extracted_on": { "type": "string", "format": "date" }
      }
    },

    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shacl_passed": { "type": "boolean" },
        "validator": { "type": "string", "description": "e.g. 'clj-urpx'." },
        "validator_ver": { "type": "string" },
        "validated_on": { "type": "string", "format": "date" }
      }
    },

    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["draft", "reviewed", "published", "superseded"]
        },
        "reviewer": { "type": "string" },
        "reviewed_on": { "type": "string", "format": "date" },
        "notes": { "type": "string" }
      }
    }
  }
}

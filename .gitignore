# Per-filing extraction byproducts (MinerU markdown, OCR, intermediates).
# Reproducible from the source PDF; preserve via extracted/notes.md if needed.
**/extracted/

# Source PDFs are committed alongside each filing (see LAYOUT.md §7).
# No PDF gitignore rule.

# Clojure CLI dependency cache
.cpcache/

# Python bytecode cache (e.g. dev/__pycache__/ from dev/validate-with-base.py)
__pycache__/
*.pyc

# OS / editor noise
.DS_Store
*.swp
*~
.idea/
.vscode/

# nREPL port file written by `clojure -M:nrepl`
.nrepl-port

# MIDAS working store and its per-identifier export. Both are rebuilt from
# the API by dev/mine_midas.py; the export is 31MB of one line per identifier.
# What IS committed from the mine is data/midas/census.json (the shape of the
# whole feed) and data/midas/lookups/ (the ten reference tables), which are
# small, and the reports generated from the store.
data/midas/midas.sqlite*
data/midas/rins.jsonl


# clj-kondo analysis cache
.clj-kondo/.cache/

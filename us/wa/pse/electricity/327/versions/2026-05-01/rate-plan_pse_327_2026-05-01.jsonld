      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "pse:327-2026-05-01-er-residential",
          "urpx:name": "Eligibility for Schedule 327 Residential Service Time-of-Use with Super Off-Peak",
          "urpx:description": "Sheet 327, AVAILABILITY: available to a Customer eligible for Schedule 7 Residential Service where PSE determines that adequate metering is available, on or after October 1, 2023; participation is limited to 2,500 Customer accounts; PSE may limit participation for study purposes; a Customer taking optional Schedule 171 service is not eligible. ENROLLMENT: the Customer must complete PSE's enrollment process. Schedule 7 limits residential service to service delivered through one meter to a single-family unit and used principally for domestic purposes, including an adult family home. The condition expression tests only that the customer is residential.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "pse:327-2026-05-01-er-residential-condition-expression",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "pse:327-2026-05-01-er-residential-condition-expression-root-node",

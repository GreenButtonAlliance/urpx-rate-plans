  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "pse:327",
    "urpx:name": "Residential Service Time-of-Use with Super Off-Peak",
    "urpx:ratePlanUniqueIdentifier": "327",
    "urpx:initialEffectiveDate": "2023-10-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "pse:327-2026-05-01",
      "urpx:description": "Puget Sound Energy's optional residential time-of-use schedule with a super off-peak period, WN U-60 Electric Tariff G Schedule 327, sheets 327 through 327-C (327, 327-A and 327-B issued September 22, 2025 under Advice No. 2025-39, effective December 12, 2025, Docket UE-250725). It is a schedule in its own right rather than a rider on Schedule 7 or Schedule 307: it prices its own Basic Charge and a three-period time-of-use Energy Charge, and a Customer leaves it by changing to Schedule 7. The Energy Charge here is the sheet 327-A column headed 'Beginning January 29, 2026'. Winter is October 1 through March 31 and Summer April 1 through September 30; in both, Peak is 7am-10am and 5pm-8pm on weekdays and Off-Peak is 10am-5pm and 8pm-11pm on weekdays and 7am-11pm on weekends and the eleven legal holidays sheet 327-B lists. Super Off-Peak is 11pm-7am every day of the year at one price. Each supplemental schedule that prices Schedule 327 per kWh is carried as its own Price with the rate that schedule states for Schedule 327, and each PriceDefinition cites the schedule and sheet. This version is the set of rates in force from May 1, 2026, the effective date of the newest supplemental sheets it carries (Schedules 95A, 120, 140, 141TEP and 142), until October 1, 2026, when the 25th Revision of Sheet 129-B replaced the Schedule 129 rate of $0.007550 per kWh carried here.",
      "urpx:effectiveDateTime": "2026-05-01T00:00:00",
      "urpx:expirationDateTime": "2026-10-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:riderUpdate"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,

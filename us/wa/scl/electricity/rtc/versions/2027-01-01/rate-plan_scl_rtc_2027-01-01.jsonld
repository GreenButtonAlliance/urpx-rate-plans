  "@id": "scl:doc-rtc-2027-01-01",
  "@type": "urpx:URPXPackage",
  "urpx:hasRatePlan": [
    {
      "@id": "scl:rtc",
      "@type": "urpx:RatePlan",
      "urpx:hasRatePlanVersion": {
        "@id": "scl:rtc-2027-01-01",
        "@type": "urpx:RatePlanVersion",
        "urpx:changeReason": {
          "@id": "urpx:rateCase"
        },
        "urpx:commodity": [
          {
            "@id": "urpx:electricity"
          }
        ],
        "urpx:customerChoice": {
          "@id": "urpx:voluntaryChoice"
        },
        "urpx:description": "Seattle City Light Schedule RTC (Residential: City Time-of-Use), the optional residential time-of-use schedule for customers inside the City of Seattle, Seattle Municipal Code 21.49.030.B as amended by Ordinance 127473 (Council Bill 121231, passed July 21, 2026, approved July 22, 2026). This version carries the column headed 'Effective January 1, 2027': Base Service Charge 55.18 cents per meter per day; Energy Off-Peak 8.45, Mid-Peak 14.79 and Peak 16.90 cents per kWh. Off-Peak is 12 a.m. to 6 a.m. every day; Mid-Peak is 6 a.m. to 5 p.m. and 9 p.m. to 12 a.m. Mondays through Saturdays and 6 a.m. to 12 a.m. on Sundays and holidays; Peak is 5 p.m. to 9 p.m. Mondays through Saturdays, other than on a holiday. There are no seasons and no blocks. The Monday-through-Saturday and Sunday brackets name their days with urpx:daysOfWeek, proposed in urpx-org/urpx#71 and in no URPX release yet. Superseded on 2028-01-01 by the ordinance's next column.",
        "urpx:effectiveDateTime": "2027-01-01T00:00:00",
        "urpx:expirationDateTime": "2028-01-01T00:00:00",
        "urpx:forRatePlan": {
          "@id": "scl:rtc"
        },
        "urpx:hasCoverageClaim": {
          "@id": "scl:cc-rtc-2027-01-01",
          "@type": "urpx:CoverageClaim",
          "urpx:completenessResult": {
            "@id": "urpx:partial"
          },
          "urpx:explainedBy": [
            {
              "@id": "scl:cc-rtc-2027-01-01-evaluation",
              "@type": "urpx:Evaluation",
              "urpx:description": "This filing does not carry everything its source document states. 1 parts are deferred, listed here in the same words as the filing's tariff.toml [modeling].deferrals so the two records cannot drift. (1) City Light's residential Time of Use page: a NERC holiday that falls on a Sunday \"is observed on the following Monday\"; one on a Saturday \"remains on that Saturday\". New Year's Day, Independence Day and Christmas Day in scl:rtc-2027-01-01-holidays carry no urpx:observanceRule, so each resolves on its actual date and a Saturday one stays on Saturday. The Monday after a Sunday New Year's Day, Independence Day or Christmas Day is carried as a dated urpx:Holiday with urpx:holidayDate: 2027-07-05, 2032-07-05, 2033-12-26, 2034-01-02, 2038-07-05, 2039-12-26, 2040-01-02. After 2040 each such Sunday holiday needs a further dated entry, until urpx:mondayIfSundayObservance (proposed in urpx-org/urpx#77) can state the rule; the dated entries then come out.",
              "urpx:evaluatedOn": "2026-10-05T00:00:00",
              "urpx:evaluationKind": {
                "@id": "urpx:coverageEvaluation"
              }
            }
          ],
          "urpx:selfContained": true
        },
        "urpx:hasDataSourceReference": [
          {
            "@type": "urpx:DataSourceReference",
            "urpx:accessURL": "https://clerk.seattle.gov/~archives/Ordinances/Ord_127473.pdf",
            "urpx:dataSourceType": {
              "@id": "urpx:regulatoryWebsiteSource"
            },
            "urpx:dateRetrieved": "2026-10-05",
            "urpx:fileName": "Ord_127473.pdf",
            "urpx:mediaType": {
              "@id": "urpx:applicationPdf"
            },
            "urpx:pageEnd": 12,
            "urpx:pageStart": 10
          }
        ],
        "urpx:hasEligibilityRule": [
          {
            "@id": "scl:rtc-2027-01-01-er-residential",
            "@type": "urpx:EligibilityRule",
            "urpx:description": "SMC 21.49.030.B as amended by Ordinance 127473: Schedules RTC and RTS are optional rate schedules available to customers who meet eligibility requirements outlined in City Light's Department Policy and Procedure (DPP) 500 P III-434, as amended, or successor rule. Customers may return to their default rate schedule but will not be able to re-enroll in Schedule RTC or RTS until 12 months from the time of unenrollment. City Light's residential Time of Use page requires an advanced meter and a Utility Services Website profile, and does not offer the rate to net metering customers. 21.49.030.C limits normal residential service to single-phase. The condition expression tests only that the customer is residential.",
            "urpx:hasConditionExpression": {
              "@id": "scl:rtc-2027-01-01-er-residential-condition-expression",
              "@type": "urpx:ConditionExpression",
              "urpx:rootNode": {
                "@id": "scl:rtc-2027-01-01-er-residential-condition-expression-root-node",
                "@type": "urpx:ComparisonNode",
                "urpx:leftOperand": {
                  "@id": "scl:rtc-2027-01-01-er-residential-condition-expression-root-node-left-operand",
                  "@type": "urpx:ObjectOperandNode",
                  "urpx:conditionProperty": {
                    "@id": "urpx:hasCustomerKind"
                  }
                },
                "urpx:operator": {
                  "@id": "urpx:equalsOperator"
                },
                "urpx:rightOperand": {
                  "@id": "scl:rtc-2027-01-01-er-residential-condition-expression-root-node-right-operand",
                  "@type": "urpx:ObjectOperandNode",
                  "urpx:referencesValue": {
                    "@id": "urpx:residentialKind"
                  }
                }
              }
            },
            "urpx:name": "Eligibility for Schedule RTC (Residential: City Time-of-Use)"
          }
        ],

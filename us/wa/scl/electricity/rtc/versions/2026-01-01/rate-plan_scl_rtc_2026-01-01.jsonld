        ],
        "urpx:hasEligibilityRule": [
          {
            "@id": "scl:rtc-2026-01-01-er-residential",
            "@type": "urpx:EligibilityRule",
            "urpx:description": "SMC 21.49.030.B as amended by Ordinance 127473: Schedules RTC and RTS are optional rate schedules available to customers who meet eligibility requirements outlined in City Light's Department Policy and Procedure (DPP) 500 P III-434, as amended, or successor rule. Customers may return to their default rate schedule but will not be able to re-enroll in Schedule RTC or RTS until 12 months from the time of unenrollment. City Light's residential Time of Use page requires an advanced meter and a Utility Services Website profile, and does not offer the rate to net metering customers. 21.49.030.C limits normal residential service to single-phase. The condition expression tests only that the customer is residential.",
            "urpx:hasConditionExpression": {
              "@id": "scl:rtc-2026-01-01-er-residential-condition-expression",
              "@type": "urpx:ConditionExpression",
              "urpx:rootNode": {
                "@id": "scl:rtc-2026-01-01-er-residential-condition-expression-root-node",
                "@type": "urpx:ComparisonNode",

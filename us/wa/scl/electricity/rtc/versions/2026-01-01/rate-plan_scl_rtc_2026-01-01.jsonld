  "@id": "scl:doc-rtc-2026-01-01",
  "@type": "urpx:URPXPackage",
  "urpx:hasRatePlan": [
    {
      "@id": "scl:rtc",
      "@type": "urpx:RatePlan",
      "urpx:hasRatePlanVersion": {
        "@id": "scl:rtc-2026-01-01",
        "@type": "urpx:RatePlanVersion",
        "urpx:changeReason": {
          "@id": "urpx:rateCase"
        },
        "urpx:commodity": [
          {
            "@id": "urpx:electricity"
          }
        ],
        "urpx:customerChoice": {
          "@id": "urpx:voluntaryChoice"
        },
        "urpx:description": "Seattle City Light Schedule RTC (Residential: City Time-of-Use), the optional residential time-of-use schedule for customers inside the City of Seattle, Seattle Municipal Code 21.49.030.B as amended by Ordinance 127473 (Council Bill 121231, passed July 21, 2026, approved July 22, 2026). This version carries the column headed 'Effective January 1, 2026': Base Service Charge 39.45 cents per meter per day; Energy Off-Peak 8.05, Mid-Peak 14.09 and Peak 16.10 cents per kWh. Off-Peak is 12 a.m. to 6 a.m. every day; Mid-Peak is 6 a.m. to 5 p.m. and 9 p.m. to 12 a.m. Mondays through Saturdays and 6 a.m. to 12 a.m. on Sundays and holidays; Peak is 5 p.m. to 9 p.m. Mondays through Saturdays, other than on a holiday. There are no seasons and no blocks. The Monday-through-Saturday and Sunday brackets name their days with urpx:daysOfWeek, proposed in urpx-org/urpx#71 and in no URPX release yet. The 2026 column was enacted by Ordinance 127122 and is restated unchanged by Ordinance 127473; City Light opened enrollment in the schedule on May 4, 2026. Superseded on 2027-01-01 by the ordinance's next column.",
        "urpx:effectiveDateTime": "2026-01-01T00:00:00",
        "urpx:expirationDateTime": "2027-01-01T00:00:00",
        "urpx:forRatePlan": {
          "@id": "scl:rtc"
        },
        "urpx:hasCoverageClaim": {
          "@id": "scl:cc-rtc-2026-01-01",
          "@type": "urpx:CoverageClaim",
          "urpx:completenessResult": {
            "@id": "urpx:partial"
          },
          "urpx:explainedBy": [
            {
              "@id": "scl:cc-rtc-2026-01-01-evaluation",
              "@type": "urpx:Evaluation",
              "urpx:description": "This filing does not carry everything its source document states. 1 parts are deferred, listed here in the same words as the filing's tariff.toml [modeling].deferrals so the two records cannot drift. (1) City Light's residential Time of Use page: a NERC holiday that falls on a Sunday \"is observed on the following Monday\"; one on a Saturday \"remains on that Saturday\". New Year's Day, Independence Day and Christmas Day in scl:rtc-2026-01-01-holidays carry no urpx:observanceRule, so each resolves on its actual date and a Saturday one stays on Saturday. The Monday after a Sunday New Year's Day, Independence Day or Christmas Day is carried as a dated urpx:Holiday with urpx:holidayDate: 2027-07-05, 2032-07-05, 2033-12-26, 2034-01-02, 2038-07-05, 2039-12-26, 2040-01-02. After 2040 each such Sunday holiday needs a further dated entry, until urpx:mondayIfSundayObservance (proposed in urpx-org/urpx#77) can state the rule; the dated entries then come out.",
              "urpx:evaluatedOn": "2026-10-05T00:00:00",
              "urpx:evaluationKind": {
                "@id": "urpx:coverageEvaluation"
              }
            }
          ],
          "urpx:selfContained": true
        },

              "@id": "scl:residential-suburban-2026-01-01-er-residential-condition-expression-root-node",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",

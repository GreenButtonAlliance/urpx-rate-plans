  "@type": "urpx:URPXPackage",
  "@id": "scl:doc-residential-suburban-2026-01-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlanModifier": {
    "@type": "urpx:RatePlanModifier",
    "@id": "scl:residential-suburban",
    "urpx:name": "Residential Suburban Franchise and Tax Multipliers and Undergrounding Charges",
    "urpx:modifierUniqueIdentifier": "RSS-RTS-SUBURBAN",
    "urpx:initialEffectiveDate": "2024-01-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "scl:residential-suburban-2026-01-01",
      "urpx:version": "2026-01-01",
      "urpx:modifierVersionNumber": "2026-01-01",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:description": "Seattle City Light's suburban franchise and tax multipliers and suburban undergrounding charges on Schedule RTS (Residential: Suburban Time-of-Use). SMC 21.49.030.A, as amended by Ordinance 127473, states for Schedule RSS that 'All charges in Schedule RSS shall be increased by the following percentages respective of the location of service' and that 'Additional undergrounding charges will apply to all customers in Shoreline and Burien'; 21.49.030.B applies 'The same franchise and tax multipliers and suburban undergrounding charges ... to Schedule RTS as Schedule RSS.' This version carries the multiplier column headed 'Effective January 1, 2026': Burien, unincorporated King County, SeaTac and Shoreline 8.00 percent; Lake Forest Park 8.04 percent; Normandy Park 6.38 percent; Tukwila 7.19 percent. The undergrounding charges, unchanged since January 1, 2023, total 0.69 cents per kWh in Shoreline (North City 0.07, Aurora 1 0.17, Aurora 2 0.18, Aurora 3A 0.05, Aurora 3B 0.22) and 0.50 cents per kWh in Burien (First Avenue South 1 0.37, First Avenue South 2 0.13). The customer's jurisdiction is a urpx:ProfileAlternatives dimension. Each alternative applies its percentage twice, as a multiplier over the RTS version's energy subtotal, which holds its Peak, Mid-Peak and Off-Peak energy charges, and as a multiplier over its Base Service Charge. A customer in Renton takes Schedule RTS with no multiplier and no undergrounding charge, so takes it without this modifier. Superseded on 2027-01-01 by the ordinance's next multiplier column.",
      "urpx:effectiveDateTime": "2026-01-01T00:00:00",
      "urpx:expirationDateTime": "2027-01-01T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:applicableToRatePlan": [
        {
          "@id": "scl:rts"
        }
      ],
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "urpx:fileName": "Ord_127473.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://clerk.seattle.gov/~archives/Ordinances/Ord_127473.pdf",
        "urpx:dateRetrieved": "2026-10-05",
        "urpx:dataSourceType": {
          "@id": "urpx:regulatoryWebsiteSource"
        },
        "urpx:pageStart": 9,
        "urpx:pageEnd": 11
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "scl:residential-suburban-2026-01-01-er-residential",
          "urpx:name": "Residential customer on Schedule RTS in a suburban jurisdiction",
          "urpx:description": "SMC 21.49.030.B: the franchise and tax multipliers and suburban undergrounding charges of Schedule RSS apply to Schedule RTS. Which multiplier and which undergrounding charges apply is set by the location of service and is the urpx:ProfileAlternative selected. The condition expression tests only that the customer is residential.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "scl:residential-suburban-2026-01-01-er-residential-condition-expression",
            "urpx:rootNode": {

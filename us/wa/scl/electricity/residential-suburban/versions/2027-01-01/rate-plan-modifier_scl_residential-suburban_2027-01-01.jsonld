        "urpx:version": "2027-01-01",
        "urpx:description": "Seattle City Light's suburban franchise and tax multipliers and suburban undergrounding charges on Schedule RTS (Residential: Suburban Time-of-Use). SMC 21.49.030.A, as amended by Ordinance 127473, states for Schedule RSS that 'All charges in Schedule RSS shall be increased by the following percentages respective of the location of service' and that 'Additional undergrounding charges will apply to all customers in Shoreline and Burien'; 21.49.030.B applies 'The same franchise and tax multipliers and suburban undergrounding charges ... to Schedule RTS as Schedule RSS.' This version carries the multiplier column headed 'Effective January 1, 2027': Burien, unincorporated King County, SeaTac and Shoreline 8.00 percent; Lake Forest Park 8.04 percent; Normandy Park 6.38 percent; Tukwila 7.05 percent. The undergrounding charges, unchanged since January 1, 2023, total 0.69 cents per kWh in Shoreline (North City 0.07, Aurora 1 0.17, Aurora 2 0.18, Aurora 3A 0.05, Aurora 3B 0.22) and 0.50 cents per kWh in Burien (First Avenue South 1 0.37, First Avenue South 2 0.13). The customer's jurisdiction is a urpx:ProfileAlternatives dimension. Each alternative applies its percentage twice, as a multiplier over the RTS version's energy subtotal, which holds its Peak, Mid-Peak and Off-Peak energy charges, and as a multiplier over its Base Service Charge. A customer in Renton takes Schedule RTS with no multiplier and no undergrounding charge, so takes it without this modifier. Superseded on 2028-01-01 by the ordinance's next multiplier column.",
        "urpx:changeReason": {
          "@id": "urpx:rateCase"
        },
        "urpx:modifierVersionNumber": "2027-01-01",
        "urpx:expirationDateTime": "2028-01-01T00:00:00",
        "urpx:hasEligibilityRule": [
          {
            "urpx:name": "Residential customer on Schedule RTS in a suburban jurisdiction",
            "urpx:description": "SMC 21.49.030.B: the franchise and tax multipliers and suburban undergrounding charges of Schedule RSS apply to Schedule RTS. Which multiplier and which undergrounding charges apply is set by the location of service and is the urpx:ProfileAlternative selected. The condition expression tests only that the customer is residential.",
            "urpx:hasConditionExpression": {
              "urpx:rootNode": {
                "urpx:operator": {
                  "@id": "urpx:equalsOperator"
                },
                "urpx:leftOperand": {
                  "urpx:conditionProperty": {
                    "@id": "urpx:hasCustomerKind"
                  },
                  "@type": "urpx:ObjectOperandNode",
                  "@id": "scl:residential-suburban-2027-01-01-er-residential-condition-expression-root-node-left-operand"
                },
                "urpx:rightOperand": {
                  "urpx:referencesValue": {
                    "@id": "urpx:residentialKind"
                  },
                  "@type": "urpx:ObjectOperandNode",
                  "@id": "scl:residential-suburban-2027-01-01-er-residential-condition-expression-root-node-right-operand"
                },
                "@type": "urpx:ComparisonNode",
                "@id": "scl:residential-suburban-2027-01-01-er-residential-condition-expression-root-node"
              },
              "@type": "urpx:ConditionExpression",
              "@id": "scl:residential-suburban-2027-01-01-er-residential-condition-expression"
            },
            "@type": "urpx:EligibilityRule",
            "@id": "scl:residential-suburban-2027-01-01-er-residential"
          }
        ],
        "urpx:applicableToRatePlan": [
          {
            "@id": "scl:rts"
          }
        ],
        "urpx:forRatePlanModifier": {
          "@id": "scl:residential-suburban"
        },
        "urpx:hasDataSourceReference": [

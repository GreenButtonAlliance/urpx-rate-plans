              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "scl:rts-2028-01-01-er-residential-condition-expression-root-node-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:hasCustomerKind"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "scl:rts-2028-01-01-er-residential-condition-expression-root-node-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:residentialKind"
                }
              }
            }
          }
        }
      ],

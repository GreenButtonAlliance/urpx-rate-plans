  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "scl:rts",
    "urpx:name": "Residential: Suburban Time-of-Use",
    "urpx:ratePlanUniqueIdentifier": "RTS",
    "urpx:initialEffectiveDate": "2024-01-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "scl:rts-2028-01-01",
      "urpx:description": "Seattle City Light Schedule RTS (Residential: Suburban Time-of-Use), the optional residential time-of-use schedule for customers in the suburban jurisdictions City Light serves, Seattle Municipal Code 21.49.030.B as amended by Ordinance 127473 (Council Bill 121231, passed July 21, 2026, approved July 22, 2026). This version carries the column headed 'Effective January 1, 2028': Base Service Charge 77.22 cents per meter per day; Energy Off-Peak 8.93, Mid-Peak 15.63 and Peak 17.86 cents per kWh. Off-Peak is 12 a.m. to 6 a.m. every day; Mid-Peak is 6 a.m. to 5 p.m. and 9 p.m. to 12 a.m. Mondays through Saturdays and 6 a.m. to 12 a.m. on Sundays and holidays; Peak is 5 p.m. to 9 p.m. Mondays through Saturdays, other than on a holiday. There are no seasons and no blocks. The Monday-through-Saturday and Sunday brackets name their days with urpx:daysOfWeek, proposed in urpx-org/urpx#71 and in no URPX release yet.",
      "urpx:effectiveDateTime": "2028-01-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "urpx:fileName": "Ord_127473.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://clerk.seattle.gov/~archives/Ordinances/Ord_127473.pdf",
        "urpx:dateRetrieved": "2026-10-05",
        "urpx:dataSourceType": {
          "@id": "urpx:regulatoryWebsiteSource"
        },
        "urpx:pageStart": 10,
        "urpx:pageEnd": 12
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "scl:rts-2028-01-01-er-residential",
          "urpx:name": "Eligibility for Schedule RTS (Residential: Suburban Time-of-Use)",
          "urpx:description": "SMC 21.49.030.B as amended by Ordinance 127473: Schedules RTC and RTS are optional rate schedules available to customers who meet eligibility requirements outlined in City Light's Department Policy and Procedure (DPP) 500 P III-434, as amended, or successor rule. Customers may return to their default rate schedule but will not be able to re-enroll in Schedule RTC or RTS until 12 months from the time of unenrollment. City Light's residential Time of Use page requires an advanced meter and a Utility Services Website profile, and does not offer the rate to net metering customers. 21.49.030.C limits normal residential service to single-phase. The condition expression tests only that the customer is residential.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "scl:rts-2028-01-01-er-residential-condition-expression",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "scl:rts-2028-01-01-er-residential-condition-expression-root-node",
              "urpx:operator": {

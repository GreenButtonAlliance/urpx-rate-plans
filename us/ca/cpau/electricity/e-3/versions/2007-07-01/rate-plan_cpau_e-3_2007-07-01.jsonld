  "@type": "urpx:URPXPackage",
  "@id": "cpau:doc-e-3-2007-07-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "cpau:e-3",
    "urpx:name": "Customer-Owned Generation Retail Rate",
    "urpx:ratePlanUniqueIdentifier": "CPAU-E-3",
    "urpx:initialEffectiveDate": "2007-07-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "cpau:e-3-2007-07-01",
      "urpx:version": "1.0",
      "urpx:effectiveDateTime": "2007-07-01T00:00:00",
      "urpx:description": "CPAU Schedule E-3 (Customer-Owned Generation), effective 2007-07-01 — buyback rates the utility pays for power produced by customer-owned generation facilities that are NOT NEM-eligible. Long-stable schedule (no published reissues since 2007). Models both Section C.1 (without-interval-meter, flat seasonal — 2 seasons × per-kWh energy buyback applying to both Firm and Non-Firm power, plus a Firm-only $4.32/kW/month capacity credit) AND Section C.2 (with-interval-meter, TOU-windowed — 3 Summer periods Peak/Mid-Peak/Off-Peak and 2 Winter periods Peak/Off-Peak, with TOU windows that DIFFER from CPAU E-4 TOU / E-7 TOU; per-kWh energy buyback applying to both Firm and Non-Firm with Peak-only Firm capacity credit). The choice of table and the type of power are one urpx:ProfileAlternatives, cpau:e3-pa-buyback-configuration, with two dimensions (hasIntervalMeter, powerType) and four cells, and the Prices sit in one urpx:PriceSetAlternative per cell: the energy buyback of the facility's table in both its Firm and Non-Firm cells, the capacity credit in the Firm cell only. Reverse-flow direction throughout — first reverse-flow filing in the urpx-rate-plans corpus (the existing CPAU E-EEC-1 / E-NSE-1 modifiers are also reverse-flow but ride inside CPAU E-1 2025-09-01's @graph). DEFERRED to follow-up: Section C.3 market-based buyback rate for facilities > 1 MW (range pricing, $2-10/kW, $0.03-0.20/kWh) — has open URPX vocabulary questions around range-pricing and reference-rate calculation.",
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:changeReason": {
        "@id": "urpx:initial"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "cpau:e3-dsr",
        "urpx:name": "CPAU Schedule E-3 (effective 2007-07-01)",
        "urpx:fileName": "e-3-rate-effective-2007-07-01.pdf",
        "urpx:url": "https://www.paloalto.gov/files/assets/public/v/1/utilities/rates-schedules-for-utilities/commercial-utility-rates/e-3-rate-effective-2007-07-01.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:dateRetrieved": "2026-04-30"
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "cpau:e3-er-eligibility",
          "urpx:name": "Customer-owned generation, not NEM-eligible",
          "urpx:description": "Applies to customer-owned power generating facilities that are NOT eligible for net metering (per Section A). Customers WITHOUT an interval meter receive the flat seasonal Section C.1 rates; customers WITH an interval meter receive the TOU-windowed Section C.2 rates. The table, and Firm against Non-Firm power, are selected through the ProfileAlternatives cpau:e3-pa-buyback-configuration. Customers with rated capacity > 1 MW may additionally request the market-based buyback rate per Section C.3 (modeling deferred — range pricing has open URPX vocabulary questions).",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "cpau:e3-cx-eligibility",
            "urpx:rootNode": {
              "@type": "urpx:BooleanOperationNode",
              "@id": "cpau:e3-bn-eligibility-and",
              "urpx:operator": {
                "@id": "urpx:andOperator"
              },
              "urpx:operandNodes": [
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "cpau:e3-cn-customer-owned-generation",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e3-cn-customer-owned-generation-left-operand",
                    "urpx:customConditionProperty": "facilityType"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e3-cn-customer-owned-generation-right-operand",
                    "urpx:stringValue": "Customer-owned generation"
                  }
                },
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "cpau:e3-cn-not-nem-eligible",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e3-cn-not-nem-eligible-left-operand",
                    "urpx:customConditionProperty": "nemEligible"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e3-cn-not-nem-eligible-right-operand",
                    "urpx:booleanValue": false
                  }
                }
              ],
              "urpx:logicExpression": "facilityType = 'Customer-owned generation' AND nemEligible = false"
            }
          }
        }
      ],

  "@type": "urpx:URPXPackage",
  "@id": "cpau:doc-e-16-2026-07-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "cpau:e-16",
    "urpx:name": "Unmetered Electric Service",
    "urpx:ratePlanUniqueIdentifier": "CPAU-E-16",
    "urpx:initialEffectiveDate": "2025-09-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "cpau:e-16-2026-07-01",
      "urpx:version": "2026-07-01",
      "urpx:effectiveDateTime": "2026-07-01T00:00:00",
      "urpx:description": "CPAU Schedule E-16 (Unmetered Electric Service), effective 2026-07-01. PARTIAL MODELING. Customer charge $11.28/month (Section C.1) is modeled structurally. The Section C.2 energy charge — published as 'using Electric Rate Schedule E-2 plus all applicable riders' — is a cross-schedule reference for which we couldn't figure out a structural URPX pattern. Energy charge described in prose only; consumers needing a full E-16 bill must combine this filing with cpau:e-2 and applicable riders. Section D estimation method (kWh estimated from Total Wattage × annual operating hours / 1000 / 12) is a calculation rule documented in prose. Section E miscellaneous rates (license fees for conduit usage, utility pole attachments, communication equipment mounting) are not modeled in v1 — annual rates rather than monthly, indexed to CPI per Section F; deferred to a follow-up. Customer charge is also the minimum monthly charge per Section C.3.",
      "urpx:customerChoice": {
        "@id": "urpx:mandatoryChoice"
      },
      "urpx:isDefault": true,
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "cpau:e-16-2026-07-01-dsr",
        "urpx:name": "CPAU Schedule E-16 (effective 2026-07-01)",
        "urpx:fileName": "e-16_effective_2026-07-01.pdf",
        "urpx:url": "https://www.paloalto.gov/files/assets/public/v/3/utilities/rates-schedules-for-utilities/city-facility-utility-rates/e-16_effective_2026-07-01.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:dateRetrieved": "2026-10-06"
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "cpau:e-16-2026-07-01-er-eligibility",
          "urpx:name": "Unmetered electric service customer",
          "urpx:description": "Applies to customers contracting with the City of Palo Alto Utilities for UNMETERED electric service for billboards, unmetered telephone services, telephone booths, railroad signals, cathodic protection units, traffic cameras, wireless antennas and related equipment, community antenna television and video systems, cable TV power supplies, automatic irrigation systems, and other miscellaneous Electric Utility fees to public agencies and private entities. Per Section A of the published Schedule E-16.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "cpau:e-16-2026-07-01-cx-eligibility",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "cpau:e-16-2026-07-01-cn-unmetered",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:CustomOperandNode",
                "@id": "cpau:e-16-2026-07-01-cn-unmetered-left-operand",
                "urpx:customConditionProperty": "metering"
              },
              "urpx:rightOperand": {
                "@type": "urpx:CustomOperandNode",
                "@id": "cpau:e-16-2026-07-01-cn-unmetered-right-operand",
                "urpx:stringValue": "Unmetered"
              }
            }
          }
        }
      ],
      "urpx:hasPlanElements": {

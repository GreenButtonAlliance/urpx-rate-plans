                "@type": "urpx:CalculationMethod",
                "@id": "cpau:e-16-2026-07-01-pd-customer-charge-cm",
                "urpx:intervalDuration": "P1M"
              },
              "urpx:referencesLedger": {
                "@id": "cpau:e-16-2026-07-01-ledger-service"

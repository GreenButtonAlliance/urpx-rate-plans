                        "@id": "cpau:e-hra-2023-01-01-price-above-max-gen-lt319-cn-left-operand",
                        "urpx:customConditionProperty": "projectedHydroGeneration"
                      },
                      "urpx:rightOperand": {
                        "@type": "urpx:CustomOperandNode",
                        "@id": "cpau:e-hra-2023-01-01-price-above-max-gen-lt319-cn-right-operand",
                        "urpx:stringValue": "319 GWh/year"
                      }
                    }
                  }
                },
                "urpx:hasDynamicPricing": {
                  "@type": "urpx:DynamicPricing",
                  "@id": "cpau:hra-dp-above-max-gen-lt319",
                  "urpx:dynamicPricingType": {
                    "@id": "urpx:indexBasedPricing"
                  },
                  "urpx:priceSource": {
                    "@id": "urpx:renewableForecastSource"
                  },
                  "urpx:updateFrequency": {
                    "@id": "urpx:onDemandUpdates"
                  },
                  "urpx:hasPriceUpdateRule": {
                    "@type": "urpx:PriceUpdateRule",
                    "@id": "cpau:hra-pur-above-max-gen-lt319",
                    "urpx:name": "CPAU E-HRA Annual Hydro Adjustment Update",
                    "urpx:description": "The Electric Hydro Rate Adjuster value is reset by the Palo Alto City Council annually in May (or when conditions warrant) based on a 4x4 lookup matrix indexed by Hydro Stabilization Reserve level (Above Maximum / 75-100% / 50-75% / Below Minimum) crossed with projected hydro generation tier (<319 / 319-480 / 480-642 / >642 GWh/year). The adjustment ranges from -$0.066/kWh credit to +$0.048/kWh surcharge. priceSource=urpx:renewableForecastSource reflects the hydro-generation projection that drives one of the two index dimensions. updateFrequency=urpx:onDemandUpdates is the closest enum fit for an annually-or-as-needed cadence (the v0.5.1 UpdateFrequencyValue enum has continuousUpdates / dailyUpdates / eventTriggeredUpdates / every15Minutes / every5Minutes / hourlyUpdates / monthlyUpdates / onDemandUpdates / weeklyUpdates — 'annuallyUpdates' is not a member; 'monthlyUpdates' would overstate the cadence)."
                  }
                }
              },

              "@id": "cpau:e-hra-2023-01-01-ledger-adjustment",
              "urpx:name": "Hydro Rate Adjustment",
              "urpx:ledgerType": {
                "@id": "urpx:bundledLedger"
              },
              "urpx:referencesMetricInput": {
                "@id": "cpau:e-hra-2023-01-01-mi-energy"

  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "cpau:e-2",
    "urpx:name": "Residential Master-Metered and Small Non-Residential Electric Service",
    "urpx:ratePlanUniqueIdentifier": "CPAU-E-2",
    "urpx:initialEffectiveDate": "2025-07-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "cpau:e-2-2025-07-01",
      "urpx:version": "1.0",
      "urpx:effectiveDateTime": "2025-07-01T00:00:00",
      "urpx:description": "CPAU Schedule E-2 (Residential Master-Metered and Small Non-Residential Electric Service), effective 2025-07-01. Two-period seasonal rate (Summer May–Oct, Winter Nov–Apr) with three-component unbundled energy pricing (commodity / distribution / public benefits) plus a flat $6.22/month customer charge.",
      "urpx:customerChoice": {
        "@id": "urpx:mandatoryChoice"
      },
      "urpx:isDefault": true,
      "urpx:changeReason": {
        "@id": "urpx:initial"
      },
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "cpau:e2-dsr",
        "urpx:name": "CPAU Schedule E-2 (effective 2025-07-01)",
        "urpx:fileName": "e-2-effective-2025-07-01.pdf",
        "urpx:url": "https://www.paloalto.gov/files/assets/public/v/5/utilities/rates-schedules-for-utilities/commercial-utility-rates/e-2-effective-2025-07-01.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:dateRetrieved": "2026-04-29"
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "cpau:er-e2-eligibility",
          "urpx:name": "Non-residential non-demand or master-metered multi-family",
          "urpx:description": "Applies to (a) non-residential customers receiving non-demand-metered Electric Service, OR (b) customers with accounts at master-metered multi-family facilities receiving non-demand-metered Electric Service. Per Section A of the published Schedule E-2 (sheet E-2-1, effective 2025-07-01).",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "cpau:cx-e2-eligibility",
            "urpx:rootNode": {
              "@type": "urpx:BooleanOperationNode",
              "@id": "cpau:bn-e2-eligibility-or",
              "urpx:operator": {
                "@id": "urpx:orOperator"
              },
              "urpx:operandNodes": [
                {
                  "@type": "urpx:BooleanOperationNode",
                  "@id": "cpau:bn-e2-non-residential",
                  "urpx:operator": {
                    "@id": "urpx:andOperator"
                  },
                  "urpx:operandNodes": [
                    {
                      "@type": "urpx:ComparisonNode",
                      "@id": "cpau:cn-e2-non-residential-kind",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:ObjectOperandNode",
                        "@id": "cpau:cn-e2-non-residential-kind-left-operand",
                        "urpx:conditionProperty": {
                          "@id": "urpx:hasCustomerKind"
                        }
                      },
                      "urpx:rightOperand": {
                        "@type": "urpx:ObjectOperandNode",
                        "@id": "cpau:cn-e2-non-residential-kind-right-operand",
                        "urpx:referencesValue": {
                          "@id": "urpx:nonResidentialKind"
                        }
                      }
                    },
                    {
                      "@type": "urpx:ComparisonNode",
                      "@id": "cpau:cn-e2-non-residential-metering",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:CustomOperandNode",
                        "@id": "cpau:cn-e2-non-residential-metering-left-operand",
                        "urpx:customConditionProperty": "metering"
                      },
                      "urpx:rightOperand": {
                        "@type": "urpx:CustomOperandNode",
                        "@id": "cpau:cn-e2-non-residential-metering-right-operand",
                        "urpx:stringValue": "Non-Demand metered"
                      }
                    }
                  ],
                  "urpx:logicExpression": "hasCustomerKind = nonResidentialKind AND metering = 'Non-Demand metered'"
                },
                {
                  "@type": "urpx:BooleanOperationNode",
                  "@id": "cpau:bn-e2-master-metered-mf",
                  "urpx:operator": {
                    "@id": "urpx:andOperator"
                  },
                  "urpx:operandNodes": [
                    {
                      "@type": "urpx:ComparisonNode",
                      "@id": "cpau:cn-e2-master-metered-residential-kind",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:ObjectOperandNode",
                        "@id": "cpau:cn-e2-master-metered-residential-kind-left-operand",
                        "urpx:conditionProperty": {
                          "@id": "urpx:hasCustomerKind"
                        }
                      },
                      "urpx:rightOperand": {
                        "@type": "urpx:ObjectOperandNode",
                        "@id": "cpau:cn-e2-master-metered-residential-kind-right-operand",
                        "urpx:referencesValue": {
                          "@id": "urpx:residentialKind"
                        }
                      }
                    },
                    {
                      "@type": "urpx:ComparisonNode",
                      "@id": "cpau:cn-e2-master-metered-dwelling",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:CustomOperandNode",
                        "@id": "cpau:cn-e2-master-metered-dwelling-left-operand",
                        "urpx:customConditionProperty": "dwellingType"
                      },
                      "urpx:rightOperand": {
                        "@type": "urpx:CustomOperandNode",
                        "@id": "cpau:cn-e2-master-metered-dwelling-right-operand",
                        "urpx:stringValue": "Master-metered multi-family"
                      }
                    },
                    {
                      "@type": "urpx:ComparisonNode",
                      "@id": "cpau:cn-e2-master-metered-metering",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:CustomOperandNode",
                        "@id": "cpau:cn-e2-master-metered-metering-left-operand",
                        "urpx:customConditionProperty": "metering"
                      },
                      "urpx:rightOperand": {
                        "@type": "urpx:CustomOperandNode",
                        "@id": "cpau:cn-e2-master-metered-metering-right-operand",
                        "urpx:stringValue": "Non-Demand metered"
                      }
                    }
                  ],
                  "urpx:logicExpression": "hasCustomerKind = residentialKind AND dwellingType = 'Master-metered multi-family' AND metering = 'Non-Demand metered'"
                }
              ],
              "urpx:logicExpression": "(non-residential branch) OR (master-metered multi-family branch)"
            }
          }
        }
      ],

      "urpx:hasCoverageClaim": {
        "@id": "cpau:cc-e-2-2025-07-01",
        "@type": "urpx:CoverageClaim",
        "urpx:completenessResult": {
          "@id": "urpx:partial"
        },
        "urpx:selfContained": true,
        "urpx:explainedBy": {
          "@type": "urpx:Evaluation",
          "@id": "cpau:cc-e-2-2025-07-01-evaluation",
          "urpx:evaluationKind": {
            "@id": "urpx:coverageEvaluation"
          },
          "urpx:description": "This filing does not carry everything its source document states. One part is deferred, listed here in the same words as the filing's tariff.toml [modeling].deferrals so the two records cannot drift. (1) Section D.3 Maximum Demand Meter is unmodeled: a demand meter is installed whenever monthly use exceeds 8,000 kWh for three consecutive months, and stays in service until monthly use falls below 6,000 kWh for twelve consecutive months. Neither threshold nor the consecutive-month counts appear anywhere in the JSON-LD; the only \"Demand\" strings are the Non-Demand-metered eligibility values.",
          "urpx:evaluatedOn": "2026-09-22T00:00:00"
        }
      }

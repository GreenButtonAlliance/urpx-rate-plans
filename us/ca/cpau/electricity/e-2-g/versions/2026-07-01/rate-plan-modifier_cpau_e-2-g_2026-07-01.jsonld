      "urpx:hasCoverageClaim": {
        "@id": "cpau:cc-e-2-g-2026-07-01",
        "@type": "urpx:CoverageClaim",
        "urpx:completenessResult": {
          "@id": "urpx:partial"
        },
        "urpx:selfContained": true,
        "urpx:explainedBy": {
          "@type": "urpx:Evaluation",
          "@id": "cpau:cc-e-2-g-2026-07-01-evaluation",
          "urpx:evaluationKind": {
            "@id": "urpx:coverageEvaluation"
          },
          "urpx:description": "The published Schedule E-2-G offers two ways into the Palo Alto Green Program and this filing represents one of them. Section C.1, the 100% Renewable Option, is modeled as the $0.0075 per kWh Palo Alto Green Charge that rides on every kWh consumed; the commodity, distribution and public benefits components printed alongside it are Schedule E-2's own values, republished unchanged, and are carried by the cpau:e-2 base filing rather than duplicated here. Section C.2, the 1000 kWh Block Purchase Option, is not represented. A customer on that option pays no per-kWh green adder at all and instead asks CPAU to buy a designated number of discrete 1,000 kWh blocks of renewable energy credits at $7.50 per block, a count of blocks the customer requests and may revise in writing at any time rather than a quantity the meter produces, so there is nothing in this filing to price such a customer with. Two Section D provisions are out of scope rather than missing: the D.4 maximum demand meter rule, under which a demand meter is installed once monthly use has exceeded 8,000 kWh for three consecutive months and may be removed once it has fallen below 6,000 kWh for twelve, is a metering operation and not a rate, and the Palo Alto Green Program application and change procedure in D.3 is a customer service step.",
          "urpx:evaluatedOn": "2026-10-06T00:00:00"
        }
      }
    }

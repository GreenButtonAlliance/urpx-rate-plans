  "@type": "urpx:URPXPackage",
  "@id": "cpau:doc-e-7-tou-2025-07-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "cpau:e-7-tou",
    "urpx:name": "Large Non-Residential Electric Time of Use Service",
    "urpx:ratePlanUniqueIdentifier": "CPAU-E-7-TOU",
    "urpx:initialEffectiveDate": "2025-07-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "cpau:e-7-tou-2025-07-01",
      "urpx:version": "1.0",
      "urpx:effectiveDateTime": "2025-07-01T00:00:00",
      "urpx:minimumTenure": "P12M",
      "urpx:description": "CPAU Schedule E-7 TOU (Large Non-Residential Electric Time of Use Service), effective 2025-07-01. Voluntary opt-in rate for demand-metered customers with maximum demand at least 1000 kW per site, sustained 3+ consecutive months in the most recent 12-month period. Two seasons; three TOU periods for energy (Peak / Mid-Peak / Off-Peak); two demand windows (Peak Demand within the energy peak window, plus Max Demand at any time). Holiday-aware (US federal holidays observed by CA utilities). Section D.3 site-aggregation feature (multiple Accounts on contiguous parcels with a common billing address) is noted but not modeled — URPX has no native vocabulary for site-level account aggregation. Modeled in v1: eligibility, seasons, TOU windows, energy + demand pricing, monthly customer charge. NOT modeled in v1 (deferred): Section D.6 Primary Voltage Discount (2.8% for >2 kV service), Section D.7 Standby Charge (non-utility on-site generation), Section D.5 12-month minimum commitment.",
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:changeReason": {
        "@id": "urpx:initial"
      },
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "cpau:e7tou-dsr",
        "urpx:name": "CPAU Schedule E-7 TOU (effective 2025-07-01)",
        "urpx:fileName": "e-7-tou-effective-2025-07-01.pdf",
        "urpx:url": "https://www.paloalto.gov/files/assets/public/v/5/utilities/rates-schedules-for-utilities/commercial-utility-rates/e-7-tou-effective-2025-07-01.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:dateRetrieved": "2026-04-30"
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "cpau:e7tou-er-eligibility",
          "urpx:name": "Demand-metered, max demand at least 1000 kW sustained 3+ months",
          "urpx:description": "Voluntary opt-in rate for large non-residential customers receiving Demand metered Electric Service whose maximum monthly demand is at least 1000 kW per site, sustained at that level for at least three consecutive months in the most recent 12-month period. Section A of the published Schedule E-7 TOU.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "cpau:e7tou-cx-eligibility",
            "urpx:rootNode": {
              "@type": "urpx:BooleanOperationNode",
              "@id": "cpau:e7tou-bn-eligibility-and",
              "urpx:operator": {
                "@id": "urpx:andOperator"
              },
              "urpx:operandNodes": [
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "cpau:e7tou-cn-demand-metered",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e7tou-cn-demand-metered-left-operand",
                    "urpx:customConditionProperty": "metering"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e7tou-cn-demand-metered-right-operand",
                    "urpx:stringValue": "Demand metered"
                  }
                },
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "cpau:e7tou-cn-demand-min-1000",
                  "urpx:operator": {
                    "@id": "urpx:greaterThanOrEqualOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e7tou-cn-demand-min-1000-left-operand",
                    "urpx:customConditionProperty": "monthlyMaxDemand_kW"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e7tou-cn-demand-min-1000-right-operand",
                    "urpx:decimalValue": "1000"
                  }
                },
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "cpau:e7tou-cn-sustained-3mo",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e7tou-cn-sustained-3mo-left-operand",
                    "urpx:customConditionProperty": "demandSustainedConsecutiveMonths"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e7tou-cn-sustained-3mo-right-operand",
                    "urpx:stringValue": "3"
                  }
                }
              ],
              "urpx:logicExpression": "metering = 'Demand metered' AND monthlyMaxDemand_kW >= 1000 AND demandSustainedConsecutiveMonths = 3"
            }
          }
        }
      ],

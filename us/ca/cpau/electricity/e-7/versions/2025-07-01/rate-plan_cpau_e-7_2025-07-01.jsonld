  "@type": "urpx:URPXPackage",
  "@id": "cpau:doc-e-7-2025-07-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "cpau:e-7",
    "urpx:name": "Large Non-Residential Electric Service",
    "urpx:ratePlanUniqueIdentifier": "CPAU-E-7",
    "urpx:initialEffectiveDate": "2025-07-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "cpau:e-7-2025-07-01",
      "urpx:version": "1.0",
      "urpx:effectiveDateTime": "2025-07-01T00:00:00",
      "urpx:description": "CPAU Schedule E-7 (Large Non-Residential Electric Service), effective 2025-07-01. Demand-metered service for customers with maximum demand at least 1000 kW per site sustained 3+ consecutive months in the most recent 12-month period. Two-period seasonal rate (Summer May–Oct, Winter Nov–Apr); no TOU within periods. Three-component unbundled energy ($/kWh: commodity / distribution / public-benefits) plus a two-component demand charge ($/kW: commodity / distribution) plus a flat $578.08/month customer charge. Demand is measured as the max kW in any 15-minute interval over the billing month (urpx:CalculationMethod with aggregationMethod=urpx:maximum). Section D.3 site-aggregation feature (qualifying customers may request service for multiple Accounts on contiguous parcels with a common billing address) is noted but not modeled — URPX has no native vocabulary for site-level account aggregation. NOT modeled in v1: Section D.6 Primary Voltage Discount (2.8% for >2 kV), Section D.7 Standby Charge, Section D.4 TES carve-out (noon-6pm weekday demand window for Thermal Energy Storage customers).",
      "urpx:customerChoice": {
        "@id": "urpx:mandatoryChoice"
      },
      "urpx:isDefault": true,
      "urpx:changeReason": {
        "@id": "urpx:initial"
      },
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "cpau:e7-dsr",
        "urpx:name": "CPAU Schedule E-7 (effective 2025-07-01)",
        "urpx:fileName": "e-7-effective-2025-07-01.pdf",
        "urpx:url": "https://www.paloalto.gov/files/assets/public/v/6/utilities/rates-schedules-for-utilities/commercial-utility-rates/e-7-effective-2025-07-01.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:dateRetrieved": "2026-04-30"
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "cpau:e7-er-eligibility",
          "urpx:name": "Demand-metered, max demand at least 1000 kW sustained 3+ months",
          "urpx:description": "Applies to large non-residential customers receiving Demand metered Electric Service whose maximum monthly demand is at least 1000 kW per site, sustained at that level for at least three consecutive months during the most recent 12-month period. Per Section A of the published Schedule E-7 (sheet E-7-1, effective 2025-07-01).",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "cpau:e7-cx-eligibility",
            "urpx:rootNode": {
              "@type": "urpx:BooleanOperationNode",
              "@id": "cpau:e7-bn-eligibility-and",
              "urpx:operator": {
                "@id": "urpx:andOperator"
              },
              "urpx:operandNodes": [
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "cpau:e7-cn-demand-metered",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e7-cn-demand-metered-left-operand",
                    "urpx:customConditionProperty": "metering"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e7-cn-demand-metered-right-operand",
                    "urpx:stringValue": "Demand metered"
                  }
                },
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "cpau:e7-cn-demand-min-1000",
                  "urpx:operator": {
                    "@id": "urpx:greaterThanOrEqualOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e7-cn-demand-min-1000-left-operand",
                    "urpx:customConditionProperty": "monthlyMaxDemand_kW"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e7-cn-demand-min-1000-right-operand",
                    "urpx:decimalValue": "1000"
                  }
                },
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "cpau:e7-cn-sustained-3mo",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e7-cn-sustained-3mo-left-operand",
                    "urpx:customConditionProperty": "demandSustainedConsecutiveMonths"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e7-cn-sustained-3mo-right-operand",
                    "urpx:stringValue": "3"
                  }
                }
              ],
              "urpx:logicExpression": "metering = 'Demand metered' AND monthlyMaxDemand_kW >= 1000 AND demandSustainedConsecutiveMonths = 3"
            }
          }
        }
      ],

        "urpx:explainedBy": {
          "@type": "urpx:Evaluation",
          "@id": "cpau:cc-e-7-2025-07-01-evaluation",
          "urpx:evaluationKind": {
            "@id": "urpx:coverageEvaluation"
          },
          "urpx:description": "The Section D.3 site-aggregation provision is not represented. It lets a qualifying customer take service under this schedule for more than one account or meter where the accounts cover contiguous parcels with no intervening public right-of-way and share a common billing address. URPX v0.5.1 names no site or account class that a demand aggregation could be scoped to, so the provision is recorded in prose and the filing prices a single account.",

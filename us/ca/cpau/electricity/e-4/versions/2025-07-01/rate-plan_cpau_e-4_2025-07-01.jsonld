  "@type": "urpx:URPXPackage",
  "@id": "cpau:doc-e-4-2025-07-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "cpau:e-4",
    "urpx:name": "Medium Non-Residential Electric Service",
    "urpx:ratePlanUniqueIdentifier": "CPAU-E-4",
    "urpx:initialEffectiveDate": "2025-07-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "cpau:e-4-2025-07-01",
      "urpx:version": "1.0",
      "urpx:effectiveDateTime": "2025-07-01T00:00:00",
      "urpx:expirationDateTime": "2026-07-01T00:00:00",
      "urpx:description": "CPAU Schedule E-4 (Medium Non-Residential Electric Service), effective 2025-07-01. Demand-metered Secondary service for customers with maximum demand below 1000 kW. Two-period seasonal rate (Summer May–Oct, Winter Nov–Apr); no TOU within periods. Three-component unbundled energy ($/kWh: commodity / distribution / public-benefits) plus a two-component demand charge ($/kW: commodity / distribution) plus a flat $126.24/month customer charge. Demand is measured as the max kW in any 15-minute interval over the billing month (urpx:CalculationMethod with aggregationMethod=urpx:maximum). NOT modeled in v1: Section D.5 Primary Voltage Discount, Section D.6 Standby Charge, Section D.3 TES carve-out (noon-6pm weekday demand window for Thermal Energy Storage customers).",
      "urpx:customerChoice": {
        "@id": "urpx:mandatoryChoice"
      },
      "urpx:isDefault": true,
      "urpx:changeReason": {
        "@id": "urpx:initial"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "cpau:e4-dsr",
        "urpx:name": "CPAU Schedule E-4 (effective 2025-07-01)",
        "urpx:fileName": "e-4-effective-2025-07-01.pdf",
        "urpx:url": "https://www.paloalto.gov/files/assets/public/v/5/utilities/rates-schedules-for-utilities/commercial-utility-rates/e-4-effective-2025-07-01.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:dateRetrieved": "2026-04-30"
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "cpau:e4-er-eligibility",
          "urpx:name": "Demand-metered Secondary, max demand below 1000 kW",
          "urpx:description": "Applies to customers receiving Demand metered Secondary Electric Service whose maximum monthly demand is below 1000 kW. May include master-metered multi-family facilities or other facilities requiring demand-metered service, as determined by the City. Per Section A of the published Schedule E-4 (sheet E-4-1, effective 2025-07-01).",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "cpau:e4-cx-eligibility",
            "urpx:rootNode": {
              "@type": "urpx:BooleanOperationNode",
              "@id": "cpau:e4-bn-eligibility-and",
              "urpx:operator": {
                "@id": "urpx:andOperator"
              },
              "urpx:operandNodes": [
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "cpau:e4-cn-demand-metered",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e4-cn-demand-metered-left-operand",
                    "urpx:customConditionProperty": "metering"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e4-cn-demand-metered-right-operand",
                    "urpx:stringValue": "Demand metered Secondary"
                  }
                },
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "cpau:e4-cn-demand-below-1000",
                  "urpx:operator": {
                    "@id": "urpx:lessThanOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e4-cn-demand-below-1000-left-operand",
                    "urpx:customConditionProperty": "monthlyMaxDemand_kW"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e4-cn-demand-below-1000-right-operand",
                    "urpx:decimalValue": "1000"
                  }
                }
              ],
              "urpx:logicExpression": "metering = 'Demand metered Secondary' AND monthlyMaxDemand_kW < 1000"
            }
          }
        }
      ],

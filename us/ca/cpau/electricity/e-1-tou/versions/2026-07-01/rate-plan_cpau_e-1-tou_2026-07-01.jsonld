                    "@id": "cpau:e-1-tou-2026-07-01-cn-residential-left-operand",
                    "urpx:conditionProperty": {
                      "@id": "urpx:hasCustomerKind"
                    }
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "cpau:e-1-tou-2026-07-01-cn-residential-right-operand",
                    "urpx:referencesValue": {
                      "@id": "urpx:residentialKind"
                    }
                  }
                },
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "cpau:e-1-tou-2026-07-01-cn-single-family",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e-1-tou-2026-07-01-cn-single-family-left-operand",
                    "urpx:customConditionProperty": "dwellingType"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e-1-tou-2026-07-01-cn-single-family-right-operand",
                    "urpx:stringValue": "Single-family dwelling"
                  }
                },
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "cpau:e-1-tou-2026-07-01-cn-separately-metered",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e-1-tou-2026-07-01-cn-separately-metered-left-operand",
                    "urpx:customConditionProperty": "metering"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e-1-tou-2026-07-01-cn-separately-metered-right-operand",
                    "urpx:stringValue": "Separately metered"
                  }
                },
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "cpau:e-1-tou-2026-07-01-cn-ami",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e-1-tou-2026-07-01-cn-ami-left-operand",
                    "urpx:customConditionProperty": "metering"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e-1-tou-2026-07-01-cn-ami-right-operand",
                    "urpx:stringValue": "AMI"
                  }
                }
              ],
              "urpx:logicExpression": "hasCustomerKind = residentialKind AND dwellingType = 'Single-family dwelling' AND metering = 'Separately metered' AND has AMI meter"
            }
          }
        }

      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:description": "This voluntary Rate Schedule applies to separately metered single-family residential dwellings receiving Electric Service from the City of Palo Alto Utilities (CPAU) who have an Advanced Metering Infrastructure meter installed. This Rate Schedule is not available to Net Energy Metered (NEM) customers and is provided at the sole discretion of CPAU.",
      "urpx:effectiveDateTime": "2026-07-01T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "urpx:url": "https://www.paloalto.gov/files/assets/public/v/2/utilities/rates-schedules-for-utilities/residential-utility-rates/e-1-tou_effective_2026-07-01.pdf",
        "urpx:fileName": "e-1-tou_effective_2026-07-01.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:dateRetrieved": "2026-10-06",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        }
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "cpau:e-1-tou-2026-07-01-er-residential-tou",
          "urpx:name": "Residential TOU eligibility",
          "urpx:description": "Voluntary residential TOU service. Eligibility: single-family dwelling, separately metered, equipped with AMI (advanced metering infrastructure) supporting time-of-use measurement.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "cpau:e-1-tou-2026-07-01-cx-residential-tou",
            "urpx:rootNode": {

          {
            "@id": "cpau:e-14"
          },
          {
            "@id": "cpau:e-16"
          }
        ],
        "urpx:hasDataSourceReference": {
          "@type": "urpx:DataSourceReference",
          "urpx:url": "https://www.paloalto.gov/files/assets/public/v/3/utilities/rates-schedules-for-utilities/e-hra-effective-2023-01-01.pdf",
          "urpx:fileName": "e-hra-effective-2023-01-01.pdf",
          "urpx:mediaType": {
            "@id": "urpx:applicationPdf"
          },
          "urpx:dateRetrieved": "2026-04-30",
          "urpx:dataSourceType": {
            "@id": "urpx:utilityWebsiteSource"
          }
        },
        "urpx:hasPlanElements": {
          "@type": "urpx:PlanElements",
          "@id": "cpau:e-hra-2023-01-01-plan-elements",
          "urpx:hasMetricInput": [
            {
              "@type": "urpx:MetricInput",
              "@id": "cpau:e-hra-2023-01-01-mi-energy",
              "urpx:name": "Energy Consumption",
              "urpx:metricInputType": {
                "@id": "urpx:measuredMetricInput"
              },
              "urpx:hasMetricSpecification": {

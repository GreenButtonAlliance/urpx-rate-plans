    {
      "@type": "urpx:RatePlanModifier",
      "@id": "cpau:e-hra",
      "urpx:name": "Electric Hydro Rate Adjuster",
      "urpx:initialEffectiveDate": "2023-01-01",
      "urpx:timezoneIdentifier": "America/Los_Angeles",
      "urpx:hasRatePlanModifierVersion": {
        "@type": "urpx:RatePlanModifierVersion",
        "@id": "cpau:e-hra-2023-01-01",
        "urpx:version": "2023-01-01",
        "urpx:changeReason": {
          "@id": "urpx:initial"
        },
        "urpx:modifierVersionNumber": "2023-01-01",
        "urpx:description": "A surcharge or discount applied to all CPAU electric rate schedules based on the strength of the City's hydrological generation portfolio. Applied to manage volatility in energy costs and the impact on customer rates. The adjustment value is determined annually in May (or when conditions warrant) by a 4x4 matrix of Hydro Stabilization Reserve level vs. projected hydro generation, and falls within the range ($0.066) credit to $0.048 surcharge per kWh. Applied upon Council approval.",
        "urpx:effectiveDateTime": "2023-01-01T00:00:00",
        "urpx:priceCurrency": "USD",
        "urpx:commodity": {
          "@id": "urpx:electricity"
        },
        "urpx:serviceRole": {
          "@id": "urpx:bundledServiceRole"
        },
        "urpx:applicableToRatePlan": {
          "@id": "cpau:e-1"
        },
        "urpx:publishedBy": {
          "@type": "urpx:Organization",
          "@id": "org:utility-cpau",
          "urpx:legalName": "City of Palo Alto Utilities",
          "urpx:eiaId": "3203",
          "urpx:organizationType": {
            "@id": "urpx:municipalOrganization"
          }
        },
        "urpx:hasDataSourceReference": {
          "@type": "urpx:DataSourceReference",
          "urpx:url": "file://./assets/CPAU_E-HRA_2023-01-01.pdf",
          "urpx:fileName": "CPAU_E-HRA_2023-01-01.pdf",
          "urpx:mediaType": {
            "@id": "urpx:applicationPdf"
          }
        },
        "urpx:hasPlanElements": {
          "@type": "urpx:PlanElements",
          "urpx:hasMetricInput": [
            {
              "@type": "urpx:MetricInput",
              "@id": "cpau:hra-mi-energy",
              "urpx:name": "Energy Consumption",
              "urpx:metricInputType": {
                "@id": "urpx:measuredMetricInput"
              },
              "urpx:hasMetricSpecification": {
                "@type": "urpx:MetricSpecification",
                "@id": "cpau:hra-ms-energy",
                "urpx:measurementKind": {
                  "@id": "urpx:energy"
                },
                "urpx:unitOfMeasure": {
                  "@id": "urpx:kWh"
                },
                "urpx:flowDirection": {
                  "@id": "urpx:forward"
                }
              }
            }
          ],
          "urpx:hasBillingModel": {
            "@type": "urpx:BillingModel",
            "urpx:hasLedger": [
              {
                "@type": "urpx:Ledger",
                "@id": "cpau:hra-ledger-adjustment",
                "urpx:name": "Hydro Rate Adjustment",
                "urpx:ledgerType": {
                  "@id": "urpx:bundledLedger"
                },
                "urpx:referencesMetricInput": {
                  "@id": "cpau:hra-mi-energy"
                }
              }
            ],
            "urpx:hasPriceDefinition": [
              {
                "@type": "urpx:PriceDefinition",
                "@id": "cpau:hra-pd-adjustment",
                "urpx:name": "Hydro Rate Adjustment",
                "urpx:description": "Surcharge or discount per kWh determined by a matrix of Hydro Stabilization Reserve level (4 rows) vs. projected hydro generation relative to average (4 columns). Value ranges from ($0.066) credit to $0.048 surcharge. One value from the matrix is in effect at any given time, set annually by staff and approved by Council.",
                "urpx:chargeType": {
                  "@id": "urpx:adjustmentPowerCost"
                },
                "urpx:chargeCategory": {
                  "@id": "urpx:adjustment"
                },
                "urpx:billPortion": {
                  "@id": "urpx:supplyPortion"
                },
                "urpx:referencesLedger": {
                  "@id": "cpau:hra-ledger-adjustment"
                }
              }
            ]
          }
        },
        "urpx:hasPrices": {
          "@type": "urpx:Prices",
          "urpx:hasPriceSet": [
            {
              "@type": "urpx:PriceSet",
              "@id": "cpau:hra-ps-reserve-above-max",
              "urpx:name": "Hydro Adjustment — Reserve Above Maximum",
              "urpx:startDate": "2023-01-01",
              "urpx:hasApplicabilityRule": {
                "@type": "urpx:ApplicabilityRule",
                "urpx:hasConditionExpression": {
                  "@type": "urpx:ConditionExpression",
                  "@id": "cpau:hra-ps-reserve-above-max-cx",
                  "urpx:rootNode": {
                    "@type": "urpx:ComparisonNode",
                    "@id": "cpau:hra-cond-reserve-above-max",
                    "urpx:operator": {
                      "@id": "urpx:greaterThanOperator"
                    },
                    "urpx:leftOperand": {
                      "@type": "urpx:CustomOperandNode",
                      "urpx:customConditionProperty": "hydroStabilizationReserveLevel"
                    },
                    "urpx:rightOperand": {
                      "@type": "urpx:CustomOperandNode",
                      "urpx:stringValue": "Maximum"
                    }
                  }
                }
              },
              "urpx:hasPrice": [
                {
                  "@type": "urpx:Price",
                  "@id": "cpau:hra-price-above-max-gen-lt319",
                  "urpx:referencesPriceDefinition": {
                    "@id": "cpau:hra-pd-adjustment"
                  },
                  "urpx:name": "Reserve Above Max / Generation < 319 GWh",
                  "urpx:unitPrice": "0.000",
                  "urpx:hasApplicabilityRule": {
                    "@type": "urpx:ApplicabilityRule",
                    "urpx:hasConditionExpression": {
                      "@type": "urpx:ConditionExpression",
                      "@id": "cpau:hra-price-above-max-gen-lt319-cx",
                      "urpx:rootNode": {
                        "@type": "urpx:ComparisonNode",
                        "@id": "cpau:hra-price-above-max-gen-lt319-cn",
                        "urpx:operator": {
                          "@id": "urpx:lessThanOperator"
                        },
                        "urpx:leftOperand": {
                          "@type": "urpx:CustomOperandNode",
                          "urpx:customConditionProperty": "projectedHydroGeneration"
                        },
                        "urpx:rightOperand": {
                          "@type": "urpx:CustomOperandNode",
                          "urpx:stringValue": "319 GWh/year"
                        }
                      }
                    }
                  }
                },
                {
                  "@type": "urpx:Price",
                  "@id": "cpau:hra-price-above-max-gen-319-480",
                  "urpx:referencesPriceDefinition": {
                    "@id": "cpau:hra-pd-adjustment"
                  },
                  "urpx:name": "Reserve Above Max / Generation 319–480 GWh",
                  "urpx:unitPrice": "-0.024",
                  "urpx:hasApplicabilityRule": {
                    "@type": "urpx:ApplicabilityRule",
                    "urpx:hasConditionExpression": {
                      "@type": "urpx:ConditionExpression",
                      "@id": "cpau:hra-price-above-max-gen-319-480-cx",
                      "urpx:rootNode": {
                        "@type": "urpx:ComparisonNode",
                        "@id": "cpau:hra-price-above-max-gen-319-480-cn",
                        "urpx:operator": {
                          "@id": "urpx:betweenOperator"
                        },
                        "urpx:leftOperand": {
                          "@type": "urpx:CustomOperandNode",
                          "urpx:customConditionProperty": "projectedHydroGeneration"
                        },
                        "urpx:rightOperand": {
                          "@type": "urpx:CustomOperandNode",
                          "urpx:stringValue": "319–480 GWh/year"
                        }
                      }
                    }
                  }
                },

            "urpx:description": "Applies to all single-family residential electric service supplied through one meter at one point of delivery for domestic purposes in a single-family dwelling unit within the City of Palo Alto electric service area.",
            "urpx:hasConditionExpression": {
              "@type": "urpx:ConditionExpression",
              "@id": "cpau:cx-residential-single-family",
              "urpx:rootNode": {

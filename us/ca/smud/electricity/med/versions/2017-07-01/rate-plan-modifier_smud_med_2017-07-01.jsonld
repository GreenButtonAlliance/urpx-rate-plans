  "@type": "urpx:URPXPackage",
  "@id": "smud:doc-med-2017-07-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlanModifier": {
    "@type": "urpx:RatePlanModifier",
    "@id": "smud:med",
    "urpx:name": "Schedule MED Medical Equipment Discount Program",
    "urpx:modifierUniqueIdentifier": "MED",
    "urpx:initialEffectiveDate": "2017-07-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "smud:med-2017-07-01",
      "urpx:version": "2017-07-01",
      "urpx:modifierVersionNumber": "2017-07-01",
      "urpx:changeReason": {
        "@id": "urpx:initial"
      },
      "urpx:description": "SMUD's Medical Equipment Discount (MED) — a flat per-month bill credit applied as an overlay to any SMUD residential base RatePlan when the customer or a full-time resident in the home depends on a qualifying medical equipment device, or has a medical condition with special heating/AC electrical needs. Adopted under SMUD Board Resolution 17-06-01 effective July 1, 2017; rate has been unchanged since (the source PDF carries an 'Edition: January 1, 2021' formatting re-issue date but the underlying $15/month credit is the original). Eligibility (Sec I + IV): customer application with qualified-health-professional certification required; qualified device list and qualified-health-professional definition maintained on smud.org. The single benefit is a flat $-15.00/month credit on the electricity usage portion of the bill (per-meter, per-month). Modeled here as $-0.4931/day (= $15/30.4 days average month length) since URPX's intervalDuration uses ISO-8601 duration and per-day credits compose more naturally with the resolver's day-based math; the per-day approximation introduces ~3% per-month error vs the actual per-month credit on customers with non-30.4-day billing cycles (deferred — exact per-month modeling would require URPX P1M intervalDuration support). Stacks additively with EAPR (Schedule MED Sec III: customers eligible for both EAPR and MED receive BOTH discounts). NOT applicable when customer is on Commercial & Industrial rates — residential only.",
      "urpx:effectiveDateTime": "2017-07-01T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:applicableToRatePlan": [
        {
          "@id": "smud:fixed"
        },
        {
          "@id": "smud:tod-5-8pm"
        },
        {
          "@id": "smud:tod-low-use"
        }
      ],
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "urpx:fileName": "SMUD_SCHEDULE_MED.pdf",
        "urpx:mediaType": {

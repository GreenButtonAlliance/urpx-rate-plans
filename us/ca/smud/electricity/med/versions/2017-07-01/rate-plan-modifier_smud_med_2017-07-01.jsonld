        },
        "urpx:accessURL": "https://www.smud.org/-/media/Documents/Rate-Information/Rates/01_MED.ashx",
        "urpx:dateRetrieved": "2026-05-04",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 1,
        "urpx:leafStart": "MED-1",
        "urpx:leafEnd": "MED-1"
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "smud:med-2017-07-01-er-eligible",
          "urpx:name": "MED-eligible residential customer",
          "urpx:description": "Customer is a residential customer who has certified (in writing, with qualified-health-professional attestation) that the customer or a full-time resident in the home: (a) depends on a qualifying medical equipment device used in the home, OR (b) has a medical condition with special electric heating needs or air conditioning needs. Application + certification required (Sec IV.A). Qualified device list and qualified-health-professional definition maintained on smud.org. Stacks additively with EAPR.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "smud:med-2017-07-01-cx-eligible",
            "urpx:rootNode": {
              "@type": "urpx:BooleanOperationNode",
              "@id": "smud:med-2017-07-01-bn-residential-and-enrolled",
              "urpx:operator": {
                "@id": "urpx:andOperator"
              },
              "urpx:operandNodes": [
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "smud:med-2017-07-01-cn-residential",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "smud:med-2017-07-01-cn-residential-left-operand",
                    "urpx:conditionProperty": {
                      "@id": "urpx:hasCustomerKind"
                    }
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "smud:med-2017-07-01-cn-residential-right-operand",
                    "urpx:referencesValue": {
                      "@id": "urpx:residentialKind"
                    }
                  }
                },
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "smud:med-2017-07-01-cn-program-enrollment",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "smud:med-2017-07-01-cn-program-enrollment-left-operand",
                    "urpx:customConditionProperty": "Program Enrollment"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "smud:med-2017-07-01-cn-program-enrollment-right-operand",
                    "urpx:stringValue": "Medical Equipment Discount"
                  }
                }
              ]
            }
          }
        }
      ],

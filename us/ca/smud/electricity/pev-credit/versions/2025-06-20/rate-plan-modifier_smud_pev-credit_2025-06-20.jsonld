          "@type": "urpx:EligibilityRule",
          "@id": "smud:er-pev-residential",
          "urpx:name": "PEV Credit — residential customer",
          "urpx:description": "Available exclusively to residential customers (per the Sec II.D phrasing 'residential customers who have a licensed passenger battery electric plug-in or plug-in hybrid electric vehicle').",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "smud:cx-pev-residential",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "smud:cn-pev-residential",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "smud:cn-pev-residential-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:hasCustomerKind"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "smud:cn-pev-residential-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:residentialKind"
                }
              }
            }
          }
        },
        {
          "@type": "urpx:EligibilityRule",
          "@id": "smud:er-pev-licensed-vehicle",
          "urpx:name": "PEV Credit — licensed passenger BEV or PHEV",
          "urpx:description": "Customer must own or lease a licensed passenger battery-electric vehicle (BEV) or plug-in hybrid electric vehicle (PHEV). Both map to urpx:evChargingDER since URPX's DERTypeValue enum does not distinguish BEV from PHEV. Conventional charge-sustaining hybrids without grid charging are NOT eligible (the Sec II.D phrasing is explicit: 'plug-in or plug-in hybrid'). The 'licensed' requirement (vehicle must be registered as a road-legal passenger vehicle, not e.g. a fleet truck or off-road EV) is captured in description prose since URPX has no structured vocabulary for vehicle-licensing-status conditions.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "smud:cx-pev-licensed-vehicle",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "smud:cn-pev-ev-charging",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "smud:cn-pev-ev-charging-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:derType"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "smud:cn-pev-ev-charging-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:evChargingDER"
                }
              }
            }
          }
        }
      ],

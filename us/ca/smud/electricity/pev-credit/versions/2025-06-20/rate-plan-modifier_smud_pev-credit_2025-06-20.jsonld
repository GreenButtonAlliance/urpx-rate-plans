  "urpx:hasRatePlanModifier": {
    "@type": "urpx:RatePlanModifier",
    "@id": "smud:pev-credit",
    "urpx:name": "Plug-In Electric Vehicle Credit (overnight EV charging incentive)",
    "urpx:modifierUniqueIdentifier": "PEV-CREDIT",
    "urpx:initialEffectiveDate": "2025-06-20",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "smud:pev-credit-2025-06-20",
      "urpx:version": "2025-06-20",
      "urpx:modifierVersionNumber": "2025-06-20",
      "urpx:changeReason": {
        "@id": "urpx:initial"
      },
      "urpx:description": "SMUD's Plug-In Electric Vehicle (PEV) Credit — a residential EV-charging incentive overlay applied on top of the customer's base SMUD residential rate (R-TOD rate categories RT02 / RTL1 / RTC1, per Schedule R-TOD Sec II.D Sheet R-TOD-3). Estimated ~30K SMUD residential EV-owner customers. Compensation: a flat $-0.0150/kWh credit applied to all electricity-usage charges from midnight to 6:00 a.m. daily (no day-of-week or seasonal restriction). Credit is published in the same Board Resolution that adopts the R-TOD base rate trajectory (Resolution 25-06-15 adopted June 19 2025, effective June 20 2025); credit value is stable across the multi-year forward rate columns (May 2025 / Jan 2026 / Jan 2027) — only the underlying R-TOD usage charges step up across those columns. Eligibility (Sec II.D): residential customer with a licensed passenger battery-electric vehicle (BEV) or plug-in hybrid electric vehicle (PHEV) — both map to urpx:evChargingDER since URPX's DERTypeValue enum does not distinguish BEV from PHEV. Conventional charge-sustaining hybrids without grid charging are NOT eligible. The credit applies on top of any of three R-TOD rate categories (RT02 Time-of-Day 5-8pm, RTL1 TOD Low-Use, RTC1 Critical Peak Pricing) — composing PEV-CREDIT with the customer's specific R-TOD rate category at billing time is the consumer (price-server) responsibility. Modeled as the modifier's own TOUSchedule with one TOUTier (PEV credit window, mapped to urpx:superOffPeakTier since the midnight-6am window aligns most closely with that standard tier role) and one TOUPeriod (midnight-6am all days). The modifier's PriceDefinition uses urpx:touPeriodNumber to reference this internal TOUPeriod (touPeriodNumber=1).",
      "urpx:effectiveDateTime": "2025-06-20T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:applicableToRatePlan": [
        {
          "@id": "smud:tod-5-8pm"
        },
        {
          "@id": "smud:tod-low-use"
        }
      ],

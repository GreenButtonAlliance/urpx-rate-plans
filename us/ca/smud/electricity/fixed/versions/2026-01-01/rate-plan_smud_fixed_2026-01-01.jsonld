  "@type": "urpx:URPXDocument",
  "@id": "smud:doc-fixed-2026-01-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.2.0/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "smud:fixed",
    "urpx:name": "Schedule R Residential Service — Fixed Rate",
    "urpx:ratePlanUniqueIdentifier": "FIXED",
    "urpx:initialEffectiveDate": "1948-01-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "smud:fixed-2026-01-01",
      "urpx:publishedBy": {
        "@type": "urpx:Organization",
        "@id": "org:utility-smud",
        "urpx:legalName": "Sacramento Municipal Utility District",
        "urpx:eiaId": "16534",
        "urpx:organizationType": {
          "@id": "urpx:utilityOrganization"
        }
      },
      "urpx:description": "SMUD's voluntary opt-out flat residential rate — alternative to the Time-of-Day (5-8 p.m.) default. Regulatory rate category RF01 within Rate Schedule R. Distinctive among modern CA residential offerings: a true non-TOU non-tiered flat rate, season-varying only. Estimated ~10% of SMUD residential = ~60K customers. Bill structure: System Infrastructure Fixed Charge ($27.00/meter/month) + flat per-kWh Electricity Usage Charge by season ($0.1371/kWh non-summer, $0.2189/kWh summer per the Jan 1, 2026 column of the multi-year rate schedule adopted by Board Resolution 25-06-15). Required (not optional) for customers with analog or digital non-communicating meters. NOT available to customers with NEM1 customer-generation approved on/after January 1, 2018, or any SSR (Solar and Storage Rate) generation, or storage-only without generation. Customers on master meters (RSMM rate category) and customers grandfathered with NEM1 generation approved before January 1, 2018 are eligible. Same source PDF (Resolution 25-06-15) as TOD-5-8pm with three forward effective-date columns; this filing captures the January 1, 2026 column. Plug-In EV Credit, EAPR/Medical Equipment overlays, NEM1/SSR/Standby/Three-Phase/Renewable-Energy options all deferred to grid-coordination/urpx-tariffs#15 (secondary epic) per cross-utility convention. Master-Metered Multifamily / Mobile Home Park Billing (rate category RSMM, also in Schedule R) is closed to new customers and is not modeled here — defer to grid-coordination/urpx-tariffs#15 or future modeling issues.",
      "urpx:effectiveDateTime": "2026-01-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "urpx:fileName": "1-R.ashx",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.smud.org/-/media/Documents/Rate-Information/Rates/1-R.ashx",
        "urpx:dateRetrieved": "2026-04-30",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:hasTariffBookReference": {
          "@type": "urpx:TariffBookReference",
          "urpx:pageStart": 1,
          "urpx:pageEnd": 4,
          "urpx:leafStart": "R-1",
          "urpx:leafEnd": "R-4"
        }
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "smud:er-residential-fixed",
          "urpx:name": "Eligibility for Schedule R Fixed Rate (rate category RF01)",
          "urpx:description": "Applicable to single- and three-phase service for residential premises: individually-metered single-family homes, duplexes, apartments, condominiums; general farm service where the meter also serves the residence; master-metered service to qualifying multifamily accommodations or mobile home parks that are submetered to single-family units. The Fixed Rate is the alternative to the TOD (5-8 p.m.) default. REQUIRED for customers with analog meters or digital non-communicating meters. NOT eligible: customers with NEM1 generation approved on/after January 1, 2018 (mandatorily on R-TOD); customers with SSR (Solar and Storage Rate) generation; customers with storage-only without an associated generating facility; customers on master meters in rate category RSMM. Customers with NEM1 generation approved BEFORE January 1, 2018 are grandfathered and may remain on Fixed Rate.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "smud:cx-residential-fixed",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "smud:cn-residential-fixed",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "urpx:conditionProperty": {
                  "@id": "urpx:hasCustomerKind"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "urpx:referencesValue": {
                  "@id": "urpx:residentialKind"
                }
              }
            }
          }
        }
      ],

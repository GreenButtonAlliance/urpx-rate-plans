    "urpx:name": "Solar and Storage Rate (SSR) — Export Compensation",
    "urpx:modifierUniqueIdentifier": "SSR",
    "urpx:initialEffectiveDate": "2022-03-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "smud:ssr-2022-03-01",
      "urpx:version": "2022-03-01",

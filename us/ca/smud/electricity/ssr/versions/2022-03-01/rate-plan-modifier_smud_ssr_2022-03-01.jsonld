      "urpx:offeredBy": {
        "@type": "urpx:UtilityOperator",
        "@id": "org:utility-smud",
        "urpx:legalName": "Sacramento Municipal Utility District",
        "urpx:organizationType": {
          "@id": "urpx:utilityOrganization"
        },
        "urpx:hasIdentity": {
          "@id": "org:utility-smud-identity",
          "@type": "urpx:OrganizationIdentity",
          "urpx:hasName": {
            "@id": "org:utility-smud-name",
            "@type": "urpx:OrganizationName",
            "urpx:name": "Sacramento Municipal Utility District"
          },
          "urpx:hasIdentifier": {
            "@id": "org:utility-smud-eia",
            "@type": "urpx:OrganizationIdentifier",

      "urpx:hasRatePlanModifier": {
        "@type": "urpx:RatePlanModifier",
        "@id": "pge:e-1-income-tier",
        "urpx:name": "E-1 Base Services Charge by income tier",
        "urpx:initialEffectiveDate": "2026-03-01",
        "urpx:timezoneIdentifier": "America/Los_Angeles",
        "urpx:modifierUniqueIdentifier": "E-1-INCOME-TIER",
        "urpx:hasRatePlanModifierVersion": {
          "@type": "urpx:RatePlanModifierVersion",
          "@id": "pge:e-1-income-tier-2026-06-01",
          "urpx:modifierVersionNumber": "2026-06-01",
          "urpx:description": "The Base Services Charge of Schedule E-1, a flat amount per customer per day at three income tiers: 0.19713 for Income Tier 1 (CARE), 0.39688 for Income Tier 2 (FERA) and 0.79343 for Income Tier 3, per Sheet 1 (Cal. P.U.C. Sheet 61362-E). Every E-1 customer pays one of the three, so this modifier is not elective; it is separate from the base plan because urpx:PlanElements allows one urpx:hasProfileAlternatives container and the base plan spends its container on the 20-cell baseline Territory x Code matrix that sets the energy tier boundaries. A caller nominates income tier here and baseline Territory and Code on the base plan, one container each.",
          "urpx:changeReason": {
            "@id": "urpx:regulatoryOrder"
          },
          "urpx:effectiveDateTime": "2026-06-01T00:00:00",
          "urpx:priceCurrency": "USD",

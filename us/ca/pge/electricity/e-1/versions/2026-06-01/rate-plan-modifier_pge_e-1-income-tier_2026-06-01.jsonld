          "urpx:hasCoverageClaim": {
            "@id": "pge:cc-e-1-income-tier-2026-06-01",
            "@type": "urpx:CoverageClaim",
            "urpx:completenessResult": {
              "@id": "urpx:partial"
            },
            "urpx:selfContained": true,
            "urpx:explainedBy": {
              "@type": "urpx:Evaluation",
              "@id": "pge:cc-e-1-income-tier-2026-06-01-evaluation",
              "urpx:evaluationKind": {
                "@id": "urpx:coverageEvaluation"
              },
              "urpx:description": "The three income-tier totals are carried and are the amounts a customer is billed. Sheet 3 (Cal. P.U.C. Sheet 61098-E) also publishes the same charge by component, 4 components x 3 income tiers = 12 values, and none of the 12 appears here. The components sum to the totals, so no bill is wrong; the published unbundling is absent. Income Tier 2 is also narrower here than on Sheet 1: it is gated on FERA enrollment alone, and Sheet 1 admits a second branch, a resident of an affordable rental unit in the California Housing Partnership database restricted to 80 percent of Area Median Income, who resolves to Tier 3 here and is billed 0.79343 rather than 0.39688. Both are listed in the filing's tariff.toml [modeling].deferrals."
            }
          }

  "@graph": [
    {
      "@id": "pge:doc-e-1-2026-03-01",
      "@type": "urpx:URPXPackage",
      "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
      "urpx:hasRatePlan": {
        "@type": "urpx:RatePlan",
        "@id": "pge:e-1",
        "urpx:name": "Residential Services",
        "urpx:initialEffectiveDate": "2001-01-01",
        "urpx:timezoneIdentifier": "America/Los_Angeles",
        "urpx:hasRatePlanVersion": {
          "@type": "urpx:RatePlanVersion",
          "@id": "pge:e-1-2026-03-01",
          "urpx:description": "Default non-TOU residential schedule. Energy is billed at three tiered rates based on percentage of baseline allowance: Tier 1 (0-100%), Tier 2 (101-400%), Tier 2 Continued (over 400%). Generation and Distribution components are tier-agnostic; the tier-varying piece is the Conservation Incentive Adjustment. The baseline allowance itself varies by baseline territory (10) and baseline code (B basic, H all-electric), and this version carries all 20 cells as urpx:ProfileAlternative nodes over two urpx:AlternativeDimension nodes, with 20 cell-scoped urpx:ServiceBracket nodes on each of the six urpx:ServiceTier nodes: 120 brackets holding the 40 kWh/day quantities of Special Condition 2, Sheet 4 (Cal. P.U.C. Sheet 61099-E), Tier 2 ending at four times Tier 1. Which cell applies is the caller's to name; nothing here selects one. Season is carried by the identity of the six tiers, three summer rungs and three winter rungs, and by no urpx:appliesInSeason. Two sibling urpx:RatePlanModifier versions complete the schedule: the Vintaged PCIA for CCA, DA and TBS customers, in this document, and the daily Base Services Charge at its three income tiers (CARE, FERA, standard), in rate-plan-modifier_pge_e-1-income-tier_2026-03-01.jsonld. Every customer pays a Base Services Charge, so that modifier is not elective even though urpx:hasModifierOptions is the only vocabulary for the link. (urpx:initialEffectiveDate is set to 2001-01-01 as a placeholder for the post-restructuring modern PG&E E-1 era; the schedule predates this.)",
          "urpx:effectiveDateTime": "2026-03-01T00:00:00",
          "urpx:changeReason": {
            "@id": "urpx:rateCase"
          },
          "urpx:priceCurrency": "USD",
          "urpx:commodity": {
            "@id": "urpx:electricity"
          },
          "urpx:serviceRole": {
            "@id": "urpx:bundledServiceRole"
          },
          "urpx:customerChoice": {
            "@id": "urpx:voluntaryChoice"
          },
          "urpx:isDefault": true,
          "urpx:hasDataSourceReference": {
            "@type": "urpx:DataSourceReference",
            "urpx:fileName": "ELEC_SCHEDS_E-1.pdf",

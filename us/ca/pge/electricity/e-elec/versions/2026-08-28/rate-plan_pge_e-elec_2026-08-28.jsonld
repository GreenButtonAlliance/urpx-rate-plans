    {
      "@id": "pge:doc-e-elec-2026-08-28",
      "@type": "urpx:URPXPackage",
      "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
      "urpx:hasRatePlan": {
        "@type": "urpx:RatePlan",
        "@id": "pge:e-elec",
        "urpx:name": "Residential Time-of-Use (Electric Home) Service",
        "urpx:initialEffectiveDate": "2022-12-01",
        "urpx:timezoneIdentifier": "America/Los_Angeles",
        "urpx:hasRatePlanVersion": {
          "@type": "urpx:RatePlanVersion",
          "@id": "pge:e-elec-2026-08-28",
          "urpx:description": "Optional residential TOU schedule for customers with qualifying electric technologies (EV charging, energy storage, electric heat pump) or NBT enrollment. Sheet 1 (61545-E) reissued under PG&E Advice Letter 7975-E effective 2026-08-28: a residential customer billed on the Net Billing Tariff who is transitioned to the PURPA Compliant tariff over a contractor's willful prevailing wage violation may stay on this schedule without a qualifying technology. Prices are those of Sheet 2 (61363-E, Advice 7921-E, effective 2026-06-01), unchanged from the 2026-06-01 version. Base Services Charge by income tier: $0.19713 (Tier 1, CARE), $0.39688 (Tier 2, FERA), $0.79343 (Tier 3). The California Climate Credit, ($36.18) per household as a semi-annual payment in the August and September bill cycles, is in this version, as in the 2026-06-01 one, priced in calendar months --08 and --09 on a urpx:householdCount MetricInput.",
          "urpx:effectiveDateTime": "2026-08-28T00:00:00",
          "urpx:changeReason": {
            "@id": "urpx:correction"
          },
          "urpx:priceCurrency": "USD",
          "urpx:commodity": {
            "@id": "urpx:electricity"
          },
          "urpx:serviceRole": {
            "@id": "urpx:bundledServiceRole"
          },
          "urpx:hasRateCase": {
            "@id": "pge:rc-d-26-04-036"
          },
          "urpx:hasDataSourceReference": {
            "@type": "urpx:DataSourceReference",
            "urpx:fileName": "ELEC_SCHEDS_E-ELEC.pdf",
            "urpx:mediaType": {
              "@id": "urpx:applicationPdf"
            },
            "urpx:accessURL": "https://www.pge.com/tariffs/assets/pdf/tariffbook/ELEC_SCHEDS_E-ELEC.pdf",
            "urpx:dateRetrieved": "2026-09-23",
            "urpx:dataSourceType": {
              "@id": "urpx:utilityWebsiteSource"
            },
            "urpx:pageStart": 1,
            "urpx:pageEnd": 6,
            "urpx:leafStart": "61118-E",
            "urpx:leafEnd": "61545-E",
            "urpx:sourcePublication": {
              "@id": "pge:al-7975-e"
            }
          },
          "urpx:hasEligibilityRule": [
            {
              "@type": "urpx:EligibilityRule",
              "@id": "pge:e-elec-2026-08-28-er-residential",
              "urpx:name": "Residential customer",
              "urpx:description": "Available to PG&E residential customers (individually-metered, whole-house service).",
              "urpx:hasConditionExpression": {
                "@type": "urpx:ConditionExpression",
                "@id": "pge:e-elec-2026-08-28-cx-residential",
                "urpx:rootNode": {
                  "@type": "urpx:ComparisonNode",
                  "@id": "pge:e-elec-2026-08-28-cn-residential",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "pge:e-elec-2026-08-28-cn-residential-left-operand",
                    "urpx:conditionProperty": {
                      "@id": "urpx:hasCustomerKind"
                    }
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "pge:e-elec-2026-08-28-cn-residential-right-operand",
                    "urpx:referencesValue": {
                      "@id": "urpx:residentialKind"
                    }
                  }
                }
              }
            },
            {
              "@type": "urpx:EligibilityRule",
              "@id": "pge:e-elec-2026-08-28-er-qualifying-technology",
              "urpx:name": "Qualifying electric technology: storage, EV, heat pump, NBT enrollment, or a former NBT customer moved to the PURPA Compliant tariff",
              "urpx:description": "Available to customers who have one or more of: a currently registered battery-electric vehicle (BEV) or plug-in hybrid (PHEV) — both map to urpx:evChargingDER since URPX's DERTypeValue enum does not distinguish them; energy storage (per Special Condition interconnection requirements); or an electric heat pump as primary water-heating or climate-control source. Customers billed on the Net Billing Tariff (NBT) must take service on E-ELEC and are not required to have any of the qualifying technologies above; the NBT condition is therefore included as a fourth OR-leaf. Sheet 1 (61545-E): \"If a NBT residential customer is transitioned to the PURPA Compliant tariff due to a willful prevailing wage violation by their contractor, that customer may continue to be served under this rate schedule without the technology requirements.\" That is a fifth OR-leaf, enrollment in the PURPA Compliant tariff, which names the prevailing wage transition in its value.",
              "urpx:hasConditionExpression": {
                "@type": "urpx:ConditionExpression",
                "@id": "pge:e-elec-2026-08-28-cx-qualifying-technology",
                "urpx:rootNode": {
                  "@type": "urpx:BooleanOperationNode",
                  "@id": "pge:e-elec-2026-08-28-bn-qualifying-technology-or",
                  "urpx:operator": {
                    "@id": "urpx:orOperator"
                  },
                  "urpx:operandNodes": [
                    {
                      "@type": "urpx:ComparisonNode",
                      "@id": "pge:e-elec-2026-08-28-cn-storage",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {

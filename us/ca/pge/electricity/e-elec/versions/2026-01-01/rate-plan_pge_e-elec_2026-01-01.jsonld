    "@id": "pge:e-elec",
    "urpx:name": "Residential Time-of-Use (Electric Home) Service",
    "urpx:initialEffectiveDate": "2022-12-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "pge:e-elec-2026-01-01",
      "urpx:description": "This optional schedule applies to individually-metered electric service to residential customers who have one or more of the following qualifying electric technologies: • Electric vehicle charging; • Energy storage; or • Electric heat pump for water heating or climate control (space heating and/or cooling).",
      "urpx:effectiveDateTime": "2026-01-01T00:00:00",
      "urpx:expirationDateTime": "2026-03-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:hasRateCase": {
        "@type": "urpx:RateCase",
        "@id": "pge:rate-case-2025",
        "urpx:caseNumber": "A2409015",
        "urpx:url": "https://apps.cpuc.ca.gov/c/A2409015"
      },

      "@type": "urpx:URPXPackage",
      "@id": "pge:doc-cca-crs-2026-01-01",
      "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
      "urpx:hasRatePlanModifier": {
        "@type": "urpx:RatePlanModifier",
        "@id": "pge:cca-crs",
        "urpx:name": "Schedule CCA-CRS",
        "urpx:modifierUniqueIdentifier": "CCA-CRS",
        "urpx:initialEffectiveDate": "2026-01-01",
        "urpx:timezoneIdentifier": "America/Los_Angeles",
        "urpx:hasRatePlanModifierVersion": {
          "@type": "urpx:RatePlanModifierVersion",
          "@id": "pge:cca-crs-2026-01-01",
          "urpx:modifierVersionNumber": "2026-01-01",
          "urpx:changeReason": {
            "@id": "urpx:rateCase"
          },
          "urpx:description": "Schedule CCA-CRS, Community Choice Aggregation Cost Responsibility Surcharge, for a residential customer taking CCA service, applied over the customer's PG&E residential base plan (E-1, E-ELEC, E-TOU-C, E-TOU-D or EV2). A CCA customer's PG&E price is the base plan plus this modifier and nothing else. Sheet 1 names four components: the Energy Cost Recovery Amount, the Ongoing Competition Transition Charge, the Wildfire Fund Charge and the Power Charge Indifference Adjustment. Sheet 3 states that its rates \"are currently reflected in each individual applicable rate schedule and are consolidated below\", and every base prices the first three in its Unbundling of Total Rates at the Sheet 3 Residential values ($0.00002, $0.00027 and $0.00591 per kWh), so this modifier carries only the Vintage PCIA. Its eighteen Residential vintage rates, 2009 through 2026, are mutually exclusive: a urpx:ProfileAlternatives crosses the departureVintage attribute with CARE enrollment, and only the non-CARE cells carry a Price, because Sheet 2 row 2 exempts CARE customers from the Vintage PCIA. Each base's Billing condition excludes the generation charge and the Bundled PCIA for CCA customers; a Price carrying urpx:multiplier -1 over that base's generation urpx:PriceSummary removes both. Generation from the CCA itself is priced by the CCA and is outside this filing. Direct Access and Transitional Bundled Service customers take the vintage rates from the inlined pge:<base>-vintage-pcia modifiers.",
          "urpx:effectiveDateTime": "2026-01-01T00:00:00",
          "urpx:priceCurrency": "USD",
          "urpx:commodity": {
            "@id": "urpx:electricity"
          },
          "urpx:serviceRole": {
            "@id": "urpx:bundledServiceRole"
          },
          "urpx:applicableToRatePlan": [
            {
              "@id": "pge:e-1"
            },
            {
              "@id": "pge:e-elec"
            },
            {
              "@id": "pge:e-tou-c"
            },
            {
              "@id": "pge:e-tou-d"
            },
            {
              "@id": "pge:ev2"
            }
          ],

      "urpx:hasPrices": {
        "@type": "urpx:Prices",
        "@id": "pge:e-rsmart-2025-10-31-prices",
        "urpx:hasPrice": [
          {
            "@type": "urpx:Price",
            "@id": "pge:e-rsmart-price-smartday-charge-2025-10-31",
            "urpx:referencesPriceDefinition": {
              "@id": "pge:e-rsmart-pd-smartday-charge"
            },
            "urpx:startDate": "2025-10-31",
            "urpx:name": "SmartDay High-Price Period Charge",
            "urpx:unitPrice": "0.60000",
            "urpx:hasDynamicPricing": {
              "@type": "urpx:DynamicPricing",
              "@id": "pge:e-rsmart-2025-10-31-dp-smartday-charge",
              "urpx:dynamicPricingType": {
                "@id": "urpx:criticalPeakPricing"
              },
              "urpx:priceSource": {
                "@id": "urpx:wholesaleMarketSource"
              },
              "urpx:updateFrequency": {
                "@id": "urpx:eventTriggeredUpdates"
              },
              "urpx:hasPriceUpdateRule": {
                "@type": "urpx:PriceUpdateRule",
                "@id": "pge:e-rsmart-2025-10-31-pur-smartday-trigger",
                "urpx:name": "SmartDay Event Day Trigger Rule",
                "urpx:description": "SmartDays are called by PG&E day-ahead, with notification by 4:00 PM the previous day. 9-15 events per calendar year. Primary trigger is the day-ahead forecast average maximum temperature across San Jose, Concord, Red Bluff, Sacramento, and Fresno: ≥98°F on non-holiday weekdays, ≥105°F on holidays/weekends (May 1 onwards each summer season; thresholds adjustable up to twice per month to achieve the 9-15-event target). Events can also be initiated for CAISO Flex Alert conditions, high California spot-market power prices, annual minimum-event-count, or testing. PG&E retains sole discretion not to call an event even if criteria are met. During an event, the +$0.60000/kWh adder applies during 4:00-9:00 PM PT, in addition to the customer's underlying OAS base rate for that period."
              }
            }
          },
          {
            "@type": "urpx:Price",
            "@id": "pge:e-rsmart-price-non-high-price-credit-2025-10-31",
            "urpx:referencesPriceDefinition": {
              "@id": "pge:e-rsmart-pd-non-high-price-credit"
            },
            "urpx:startDate": "2025-10-31",
            "urpx:name": "SmartRate Non-High-Price Period Credit — per-event rate",
            "urpx:unitPrice": "-0.00636",
            "urpx:hasApplicabilityRule": {
              "@type": "urpx:ApplicabilityRule",
              "@id": "pge:e-rsmart-2025-10-31-ar-non-high-price-credit",
              "urpx:name": "Applies to non-High-Price-Period kWh on SmartDays AND all kWh on non-SmartDays within a bill period containing at least one SmartDay. Per-event rate; effective per-kWh credit on a customer's bill = ($-0.00636) × (number of SmartDays in bill period). The N_SmartDays multiplier and bill-period aggregation are consumer-side billing-engine responsibilities — modifier-level unitPrice carries the per-event rate.",
              "urpx:hasConditionExpression": {
                "@type": "urpx:ConditionExpression",
                "@id": "pge:e-rsmart-2025-10-31-cx-non-high-price-credit",
                "urpx:rootNode": {
                  "@type": "urpx:ComparisonNode",
                  "@id": "pge:e-rsmart-2025-10-31-cn-non-high-price-credit",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "pge:e-rsmart-2025-10-31-cn-non-high-price-credit-left-operand",
                    "urpx:customConditionProperty": "SmartRate Credit Applicable"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "pge:e-rsmart-2025-10-31-cn-non-high-price-credit-right-operand",
                    "urpx:stringValue": "true"
                  }
                }
              }
            }
          },
          {
            "@type": "urpx:Price",
            "@id": "pge:e-rsmart-price-participation-credit-2025-10-31",
            "urpx:referencesPriceDefinition": {
              "@id": "pge:e-rsmart-pd-participation-credit"
            },
            "urpx:startDate": "2025-10-31",
            "urpx:name": "SmartRate Participation Credit — per-event rate",
            "urpx:unitPrice": "-0.00167",
            "urpx:hasApplicabilityRule": {
              "@type": "urpx:ApplicabilityRule",
              "@id": "pge:e-rsmart-2025-10-31-ar-participation-credit",
              "urpx:name": "Same applicability as Non-High-Price Period Credit: applies to non-High-Price-Period kWh on SmartDays AND all kWh on non-SmartDays within a bill period containing at least one SmartDay. Per-event rate; effective per-kWh credit = ($-0.00167) × (number of SmartDays in bill period). N_SmartDays multiplier and bill-period aggregation are consumer-side responsibilities.",
              "urpx:hasConditionExpression": {
                "@type": "urpx:ConditionExpression",
                "@id": "pge:e-rsmart-2025-10-31-cx-participation-credit",
                "urpx:rootNode": {
                  "@type": "urpx:ComparisonNode",
                  "@id": "pge:e-rsmart-2025-10-31-cn-participation-credit",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "pge:e-rsmart-2025-10-31-cn-participation-credit-left-operand",
                    "urpx:customConditionProperty": "SmartRate Credit Applicable"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "pge:e-rsmart-2025-10-31-cn-participation-credit-right-operand",
                    "urpx:stringValue": "true"
                  }
                }
              }
            }
          }
        ]
      },
      "urpx:offeredBy": {

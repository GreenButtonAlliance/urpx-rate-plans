  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlanModifier": {
    "@type": "urpx:RatePlanModifier",
    "@id": "pge:e-rsmart",
    "urpx:name": "Schedule E-RSMART (Residential SmartRate Program)",
    "urpx:modifierUniqueIdentifier": "E-RSMART",
    "urpx:initialEffectiveDate": "2008-06-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "pge:e-rsmart-2025-10-31",
      "urpx:version": "2025-10-31",
      "urpx:modifierVersionNumber": "2025-10-31",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:description": "Residential SmartRate Program (customer-facing 'SmartRate'), a voluntary Critical Peak Pricing overlay for PG&E Bundled-Service single-family residential customers. Pays a small per-kWh credit on non-event-window kWh in exchange for accepting a +$0.60/kWh adder on the 4-9pm window during 9-15 SmartDay event days per calendar year. PG&E's residential analog of SCE TOU-D-PRIME-CPP. SmartDays are called day-ahead by 4pm based on a temperature-forecast trigger (98°F weekdays / 105°F holidays-weekends, averaged across San Jose / Concord / Red Bluff / Sacramento / Fresno) or CAISO Flex Alerts. Available on FIVE base RatePlans (Sheet 1 APPLICABILITY): E-1, E-ELEC, E-TOU-C, E-TOU-D, EV2 — first multi-base modifier in this corpus. NBT-compatible (NBT + SmartRate stack for solar+battery+EMS customers). Modeling follows PRIME-CPP pattern: 3 PriceDefinitions on 3 Ledgers — SmartDay High-Price Period Charge ($+0.60000/kWh; hasDynamicPricing + criticalPeakPricing + PriceUpdateRule), SmartRate Non-High-Price Period Credit ($-0.00636/kWh per-event rate; N_SmartDays bill-period multiplier consumer-side), SmartRate Participation Credit ($-0.00167/kWh per-event rate; same N_SmartDays multiplier semantic). Eligibility: single CustomOperandNode predicate 'SmartRate Election' = 'true' — mirrors PRIME-CPP's single-predicate 'CPP Election' eligibility. The 4-9pm window is descriptive prose in the PriceUpdateRule, not a structurally-encoded TOUPeriod — same approach PRIME-CPP relies on. Bill Protection (first full Summer Season vs OAS), grandfathered SmartAC dual-enrollment exception, and customer-onboarding mechanics are deferred — year-long-window / process concerns that don't fit per-bill modifier shape.",
      "urpx:effectiveDateTime": "2025-10-31T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },

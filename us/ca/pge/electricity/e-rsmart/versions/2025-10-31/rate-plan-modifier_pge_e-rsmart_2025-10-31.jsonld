      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "pge:e-rsmart-2025-10-31-er-elected",
          "urpx:name": "Customer has elected SmartRate enrollment. Implies the customer is on one of the eligible base RatePlans (E-1, E-ELEC, E-TOU-C, E-TOU-D, EV2), is on Bundled Service, has a SmartMeter installed, is not master-metered, is not on NEM-1 or NEM-2, is not on standby, is not DA/CCA, is not Rule-22.1 TBS, and is not dual-enrolled in another DR program (per D.18-11-029). PG&E validates these gates at enrollment time; SmartRate Election = true encodes the post-validation customer state.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "pge:e-rsmart-2025-10-31-cx-elected",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "pge:e-rsmart-2025-10-31-cn-elected",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:CustomOperandNode",
                "@id": "pge:e-rsmart-2025-10-31-cn-elected-left-operand",
                "urpx:customConditionProperty": "SmartRate Election"
              },
              "urpx:rightOperand": {
                "@type": "urpx:CustomOperandNode",
                "@id": "pge:e-rsmart-2025-10-31-cn-elected-right-operand",
                "urpx:stringValue": "true"
              }
            }
          }
        }
      ],

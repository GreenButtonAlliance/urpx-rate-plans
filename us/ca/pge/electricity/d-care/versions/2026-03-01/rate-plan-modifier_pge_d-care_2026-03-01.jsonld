  "urpx:hasRatePlanModifier": {
    "@type": "urpx:RatePlanModifier",
    "@id": "pge:d-care",
    "urpx:name": "Schedule D-CARE Line-Item Discount for California Alternate Rates for Energy (CARE) Customers",
    "urpx:modifierUniqueIdentifier": "D-CARE",
    "urpx:initialEffectiveDate": "2026-03-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "pge:d-care-2026-03-01",
      "urpx:version": "2026-03-01",
      "urpx:modifierVersionNumber": "2026-03-01",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:description": "Line-item CARE discount applied to PG&E residential base plans E-1, E-TOU-C, E-TOU-D, EV2 and E-ELEC. Sheet 1: a CARE customer receives a percentage discount \"on their total bundled volumetric charges less charges from which they are exempt (Wildfire Fund Charge, Wildfire Hardening Charge, Recovery Bond Charge, Recovery Bond Credit, and the CARE surcharge portion of the public purpose program charge used to fund the CARE discount) on their otherwise applicable rate schedule (except for the California Climate Credit, which will not be discounted)\"; Sheet 2 sets the D-CARE Discount at 35.000 percent. The exemptions are carried as urpx:multiplier -1 over the composed base's own charge, and the discount as urpx:multiplier -0.35 over the base's CARE-discountable urpx:PriceSummary; each names its candidates in all five base plans, read as alternatives. The base services charge is not discounted: Sheet 1 assigns a CARE customer to Income Tier 1, which each base prices as a urpx:ProfileAlternative.",
      "urpx:effectiveDateTime": "2026-03-01T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },

  "@type": "urpx:URPXPackage",
  "@id": "pge:doc-nbt-2026-08-28",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlanModifier": {
    "@type": "urpx:RatePlanModifier",
    "@id": "pge:nbt",
    "urpx:name": "Schedule NBT (Net Billing Tariff) Service",
    "urpx:modifierUniqueIdentifier": "NBT",
    "urpx:initialEffectiveDate": "2023-03-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "pge:nbt-2026-08-28",
      "urpx:version": "2026-08-28",
      "urpx:modifierVersionNumber": "2026-08-28",
      "urpx:changeReason": {
        "@id": "urpx:correction"
      },
      "urpx:description": "Net Billing Tariff (NBT) per CPUC Decision 22-12-056, adopted Dec 2022, effective for new residential interconnection applications submitted on or after April 15, 2023. NBT replaces NEM-2 for new interconnections and compensates customer exports at Avoided Cost Calculator (ACC)-derived hourly Export Compensation Rates rather than at the retail rate. Customer-facing name: 'Solar Billing Plan'. Per Sheet 9 §A, residential customers taking NBT must take E-ELEC as their Otherwise Applicable Schedule (OAS) — modeled here as a urpx:RatePlanModifier overlay binding to pge:e-elec. Import-side charges remain governed by the base E-ELEC RatePlan (measured on the meter's Import Channel); this modifier handles only the export-side compensation (measured on the Export Channel; urpx:flowDirection urpx:reverse on the MetricSpecification). Import/export are independently recorded and not netted (Sheet 7). PriceDefinitions: (1) Export Compensation Rate Generation Component (system-wide; per-hour ACC values for the generation portion); (2) Export Compensation Rate Delivery Component (system-averaged across PG&E climate zones per Sheet 10 step 2; per-hour ACC values for the delivery portion); (3) ACC Plus Residential adder ('Energy Export Bonus Credit'; per-vintage 2023-2027 declining schedule; 9-year lock-in from PTO date); (4) ACC Plus Low-Income adder (higher per-kWh value for CARE/FERA / disadvantaged-community-resident-owner / California-Indian-Country residents per Sheet 5). This initial filing scopes to canonical residential NBT-S (Sheet 13: solar/wind ≤30 kW Small Customer); sibling sub-schedule filings (NBT-EXP, NBT-EXP-OTR, NBT-MT, NBT-PS, NBTA) deferred. Export Compensation Rate Prices cover 576 cells (12 months × 24 hours × weekday/weekend) per component for each of the four published vintages 2023-2026, one urpx:PriceSetAlternative per vintage, the 2025 vintage split into two by NBT Customer Segment (Residential, Residential Low Income) because its ACC Plus adder differs by segment. A weekday holiday takes that hour's weekend cell, per Sheet 6's weekdays and weekends/holidays split; the holidays are this version's own urpx:HolidayCalendar, the eight PG&E TOU holidays observed per California Government Code section 6701, because the base pge:e-elec carries none; ACC Plus values are carried for the 2025 vintage only. Annual true-up settlement, Net Surplus Compensation (NSC), and bill-credit rollover deferred to consumer (price-server) responsibility — year-long-window calculations don't fit the per-bill modifier shape (same deferral pattern as SCE TOU-D-PRIME-CPP Bill Protection). Establishes the modeling pattern reused by the SCE and SDG&E NBT filings.",
      "urpx:effectiveDateTime": "2026-08-28T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:applicableToRatePlan": [
        {
          "@id": "pge:e-elec"
        }
      ],
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "urpx:fileName": "ELEC_SCHEDS_NBT.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.pge.com/tariffs/assets/pdf/tariffbook/ELEC_SCHEDS_NBT.pdf",
        "urpx:dateRetrieved": "2026-09-23",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 48,
        "urpx:leafStart": "55440-E",

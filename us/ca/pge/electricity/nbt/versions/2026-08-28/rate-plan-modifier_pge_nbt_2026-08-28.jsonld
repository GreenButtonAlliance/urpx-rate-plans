      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "pge:nbt-2026-08-28-er-regf",
          "urpx:name": "Customer has Renewable Electrical Generating Facility (REGF)",
          "urpx:description": "Customer must operate a Renewable Electrical Generating Facility (REGF) on-site, interconnected to PG&E's distribution system. Eligible REGF technologies per Sheet 5: biomass, solar thermal, photovoltaic, wind, geothermal, fuel cells/linear generators, small hydroelectric, digester gas, municipal solid waste conversion, landfill gas, ocean wave, ocean thermal, tidal current.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "pge:nbt-2026-08-28-cx-regf",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "pge:nbt-2026-08-28-cn-regf",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:CustomOperandNode",
                "@id": "pge:nbt-2026-08-28-cn-regf-left-operand",
                "urpx:customConditionProperty": "Has Eligible REGF"
              },
              "urpx:rightOperand": {
                "@type": "urpx:CustomOperandNode",
                "@id": "pge:nbt-2026-08-28-cn-regf-right-operand",
                "urpx:stringValue": "true"
              }
            }
          }
        },
        {
          "@type": "urpx:EligibilityRule",
          "@id": "pge:nbt-2026-08-28-er-interconnection-date",
          "urpx:name": "NBT interconnection application submitted on or after 2023-04-15",
          "urpx:description": "Per Sheet 1, NEM2 closed for new interconnection applications after 2023-04-14. Customers submitting complete interconnection applications on or after 2023-04-15 (or 2024-02-15 for NBTA Load Aggregation) take service on NBT. Transition cases (NEM/NEM2 legacy customers post-legacy-period, change-of-party, etc.) per Sheet 3 are out of scope for this billing-time eligibility encoding and handled as process state.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "pge:nbt-2026-08-28-cx-interconnection-date",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "pge:nbt-2026-08-28-cn-interconnection-date",
              "urpx:operator": {
                "@id": "urpx:greaterThanOrEqualOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:CustomOperandNode",
                "@id": "pge:nbt-2026-08-28-cn-interconnection-date-left-operand",
                "urpx:customConditionProperty": "NBT Interconnection Application Date"
              },
              "urpx:rightOperand": {
                "@type": "urpx:CustomOperandNode",
                "@id": "pge:nbt-2026-08-28-cn-interconnection-date-right-operand",
                "urpx:stringValue": "2023-04-15"
              }
            }
          }
        }
      ],

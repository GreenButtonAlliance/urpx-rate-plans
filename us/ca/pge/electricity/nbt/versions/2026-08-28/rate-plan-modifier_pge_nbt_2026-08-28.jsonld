                "@id": "urpx:bundledLedger"
              },
              "urpx:referencesMetricInput": {
                "@id": "pge:nbt-2026-08-28-mi-energy-export"
              }
            },
            {
              "@type": "urpx:Ledger",
              "@id": "pge:nbt-2026-08-28-ledger-acc-plus-low-income",
              "urpx:name": "ACC Plus Low-Income Residential Adder (Energy Export Bonus Credit, low-income tier)",
              "urpx:ledgerType": {
                "@id": "urpx:bundledLedger"

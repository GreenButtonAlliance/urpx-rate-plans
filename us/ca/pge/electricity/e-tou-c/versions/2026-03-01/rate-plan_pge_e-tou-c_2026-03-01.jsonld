  "@graph": [
    {
      "@id": "pge:doc-e-tou-c-2026-03-01",
      "@type": "urpx:URPXPackage",
      "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
      "urpx:hasRatePlan": {
        "@type": "urpx:RatePlan",
        "@id": "pge:e-tou-c",
        "urpx:name": "Residential Time-Of-Use (Peak Pricing 4-9 p.m. Every Day)",
        "urpx:initialEffectiveDate": "2019-03-01",
        "urpx:timezoneIdentifier": "America/Los_Angeles",
        "urpx:hasRatePlanVersion": {
          "@type": "urpx:RatePlanVersion",
          "@id": "pge:e-tou-c-2026-03-01",
          "urpx:description": "Voluntary residential TOU schedule with summer/winter peak (4-9 p.m. all days) and off-peak periods. Customers pay a daily base services charge that varies by income tier (CARE / FERA / standard). The Conservation Incentive Adjustment applies per the 10-territory × 2-code × 2-season baseline-allowance matrix and is modeled in the sibling RatePlanModifier file `rate-plan-modifier_pge_e-tou-c-baseline-tier_2026-03-01.jsonld` (one urpx:ServiceTiers container holding three tiers, over a 20-member baselineTerritory-by-baselineCode urpx:ProfileAlternatives, with each of its 120 urpx:ServiceBracket carrying the per-cell urpx:referencesProfileAlternative and the urpx:appliesInSeason). Sheet 2’s Baseline Credit of ($0.08140) on baseline usage is the difference between Sheet 3’s two CIA rates, so that pair carries it and it is not priced again. Vintage PCIA for CCA/DA/TBS customers is modeled as a sibling RatePlanModifier in this file.",
          "urpx:effectiveDateTime": "2026-03-01T00:00:00",
          "urpx:expirationDateTime": "2026-03-27T00:00:00",
          "urpx:changeReason": {
            "@id": "urpx:rateCase"
          },
          "urpx:priceCurrency": "USD",
          "urpx:commodity": {
            "@id": "urpx:electricity"
          },
          "urpx:serviceRole": {
            "@id": "urpx:bundledServiceRole"
          },
          "urpx:customerChoice": {
            "@id": "urpx:voluntaryChoice"
          },
          "urpx:isDefault": false,
          "urpx:hasDataSourceReference": {
            "@type": "urpx:DataSourceReference",
            "urpx:fileName": "ELEC_SCHEDS_E-TOU-C.pdf",
            "urpx:mediaType": {

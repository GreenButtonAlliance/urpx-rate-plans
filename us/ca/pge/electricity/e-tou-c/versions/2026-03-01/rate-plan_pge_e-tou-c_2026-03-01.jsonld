          "urpx:hasEligibilityRule": [
            {
              "@type": "urpx:EligibilityRule",
              "@id": "pge:e-tou-c-2026-03-01-er-residential-tou-c",
              "urpx:name": "Eligibility for E-TOU-C Residential Service",
              "urpx:description": "Voluntary, opt-in. Single-phase or polyphase residential service in single-family dwellings, separately metered flats and apartments, common-area accounts in multifamily complexes, and farm service on residential premises.",

          },
          "urpx:hasCoverageClaim": {
            "@id": "pge:cc-e-tou-c-vintage-pcia-2026-03-01",
            "@type": "urpx:CoverageClaim",
            "urpx:completenessResult": {
              "@id": "urpx:partial"
            },
            "urpx:selfContained": true,
            "urpx:explainedBy": {
              "@type": "urpx:Evaluation",
              "@id": "pge:cc-e-tou-c-vintage-pcia-2026-03-01-evaluation",
              "urpx:evaluationKind": {
                "@id": "urpx:coverageEvaluation"
              },
              "urpx:description": "This modifier carries the eighteen vintage Power Charge Indifference Adjustment rates published on Sheet 8, from $0.02973 per kWh for the 2009 vintage to a credit of $0.01011 per kWh for the 2025 and 2026 vintages, gated on a residential customer taking generation service through community choice aggregation, direct access or transitional bundled service. What it does not carry is the other half of the same instruction. Sheet 8 states that these customers pay every charge in the Unbundling of Total Rates except the Bundled Power Charge Indifference Adjustment and the generation charge, but the base filing's bundled adjustment (a credit of $0.01011 per kWh) and its four seasonal generation energy prices carry no condition excluding them, and this modifier records the replacement only in its description prose, so a consumer applying the base plan together with this modifier will charge a departed customer both the bundled and the vintaged adjustment as well as PG&E generation. Three further charges Sheet 8 directs the same customers to are absent because they live in other schedules: the franchise fee surcharge under Schedule E-FFS for community choice aggregation and direct access customers, the short-term commodity prices under Schedule TBCC for transitional bundled service customers, and the exemptions set out in Schedules DA CRS and CCA CRS, including those for medical baseline customers and for continuous direct access service.",
              "urpx:evaluatedOn": "2026-09-21T00:00:00"
            }
          }
        },
        "urpx:modifierUniqueIdentifier": "E-TOU-C-VPCIA"
      }

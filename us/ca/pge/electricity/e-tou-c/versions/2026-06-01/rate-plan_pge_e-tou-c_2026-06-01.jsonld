  "@graph": [
    {
      "@id": "pge:doc-e-tou-c-2026-06-01",
      "@type": "urpx:URPXPackage",
      "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
      "urpx:hasRatePlan": {
        "@type": "urpx:RatePlan",
        "@id": "pge:e-tou-c",
        "urpx:name": "Residential Time-Of-Use (Peak Pricing 4-9 p.m. Every Day)",
        "urpx:initialEffectiveDate": "2019-03-01",
        "urpx:timezoneIdentifier": "America/Los_Angeles",
        "urpx:hasRatePlanVersion": {
          "@type": "urpx:RatePlanVersion",
          "@id": "pge:e-tou-c-2026-06-01",
          "urpx:description": "Voluntary residential TOU schedule with summer/winter peak (4-9 p.m. all days) and off-peak periods. Customers pay a daily base services charge that varies by income tier (CARE / FERA / standard). The Conservation Incentive Adjustment is priced on pge:e-tou-c-2026-06-01-tiers-baseline: Tier 1 up to the Special Condition 1 baseline quantity, Tier 2 to four times it and Tier 2 Continued above that, in kWh per day for each of the 10 baseline territories, Code B (basic) and Code H (all-electric), and both seasons. The territory and code share one urpx:ProfileAlternatives with the income tier, pge:e-tou-c-2026-06-01-pa-income-territory-code, whose 60 members are the cells of the three dimensions; each urpx:ServiceBracket names one cell and one season. Vintage PCIA for CCA/DA/TBS customers is modeled as a sibling RatePlanModifier in this file. Compared to the 2026-03-27 version: Sheet 2 (61364-E) is reissued under AL 7921-E / D.26-04-036 with the California Climate Credit restored, in the August and September bill cycles; no other price moved. The Standard Medical Baseline Quantity of Electric Rule 19 (Code M and Code S) is the modifier pge:e-tou-c-medical-baseline, a second document in this filing's directory. The California Climate Credit, ($36.18) per household as a semi-annual payment in the August and September bill cycles, is in this version, priced in calendar months --08 and --09 on a urpx:householdCount MetricInput.",
          "urpx:effectiveDateTime": "2026-06-01T00:00:00",
          "urpx:changeReason": {
            "@id": "urpx:regulatoryOrder"
          },
          "urpx:priceCurrency": "USD",
          "urpx:commodity": {
            "@id": "urpx:electricity"
          },
          "urpx:serviceRole": {
            "@id": "urpx:bundledServiceRole"
          },
          "urpx:customerChoice": {
            "@id": "urpx:voluntaryChoice"
          },
          "urpx:isDefault": false,
          "urpx:hasDataSourceReference": {
            "@type": "urpx:DataSourceReference",

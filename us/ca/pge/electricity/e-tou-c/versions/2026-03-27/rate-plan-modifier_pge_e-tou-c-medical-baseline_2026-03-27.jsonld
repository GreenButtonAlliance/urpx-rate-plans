  "@id": "pge:doc-e-tou-c-medical-baseline-2026-03-27",
  "@type": "urpx:URPXPackage",
  "urpx:hasRatePlanModifier": [
    {
      "@id": "pge:e-tou-c-medical-baseline",
      "@type": "urpx:RatePlanModifier",
      "urpx:hasRatePlanModifierVersion": {
        "@id": "pge:e-tou-c-medical-baseline-2026-03-27",
        "@type": "urpx:RatePlanModifierVersion",
        "urpx:applicableToRatePlan": [
          {
            "@id": "pge:e-tou-c"
          }
        ],
        "urpx:changeReason": {
          "@id": "urpx:rateCase"
        },
        "urpx:commodity": [
          {
            "@id": "urpx:electricity"
          }
        ],
        "urpx:description": "PG&E Electric Rule 19, Part A: \"The Standard Medical Baseline Quantity is 16.438 kWh per day (approximately) year-round.\" Schedule E-TOU-C Special Condition 5 (Sheet 6, Cal. P.U.C. Sheet 61129-E): \"Standard medical quantities are added to the baseline usage from Special Condition 1 to increase the maximum level of usage subject to baseline (Tier 1) rates.\" Its heading names the two results: Code M, Basic Plus Medical Quantities, is Code B plus the medical quantity, and Code S, All-Electric Plus Medical Quantities, is Code H plus it. This version adds 16.438 kWh per day to the Tier 1 upper bound and the Tier 2 lower bound of pge:e-tou-c-2026-03-27, and 65.752 kWh per day, four times 16.438, to the Tier 2 upper bound and the Tier 2 Continued lower bound, because Tier 2 ends at four times the baseline quantity and the medical quantity is part of the baseline. The base version's ladder ends Tier 2 at four times the Special Condition 1 quantity, the Tier 2 that Schedule E-1 prints as \"Tier 2 Usage (101% - 400% of Baseline)\"; no E-TOU-C sheet states the 400 percent figure, which the base version's manifest records as a deferral. The quantity is the same in every baseline territory, code and season, so each of the 4 urpx:ServiceBracket here names one base tier with urpx:adjustsServiceTier and no territory, code or season, one for each of the four bounds, because the base tiers carry season on their own brackets; the Code B or Code H cell selected on the base decides which bound moves. Rule 19 Part A also states that \"The Standard Medical Baseline Quantity used for automated billing is calculated using the unrounded quotient of the following equation: 6,000 kWh per year divided by 365 days. Any billing that requires hand calculations will use 16.438 kWh per day.\" The quotient (16.438356...) has no terminating decimal form, so this version carries 16.438, the figure Rule 19 prints. Customers receiving a medical baseline allowance do not pay the Wildfire Fund Charge (Sheet 1, Cal. P.U.C. Sheet 61124-E, and Special Condition 11, Sheet 10, Cal. P.U.C. Sheet 61133-E: the charge \"applies to all retail sales, excluding CARE and Medical Baseline sales\"), so this version also carries an exemption Price at urpx:multiplier -1 over pge:e-tou-c-2026-03-27-price-wildfire-fund, the shape pge:d-care uses. urpx:adjustsServiceTier, urpx:lowerBoundOffset and urpx:upperBoundOffset are proposed in urpx-org/urpx#80 and are in no URPX release.",
        "urpx:effectiveDateTime": "2026-03-27T00:00:00",
        "urpx:expirationDateTime": "2026-06-01T00:00:00",
        "urpx:forRatePlanModifier": {
          "@id": "pge:e-tou-c-medical-baseline"
        },
        "urpx:hasCoverageClaim": {
          "@id": "pge:cc-e-tou-c-medical-baseline-2026-03-27",
          "@type": "urpx:CoverageClaim",
          "urpx:completenessResult": {
            "@id": "urpx:partial"
          },
          "urpx:explainedBy": [
            {
              "@id": "pge:cc-e-tou-c-medical-baseline-2026-03-27-evaluation",
              "@type": "urpx:Evaluation",
              "urpx:description": "Rule 19 Part F's Additional Medical Baseline Quantities, which PG&E assigns case by case in increments of 16.438 kWh per day, are not carried: this version adds one Standard Medical Baseline Quantity. The offsets are kWh per day, as are the bounds they adjust, and this document does not state how a consumer scales either to a billing period. The adjusting brackets name the tier @ids of pge:e-tou-c-2026-03-27, so a later version of the schedule needs its own version of this modifier. A customer on both CARE and Medical Baseline is exempt from the Wildfire Fund Charge once, but pge:d-care and this modifier each carry a -1 multiple of the same Price, so a composition holding both would credit it twice; the one-modifier composition policy in this repository never builds that composition.",
              "urpx:evaluatedOn": "2026-10-07T00:00:00",
              "urpx:evaluationKind": {
                "@id": "urpx:coverageEvaluation"
              }
            }
          ],
          "urpx:selfContained": false
        },
        "urpx:hasDataSourceReference": [
          {
            "@id": "pge:e-tou-c-medical-baseline-2026-03-27-data-source-reference",
            "@type": "urpx:DataSourceReference",
            "urpx:accessURL": "https://www.pge.com/tariffs/assets/pdf/tariffbook/ELEC_RULES_19.pdf",
            "urpx:dataSourceType": {
              "@id": "urpx:utilityWebsiteSource"
            },
            "urpx:dateRetrieved": "2026-10-07",
            "urpx:fileName": "ELEC_RULES_19.pdf",
            "urpx:leafEnd": "55541-E",
            "urpx:leafStart": "55539-E",
            "urpx:mediaType": {
              "@id": "urpx:applicationPdf"
            },
            "urpx:pageEnd": 3,
            "urpx:pageStart": 1
          }
        ],
        "urpx:hasEligibilityRule": [
          {
            "@id": "pge:e-tou-c-medical-baseline-2026-03-27-er-eligible",
            "@type": "urpx:EligibilityRule",
            "urpx:description": "Rule 19 Part B: \"To qualify for a Standard Medical Baseline Quantity, you must certify in writing that you or a full-time resident in your home is\" dependent on a life-support device used in the home, a paraplegic, hemiplegic or quadriplegic person or a multiple sclerosis patient with special heating or cooling needs, a person being treated for a life-threatening illness or with a compromised immune system with special heating or cooling needs, or a scleroderma patient with special heating needs, with other conditions reviewed individually. Part C sets recertification every four years for a permanent condition and every two years otherwise. Carried as one enrollment condition, as sce:medical-baseline carries it.",
            "urpx:hasConditionExpression": {
              "@id": "pge:e-tou-c-medical-baseline-2026-03-27-cx-eligible",
              "@type": "urpx:ConditionExpression",
              "urpx:rootNode": {
                "@id": "pge:e-tou-c-medical-baseline-2026-03-27-cx-eligible-root-node",
                "@type": "urpx:ComparisonNode",
                "urpx:leftOperand": {
                  "@id": "pge:e-tou-c-medical-baseline-2026-03-27-cx-eligible-root-node-left-operand",
                  "@type": "urpx:CustomOperandNode",
                  "urpx:customConditionProperty": "Program Enrollment"
                },
                "urpx:operator": {
                  "@id": "urpx:equalsOperator"
                },
                "urpx:rightOperand": {
                  "@id": "pge:e-tou-c-medical-baseline-2026-03-27-cx-eligible-root-node-right-operand",
                  "@type": "urpx:CustomOperandNode",
                  "urpx:stringValue": "Medical Baseline"
                }
              }
            },
            "urpx:name": "Customer certified for Medical Baseline under Electric Rule 19"
          }
        ],
        "urpx:hasPlanElements": {
          "@id": "pge:e-tou-c-medical-baseline-2026-03-27-plan-elements",
          "@type": "urpx:PlanElements",
          "urpx:hasBillingModel": {

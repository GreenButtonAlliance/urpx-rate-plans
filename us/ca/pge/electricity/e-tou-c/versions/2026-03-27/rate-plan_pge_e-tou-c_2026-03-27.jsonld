      "urpx:hasRatePlan": {
        "@type": "urpx:RatePlan",
        "@id": "pge:e-tou-c",
        "urpx:name": "Residential Time-Of-Use (Peak Pricing 4-9 p.m. Every Day)",
        "urpx:initialEffectiveDate": "2019-03-01",
        "urpx:timezoneIdentifier": "America/Los_Angeles",
        "urpx:hasRatePlanVersion": {
          "@type": "urpx:RatePlanVersion",
          "@id": "pge:e-tou-c-2026-03-27",
          "urpx:description": "Voluntary residential TOU schedule with summer/winter peak (4-9 p.m. all days) and off-peak periods. Customers pay a daily base services charge that varies by income tier (CARE / FERA / standard). The baseline allowance varies by baseline territory (10) and baseline code (B basic, H all-electric), and this version carries all 20 cells as urpx:ProfileAlternative nodes over two urpx:AlternativeDimension nodes, with 40 cell-and-season urpx:ServiceBracket nodes on each of the three urpx:ServiceTier nodes: 120 brackets holding the 40 kWh/day quantities of Special Condition 1, Sheet 5 (Cal. P.U.C. Sheet 61128-E), Tier 2 ending at four times Tier 1. The Conservation Incentive Adjustment those tiers price is carried here too, at a credit of $0.02786 within baseline and a charge of $0.05354 above it, per Sheet 3. Which cell applies is the caller's to name; nothing here selects one. Vintage PCIA for CCA/DA/TBS customers is modeled as a sibling RatePlanModifier in this file. Compared to the 2026-03-01 version: California Climate Credit removed (Sheet 2 reissued under AL 7869-E / D.26-03-013, sheet 61249-E).",
          "urpx:effectiveDateTime": "2026-03-27T00:00:00",
          "urpx:changeReason": {
            "@id": "urpx:rateCase"
          },
          "urpx:priceCurrency": "USD",
          "urpx:commodity": {
            "@id": "urpx:electricity"
          },
          "urpx:serviceRole": {
            "@id": "urpx:bundledServiceRole"
          },
          "urpx:customerChoice": {
            "@id": "urpx:voluntaryChoice"
          },
          "urpx:isDefault": false,

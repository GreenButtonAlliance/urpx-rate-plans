      "urpx:hasRatePlan": {
        "@type": "urpx:RatePlan",
        "@id": "pge:e-tou-c",
        "urpx:name": "Residential Time-Of-Use (Peak Pricing 4-9 p.m. Every Day)",
        "urpx:initialEffectiveDate": "2019-03-01",
        "urpx:timezoneIdentifier": "America/Los_Angeles",
        "urpx:hasRatePlanVersion": {
          "@type": "urpx:RatePlanVersion",
          "@id": "pge:e-tou-c-2026-03-27",
          "urpx:description": "Voluntary residential TOU schedule with summer/winter peak (4-9 p.m. all days) and off-peak periods. Customers pay a daily base services charge that varies by income tier (CARE / FERA / standard). Baseline credit and Conservation Incentive Adjustment apply per the 10-territory × 2-code × 2-season baseline-allowance matrix and are modeled in the sibling RatePlanModifier file at `versions/2026-03-01/rate-plan-modifier_pge_e-tou-c-baseline-tier_2026-03-01.jsonld` (the matrix didn't change between 2026-03-01 and 2026-03-27, so no reissue of the modifier was needed; `applicableToRatePlan` references `pge:e-tou-c` and resolves across versions). Vintage PCIA for CCA/DA/TBS customers is modeled as a sibling RatePlanModifier in this file. Compared to the 2026-03-01 version: California Climate Credit removed (Sheet 2 reissued under AL 7869-E / D.26-03-013, sheet 61249-E).",
          "urpx:effectiveDateTime": "2026-03-27T00:00:00",
          "urpx:changeReason": {
            "@id": "urpx:rateCase"
          },
          "urpx:priceCurrency": "USD",
          "urpx:commodity": {
            "@id": "urpx:electricity"
          },
          "urpx:serviceRole": {
            "@id": "urpx:bundledServiceRole"
          },
          "urpx:customerChoice": {
            "@id": "urpx:voluntaryChoice"
          },
          "urpx:isDefault": false,
          "urpx:hasDataSourceReference": {
            "@type": "urpx:DataSourceReference",

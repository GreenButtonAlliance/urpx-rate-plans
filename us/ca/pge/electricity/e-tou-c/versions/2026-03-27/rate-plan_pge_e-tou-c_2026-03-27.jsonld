            "urpx:commodity": [
              {
                "@id": "urpx:electricity"
              }
            ],
            "urpx:description": "Vintaged Power Charge Indifference Adjustment (per kWh) applied to Transitional Bundled Service (TBS) and Direct Access (DA) customers on Schedule E-TOU-C. Replaces the Bundled PCIA for these customers; the applicable rate is determined by the customer's bundled-service departure vintage year. Community Choice Aggregation (CCA) customers take the same rates from pge:cca-crs.",
            "urpx:effectiveDateTime": "2026-03-01T00:00:00",
            "urpx:forRatePlanModifier": {
              "@id": "pge:e-tou-c-vintage-pcia"
            },
            "urpx:hasCoverageClaim": {
              "@id": "pge:cc-e-tou-c-vintage-pcia-2026-03-01",
              "@type": "urpx:CoverageClaim",
              "urpx:completenessResult": {
                "@id": "urpx:partial"
              },
              "urpx:explainedBy": [
                {
                  "@id": "pge:cc-e-tou-c-vintage-pcia-2026-03-01-evaluation",
                  "@type": "urpx:Evaluation",
                  "urpx:description": "This modifier carries the eighteen vintage Power Charge Indifference Adjustment rates published on Schedule E-TOU-C Sheet 8, from $0.02973 per kWh for the 2009 vintage to a credit of $0.01011 per kWh for the 2025 and 2026 vintages, gated on a residential customer taking Direct Access or Transitional Bundled Service. Community Choice Aggregation customers take the same eighteen rates from pge:cca-crs. Sheet 8 states that Direct Access and Transitional Bundled Service customers pay every charge in the Unbundling of Total Rates except the Bundled Power Charge Indifference Adjustment and the generation charge, and nothing in this modifier removes the base plan's generation Prices or its Bundled PCIA, so a consumer applying the base plan together with this modifier charges a Direct Access or Transitional Bundled Service customer PG&E generation and both the bundled and the vintaged adjustment. Three further charges the same sheet directs these customers to are absent because they live in other schedules: the franchise fee surcharge under Schedule E-FFS for Direct Access customers, the short-term commodity prices under Schedule TBCC for Transitional Bundled Service customers, and the exemptions set out in Schedule DA CRS.",
                  "urpx:evaluatedOn": "2026-09-21T00:00:00",
                  "urpx:evaluationKind": {
                    "@id": "urpx:coverageEvaluation"
                  }
                }
              ],
              "urpx:selfContained": true
            },
            "urpx:hasDataSourceReference": [
              {
                "@type": "urpx:DataSourceReference",
                "urpx:accessURL": "https://www.pge.com/tariffs/assets/pdf/tariffbook/ELEC_SCHEDS_E-TOU-C.pdf",
                "urpx:dataSourceType": {
                  "@id": "urpx:utilityWebsiteSource"
                },
                "urpx:dateRetrieved": "2026-04-26",

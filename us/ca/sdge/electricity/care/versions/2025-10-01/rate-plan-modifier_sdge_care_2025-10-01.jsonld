  "@type": "urpx:URPXPackage",
  "@id": "sdge:doc-care-2025-10-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlanModifier": {
    "@type": "urpx:RatePlanModifier",
    "@id": "sdge:care",
    "urpx:name": "Schedule E-CARE California Alternate Rates for Energy",
    "urpx:modifierUniqueIdentifier": "E-CARE",
    "urpx:initialEffectiveDate": "2001-08-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "sdge:care-2025-10-01",
      "urpx:version": "2025-10-01",
      "urpx:modifierVersionNumber": "2025-10-01",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:description": "California Alternate Rates for Energy (CARE) program — income-qualified bill discount applied as an overlay to any SDG&E residential base rate plan (Schedule DR, DR-SES, EV-TOU, EV-TOU-2, EV-TOU-5, TOU-DR, TOU-DR1, TOU-DR2, TOU-ELEC). CPUC-mandated program; SDG&E's implementation is defined in Schedule E-CARE per Decision 24-05-028 (intended discount rate 35%). Eligibility: customer income at-or-below 200% of Federal Poverty Guidelines OR enrollment in qualifying public-assistance programs, per Schedule E-CARE Special Condition 4 (income table). CARE provides several distinct benefits: (1) a 35% line-item bill discount (modeled as urpx:multiplier -0.35 on sdge:care-price-bill-discount-2025-10-01, over each base plan's CARE-discountable subtotal), (2) exemption from the California Wildfire Fund Charge (modeled as $-0.00591/kWh credit), (3) exemption from the Department of Water Resources Bond Charge (modeled as $-0.00000/kWh credit; currently zero but tracked for future use), (4) exemption from the CARE Surcharge that funds the program (modeled as urpx:multiplier -1 over the composed base plan's own CARE Surcharge Price, which each base splits out of its Public Purpose Programs Charge: $0.00864/kWh on the 'All Other Residential CARE Schedules' and $0.01062/kWh on EV-TOU, per Sheet 2), and (5) a Base Services Charge reduction from the standard $0.79343/day to $0.19713/day (modeled as $-0.59630/day BSC adjustment). Net per-kWh credit from line-item exemptions: $-0.01455/kWh, or $-0.01653/kWh on EV-TOU. Net per-meter-per-day credit from BSC adjustment: $-0.59630/day. Bill calculation with this modifier captures the line-item exemptions, the BSC reduction and the percentage discount. It still misstates the benefit for Schedule EV-TOU customers, whose fixed charge is a minimum bill that Schedule E-CARE halves rather than a base services charge. Customers receiving FERA discount are NOT eligible for CARE simultaneously (per Schedule FERA applicability statement). CARE Medical Baseline customers also receive Medical Baseline Program co-benefits via Schedule E-MEDICAL (NOT modeled — blocked on urpx-org/urpx#32 OPEN, additive baseline allowance vocabulary).",
      "urpx:effectiveDateTime": "2025-10-01T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },

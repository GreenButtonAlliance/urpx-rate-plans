      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "sdge:er-residential-dr-ses",
          "urpx:name": "Eligibility for Schedule DR-SES — residential customer",
          "urpx:description": "Available on a voluntary basis to individually-metered residential customers (single-family dwellings + flats) with domestic service for lighting, heating, cooking, water heating, and power. Customer must additionally have an on-premises Solar Energy System (see second EligibilityRule).",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "sdge:cx-residential-dr-ses",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "sdge:cn-residential-dr-ses",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "sdge:cn-residential-dr-ses-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:hasCustomerKind"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "sdge:cn-residential-dr-ses-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:residentialKind"
                }
              }
            }
          }
        },
        {
          "@type": "urpx:EligibilityRule",
          "@id": "sdge:er-solar-dr-ses",
          "urpx:name": "Eligibility for Schedule DR-SES — has Solar Energy System",
          "urpx:description": "Customer must have an on-premises Solar Energy System with peak AC capacity 1 kW – 5 MW, meeting California Solar Initiative eligibility criteria per CA Public Resources Code §§ 25780, 25781, 25782 (Special Condition 13). Mapped to urpx:solarDER. Current and future occupants of the premises are required to enter into a Rule 21 interconnection agreement (Special Condition 5).",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "sdge:cx-solar-dr-ses",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "sdge:cn-solar-dr-ses",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "sdge:cn-solar-dr-ses-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:derType"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "sdge:cn-solar-dr-ses-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:solarDER"
                }
              }
            }
          }
        }
      ],

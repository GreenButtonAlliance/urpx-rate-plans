  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "sdge:tou-dr1",
    "urpx:name": "Schedule TOU-DR1 Residential Time-of-Use",
    "urpx:ratePlanUniqueIdentifier": "TOU-DR1",
    "urpx:initialEffectiveDate": "2019-01-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "sdge:tou-dr1-2026-04-01",
      "urpx:description": "SDG&E's CPUC mass-migration default residential time-of-use schedule per CPUC D.18-12-004 (effective March 1, 2019). Available to ~50% of SDG&E residential = ~700K customers — the highest-leverage CA single-schedule modeling target after the SCE/PG&E defaults. Three TOU periods (On-Peak / Off-Peak / Super Off-Peak); on-peak window is 4pm-9pm every day (no weekday-only restriction, unlike SCE TOU-D-4-9PM which has weekday-only on-peak). Super-Off-Peak windows differ between weekdays (midnight-6am AND 10am-2pm) and weekends/holidays (continuous midnight-2pm). Summer season is June 1 – October 31 (5 months — longer than SCE/PG&E's 4-month summer Jun-Sep). Bill structure decomposes into UDC Total (Utility Distribution Company — delivery; flat across all periods/seasons at $0.34061/kWh; broken into 8 sub-components Trans/Distr/PPP/ND/CTC/LGC/RS/TRAC), DWR BC + WF-NBC (flat $0.00591/kWh), and EECC (Electric Energy Commodity Cost — bundled customers only; this is where the TOU signal lives, ranging from $0.04121 summer super-off-peak to $0.34920 summer on-peak). Base Services Charge is $0.79343/day for standard customers; reduced BSCs apply for CARE ($0.19713) / FERA ($0.39688) / DRAH-deed-restricted ($0.39688) — those discounted-BSC variants modeled as RatePlanModifiers in the grid-coordination/urpx-rate-plans#13 secondary epic. Baseline Adjustment Credit of $-0.10892/kWh applies to usage up to 130% of CPUC baseline allocation (both seasons; 130% threshold differs from PG&E's 400% Tier-2 boundary and SCE's 100%). CCA-served customers pay UDC + DWR-BC + WF-NBC + their CCA's generation rate plus PCIA (Power Charge Indifference Adjustment) per Special Condition 16 — PCIA modeling deferred. Franchise Fee Differential of 5.78% applies to customers within City of San Diego corporate limits (modeling deferred — affects bill total but not per-component rates). Holiday handling: the urpx:HolidayCalendar on this filing carries the eight Time-of-Use Holidays enumerated in SDG&E Electric Rule 1 (Definitions), Sheet 6, Cal. P.U.C. Sheet No. 61672-E. The weekday and the weekend/holiday shapes differ only over 6am-10am, which is Off-Peak on a weekday and Super Off-Peak on a weekend or holiday, so the calendar is applied by excluding holidays from the 6am-10am weekday Off-Peak bracket and adding a 6am-10am weekday Super Off-Peak bracket that admits holidays only. Rule 1 further directs that a Holiday falling on Sunday makes the following Monday a Holiday, with no change for one falling on Saturday. urpx:observanceRule has no value for a Sunday-only shift (its four are actualDateObservance, fridayIfWeekendObservance, mondayIfWeekendObservance and nearestWeekdayObservance), so that direction is carried as urpx:holidayRule text and is not machine-readable: the Monday after a Sunday-falling fixed-date holiday resolves here as an ordinary weekday, first on 2027-07-05.",
      "urpx:effectiveDateTime": "2026-04-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": true,

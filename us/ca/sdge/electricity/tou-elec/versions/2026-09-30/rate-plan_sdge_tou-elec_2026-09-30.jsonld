      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "sdge:tou-elec-2026-09-30-er-residential-tou-elec",
          "urpx:name": "Eligibility for Schedule TOU-ELEC, residential customer",
          "urpx:description": "Available on a voluntary basis to residential customers meeting at least one of the qualifying-technology criteria below. Customer must additionally be a residential customer (urpx:residentialKind).",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "sdge:tou-elec-2026-09-30-cx-residential-tou-elec",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "sdge:tou-elec-2026-09-30-cn-residential-tou-elec",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "sdge:tou-elec-2026-09-30-cn-residential-tou-elec-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:hasCustomerKind"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "sdge:tou-elec-2026-09-30-cn-residential-tou-elec-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:residentialKind"
                }
              }
            }
          }
        },
        {
          "@type": "urpx:EligibilityRule",
          "@id": "sdge:tou-elec-2026-09-30-er-qualifying-technology-tou-elec",
          "urpx:name": "Eligibility for Schedule TOU-ELEC, qualifying electrification technology",
          "urpx:description": "Customer must own or have on-premises at least one of: (1) a battery-electric vehicle (BEV) or plug-in hybrid (PHEV) recharged via a recharging outlet at the customer's premises (mapped to urpx:evChargingDER since URPX's DERTypeValue enum does not distinguish BEV from PHEV); (2) a natural-gas vehicle (NGV) refueled via a home refueling appliance (HRA) at the customer's premises (modeled as a CustomOperandNode since URPX has no NGV-specific vocabulary); (3) a behind-the-meter energy storage device interconnected through Electric Rule 21 (mapped to urpx:storageDER); (4) an electric heat pump for water heating or climate control (modeled as a CustomOperandNode since URPX has no heat-pump DER type). Conventional charge-sustaining hybrids (HEVs without grid charging) are NOT eligible. Per General Special Condition 9, total enrollment capped at 10,000 customers; per General Special Condition 4, customers must remain on the schedule for at least 12 consecutive months once enrolled.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "sdge:tou-elec-2026-09-30-cx-qualifying-technology-tou-elec",
            "urpx:rootNode": {
              "@type": "urpx:BooleanOperationNode",
              "@id": "sdge:tou-elec-2026-09-30-bn-qualifying-technology-tou-elec",
              "urpx:operator": {
                "@id": "urpx:orOperator"
              },
              "urpx:operandNodes": [
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "sdge:tou-elec-2026-09-30-cn-ev-charging",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "sdge:tou-elec-2026-09-30-cn-ev-charging-left-operand",
                    "urpx:conditionProperty": {
                      "@id": "urpx:derType"
                    }
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "sdge:tou-elec-2026-09-30-cn-ev-charging-right-operand",
                    "urpx:referencesValue": {
                      "@id": "urpx:evChargingDER"
                    }
                  }
                },
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "sdge:tou-elec-2026-09-30-cn-ngv",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "sdge:tou-elec-2026-09-30-cn-ngv-left-operand",
                    "urpx:customConditionProperty": "Has Natural Gas Vehicle with Home Refueling Appliance"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "sdge:tou-elec-2026-09-30-cn-ngv-right-operand",
                    "urpx:stringValue": "true"
                  }
                },
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "sdge:tou-elec-2026-09-30-cn-storage",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "sdge:tou-elec-2026-09-30-cn-storage-left-operand",
                    "urpx:conditionProperty": {
                      "@id": "urpx:derType"
                    }
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "sdge:tou-elec-2026-09-30-cn-storage-right-operand",
                    "urpx:referencesValue": {
                      "@id": "urpx:storageDER"
                    }
                  }
                },
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "sdge:tou-elec-2026-09-30-cn-heat-pump",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "sdge:tou-elec-2026-09-30-cn-heat-pump-left-operand",
                    "urpx:customConditionProperty": "Has Electric Heat Pump (water heating or climate control)"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "sdge:tou-elec-2026-09-30-cn-heat-pump-right-operand",
                    "urpx:stringValue": "true"
                  }
                }
              ]
            }
          }
        }
      ],

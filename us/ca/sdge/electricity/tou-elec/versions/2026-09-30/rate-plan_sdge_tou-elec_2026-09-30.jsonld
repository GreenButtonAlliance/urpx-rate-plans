  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "sdge:tou-elec",
    "urpx:name": "Schedule TOU-ELEC Domestic Time-of-Use for Households with Electric Vehicles, Energy Storage, or Electric Heat Pumps",
    "urpx:ratePlanUniqueIdentifier": "TOU-ELEC",
    "urpx:initialEffectiveDate": "2023-02-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "sdge:tou-elec-2026-09-30",
      "urpx:description": "SDG&E's residential time-of-use schedule for households with an electric vehicle, a natural gas vehicle refueled at home, behind-the-meter storage or an electric heat pump, with enrollment capped. Three TOU periods: On-Peak 4 p.m. to 9 p.m. every day; Super Off-Peak midnight to 6 a.m. and 10 a.m. to 2 p.m. on weekdays and midnight to 2 p.m. on weekends and holidays; Off-Peak all other hours. Summer is June 1 to October 31, winter November 1 to May 31. The UDC Total is flat at $0.24970/kWh and carries no TRAC; there is no Baseline Adjustment Credit. DWR-BC plus WF-NBC is $0.00591/kWh; the EECC commodity rate runs from $0.08085 winter super off peak to $0.47028 summer on peak. Base Services Charge $0.79343/day; the CARE, FERA and DRAH reductions of it are the modifiers sdge:care, sdge:fera and sdge:drah. Advice 4874-E prints the EECC prices in this schedule itself from 2026-09-30; Schedule EECC, which carried them before, is retired. Holiday handling: the urpx:HolidayCalendar on this filing carries the eight Time-of-Use Holidays enumerated in SDG&E Electric Rule 1 (Definitions), Sheet 6, Cal. P.U.C. Sheet No. 61672-E. The weekday and the weekend/holiday shapes differ only over 6am-10am, which is Off-Peak on a weekday and Super Off-Peak on a weekend or holiday, so the calendar is applied by excluding holidays from the 6am-10am weekday Off-Peak bracket and adding a 6am-10am weekday Super Off-Peak bracket that admits holidays only. Rule 1 further directs that a Holiday falling on Sunday makes the following Monday a Holiday, with no change for one falling on Saturday. urpx:observanceRule has no value for a Sunday-only shift (its four are actualDateObservance, fridayIfWeekendObservance, mondayIfWeekendObservance and nearestWeekdayObservance), so that direction is carried as urpx:holidayRule text, and each Monday it creates through 2040 is carried as a dated urpx:Holiday, the first on 2027-07-05.",
      "urpx:effectiveDateTime": "2026-09-30T00:00:00",
      "urpx:minimumTenure": "P12M",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,

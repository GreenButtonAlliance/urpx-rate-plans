  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "sdge:tou-elec",
    "urpx:name": "Schedule TOU-ELEC Domestic Time-of-Use for Households with Electric Vehicles, Energy Storage, or Electric Heat Pumps",
    "urpx:ratePlanUniqueIdentifier": "TOU-ELEC",
    "urpx:initialEffectiveDate": "2023-02-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "sdge:tou-elec-2026-04-01",
      "urpx:description": "SDG&E's electrification-targeted residential time-of-use schedule for households with at least one of: a battery-electric or plug-in hybrid vehicle (BEV/PHEV) recharged via on-premises outlet, a natural-gas vehicle (NGV) refueled via a home refueling appliance (HRA), a behind-the-meter energy storage device interconnected per Electric Rule 21, or an electric heat pump for water heating or climate control. Estimated ~70K customers (capped at 10,000 enrollments per Special Condition 10 — but the cap has been raised over time and the schedule has substantial enrollment under the original cap plus subsequent expansions; precise count via SDG&E enrollment data). Three TOU periods (On-Peak / Off-Peak / Super Off-Peak); same TOU windows as TOU-DR1 and EV-TOU-5 (4-9pm peak all days; super-off-peak split midnight-6am + 10am-2pm weekdays / continuous midnight-2pm weekends/holidays). Distinguishing structural features vs TOU-DR1: (1) UDC Total is FLAT $0.26288/kWh across all periods (lower than TOU-DR1's flat $0.34061 — reflects subsidized delivery cost for electrification participants); the UDC Distribution component is $0.14708 vs TOU-DR1's $0.15719 and the TRAC component is $0.00000 vs TOU-DR1's $0.06762. (2) NO Baseline Adjustment Credit (vs TOU-DR1's $-0.10892/kWh up to 130% of baseline — the discount is built into lower UDC instead). (3) EECC values are higher in summer on-peak ($0.45690 vs $0.34920) and lower in summer super-off-peak ($0.08637 vs $0.04121 — wait, lower super-off-peak in TOU-DR1; TOU-ELEC's super-off-peak is HIGHER), reflecting cost-based per-kWh pricing for high-load electrification households. Same Base Services Charge $0.79343/day for standard customers; CARE/FERA/DRAH variants modeled as RatePlanModifiers in the grid-coordination/urpx-rate-plans#13 secondary epic. Special Condition 4 imposes a 12-month minimum-stay requirement — customers must remain on TOU-ELEC for at least 12 consecutive months before changing schedules, and customers who leave cannot return for 12 consecutive months (one-time exception for first-year-of-offering enrollees per D.22-11-022). Special Condition 10 caps enrollment at 10,000 customers; enrollment subject to availability and SDG&E does not maintain a queue if cap is reached. Holiday handling: the urpx:HolidayCalendar on this filing carries the eight Time-of-Use Holidays enumerated in SDG&E Electric Rule 1 (Definitions), Sheet 6, Cal. P.U.C. Sheet No. 61672-E. The weekday and the weekend/holiday shapes differ only over 6am-10am, which is Off-Peak on a weekday and Super Off-Peak on a weekend or holiday, so the calendar is applied by excluding holidays from the 6am-10am weekday Off-Peak bracket and adding a 6am-10am weekday Super Off-Peak bracket that admits holidays only. Rule 1 further directs that a Holiday falling on Sunday makes the following Monday a Holiday, with no change for one falling on Saturday. urpx:observanceRule has no value for a Sunday-only shift (its four are actualDateObservance, fridayIfWeekendObservance, mondayIfWeekendObservance and nearestWeekdayObservance), so that direction is carried as urpx:holidayRule text and is not machine-readable: the Monday after a Sunday-falling fixed-date holiday resolves here as an ordinary weekday, first on 2027-07-05.",
      "urpx:effectiveDateTime": "2026-04-01T00:00:00",
      "urpx:minimumTenure": "P12M",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,

  "urpx:hasRatePlanModifier": {
    "@type": "urpx:RatePlanModifier",
    "@id": "sdge:nbt",
    "urpx:name": "Schedule NBT (Net Billing Tariff) for Customer-Sited Renewable Distributed Generation",
    "urpx:modifierUniqueIdentifier": "NBT",
    "urpx:initialEffectiveDate": "2023-11-30",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "sdge:nbt-2025-01-27",
      "urpx:version": "2025-01-27",
      "urpx:modifierVersionNumber": "2025-01-27",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:description": "SDG&E's Net Billing Tariff (NBT) per CPUC Decision 22-12-056. Customer-facing name: Solar Billing Plan (SBP). Effective for new residential DER interconnection applications submitted on or after April 15, 2023 (NEM-ST sunset date). Per Sheet 3, separately metered residential customers (including Aggregation customers) taking NBT MUST take service on Schedule EV-TOU-5 as their Otherwise Applicable Schedule (OAS) — modeled here as a urpx:RatePlanModifier overlay binding to sdge:ev-tou-5. Single-base binding mirrors the PG&E NBT (E-ELEC mandate) and SCE NBT (TOU-D-PRIME mandate) patterns. EV-TOU-5 is SDG&E's residential EV-friendly TOU rate; mandating it for NBT reflects the assumption that solar customers are also EV-adopting / electrification-leaning. Third export-direction modifier in the corpus (PG&E NBT and SCE NBT preceded). Import-side charges remain governed by the base EV-TOU-5 RatePlan; this modifier handles only the export-side compensation (urpx:flowDirection urpx:reverse on the MetricSpecification). SDG&E pays 5 NBCs vs PG&E and SCE's 4: PPP, ND, CTC, DWR-BC (Department of Water Resources Bond Charge — SDG&E-specific), WF-NBC (Wildfire Fund). DWR-BC NBC modeling lives on the base EV-TOU-5 RatePlan, not on this modifier. PriceDefinition surface: (1) Export Compensation Rate Generation Component; (2) Export Compensation Rate Delivery Component; (3) ACC Plus Residential adder; (4) ACC Plus Low Income adder. The per-cell export compensation values come from the URL cited directly on Sheet 4, https://www.sdge.com/solar/solar-billing-plan/export-pricing; ACC Plus values pending discovery (Sheet 8 references 'ACC Plus credit' in annual true-up semantics but the values table is not in this composite PDF — may be in a separate SDG&E filing or in absent Sheets 21-22). Annual true-up settlement, Net Surplus Compensation (NSC), NSC Renewable Attribute Adder (RAA), Discontinuance of NSC Double Compensation, and bill-credit rollover all deferred to consumer (price-server) responsibility.",
      "urpx:effectiveDateTime": "2025-01-27T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:applicableToRatePlan": [
        {
          "@id": "sdge:ev-tou-5"
        }
      ],

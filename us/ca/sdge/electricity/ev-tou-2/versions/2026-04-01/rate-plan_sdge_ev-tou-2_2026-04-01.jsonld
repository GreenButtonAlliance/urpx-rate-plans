      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "sdge:er-residential-ev-tou-2",
          "urpx:name": "Eligibility for Schedule EV-TOU-5 — residential customer",
          "urpx:description": "Residential service for households meeting the qualifying-vehicle or NBT condition below. Customer must additionally be a residential customer (urpx:residentialKind).",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "sdge:cx-residential-ev-tou-2",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "sdge:cn-residential-ev-tou-2",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "sdge:cn-residential-ev-tou-2-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:hasCustomerKind"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "sdge:cn-residential-ev-tou-2-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:residentialKind"
                }
              }
            }
          }
        },
        {
          "@type": "urpx:EligibilityRule",
          "@id": "sdge:er-qualifying-vehicle-or-nbt-ev-tou-2",
          "urpx:name": "Eligibility for Schedule EV-TOU-5 — qualifying vehicle or NBT enrollment",
          "urpx:description": "Customer must own or lease at least one of: a battery-electric vehicle (BEV) or plug-in hybrid (PHEV), recharged via a recharging outlet at the customer's premises (both map to urpx:evChargingDER since URPX's DERTypeValue enum does not distinguish BEV from PHEV); OR a natural-gas vehicle (NGV) refueled via a home refueling appliance (HRA) at the customer's premises (modeled as a CustomOperandNode since URPX has no NGV-specific vocabulary). Conventional HEVs (charge-sustaining hybrids without grid charging) are NOT eligible. Alternatively, customers enrolled on Schedule NBT for whom EV-TOU-5 is the otherwise-applicable schedule (OAS) qualify regardless of vehicle ownership — this is the primary path for new solar customers under NBT effective 2023.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "sdge:ev-tou-2-2026-04-01-cx-qualifying-vehicle-or-nbt",
            "urpx:rootNode": {
              "@type": "urpx:BooleanOperationNode",
              "@id": "sdge:ev-tou-2-2026-04-01-bn-qualifying-vehicle-or-nbt",
              "urpx:operator": {
                "@id": "urpx:orOperator"
              },
              "urpx:operandNodes": [
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "sdge:ev-tou-2-2026-04-01-cn-ev-charging",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "sdge:ev-tou-2-2026-04-01-cn-ev-charging-left-operand",
                    "urpx:conditionProperty": {
                      "@id": "urpx:derType"
                    }
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "sdge:ev-tou-2-2026-04-01-cn-ev-charging-right-operand",
                    "urpx:referencesValue": {
                      "@id": "urpx:evChargingDER"
                    }
                  }
                },
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "sdge:ev-tou-2-2026-04-01-cn-ngv",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "sdge:ev-tou-2-2026-04-01-cn-ngv-left-operand",
                    "urpx:customConditionProperty": "Has Natural Gas Vehicle with Home Refueling Appliance"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "sdge:ev-tou-2-2026-04-01-cn-ngv-right-operand",
                    "urpx:stringValue": "true"
                  }
                },
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "sdge:ev-tou-2-2026-04-01-cn-nbt",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "sdge:ev-tou-2-2026-04-01-cn-nbt-left-operand",
                    "urpx:customConditionProperty": "Program Enrollment"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "sdge:ev-tou-2-2026-04-01-cn-nbt-right-operand",
                    "urpx:stringValue": "Net Billing Tariff (NBT)"
                  }
                }
              ]
            }
          }
        }
      ],

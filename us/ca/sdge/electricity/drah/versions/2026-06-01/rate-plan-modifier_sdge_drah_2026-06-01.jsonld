      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "sdge:drah-2026-06-01-er-eligible",
          "urpx:name": "DRAH-eligible residential customer",
          "urpx:description": "Customer is a residential customer whose service address is in a deed-restricted affordable housing unit per SDG&E TOU-DR1 Special Condition 17. Property qualifies if it's an affordable rental home restricted by federal or state subsidies to residents with income at or below 80% of Area Median Income, identified via the California Housing Partnership database. The condition makes placement subject to attestation where applicable. Eligibility is at the PROPERTY level, not the customer-income level (distinct from CARE/FERA). Customers may be DRAH-eligible AND CARE/FERA-eligible simultaneously, but BSC placement selects ONE tier (the BSC adjustments do not stack).",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "sdge:drah-2026-06-01-cx-eligible",
            "urpx:rootNode": {
              "@type": "urpx:BooleanOperationNode",

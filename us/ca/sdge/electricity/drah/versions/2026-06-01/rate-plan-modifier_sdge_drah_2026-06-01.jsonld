    "@id": "sdge:drah",
    "urpx:name": "SDG&E Deed-Restricted Affordable Housing (DRAH) BSC Discount",
    "urpx:modifierUniqueIdentifier": "DRAH",
    "urpx:initialEffectiveDate": "2025-11-15",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "sdge:drah-2026-06-01",
      "urpx:version": "2026-06-01",
      "urpx:modifierVersionNumber": "2026-06-01",
      "urpx:changeReason": {
        "@id": "urpx:regulatoryOrder"
      },
      "urpx:description": "Deed-Restricted Affordable Housing (DRAH) BSC Discount: applies to any SDG&E residential customer whose service address is in qualifying deed-restricted housing per the California Housing Partnership database. Per SDG&E TOU-DR1 Special Condition 17 (Sheet 8): 'DRAH placement constitutes those customers who live in an affordable rental home that is restricted by the rules of federal or state subsidies to residents who have incomes at or below 80 percent of Area Median Income based on the statewide database of such homes maintained by the California Housing Partnership and, subject to attestation where applicable.' Property-level eligibility (NOT income-level): based on the property's deed-restriction status, distinct from CARE/FERA which are income-level. Single BSC adjustment of $-0.39655/day reduces the standard $0.79343/day BSC to the DRAH $0.39688/day (a 49.98% reduction, identical to FERA's BSC adjustment). Per the TOU-DR1 base PDF prose 'BSC placement will be determined by participation in CARE, FERA, and/or successfully meeting the deed-restricted affordable housing (DRAH) requirement', BSC placement selects ONE tier: these BSC adjustments do NOT stack additively across DRAH, CARE, and FERA. The modifier-overlay model implicitly allows additive stacking which would be incorrect for the BSC line item; consumers should select ONE BSC modifier per customer.",
      "urpx:effectiveDateTime": "2026-06-01T00:00:00",
      "urpx:expirationDateTime": "2026-08-01T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },

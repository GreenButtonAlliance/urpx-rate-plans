  "@type": "urpx:URPXPackage",
  "@id": "sdge:doc-drah-2026-04-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlanModifier": {
    "@type": "urpx:RatePlanModifier",
    "@id": "sdge:drah",
    "urpx:name": "SDG&E Deed-Restricted Affordable Housing (DRAH) BSC Discount",
    "urpx:modifierUniqueIdentifier": "DRAH",
    "urpx:initialEffectiveDate": "2025-11-15",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "sdge:drah-2026-04-01",
      "urpx:version": "2026-04-01",
      "urpx:modifierVersionNumber": "2026-04-01",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:description": "Deed-Restricted Affordable Housing (DRAH) BSC Discount — applies to any SDG&E residential customer whose service address is in qualifying deed-restricted housing per the California Housing Partnership database. Per SDG&E TOU-DR1 Sheet 1 Special Condition 17: 'DRAH placement constitutes those customers who live in an affordable rental home that is restricted by the rules of federal or state subsidies to residents who have incomes at or below 80 percent of Area Median Income based on the statewide database of such homes maintained by the California Housing Partnership and, subject to attestation where applicable.' Property-level eligibility (NOT income-level): based on the property's deed-restriction status, distinct from CARE/FERA which are income-level. Single BSC adjustment of $-0.39655/day reduces the standard $0.79343/day BSC to the DRAH $0.39688/day (exactly 50% reduction, identical to FERA's BSC adjustment). Per the TOU-DR1 base PDF prose 'BSC placement will be determined by participation in CARE, FERA, and/or successfully meeting the deed-restricted affordable housing (DRAH) requirement', BSC placement selects ONE tier — these BSC adjustments do NOT stack additively across DRAH, CARE, and FERA. The modifier-overlay model implicitly allows additive stacking which would be incorrect for the BSC line item; consumers should select ONE BSC modifier per customer.",
      "urpx:effectiveDateTime": "2026-04-01T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:applicableToRatePlan": [
        {
          "@id": "sdge:dr"
        },
        {
          "@id": "sdge:dr-ses"
        },
        {
          "@id": "sdge:ev-tou"
        },
        {
          "@id": "sdge:ev-tou-2"
        },
        {
          "@id": "sdge:ev-tou-5"
        },
        {
          "@id": "sdge:tou-dr"
        },
        {
          "@id": "sdge:tou-dr1"
        },
        {
          "@id": "sdge:tou-dr2"
        },
        {
          "@id": "sdge:tou-elec"
        }
      ],
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "urpx:fileName": "SDGE_SCHEDULE_TOU-DR1.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://tariffsprd.sdge.com/view/tariff/?utilId=SDGE&bookId=ELEC&tarfKey=898",
        "urpx:dateRetrieved": "2026-05-04",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 1
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "sdge:drah-2026-04-01-er-eligible",
          "urpx:name": "DRAH-eligible residential customer",
          "urpx:description": "Customer is a residential customer whose service address is in a deed-restricted affordable housing unit per SDG&E TOU-DR1 Special Condition 17. Property qualifies if it's an affordable rental home restricted by federal or state subsidies to residents with income at or below 80% of Area Median Income, identified via the California Housing Partnership database. Self-attestation required for properties with less than 80% of units identified as DRAH. Eligibility is at the PROPERTY level, not the customer-income level (distinct from CARE/FERA). Customers may be DRAH-eligible AND CARE/FERA-eligible simultaneously, but BSC placement selects ONE tier (the BSC adjustments do not stack).",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "sdge:drah-2026-04-01-cx-eligible",
            "urpx:rootNode": {
              "@type": "urpx:BooleanOperationNode",
              "@id": "sdge:drah-2026-04-01-bn-residential-and-eligible",
              "urpx:operator": {
                "@id": "urpx:andOperator"
              },
              "urpx:operandNodes": [
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "sdge:drah-2026-04-01-cn-residential",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "sdge:drah-2026-04-01-cn-residential-left-operand",
                    "urpx:conditionProperty": {
                      "@id": "urpx:hasCustomerKind"
                    }
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "sdge:drah-2026-04-01-cn-residential-right-operand",
                    "urpx:referencesValue": {
                      "@id": "urpx:residentialKind"
                    }
                  }
                },
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "sdge:drah-2026-04-01-cn-housing-flag",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "sdge:drah-2026-04-01-cn-housing-flag-left-operand",
                    "urpx:customConditionProperty": "housingDeedRestricted"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "sdge:drah-2026-04-01-cn-housing-flag-right-operand",
                    "urpx:stringValue": "true"
                  }
                }
              ]
            }
          }
        }
      ],

              "urpx:name": "DRAH Base Services Charge Adjustment (reduces standard $0.79343/day BSC to DRAH $0.39688/day, exactly 50% reduction; identical to FERA BSC adjustment)",
              "urpx:chargeType": {
                "@id": "urpx:creditMisc"
              },
              "urpx:chargeCategory": {

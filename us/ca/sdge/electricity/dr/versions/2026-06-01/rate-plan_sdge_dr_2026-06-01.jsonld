  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "sdge:dr",
    "urpx:name": "Schedule DR Residential Service",
    "urpx:ratePlanUniqueIdentifier": "DR",
    "urpx:initialEffectiveDate": "1948-01-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "sdge:dr-2026-06-01",
      "urpx:description": "SDG&E's standard non-TOU residential schedule, optionally available to customers who leave the TOU-DR1 default. Two tiers split at 130% of the baseline allowance differ only in the UDC Total: $0.22285/kWh up to 130% of baseline and $0.32948/kWh above it, modeled as the above-baseline UDC components plus a Baseline Adjustment Credit of $(0.10663)/kWh on the first tier. The EECC commodity rate is flat at $0.18274/kWh in both tiers and seasons, and DWR-BC plus WF-NBC at $0.00591/kWh. Base Services Charge $0.79343/day; the CARE, FERA and DRAH reductions of it are the modifiers sdge:care, sdge:fera and sdge:drah.",
      "urpx:effectiveDateTime": "2026-06-01T00:00:00",
      "urpx:expirationDateTime": "2026-08-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:regulatoryOrder"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },

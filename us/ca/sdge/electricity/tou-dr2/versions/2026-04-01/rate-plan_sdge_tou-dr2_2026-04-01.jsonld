  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "sdge:tou-dr2",
    "urpx:name": "Schedule TOU-DR2 Residential Time-of-Use",
    "urpx:ratePlanUniqueIdentifier": "TOU-DR2",
    "urpx:initialEffectiveDate": "2019-01-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "sdge:tou-dr2-2026-04-01",
      "urpx:description": "SDG&E's alternate residential time-of-use schedule. Two-period TOU (On-Peak 4pm-9pm all days; Off-Peak all other hours — no Super Off-Peak unlike TOU-DR1). Voluntary opt-in alternative to the TOU-DR1 default. Estimated ~10% of SDG&E residential = ~140K customers. Bill structure same as TOU-DR1 (UDC + DWR-BC + WF-NBC + EECC) with two structural differences: (1) 4 EECC values (2 periods x 2 seasons) vs 6, and (2) the TRAC sub-component of UDC IS TOU-varying for this schedule — Summer On-Peak TRAC $0.07211, Summer Off-Peak TRAC $0.06564, Winter $0.06762 both periods. Other 7 UDC sub-components (Trans/Distr/PPP/ND/CTC/LGC/RS) are flat across periods/seasons with values identical to TOU-DR1. Baseline Adjustment Credit $-0.10892/kWh applies to consumption up to 130% of CPUC baseline allocation (both seasons). Same Base Services Charge $0.79343/day for standard customers; CARE/FERA/DRAH variants modeled as RatePlanModifiers in grid-coordination/urpx-rate-plans#13 secondary epic.",
      "urpx:effectiveDateTime": "2026-04-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "urpx:fileName": "SCHEDULE_TOU-DR2.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://tariffsprd.sdge.com/view/tariff/?utilId=SDGE&bookId=ELEC&tarfKey=899",
        "urpx:dateRetrieved": "2026-04-30",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 8,
        "urpx:leafStart": "64388-E",
        "urpx:leafEnd": "64672-E"
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "sdge:er-residential-tou-dr2",
          "urpx:name": "Eligibility for Schedule TOU-DR2 Residential Time-of-Use",
          "urpx:description": "Available to domestic service for lighting, heating, cooking, water heating, and power, in single-family dwellings, flats, and apartments separately metered by the utility; service used in common for residential purposes by tenants in multi-family dwellings under Special Condition 3; any approved combination of residential and nonresidential service on the same meter; and incidental farm service under Special Condition 5. Customer must have appropriate electric metering as defined under Special Condition 1. Voluntary opt-in (alternative to the TOU-DR1 default per CPUC D.18-12-004). Not applicable to customers on multi-family rate schedules DM, DT, DS, and DT-RV.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "sdge:cx-residential-tou-dr2",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "sdge:cn-residential-tou-dr2",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },

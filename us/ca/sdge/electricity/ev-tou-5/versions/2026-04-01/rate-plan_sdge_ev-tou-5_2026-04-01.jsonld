                  "@id": "urpx:residentialKind"
                }
              }
            }
          }
        },
        {
          "@type": "urpx:EligibilityRule",
          "@id": "sdge:er-qualifying-vehicle-or-nbt-ev-tou-5",
          "urpx:name": "Eligibility for Schedule EV-TOU-5 — qualifying vehicle or NBT enrollment",
          "urpx:description": "Customer must own or lease at least one of: a battery-electric vehicle (BEV) or plug-in hybrid (PHEV), recharged via a recharging outlet at the customer's premises (both map to urpx:evChargingDER since URPX's DERTypeValue enum does not distinguish BEV from PHEV); OR a natural-gas vehicle (NGV) refueled via a home refueling appliance (HRA) at the customer's premises (modeled as a CustomOperandNode since URPX has no NGV-specific vocabulary). Conventional HEVs (charge-sustaining hybrids without grid charging) are NOT eligible. Alternatively, customers enrolled on Schedule NBT for whom EV-TOU-5 is the otherwise-applicable schedule (OAS) qualify regardless of vehicle ownership — this is the primary path for new solar customers under NBT effective 2023.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "sdge:ev-tou-5-2026-04-01-cx-qualifying-vehicle-or-nbt",
            "urpx:rootNode": {
              "@type": "urpx:BooleanOperationNode",
              "@id": "sdge:ev-tou-5-2026-04-01-bn-qualifying-vehicle-or-nbt",
              "urpx:operator": {
                "@id": "urpx:orOperator"
              },
              "urpx:operandNodes": [
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "sdge:ev-tou-5-2026-04-01-cn-ev-charging",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "sdge:ev-tou-5-2026-04-01-cn-ev-charging-left-operand",
                    "urpx:conditionProperty": {
                      "@id": "urpx:derType"
                    }
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "sdge:ev-tou-5-2026-04-01-cn-ev-charging-right-operand",
                    "urpx:referencesValue": {
                      "@id": "urpx:evChargingDER"
                    }
                  }
                },
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "sdge:ev-tou-5-2026-04-01-cn-ngv",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "sdge:ev-tou-5-2026-04-01-cn-ngv-left-operand",
                    "urpx:customConditionProperty": "Has Natural Gas Vehicle with Home Refueling Appliance"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",

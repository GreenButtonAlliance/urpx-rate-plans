                "@type": "urpx:ObjectOperandNode",
                "@id": "sdge:cn-residential-ev-tou-5-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:hasCustomerKind"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "sdge:cn-residential-ev-tou-5-right-operand",

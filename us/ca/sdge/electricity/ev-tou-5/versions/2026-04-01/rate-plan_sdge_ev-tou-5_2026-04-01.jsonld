        },
        "urpx:accessURL": "https://tariffsprd.sdge.com/view/tariff/?utilId=SDGE&bookId=ELEC&tarfKey=930",
        "urpx:dateRetrieved": "2026-04-30",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,

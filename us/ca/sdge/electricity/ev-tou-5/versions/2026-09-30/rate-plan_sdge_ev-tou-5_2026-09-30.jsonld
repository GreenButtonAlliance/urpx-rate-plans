              "@id": "sdge:ev-tou-5-2026-09-30-bn-qualifying-vehicle-or-nbt",
              "urpx:operator": {
                "@id": "urpx:orOperator"
              },
              "urpx:operandNodes": [
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "sdge:ev-tou-5-2026-09-30-cn-ev-charging",
                  "urpx:operator": {

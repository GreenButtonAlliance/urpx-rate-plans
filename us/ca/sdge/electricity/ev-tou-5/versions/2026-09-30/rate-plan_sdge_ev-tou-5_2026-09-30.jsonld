              "@id": "sdge:ev-tou-5-2026-09-30-cn-residential-ev-tou-5",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",

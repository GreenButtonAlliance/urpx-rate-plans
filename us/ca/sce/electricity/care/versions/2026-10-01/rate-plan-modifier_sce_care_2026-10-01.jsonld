  "urpx:hasRatePlanModifier": {
    "@type": "urpx:RatePlanModifier",
    "@id": "sce:care",
    "urpx:name": "California Alternate Rates for Energy (CARE) Discount",
    "urpx:modifierUniqueIdentifier": "CARE",
    "urpx:initialEffectiveDate": "2001-08-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "sce:care-2026-10-01",
      "urpx:version": "2026-10-01",
      "urpx:modifierVersionNumber": "2026-10-01",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:description": "California Alternate Rates for Energy (CARE) program: an income-qualified bill discount applied as an overlay to an SCE residential base rate plan (Schedule D, TOU-D-4-9PM, TOU-D-5-8PM or TOU-D-PRIME). Schedule D-CARE Sheet 1 states the terms, restated in Schedule TOU-D Special Condition 6 and Schedule D Special Condition 4. Eligibility: a CARE Household per Schedule D-CARE Special Condition 2. Modeled benefits: (1) the 32.5 percent bill discount on the pre-PUCRF, pre-tax subtotal, as a urpx:Price carrying urpx:multiplier -0.325 over the discountable urpx:PriceSummary of the base plan the customer takes; (2) exemption from the Wildfire Fund Non-Bypassable Charge, a $-0.00591/kWh credit; (3) exemption from the Fixed Recovery Charge, a $-0.01118/kWh credit; (4) exemption from the Base Services Charge Surcharge, a $-0.069/meter/day credit; and (5) the Base Services Charge Discount, a $-0.164/meter/day credit. Sheet 1 also exempts CARE customers from the CARE Surcharge of $0.215 per meter per day and from the CARE exempted Public Purpose Programs Charge of ($0.025) per meter per day; neither is modeled.",
      "urpx:effectiveDateTime": "2026-10-01T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:applicableToRatePlan": [

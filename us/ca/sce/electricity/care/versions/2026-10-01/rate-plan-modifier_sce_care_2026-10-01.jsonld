      "urpx:hasCoverageClaim": {
        "@id": "sce:cc-care-2026-10-01",
        "@type": "urpx:CoverageClaim",
        "urpx:completenessResult": {
          "@id": "urpx:partial"
        },
        "urpx:selfContained": true,
        "urpx:explainedBy": {
          "@type": "urpx:Evaluation",
          "@id": "sce:cc-care-2026-10-01-evaluation",
          "urpx:evaluationKind": {
            "@id": "urpx:coverageEvaluation"
          },
          "urpx:description": "Sheet 1 of Schedule D-CARE states a 32.5 percent discount applied to a CARE customer's bill prior to the Public Utilities Commission Reimbursement Fee and any applicable user fees, taxes and late payment charges. This filing models it as a urpx:Price carrying urpx:multiplier -0.325 over the discountable subtotal of whichever SCE residential base plan the customer takes service under, naming the candidate subtotals of four schedules at every effective date, read disjunctively so that the one present in the consumer's graph applies. Each subtotal omits the Reimbursement Fee, the California Climate Credit, which Special Condition 12 applies after city and county utility users' taxes, and the Base Services Charge, which this filing adjusts through two per-meter-per-day credits. The four line items of the same Sheet 1 are carried alongside the percentage: the Wildfire Fund Non-Bypassable Charge exemption of $0.00591 per kWh, the Fixed Recovery Charge exemption of $0.01118 per kWh, the Base Services Charge Surcharge exemption of $0.069 per meter per day, and the Base Services Charge Discount of $(0.164) per meter per day. Four benefits of the schedule remain unrepresented, and they are why this claim is partial. Sheet 1 exempts CARE customers from the CARE Surcharge of $0.215 per meter per day and from the CARE exempted Public Purpose Programs Charge of ($0.025) per meter per day, neither of which any SCE residential rate sheet in this corpus itemizes. Special Condition 14 grants the San Joaquin Valley Disadvantaged Communities Pilot Bill Protection Discount, 20 percent in pilot years 1 through 5 and 10 or 20 percent in years 6 through 10, and Special Condition 15 a 20 percent Transitional Community Solar Discount; both are limited to pilot participants, and this filing carries no condition on pilot participation to gate them on. The California Climate Credit of Special Condition 12 is carried on the base rate plans this modifier overlays.",
          "urpx:evaluatedOn": "2026-10-06T00:00:00"
        }
      }

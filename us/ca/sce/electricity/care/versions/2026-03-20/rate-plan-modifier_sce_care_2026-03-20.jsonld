  "@id": "sce:doc-care-2026-03-20",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlanModifier": {
    "@type": "urpx:RatePlanModifier",
    "@id": "sce:care",
    "urpx:name": "California Alternate Rates for Energy (CARE) Discount",
    "urpx:modifierUniqueIdentifier": "CARE",
    "urpx:initialEffectiveDate": "2001-08-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "sce:care-2026-03-20",
      "urpx:version": "2026-03-20",
      "urpx:modifierVersionNumber": "2026-03-20",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:description": "California Alternate Rates for Energy (CARE) program — income-qualified bill discount applied as an overlay to any SCE residential base rate plan (Schedule D, TOU-D-4-9PM, TOU-D-5-8PM, TOU-D-PRIME, and others). CPUC-mandated program; SCE's implementation is defined in Schedule D-CARE and articulated in each base schedule's Special Condition 8. Eligibility: customer must meet the definition of a CARE Household per Schedule D-CARE — typically 200% of the Federal Poverty Guidelines or participation in qualifying public-assistance programs. As of 2026-04-30 SCE has ~1.5M customers enrolled in CARE (~30% of SCE residential), making this the highest-customer-impact RatePlanModifier in the corpus. CARE provides several distinct benefits: (1) a 32.5% bill discount on the pre-PUCRF / pre-tax subtotal (modeled as a urpx:Price carrying urpx:multiplier -0.325 over the discountable urpx:PriceSummary of the base plan the customer takes), (2) exemption from the Wildfire Fund Non-Bypassable Charge (modeled as $-0.00591/kWh credit), (3) exemption from the Fixed Recovery Charge (modeled as $-0.00619/kWh credit), (4) exemption from the Base Services Charge Surcharge component (modeled as $-0.064/meter/day credit), and (5) a Base Services Charge Discount (modeled as $-0.155/meter/day credit). Net per-kWh credit from line-item exemptions: $-0.01210/kWh. Net per-meter-per-day credit from BSC adjustments: $-0.219/meter/day. Special Condition 8 also references a 'CARE Surcharge of $0.208/meter/day' that CARE customers are exempt from paying — this is a non-CARE-customer-funded surcharge that supports the CARE program; it is NOT itemized in the SCE TOU-D base rate-sheet line items currently modeled in this corpus, so the exemption is not modeled as a credit (modeling deferred until base rate plans track this surcharge as a non-CARE-only line item). Bill calculation correctness with this modifier therefore captures the percentage discount and the line-item exemptions, and underrepresents the full CARE customer benefit by the $0.208/meter/day CARE Surcharge avoidance alone. That remaining gap closes when base SCE filings itemize the CARE Surcharge.",
      "urpx:effectiveDateTime": "2026-03-20T00:00:00",
      "urpx:expirationDateTime": "2026-06-01T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },

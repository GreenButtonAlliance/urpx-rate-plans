                    "@type": "urpx:CustomOperandNode",
                    "urpx:customConditionProperty": "Program Enrollment"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "urpx:stringValue": "California Alternate Rates for Energy (CARE)"
                  }
                }
              ]
            }
          }
        }
      ],

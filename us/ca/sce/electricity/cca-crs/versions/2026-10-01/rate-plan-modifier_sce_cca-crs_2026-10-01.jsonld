          "@type": "urpx:EligibilityRule",
          "@id": "sce:cca-crs-2026-10-01-er-eligible",
          "urpx:name": "CCA-CRS-eligible customer",
          "urpx:description": "Customer is enrolled in Community Choice Aggregation service. The cost-responsibility surcharge under this Schedule recovers stranded power-procurement costs allocated to customers who have departed Bundled Service. Eligibility is by enrollment record; PCIA value depends on the customer's vintage year (year of departing-load enrollment) — see per-Price ApplicabilityRule gates below.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "sce:cca-crs-2026-10-01-cx-eligible",

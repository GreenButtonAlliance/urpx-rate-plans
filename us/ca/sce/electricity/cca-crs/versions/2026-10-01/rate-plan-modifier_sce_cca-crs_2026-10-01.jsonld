  "@type": "urpx:URPXPackage",
  "@id": "sce:doc-cca-crs-2026-10-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlanModifier": {
    "@type": "urpx:RatePlanModifier",
    "@id": "sce:cca-crs",
    "urpx:name": "Schedule CCA-CRS",
    "urpx:modifierUniqueIdentifier": "CCA-CRS",
    "urpx:initialEffectiveDate": "2023-07-27",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "sce:cca-crs-2026-10-01",
      "urpx:version": "2026-10-01",
      "urpx:modifierVersionNumber": "2026-10-01",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:description": "Schedule CCA-CRS — CCA Cost Responsibility Surcharge. Recovers stranded power-procurement costs allocated to residential customers served by a Community Choice Aggregator (CCA) instead of Bundled SCE service. Applied as an overlay to the customer's base SCE residential RatePlan (Schedule D, TOU-D-4-9PM, TOU-D-5-8PM, TOU-D-PRIME). Composed of four components for the Domestic customer class: WFC ($0.00591/kWh), CTC ($0.00014/kWh), FRC ($0.01118/kWh), and PCIA (vintage-discriminated, identical PCIA values to Schedule DA-CRS — 20 vintages from 2001 through 2026, ranging from $-0.00645 for 2025/2026 to $0.02631 for 2023). The twenty PCIA vintages are mutually exclusive: exactly one applies to a customer, selected by the `departureVintage` attribute. They are filed as a urpx:ProfileAlternatives of twenty urpx:ProfileAlternative paired with a urpx:PriceSetAlternatives of twenty urpx:PriceSetAlternative, so a consumer selects one vintage rather than summing all twenty. Per Schedule D Sheet 2 footnote 1, CCA Service Customers are not subject to the base schedule's DWRBC rate component but instead pay the DWRBC as provided by Schedule CCA-CRS; this OAT-side adjustment is NOT modeled here. The base plan's SCE Generation, which each base schedule applies only to Bundled Service Customers, is offset by one Price carrying urpx:multiplier -1 over that base's generation urpx:PriceSummary. CCA-CRS Sheet 3 has a richer customer-subgroup exemption table than DA-CRS — CCA customers on Medical Baseline are WFC-exempt; CCA customers on CARE are WFC-exempt + FRC-exempt; CCA customers on FERA are FRC-exempt; Continuous DA/CCA customers are WFC + PCIA-exempt; Returning Continuous DA customers are WFC-exempt. Only the default CCA Customers subgroup is captured by the Eligibility Rule here; the subgroup exemptions are stacking interactions with already-modeled CARE / FERA modifiers and are deferred to a follow-up issue.",
      "urpx:effectiveDateTime": "2026-10-01T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:applicableToRatePlan": [
        {
          "@id": "sce:d"
        },
        {
          "@id": "sce:tou-d-4-9pm"
        },
        {
          "@id": "sce:tou-d-5-8pm"
        },
        {
          "@id": "sce:tou-d-prime"
        }
      ],

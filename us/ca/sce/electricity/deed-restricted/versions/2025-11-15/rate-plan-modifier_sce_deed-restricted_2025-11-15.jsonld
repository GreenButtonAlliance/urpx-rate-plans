                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "sce:cn-deed-restricted-housing-flag-left-operand",
                    "urpx:customConditionProperty": "housingDeedRestricted"
                  },

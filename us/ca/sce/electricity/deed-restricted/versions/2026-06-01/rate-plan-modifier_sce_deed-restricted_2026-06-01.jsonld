                    }
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "sce:deed-restricted-2026-06-01-cn-residential-right-operand",
                    "urpx:referencesValue": {
                      "@id": "urpx:residentialKind"
                    }

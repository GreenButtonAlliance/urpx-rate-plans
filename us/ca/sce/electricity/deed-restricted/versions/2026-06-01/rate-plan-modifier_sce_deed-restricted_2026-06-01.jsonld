    "@id": "sce:deed-restricted",
    "urpx:name": "Deed-Restricted Base Services Charge Discount",
    "urpx:modifierUniqueIdentifier": "DEED-RESTRICTED",
    "urpx:initialEffectiveDate": "2025-11-15",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "sce:deed-restricted-2026-06-01",
      "urpx:version": "2026-06-01",
      "urpx:modifierVersionNumber": "2026-06-01",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:description": "Base Services Charge (BSC) adjustment of $(0.327)/meter/day for SCE residential customers living in Deed Restricted Affordable Housing (DRAH), applied as an overlay to an SCE residential base rate plan (Schedule D, TOU-D-4-9PM, TOU-D-5-8PM or TOU-D-PRIME). It is the line \"BSC Adjustment - Deed Restricted\" on Schedule TOU-D Sheets 2 through 7 and \"BSC Discount - Deed Restricted\" on Schedule D Sheets 2 and 3. Schedule TOU-D Special Condition 10 (Sheet 15) and Schedule D Special Condition 4 (Sheet 6) also exempt DRAH customers from the Base Services Charge Surcharge of $0.069 per meter per day, which this filing does not carry, so the modeled BSC for a DRAH customer is $0.467 per meter per day where the schedules give $0.398. Eligibility is carried as the customer-state property housingDeedRestricted.",
      "urpx:effectiveDateTime": "2026-06-01T00:00:00",
      "urpx:expirationDateTime": "2026-10-01T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },

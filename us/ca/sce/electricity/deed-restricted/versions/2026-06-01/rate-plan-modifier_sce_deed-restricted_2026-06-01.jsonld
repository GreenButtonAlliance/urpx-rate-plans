                    "@type": "urpx:CustomOperandNode",
                    "@id": "sce:deed-restricted-2026-06-01-cn-housing-flag-left-operand",
                    "urpx:customConditionProperty": "housingDeedRestricted"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "sce:deed-restricted-2026-06-01-cn-housing-flag-right-operand",
                    "urpx:booleanValue": true

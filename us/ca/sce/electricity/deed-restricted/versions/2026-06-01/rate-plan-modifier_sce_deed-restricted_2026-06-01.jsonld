      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "sce:deed-restricted-2026-06-01-er-eligible",
          "urpx:name": "Customer in qualifying deed-restricted housing",
          "urpx:description": "Customer lives in Deed Restricted Affordable Housing. Schedule TOU-D Special Condition 10 (Sheet 15): \"DRAH will be identified by the California Housing Partnership database. For properties with less than 80 percent of units identified as DRAH, Customers or tenants must contact SCE or visit www.sce.com and self-attest to living in a DRAH to qualify for the DRAH discount to reduce their Base Services Charge.\" Carried as the customer-state property housingDeedRestricted.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "sce:deed-restricted-2026-06-01-cx-eligible",
            "urpx:rootNode": {
              "@type": "urpx:BooleanOperationNode",
              "@id": "sce:deed-restricted-2026-06-01-bn-residential-and-eligible",
              "urpx:operator": {
                "@id": "urpx:andOperator"
              },
              "urpx:operandNodes": [
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "sce:deed-restricted-2026-06-01-cn-residential",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {

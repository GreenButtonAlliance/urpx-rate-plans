  "urpx:hasRatePlanModifier": {
    "@type": "urpx:RatePlanModifier",
    "@id": "sce:deed-restricted",
    "urpx:name": "Deed-Restricted Base Services Charge Discount",
    "urpx:modifierUniqueIdentifier": "DEED-RESTRICTED",
    "urpx:initialEffectiveDate": "2025-11-15",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "sce:deed-restricted-2026-03-20",
      "urpx:version": "2026-03-20",
      "urpx:modifierVersionNumber": "2026-03-20",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:description": "Base Services Charge (BSC) Discount of $-0.334/meter/day available to SCE residential customers in qualifying deed-restricted housing, applied as an overlay to any SCE residential base rate plan (Schedule D, TOU-D-4-9PM, TOU-D-5-8PM, TOU-D-PRIME). Introduced 2025-11-15 with the income-graduated Base Services Charge restructuring per CPUC Decision 24-05-028 (SB 205 implementation): the base BSC of $0.794/meter/day is reduced by this $0.332/meter/day discount for customers in qualifying deed-restricted housing, yielding a net BSC of $0.462/meter/day. 'Deed-restricted' refers to housing units with recorded deed restrictions limiting occupancy to income-qualified tenants — typically affordable-housing developments funded under federal LIHTC, state Multifamily Housing Program, or local inclusionary-housing ordinances. Eligibility is unit-level (not customer-level): the discount applies based on the property's deed-restriction status as documented in the property records, regardless of the individual customer's income. Distinct from CARE/FERA (which gate on individual customer income); a customer can be both deed-restricted-eligible AND CARE/FERA-eligible, in which case multiple BSC adjustments stack. Bill calculation correctness: this modifier captures the structured discount; eligibility verification (deed restriction confirmed via property records) is operational rather than billing-time logic and is treated here as a customer-state property (housingDeedRestricted=true). Source: SCE Schedule TOU-D Special Condition 9 + Decision 24-05-028 implementation notes; documented in description prose of all four affected base rate-plan filings in this corpus.",
      "urpx:effectiveDateTime": "2026-03-20T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:applicableToRatePlan": [

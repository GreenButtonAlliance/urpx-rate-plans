      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "sce:deed-restricted-2026-03-20-er-eligible",
          "urpx:name": "Customer in qualifying deed-restricted housing",
          "urpx:description": "Customer must be a residential customer whose service address is a housing unit with a recorded deed restriction limiting occupancy to income-qualified tenants (typically LIHTC-funded, state Multifamily Housing Program-funded, or local inclusionary-housing-ordinance units). Eligibility is unit-level rather than customer-level — based on the property's deed-restriction status as documented in property records, regardless of the individual customer's current income.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "sce:deed-restricted-2026-03-20-cx-eligible",
            "urpx:rootNode": {
              "@type": "urpx:BooleanOperationNode",
              "@id": "sce:deed-restricted-2026-03-20-bn-residential-and-eligible",
              "urpx:operator": {
                "@id": "urpx:andOperator"
              },
              "urpx:operandNodes": [
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "sce:deed-restricted-2026-03-20-cn-residential",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },

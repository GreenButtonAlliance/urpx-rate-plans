      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "sce:medical-baseline-2026-06-25-er-eligible",
          "urpx:name": "Medical-Baseline-eligible residential customer",
          "urpx:description": "Customer is enrolled in SCE's Medical Baseline Allowance program — additional baseline allocation for households where a resident depends on life-support or qualifying medical equipment, or has a medical condition requiring temperature regulation. Eligibility verification by SCE per Medical Baseline application. Customers can be Medical-Baseline-eligible simultaneously with CARE or FERA enrollment; benefits stack independently across modifiers.",

    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "sce:medical-baseline-2026-06-25",
      "urpx:version": "2026-06-25",
      "urpx:modifierVersionNumber": "2026-06-25",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:description": "Schedule MB-E Medical Baseline Exemption: applies to any SCE residential customer who qualifies for medical baseline allocation. Sheet 1 (Cal. P.U.C. Sheet 91346-E, effective June 25, 2026 under Advice 5837-E) reads: 'Customers receiving medical baseline allocation shall be billed in accordance with the terms and conditions of their Otherwise Applicable Tariff (OAT), except that the Wildfire Fund Non-Bypassable Charge (WFC) shall not apply, and the effective Minimum Charge will be $5.00, if applicable.' Modeled here as a single line-item credit cancelling the WFC ($-0.00591/kWh, the base WFC throughout this version's window). The $5.00 effective Minimum Charge is not modeled. The Medical Baseline allocation itself (additional kWh in the baseline tier per Preliminary Statement Part H) is not modeled. Eligibility: customer's `Program Enrollment` = `Medical Baseline`. applicableToRatePlan: 4 SCE residential bases (Schedule D, TOU-D-4-9PM, TOU-D-5-8PM, TOU-D-PRIME). Benefits stack independently with CARE or FERA.",
      "urpx:effectiveDateTime": "2026-06-25T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },

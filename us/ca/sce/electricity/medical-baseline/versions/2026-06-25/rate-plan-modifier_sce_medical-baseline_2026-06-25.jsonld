      "urpx:hasCoverageClaim": {
        "@id": "sce:cc-medical-baseline-2026-06-25",
        "@type": "urpx:CoverageClaim",
        "urpx:completenessResult": {
          "@id": "urpx:partial"
        },
        "urpx:selfContained": true,
        "urpx:explainedBy": {
          "@type": "urpx:Evaluation",
          "@id": "sce:cc-medical-baseline-2026-06-25-evaluation",
          "urpx:evaluationKind": {
            "@id": "urpx:coverageEvaluation"
          },
          "urpx:description": "Schedule MB-E is a single sheet with a one-sentence Rates section, and it states two effects: the Wildfire Fund Non-Bypassable Charge shall not apply, and the effective Minimum Charge will be $5.00, if applicable. This filing models the first as a credit of $(0.00591) per kWh cancelling the base charge, and does not model the second. The $5.00 Minimum Charge is a floor on the bill rather than a per-unit price, and the sheet states no unit or period for it; no active SCE residential base sheet in June 2026 carries a residential Minimum Charge for it to replace. The Applicability sentence, which extends the schedule to all customers receiving a medical baseline allocation, also points at a benefit this filing does not carry: the additional baseline allocation itself, whose kilowatt-hour quantities live in Preliminary Statement Part H rather than on this sheet.",
          "urpx:evaluatedOn": "2026-10-06T00:00:00"
        }
      }
    }

    "urpx:modifierUniqueIdentifier": "MB-E",
    "urpx:initialEffectiveDate": "2008-01-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "sce:medical-baseline-2025-10-01",
      "urpx:version": "2025-10-01",
      "urpx:modifierVersionNumber": "2025-10-01",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:description": "Schedule MB-E Medical Baseline Exemption — applies to any SCE residential customer who qualifies for medical baseline allocation. The full text of Schedule MB-E (Sheet 1) is: 'Customers receiving medical baseline allocation shall be billed in accordance with the terms and conditions of their Otherwise Applicable Tariff (OAT), except that the Wildfire Fund Non-Bypassable Charge (WFC) shall not apply, and the effective Minimum Charge will be $5.00.' Modeled here as a single line-item credit cancelling the WFC ($-0.00591/kWh, matching the current base WFC value). The $5.00 effective Minimum Charge floor is NOT modeled (URPX vocabulary gap for residential per-day-vs-monthly minimum charge mechanic). The Medical Baseline allocation extension itself (extra kWh in the baseline tier per Preliminary Statement Part H) is also NOT modeled (same vocabulary gap as the HPWH baseline-extension modifier). Eligibility: customer's `Program Enrollment` = `Medical Baseline` (CustomOperandNode predicate, evaluated against customer-state input). applicableToRatePlan: 4 SCE residential bases (Schedule D, TOU-D-4-9PM, TOU-D-5-8PM, TOU-D-PRIME). Customers can be Medical-Baseline-eligible AND CARE/FERA-eligible simultaneously; benefits stack independently.",
      "urpx:effectiveDateTime": "2025-10-01T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:applicableToRatePlan": [

  "@type": "urpx:URPXPackage",
  "@id": "sce:doc-tou-d-prime-2026-10-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "sce:tou-d-prime",
    "urpx:name": "Schedule TOU-D Time-Of-Use Domestic — Option PRIME",
    "urpx:ratePlanUniqueIdentifier": "TOU-D-PRIME",
    "urpx:initialEffectiveDate": "2020-09-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "sce:tou-d-prime-2026-10-01",
      "urpx:description": "Voluntary residential time-of-use option with summer on-peak 4:00 p.m.-9:00 p.m. weekdays, the windows of Option 4-9 PM (Sheet 8), with no Baseline Credit. Advice 5897-E deletes the PRIME Eligibility Requirements Special Condition, so from this version Option PRIME is available on the terms of Sheet 1 alone: to Customers eligible for service under Schedule D, D-CARE or D-FERA, and not to Customers on Schedules DM, DMS-1, DMS-2 or DMS-3. Separately metered electric vehicle load is eligible for Option PRIME with an EV Meter Credit of $(0.371)/meter/day (Special Condition 4); a customer using an EV submeter receives an EV Submeter Credit of $(0.051)/meter/day (the EV Submetering Special Condition on Sheet 19). Base Services Charge (BSC) of $0.794/meter/day per Decision 24-05-028, with a BSC Adjustment of $(0.328)/meter/day for customers in deed-restricted affordable housing, modeled as sce:deed-restricted. The CARE and FERA discounts of Special Conditions 6 and 7 (32.5 and 18.0 percent, with their BSC Surcharge exemption and BSC discount or credit adjustment) are modeled as sce:care and sce:fera. The California Climate Credit of $(36.00) per household is applied semi-annually per Special Condition 10. The Medical Baseline Credit line at 100.00 percent cross-references Schedule MB-E. Special Condition 1 (Sheet 9) names eight holidays: New Year's Day, Presidents' Day, Memorial Day, Independence Day, Labor Day, Veterans Day, Thanksgiving Day and Christmas. Sheet 8 prices them in the Weekends-and-Holidays column, so a holiday landing on a summer weekday takes Mid-Peak rather than On-Peak across the 4 p.m. to 9 p.m. window; the winter weekday and weekend/holiday columns are identical, so holiday status moves no winter price. Modeled as a urpx:HolidayCalendar with urpx:includeHolidays / urpx:includeNonHolidays on the summer 4 p.m. to 9 p.m. brackets. SCE's observance rule (a holiday falling on Sunday is recognized the following Monday, with no change for one falling on Saturday) matches none of URPX v0.5.1's four urpx:ObservanceRuleValue individuals, so no urpx:observanceRule is attached and the Monday after a Sunday holiday is carried as a dated urpx:Holiday through 2040.",
      "urpx:effectiveDateTime": "2026-10-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {

        "urpx:selfContained": true,
        "urpx:explainedBy": {
          "@type": "urpx:Evaluation",
          "@id": "sce:cc-tou-d-prime-2026-10-01-evaluation",
          "urpx:evaluationKind": {
            "@id": "urpx:coverageEvaluation"
          },
          "urpx:description": "Two conditional credits on Sheet 6 are carried here without the conditions that gate them: the EV Meter Credit (Separately Metered EV Option) at $(0.371) per meter per day, which Special Condition 4 limits to a customer with a separate meter provided by SCE exclusively for charging electric vehicles, and the EV Submeter Credit at $(0.051) per meter per day, which the EV Submetering Special Condition on Sheet 19 limits to a customer whose submeter meets the Plug-In Electric Vehicle Submetering Protocol of Decision 22-08-024. This filing states both as unconditional, so a consumer computing a bill applies both to every Option PRIME customer. The two pilot bill discounts of Special Conditions 12 and 14 are also unrepresented: the San Joaquin Valley Disadvantaged Communities Pilot Bill Protection Discount (20 percent in years 1 through 5, then 10 or 20 percent in years 6 through 10) and the 20 percent Transitional Community Solar Discount. Option PRIME has no Baseline Credit line. The Option PRIME-CPP prices printed on the same sheet are the modifier sce:tou-d-prime-cpp; the Deed Restricted Base Services Charge adjustment of $(0.328) per meter per day, the CARE and FERA discount lines, and the Medical Baseline Credit line shown at 100.00 are cross-references to separate schedules each filed on its own.",
          "urpx:evaluatedOn": "2026-10-06T00:00:00"
        }
      }
    }
  }

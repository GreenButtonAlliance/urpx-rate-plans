      "urpx:hasCoverageClaim": {
        "@id": "sce:cc-tou-d-prime-2025-11-15",
        "@type": "urpx:CoverageClaim",
        "urpx:completenessResult": {
          "@id": "urpx:partial"
        },
        "urpx:selfContained": true,
        "urpx:explainedBy": {
          "@type": "urpx:Evaluation",
          "@id": "sce:cc-tou-d-prime-2025-11-15-evaluation",
          "urpx:evaluationKind": {
            "@id": "urpx:coverageEvaluation"
          },
          "urpx:description": "Two conditional credits on the Option PRIME rate sheet are carried here without the conditions that gate them. The sheet labels them EV Meter Credit (Separately Metered EV Option) at $(0.446) per meter per day and EV Submeter Credit at $(0.152) per meter per day; this filing states both as unconditional price definitions, so a consumer computing a bill from it will apply both to every Option PRIME customer rather than only to one with an SCE-provided separate electric vehicle meter or a qualifying submeter. The Option PRIME-CPP variant on the same sheet is also unrepresented at this effective date: its CPP Event Energy Charge of $0.80000 per kWh, Summer on-peak non-event energy credit of $(0.15170) per kWh, and Summer Season Maximum Available Credit of $(0.55677) per kWh are not modeled here and no companion filing carries them for 2025-11-15. Option PRIME has no Baseline Credit line, so the baseline-allocation limitation that affects the other SCE residential options does not arise. Three rate-sheet lines are out of scope rather than missing: the Deed Restricted Base Services Charge discount of $(0.334) per meter per day, the CARE and FERA discount percentages shown at 100.00, and the Medical Line Item Discount shown at 100.000 are cross-references to separate schedules, each filed as its own modifier overlay in this corpus.",
          "urpx:evaluatedOn": "2026-09-21T00:00:00"
        }
      }
    }
  }

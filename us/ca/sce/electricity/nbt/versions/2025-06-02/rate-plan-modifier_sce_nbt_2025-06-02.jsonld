  "@type": "urpx:URPXPackage",
  "@id": "sce:doc-nbt-2025-06-02",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlanModifier": {
    "@type": "urpx:RatePlanModifier",
    "@id": "sce:nbt",
    "urpx:name": "Schedule NBT (Net Billing Tariff) Service",
    "urpx:modifierUniqueIdentifier": "NBT",
    "urpx:initialEffectiveDate": "2023-03-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "sce:nbt-2025-06-02",
      "urpx:version": "2025-06-02",
      "urpx:modifierVersionNumber": "2025-06-02",
      "urpx:changeReason": {
        "@id": "urpx:changeReasonOther"
      },
      "urpx:description": "SCE's Net Billing Tariff (NBT) per CPUC Decision 22-12-056. Customer-facing name: Solar Billing Plan (SBP), with vintage labels NBT23 / NBT24 / NBT25 / NBT26 / NBT00. Effective for new residential DER interconnection applications submitted on or after April 15, 2023 (NEM and NEM-ST closed at that date except for NBT Transition Customers). Per Sheet 2 §1.a, residential customers taking NBT MUST be on the Prime Option of Schedule TOU-D — modeled here as a urpx:RatePlanModifier overlay binding to sce:tou-d-prime. Single-base binding mirrors PG&E NBT's E-ELEC mandate and the SCE TOU-D-PRIME-CPP precedent. Import-side charges remain governed by the base TOU-D-PRIME RatePlan (measured on the meter's import channel); this modifier handles only the export-side compensation (measured on channel 2; urpx:flowDirection urpx:reverse on the MetricSpecification). Second export-direction modifier in the corpus (PG&E NBT was first). PriceDefinitions: (1) Export Compensation Rate Generation Component (energy, cap-and-trade, generation capacity); (2) Export Compensation Rate Delivery Component (transmission, distribution, greenhouse adder, methane leakage); (3) ACC Plus Non-Equity Customer adder; (4) ACC Plus Equity Customer adder (higher per-kWh value for an Equity Customer as Sheet 17, Cal. P.U.C. Sheet No. 87511-E effective 2024-07-01, defines one: enrolled in CARE or FERA, a resident of a single-family home in a disadvantaged community whose account has only one meter, or a Residential Customer in California Indian Country whose account has only one meter). This initial filing scopes to canonical residential NBT (PRIME-required); sibling sub-schedule filings (NBT-A Aggregation, NBT-PS Paired Storage, NBT-MT Multiple Tariff) deferred. Export Compensation Rate Prices, from CEC MIDAS, cover 576 cells (12 months × 24 hours × weekday/weekend) per component for NBT23, NBT24, NBT25 and non-vintaged, and January through May for NBT26, one urpx:PriceSetAlternative per vintage, NBT25 split into two by NBT Customer Segment (Residential Non-Equity Customer, Residential Equity Customer) because its ACC Plus adder differs by segment. 2025-vintage ACC Plus values included (Non-Equity $0.024/kWh, Equity $0.056/kWh — Sheet 7 table). Annual true-up settlement, Net Surplus Compensation (NSC), NSC Renewable Attribute Adder (RAA), and bill-credit rollover deferred to consumer (price-server) responsibility. Advice 5497-E, effective 2025-06-02, reissued Sheet 6 (Cal. P.U.C. Sheet No. 89868-E), which assigns a Customer whose Original PTO Date is after June 30, 2024 the EEC Vintage Year of the date its Interconnection Request was submitted, and Sheet 34 (89869-E), under which a NEM or NEM-ST Customer moved to this Schedule whose modifications or repairs increase system size by more than 10 percent or 1 kW begins a new 9-year legacy period from the PTO date of the modification. No price changed.",
      "urpx:effectiveDateTime": "2025-06-02T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:applicableToRatePlan": [
        {
          "@id": "sce:tou-d-prime"
        }
      ],
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "urpx:fileName": "ELECTRIC_SCHEDULES_NBT.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://edisonintl.sharepoint.com/teams/Public/TM2/Shared%20Documents/Public/Regulatory/Tariff-SCE%20Tariff%20Books/Electric/Schedules/Other%20Rates/ELECTRIC_SCHEDULES_NBT.pdf",
        "urpx:dateRetrieved": "2026-10-11",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 42,
        "urpx:leafStart": "85350-E",
        "urpx:leafEnd": "89869-E"
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "sce:nbt-2025-06-02-er-regf",
          "urpx:name": "Customer has Renewable Electrical Generating Facility (REGF)",
          "urpx:description": "Per Sheet 11 §1.b, customer must operate an Eligible Renewable Electrical Generating Facility on the Customer's Premises, interconnected to SCE's electric system. Eligible technologies: biomass, solar thermal, photovoltaic, wind, geothermal, fuel cells using renewable fuels, small hydroelectric generation, digester gas, municipal solid waste conversion, landfill gas, ocean wave, ocean thermal, tidal current — per CEC RPS Eligibility Guidebook.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "sce:nbt-2025-06-02-cx-regf",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "sce:nbt-2025-06-02-cn-regf",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:CustomOperandNode",
                "@id": "sce:nbt-2025-06-02-cn-regf-left-operand",
                "urpx:customConditionProperty": "Has Eligible REGF"
              },
              "urpx:rightOperand": {
                "@type": "urpx:CustomOperandNode",
                "@id": "sce:nbt-2025-06-02-cn-regf-right-operand",
                "urpx:stringValue": "true"
              }
            }
          }
        },
        {
          "@type": "urpx:EligibilityRule",
          "@id": "sce:nbt-2025-06-02-er-interconnection-date",
          "urpx:name": "NBT interconnection application submitted on or after 2023-04-15",
          "urpx:description": "Per Sheet 1 / Sheet 13, Schedule NEM-ST closed for new interconnection applications after 2023-04-14. Customers submitting complete Interconnection Requests on or after 2023-04-15 take service on NBT. Customers with legacy NEM or NEM-ST whose 20-year transition period expires, or who voluntarily elect into NBT, or NBT Transition Customers are also eligible — those transition-state cases are handled in description prose and process state rather than as billing-time eligibility predicates.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "sce:nbt-2025-06-02-cx-interconnection-date",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "sce:nbt-2025-06-02-cn-interconnection-date",
              "urpx:operator": {
                "@id": "urpx:greaterThanOrEqualOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:CustomOperandNode",
                "@id": "sce:nbt-2025-06-02-cn-interconnection-date-left-operand",
                "urpx:customConditionProperty": "NBT Interconnection Application Date"
              },
              "urpx:rightOperand": {
                "@type": "urpx:CustomOperandNode",
                "@id": "sce:nbt-2025-06-02-cn-interconnection-date-right-operand",
                "urpx:stringValue": "2023-04-15"
              }
            }
          }
        }
      ],

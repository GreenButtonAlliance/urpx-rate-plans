  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "sce:d",
    "urpx:name": "Schedule D Domestic Service",
    "urpx:ratePlanUniqueIdentifier": "D",
    "urpx:initialEffectiveDate": "1949-08-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "sce:d-2025-11-15",
      "urpx:description": "Tiered residential schedule (no time-of-use). Generation, distribution, and most flat-rate surcharges do not vary by tier or season. The two-tier structure (baseline / nonbaseline) is implemented via the Conservation Incentive Adjustment (CIA): customers receive a CIA credit of $-0.03845/kWh for usage at-or-below their daily baseline allocation, and pay a CIA charge of $+0.06604/kWh for usage above. The 10.449¢ swing matches the Baseline Credit modeled in SCE TOU-D options. Baseline allocations vary by Baseline Region (5/6/8/9/10/13/14/15/16), season (Summer = June-September; Winter = October-May), and whether the customer's primary heat source is electric (Basic vs All-Electric) per Preliminary Statement Part H. Schedule D is the legacy default destination for residential customers who opt out of the CPUC TOU mass-migration default schedules (TOU-D-4-9PM, TOU-D-5-8PM); enrollment is declining as opt-outs migrate to TOU over time. Replaces the prior Basic Charge + Minimum Charge structure with an income-graduated Base Services Charge (BSC) of $0.794/meter/day per Decision 24-05-028, with a Deed-Restricted discount of $(0.334)/meter/day. CARE/FERA discounts (32.5% and 18% respectively) and the related BSC surcharge exemption + BSC discount adjustments are documented in Special Conditions and modeled separately as RatePlanModifiers at ca/iou/sce/care/ and ca/iou/sce/fera/; the Deed-Restricted discount referenced above is modeled at ca/iou/sce/deed-restricted/.",
      "urpx:effectiveDateTime": "2025-11-15T00:00:00",
      "urpx:expirationDateTime": "2026-01-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "urpx:fileName": "ELECTRIC_SCHEDULES_D_2025.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://library.sce.com/content/dam/sce-doclib/public/regulatory/tariff/2025/electric/electric-schedules/ELECTRIC_SCHEDULES_D_2025.pdf",
        "urpx:dateRetrieved": "2026-04-30",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 4,
        "urpx:pageEnd": 9,
        "urpx:leafStart": "90634-E",
        "urpx:leafEnd": "90635-E"
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "sce:er-residential-d",
          "urpx:name": "Eligibility for Schedule D Domestic Service",
          "urpx:description": "Available to residential customers individually metered by SCE living in single-family accommodations or individually-metered single-family dwellings in a Multifamily Accommodation (e.g., houses, townhouses, condominiums, apartments, rental units, manufactured houses, mobile homes). Voluntary opt-in; primary destination for customers electing to leave a CPUC TOU default schedule (TOU-D-4-9PM or TOU-D-5-8PM). 12-month minimum stay applies to elective rate changes; customers placed on a TOU schedule by SCE default may make an additional rate change within a 12-month window of being defaulted.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "sce:cx-residential-d",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "sce:cn-residential-d",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {

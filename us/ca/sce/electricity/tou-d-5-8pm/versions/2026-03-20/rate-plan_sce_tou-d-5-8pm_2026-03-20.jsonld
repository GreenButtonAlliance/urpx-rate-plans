      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "sce:tou-d-5-8pm-2026-03-20-er-residential",
          "urpx:name": "Eligibility for Schedule TOU-D Option 5-8 PM",
          "urpx:description": "Available to customers eligible for service under Schedule D (Domestic): residential customers individually metered by SCE in single-family accommodations or individually-metered single-family dwellings in a Multifamily Accommodation. Voluntary opt-in; selected by CPUC mass-migration default for inland climate zones (customers may transfer to Schedule D, TOU-D-4-9PM, TOU-D-PRIME, or other applicable residential schedules subject to a 12-month minimum-stay rule unless defaulted by SCE).",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "sce:tou-d-5-8pm-2026-03-20-cx-residential",
            "urpx:rootNode": {

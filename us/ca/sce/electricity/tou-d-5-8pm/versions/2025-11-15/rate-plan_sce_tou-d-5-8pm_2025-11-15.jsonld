  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "sce:tou-d-5-8pm",
    "urpx:name": "Schedule TOU-D Time-Of-Use Domestic — Option 5-8 PM",
    "urpx:ratePlanUniqueIdentifier": "TOU-D-5-8PM",
    "urpx:initialEffectiveDate": "2019-03-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "sce:tou-d-5-8pm-2025-11-15",
      "urpx:description": "Voluntary residential time-of-use schedule with summer on-peak 5:00 p.m.-8:00 p.m. weekdays. Alternate CPUC mass-migration default — assigned to inland climate zones (where peak demand window aligns with later-evening loads). Replaces the prior Basic Charge + Minimum Charge structure with an income-graduated Base Services Charge (BSC) of $0.794/meter/day per Decision 24-05-028, with a Deed-Restricted discount of $(0.334)/meter/day available to customers in qualifying deed-restricted housing. CARE/FERA discounts (32.5% and 18% respectively) and the related BSC surcharge exemption + BSC discount adjustments are documented in Special Conditions and modeled separately as RatePlanModifiers at ca/iou/sce/care/ and ca/iou/sce/fera/; the Deed-Restricted discount referenced above is modeled at ca/iou/sce/deed-restricted/. Climate Credit ($-56.00/household, semi-annually) is applied per Special Conditions. Heat Pump Water Heater (HPWH) customers receive an additional baseline allocation per Preliminary Statement Part H (modeling deferred — baseline credit modifier not yet captured). Special Condition 1 (Sheet 13) names eight holidays: New Year's Day, Presidents' Day, Memorial Day, Independence Day, Labor Day, Veterans Day, Thanksgiving Day and Christmas. Sheet 12 prices them in the Weekends-and-Holidays column, so a holiday landing on a summer weekday takes Mid-Peak rather than On-Peak across the 5 p.m. to 8 p.m. window; the winter weekday and weekend/holiday columns are identical, so holiday status moves no winter price. Modeled as a urpx:HolidayCalendar with urpx:includeHolidays / urpx:includeNonHolidays on the summer 5 p.m. to 8 p.m. brackets. SCE's observance rule (a holiday falling on Sunday is recognized the following Monday, with no change for one falling on Saturday) matches none of URPX v0.5.1's four urpx:ObservanceRuleValue individuals, so no urpx:observanceRule is attached and each holiday resolves on its actual date. The single consequence is that the Monday after an Independence Day falling on a Sunday resolves to On-Peak rather than the Mid-Peak Sheet 12 directs.",
      "urpx:effectiveDateTime": "2025-11-15T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,

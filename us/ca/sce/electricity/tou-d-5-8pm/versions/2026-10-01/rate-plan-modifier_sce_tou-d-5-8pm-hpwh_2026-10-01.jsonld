  "@type": "urpx:URPXPackage",
  "@id": "sce:doc-tou-d-5-8pm-hpwh-2026-10-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlanModifier": {
    "@type": "urpx:RatePlanModifier",
    "@id": "sce:tou-d-5-8pm-hpwh",
    "urpx:name": "Schedule TOU-D Option 5-8 PM Heat Pump Water Heater Baseline Allocation (Preliminary Statement Part H)",
    "urpx:modifierUniqueIdentifier": "TOU-D-5-8PM-HPWH",
    "urpx:initialEffectiveDate": "2022-10-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "sce:tou-d-5-8pm-hpwh-2026-10-01",
      "urpx:version": "2026-10-01",
      "urpx:modifierVersionNumber": "2026-10-01",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:description": "Preliminary Statement Part H, paragraph 3, adds a Heat Pump Water Heater (HPWH) baseline quantity for customers attesting to having a HPWH and served under Schedule TOU-D-4-9 or TOU-D-5-8: 1.9 kWh per day in summer for the Basic and the All-Electric Allocation, and 2.6 (Basic) and 3.0 (All-Electric) kWh per day in winter (Sheets 2 and 3, Cal. P.U.C. Sheets 91543-E and 91544-E). This version adds them to the baseline ladder of sce:tou-d-5-8pm-2026-10-01: each of its 72 urpx:ServiceBracket names that version's Tier 1 or Tier 2 with urpx:adjustsServiceTier, a Baseline Region and allocation with urpx:referencesProfileAlternative, and a season, and offsets Tier 1's upper bound and Tier 2's lower bound by that cell's quantity, so the Baseline Credit reaches the larger allocation. The offsets are kWh per day, the unit of the bounds they adjust. urpx:adjustsServiceTier, urpx:lowerBoundOffset and urpx:upperBoundOffset are proposed in urpx-org/urpx#80 and are in no URPX release.",
      "urpx:effectiveDateTime": "2026-10-01T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:applicableToRatePlan": [
        {
          "@id": "sce:tou-d-5-8pm"
        }
      ],

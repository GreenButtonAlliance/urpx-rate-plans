      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "sce:tou-d-5-8pm-hpwh-2026-10-01-er-hpwh-attested",
          "urpx:name": "Customer attesting to having a Heat Pump Water Heater",
          "urpx:description": "Preliminary Statement Part H, paragraph 3: \"The applicable Heat Pump Water Heater (HPWH) baseline quantity applies to Customers attesting to having a HPWH and served under either Schedule TOU-D-4-9 or TOU-D-5-8.\" The schedule half is urpx:applicableToRatePlan; the attestation is this condition.",
          "urpx:hasConditionExpression": {

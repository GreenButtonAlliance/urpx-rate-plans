  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "sce:tou-d-4-9pm",
    "urpx:name": "Schedule TOU-D Time-Of-Use Domestic — Option 4-9 PM",
    "urpx:ratePlanUniqueIdentifier": "TOU-D-4-9PM",
    "urpx:initialEffectiveDate": "2019-03-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "sce:tou-d-4-9pm-2025-11-15",
      "urpx:description": "Voluntary residential time-of-use schedule with summer on-peak 4:00 p.m.-9:00 p.m. weekdays. Assigned by CPUC mass-migration default rules to a portion of SCE's residential customer base by climate zone. Replaces the prior Basic Charge + Minimum Charge structure with an income-graduated Base Services Charge (BSC) of $0.794/meter/day per Decision 24-05-028, with a Deed-Restricted discount of $(0.334)/meter/day available to customers in qualifying deed-restricted housing. CARE/FERA discounts (32.5% and 18% respectively) and the related BSC surcharge exemption + BSC discount adjustments are documented in Special Conditions and modeled separately as RatePlanModifiers at ca/iou/sce/care/ and ca/iou/sce/fera/; the Deed-Restricted discount referenced above is modeled at ca/iou/sce/deed-restricted/. Climate Credit ($-56.00/household, semi-annually) is applied per Special Conditions. Heat Pump Water Heater (HPWH) customers receive an additional baseline allocation per Preliminary Statement Part H (modeling deferred — baseline credit modifier not yet captured).",
      "urpx:effectiveDateTime": "2025-11-15T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "urpx:fileName": "ELECTRIC_SCHEDULES_TOU-D_2025.pdf",

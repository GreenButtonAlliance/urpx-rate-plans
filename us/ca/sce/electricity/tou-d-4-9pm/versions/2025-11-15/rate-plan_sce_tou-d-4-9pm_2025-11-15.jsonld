      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "sce:er-residential-tou-d-4-9pm",
          "urpx:name": "Eligibility for Schedule TOU-D Option 4-9 PM",
          "urpx:description": "Available to customers eligible for service under Schedule D (Domestic): residential customers individually metered by SCE in single-family accommodations or individually-metered single-family dwellings in a Multifamily Accommodation. Voluntary opt-in; selected by CPUC mass-migration default for some climate zones (customers may transfer to Schedule D, TOU-D-5-8PM, TOU-D-PRIME, or other applicable residential schedules subject to a 12-month minimum-stay rule unless defaulted by SCE).",

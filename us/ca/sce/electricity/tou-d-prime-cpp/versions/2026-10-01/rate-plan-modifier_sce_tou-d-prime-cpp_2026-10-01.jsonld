  "@type": "urpx:URPXPackage",
  "@id": "sce:doc-tou-d-prime-cpp-2026-10-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlanModifier": {
    "@type": "urpx:RatePlanModifier",
    "@id": "sce:tou-d-prime-cpp",
    "urpx:name": "Schedule TOU-D Option PRIME-CPP (Critical Peak Pricing variant of Option PRIME)",
    "urpx:modifierUniqueIdentifier": "TOU-D-PRIME-CPP",
    "urpx:initialEffectiveDate": "2022-06-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "sce:tou-d-prime-cpp-2026-10-01",
      "urpx:version": "2026-10-01",
      "urpx:modifierVersionNumber": "2026-10-01",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:description": "Critical Peak Pricing (CPP) variant of Option PRIME, a customer-elected overlay of event charges and non-event credits on the base PRIME rates. Special Condition 3.b (Sheet 10): SCE calls 20 CPP Events per calendar year, each of 3 hours, notifying Customers no later than 3:00 p.m. the day before. Special Condition 1 (Sheet 9): within the five-hour CPP Event Window of 4:00 p.m. to 9:00 p.m., SCE designates the three-hour CPP Event Energy Charge Period, when the CPP Event Energy Charge of +$0.80000/kWh applies; in the Summer Season the CPP Non-Event Energy Credit of -$0.15170/kWh applies in the hours of the window outside that period, the whole window when no Event is called. Special Condition 3.d (Sheet 11) limits CPP options to Bundled Service Customers and caps the sum of credits for CPP Customers eligible to continue dual participation with Schedule D-SDP; the cap is the Summer Season Maximum Available Credit of -$0.41944/kWh on Sheet 6. Special Condition 3.e's Bill Protection and 3.f's 12-month minimum participation are not modeled. The CPP Event Energy Charge uses urpx:hasDynamicPricing with dynamicPricingType urpx:criticalPeakPricing, priceSource urpx:wholesaleMarketSource, updateFrequency urpx:eventTriggeredUpdates and a urpx:PriceUpdateRule describing the event trigger. The Non-Event Credit and the Maximum Available Credit carry ApplicabilityRule and CustomOperandNode gates: the Non-Event Credit applies when 'Is CPP Event Today' is false, and the Maximum Available Credit gates on the customer attribute 'Grandfathered D-SDP Dual Participation'.",
      "urpx:effectiveDateTime": "2026-10-01T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:applicableToRatePlan": [
        {
          "@id": "sce:tou-d-prime"
        }
      ],

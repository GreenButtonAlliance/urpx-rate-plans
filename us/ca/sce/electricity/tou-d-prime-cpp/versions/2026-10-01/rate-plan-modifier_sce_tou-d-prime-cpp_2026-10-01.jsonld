            },
            "urpx:startDate": "2026-10-01",
            "urpx:name": "Summer CPP Non-Event On-Peak Energy Credit",
            "urpx:unitPrice": "-0.15170",
            "urpx:hasApplicabilityRule": {
              "@type": "urpx:ApplicabilityRule",
              "@id": "sce:tou-d-prime-cpp-2026-10-01-ar-non-event-credit",
              "urpx:name": "Applies during Summer Season hours of the 4 p.m.-9 p.m. CPP Event Window outside any CPP Event Energy Charge Period; June-September only",
              "urpx:month": [
                "--06",
                "--07",
                "--08",
                "--09"
              ],

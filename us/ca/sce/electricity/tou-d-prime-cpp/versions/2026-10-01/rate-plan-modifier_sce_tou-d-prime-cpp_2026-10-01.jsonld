      },
      "urpx:hasCoverageClaim": {
        "@id": "sce:cc-tou-d-prime-cpp-2026-10-01",
        "@type": "urpx:CoverageClaim",
        "urpx:completenessResult": {
          "@id": "urpx:partial"
        },
        "urpx:selfContained": true,
        "urpx:explainedBy": {
          "@type": "urpx:Evaluation",
          "@id": "sce:cc-tou-d-prime-cpp-2026-10-01-evaluation",
          "urpx:evaluationKind": {
            "@id": "urpx:coverageEvaluation"
          },
          "urpx:description": "This filing carries the three prices Schedule TOU-D publishes for Option PRIME-CPP on Sheet 6 (a CPP Event Energy Charge of $0.80000 per kWh, a Summer On-Peak Energy Credit of $(0.15170) per kWh outside CPP Events, and a Summer Season Maximum Available Credit of $(0.41944) per kWh) and leaves several provisions of Special Conditions 1 and 3 unrepresented. No time window is modeled, so neither CPP price is limited to the CPP Event Window of 4:00 p.m. to 9:00 p.m. or to the three-hour CPP Event Energy Charge Period SCE designates within it. The Maximum Available Credit is a cap on the sum of credits for a Customer continuing dual participation with Schedule D-SDP and is carried as an additive credit. Special Condition 3.e, Bill Protection, credits a customer on a CPP option with the positive sum, if any, of CPP Event Energy Charges and Summer Non-Event Energy Credits over up to the first twelve months, and settles across a year of bills rather than within one. Special Condition 3 states that exported generation during the CPP Non-Event Energy Credit Period may result in charges and that exported generation during the CPP Event Energy Charge Period may result in CPP Event energy credits; this filing's prices apply to a metered quantity that does not distinguish import from export. The event-calling criteria, the 20 three-hour events per calendar year and the notification duty of Special Conditions 3.a to 3.c, the eligibility limits of 3.d and the 12-month minimum participation of 3.f are recorded as deferrals in this filing's manifest.",
          "urpx:evaluatedOn": "2026-10-06T00:00:00"
        }
      }
    }
  }

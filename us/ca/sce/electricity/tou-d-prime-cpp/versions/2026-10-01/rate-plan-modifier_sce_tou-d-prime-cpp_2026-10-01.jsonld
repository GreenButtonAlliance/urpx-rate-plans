              "@id": "sce:tou-d-prime-cpp-2026-10-01-cn-eligible",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:CustomOperandNode",
                "@id": "sce:tou-d-prime-cpp-2026-10-01-cn-eligible-left-operand",
                "urpx:customConditionProperty": "CPP Election"
              },
              "urpx:rightOperand": {
                "@type": "urpx:CustomOperandNode",
                "@id": "sce:tou-d-prime-cpp-2026-10-01-cn-eligible-right-operand",
                "urpx:stringValue": "PRIME-CPP"
              }
            }
          }
        }
      ],

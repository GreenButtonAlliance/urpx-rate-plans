      "urpx:hasPrices": {
        "@type": "urpx:Prices",
        "@id": "sce:tou-d-prime-cpp-2026-10-01-prices",
        "urpx:hasPrice": [
          {
            "@type": "urpx:Price",
            "@id": "sce:tou-d-prime-cpp-price-event-charge-2026-10-01",
            "urpx:referencesPriceDefinition": {
              "@id": "sce:tou-d-prime-cpp-2026-10-01-pd-event-charge"
            },
            "urpx:startDate": "2026-10-01",
            "urpx:name": "CPP Event Energy Charge",
            "urpx:unitPrice": "0.80000",
            "urpx:hasDynamicPricing": {
              "@type": "urpx:DynamicPricing",
              "@id": "sce:tou-d-prime-cpp-2026-10-01-dp-event-charge",
              "urpx:dynamicPricingType": {
                "@id": "urpx:criticalPeakPricing"
              },
              "urpx:priceSource": {
                "@id": "urpx:wholesaleMarketSource"
              },
              "urpx:updateFrequency": {
                "@id": "urpx:eventTriggeredUpdates"
              },
              "urpx:hasPriceUpdateRule": {
                "@type": "urpx:PriceUpdateRule",
                "@id": "sce:tou-d-prime-cpp-2026-10-01-pur-event-trigger",
                "urpx:name": "PRIME-CPP Event Day Trigger Rule",
                "urpx:description": "Special Condition 3.a (Sheet 10): SCE may call a CPP Event any day, based on a California Independent System Operator Alert, forecasts of SCE system emergencies, forecasts of extreme or unusual temperature conditions impacting system demand, or day-ahead load and/or price forecasts. Special Condition 3.b: 20 CPP Events are called per calendar year, each of 3 hours. Special Condition 3.c: SCE notifies Customers no later than 3:00 p.m. the day before. The CPP Event Energy Charge of +$0.80000/kWh applies during the three-hour CPP Event Energy Charge Period SCE designates within the 4:00 p.m. to 9:00 p.m. CPP Event Window, in addition to the customer's Option PRIME rate for the period."
              }
            }
          },
          {

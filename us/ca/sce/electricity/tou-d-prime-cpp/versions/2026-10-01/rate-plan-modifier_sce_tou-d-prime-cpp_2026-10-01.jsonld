                "urpx:rootNode": {
                  "@type": "urpx:ComparisonNode",
                  "@id": "sce:tou-d-prime-cpp-2026-10-01-cn-non-event-day",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",

          "urpx:name": "PRIME-CPP-elected customer",
          "urpx:description": "Customer is on Option PRIME and has elected Option PRIME-CPP. Special Condition 3.d (Sheet 11): only Bundled Service Customers may be served under a CPP option; Direct Access and CCA Service Customers, and Customers served under Schedule S, are ineligible, and a CPP Customer may not dually enroll in any other demand response program.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "sce:tou-d-prime-cpp-2026-10-01-cx-eligible",
            "urpx:rootNode": {

  "@type": "urpx:URPXPackage",
  "@id": "gpc:doc-pps-2026-06-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "gpc:pps",
    "urpx:name": "Schedule PPS Pre-Pay Service",
    "urpx:ratePlanUniqueIdentifier": "PPS",
    "urpx:initialEffectiveDate": "2026-06-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "gpc:pps-2026-06-01",
      "urpx:description": "Georgia Power's residential pre-pay schedule, PPS-11, with the riders every Schedule PPS customer pays. A Basic Service Charge of $0.66 per day, and energy at 12.2117 cents per kWh in the calendar months June through September (Summer) and 8.5977 cents per kWh in the calendar months October through May (Winter), one rate for all kWh in each season. The customer pays in advance; the sheet's prepayment terms (a $40.00 minimum balance to connect, disconnection when the balance reaches $0.00, a minimum $5.00 prepayment with reconnection) set no price per unit and are not carried. The riders the sheet applies are carried as Prices here rather than as modifiers, because every customer on the schedule pays them: Fuel Cost Recovery FCR-27 per kWh (Secondary Distribution, 3.8069 cents June through September and 3.8561 cents October through May); Environmental Compliance Cost Recovery ECCR-15 (13.0205 percent) and Demand Side Management Residential DSM-R-16 (1.1969 percent) of the base bill, each as one multiplier over the energy subtotal and one over the Basic Service Charge Price; and the Municipal Franchise Fee MFF-11, 3.0843 percent inside city limits or 1.1995 percent outside them (also for a city with which the Company has no franchise fee agreement), chosen by a ProfileAlternative, as multipliers over the energy-and-fuel subtotal and over the Basic Service Charge Price. The Income Qualified Discount is a separate rider for certified customers and is not carried here. Dating: each sheet is effective \"With Bills Rendered for the Billing Month of June, 2026\" (MFF-11 for January 2025). PPS-11 was filed with R-31 in the same compliance filing in docket 44280 (PSC document 227071), so this version begins 2026-06-01, the date Schedule R's bills show the new base rates took effect by calendar day.",
      "urpx:effectiveDateTime": "2026-06-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "urpx:fileName": "pps.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.georgiapower.com/content/dam/georgia-power/pdfs/tariffs/pps.pdf",
        "urpx:dateRetrieved": "2026-10-16",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 2
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "gpc:pps-2026-06-01-er-residential",
          "urpx:name": "Eligibility for Schedule PPS Pre-Pay Service",
          "urpx:description": "For all domestic uses of a Residential Customer in a separately metered dwelling unit, as the Company's Rules and Regulations for Electric Service define a Residential Customer, except customers who have health or safety risks associated with the loss of service. Every customer must have Automated Metering Infrastructure (AMI) with reconnect/disconnect functionality and acceptable network coverage. Available throughout the Company's service area from existing lines of adequate capacity; single phase, 60 hertz, at a standard voltage.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "gpc:pps-2026-06-01-cx-residential",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "gpc:pps-2026-06-01-cn-residential",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:pps-2026-06-01-cn-residential-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:hasCustomerKind"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:pps-2026-06-01-cn-residential-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:residentialKind"
                }
              }
            }
          }
        }
      ],

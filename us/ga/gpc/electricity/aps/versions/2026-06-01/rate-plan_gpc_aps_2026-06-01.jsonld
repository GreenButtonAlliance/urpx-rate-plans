                        "@type": "urpx:ObjectOperandNode",
                        "@id": "gpc:aps-2026-06-01-cn-pa-transmission-outside-city-limits-voltage-level-right-operand",
                        "urpx:referencesValue": {
                          "@id": "urpx:transmissionVoltage"
                        }
                      }
                    },
                    {
                      "@type": "urpx:ComparisonNode",
                      "@id": "gpc:aps-2026-06-01-cn-pa-transmission-outside-city-limits-franchise-fee-location",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:CustomOperandNode",
                        "@id": "gpc:aps-2026-06-01-cn-pa-transmission-outside-city-limits-franchise-fee-location-left-operand",
                        "urpx:customConditionProperty": "franchiseFeeLocation"
                      },
                      "urpx:rightOperand": {
                        "@type": "urpx:CustomOperandNode",
                        "@id": "gpc:aps-2026-06-01-cn-pa-transmission-outside-city-limits-franchise-fee-location-right-operand",
                        "urpx:stringValue": "Outside City Limits"
                      }
                    }
                  ],
                  "urpx:logicExpression": "voltageLevel = transmissionVoltage AND franchiseFeeLocation = 'Outside City Limits'"
                }
              }
            }
          ]
        },

        ],
        "urpx:hasProfileAlternatives": {
          "@type": "urpx:ProfileAlternatives",
          "@id": "gpc:aps-2026-06-01-pa-voltage-level-franchise-fee-location",
          "urpx:name": "Fuel Cost Recovery voltage level and Municipal Franchise Fee location",
          "urpx:hasAlternativeDimensions": {

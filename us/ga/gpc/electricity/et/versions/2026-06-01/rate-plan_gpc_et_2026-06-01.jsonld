              "urpx:name": "Primary Distribution customer, inside city limits",
              "urpx:hasConditionExpression": {
                "@type": "urpx:ConditionExpression",
                "@id": "gpc:et-2026-06-01-cx-pa-primary-inside-city-limits",
                "urpx:rootNode": {
                  "@type": "urpx:BooleanOperationNode",
                  "@id": "gpc:et-2026-06-01-bn-pa-primary-inside-city-limits",
                  "urpx:operator": {
                    "@id": "urpx:andOperator"
                  },
                  "urpx:operandNodes": [
                    {
                      "@type": "urpx:ComparisonNode",
                      "@id": "gpc:et-2026-06-01-cn-pa-primary-inside-city-limits-voltage-level",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:ObjectOperandNode",

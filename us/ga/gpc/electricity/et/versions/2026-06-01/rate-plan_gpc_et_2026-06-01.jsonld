  "@id": "gpc:doc-et-2026-06-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "gpc:et",
    "urpx:name": "Schedule ET Electric Transportation Service",
    "urpx:ratePlanUniqueIdentifier": "ET",
    "urpx:initialEffectiveDate": "2026-06-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "gpc:et-2026-06-01",
      "urpx:description": "Georgia Power's electric transportation service schedule, ET-23, for the operation of electric transportation at 19,800 volts or higher. All energy is priced by six periods: Period 1, 5 a.m. to noon, and Period 2, 8 p.m. to 1 a.m., Monday through Friday in June through September, at 5.6367 cents per kWh; Period 3, noon to 8 p.m. on the same days, at 11.1342 cents; Period 4, 1 a.m. to 5 a.m. every day of the year, at 0.0000 cents; Period 5, 5 a.m. Saturday or Sunday to 1 a.m. the next day, all year, at 2.4961 cents; and Period 6, 5 a.m. to 1 a.m. the next day, Monday through Friday in October through May, at 5.2485 cents. A period running past midnight is carried by its hour after midnight on the next day, chosen by day of week. The sheet has no Basic Service Charge and names no holidays. The riders the sheet applies are carried as Prices here rather than as modifiers, because every customer on the schedule pays them: Fuel Cost Recovery FCR-27 per kWh, by voltage level (Primary Distribution 3.7387 cents June through September and 3.7871 cents October through May, Transmission 3.7126 and 3.7607 cents; service at 19,800 volts or higher is never Secondary Distribution); Environmental Compliance Cost Recovery ECCR-15 (13.0205 percent) of the base bill, as one multiplier over the energy subtotal; the sheet applies no Demand Side Management schedule; and the Municipal Franchise Fee MFF-11, 3.0843 percent inside city limits or 1.1995 percent outside them (also for a city with which the Company has no franchise fee agreement), as multipliers over the energy-and-fuel subtotal. One ProfileAlternatives set crosses the two voltage levels with the two franchise fee locations, and each of its 4 alternatives carries that voltage level's fuel prices and that location's franchise fee. Dating: the sheet and its riders are effective \"With Bills Rendered for the Billing Month of June, 2026\" (MFF-11 for January 2025). ET-23 was filed with Schedule R-31 in the same compliance filing in docket 44280 (PSC document 227071), so this version begins 2026-06-01, the date Schedule R's bills show the new base rates took effect by calendar day.",
      "urpx:effectiveDateTime": "2026-06-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "gpc:et-2026-06-01-data-source-reference",

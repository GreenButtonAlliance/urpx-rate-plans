  "@type": "urpx:URPXPackage",
  "@id": "gpc:doc-pll-2026-06-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "gpc:pll",
    "urpx:name": "Schedule PLL Power and Light Large",
    "urpx:ratePlanUniqueIdentifier": "PLL",
    "urpx:initialEffectiveDate": "2026-06-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "gpc:pll-2026-06-01",
      "urpx:description": "Georgia Power's power and light large schedule, PLL-19, for customers with a demand of 500 kW or greater. A Basic Service Charge of $260.28 per month. Energy, including the demand charge, is priced in hours-use bands of the Billing Demand: kWh not greater than 200 hours times the Billing Demand at 19.2595 cents for the first 3,000 kWh, 17.4665 cents for the next 7,000 kWh, 14.8974 cents for the next 190,000 kWh and 11.4855 cents over 200,000 kWh; kWh in excess of 200 and not greater than 400 hours times the Billing Demand at 1.9780 cents; in excess of 400 and not greater than 600 hours at 1.4913 cents; and in excess of 600 hours at 1.1193 cents. Each band's kWh is a calculated MetricInput whose formula is stated in its CalculationMethod, as is the Billing Demand, a 30-minute demand with 95 percent summer and 60 percent winter ratchets over the current and preceding eleven months and a floor of 500 kW. Excess reactive demand, kVAR above one-third of the measured kW where the Company meters it, is billed at $0.43 per kVAR. The riders the sheet applies are carried as Prices here rather than as modifiers, because every customer on the schedule pays them: Fuel Cost Recovery FCR-27 per kWh, by voltage level (Secondary Distribution 3.8069 cents June through September and 3.8561 cents October through May, Primary Distribution 3.7387 and 3.7871 cents, Transmission 3.7126 and 3.7607 cents); Environmental Compliance Cost Recovery ECCR-15 (13.0205 percent) and Demand Side Management Commercial DSM-C-15 (1.2676 percent) of the base bill, each as one multiplier over the energy subtotal and one over each non-energy charge; and the Municipal Franchise Fee MFF-11, 3.0843 percent inside city limits or 1.1995 percent outside them (also for a city with which the Company has no franchise fee agreement), as multipliers over the energy-and-fuel subtotal and each non-energy charge. One ProfileAlternatives set crosses the three voltage levels with the two franchise fee locations, and each of its six alternatives carries that voltage level's fuel prices and that location's franchise fee. Dating: the sheet and its riders are effective \"With Bills Rendered for the Billing Month of June, 2026\" (MFF-11 for January 2025). PLL-19 was filed with Schedule R-31 in the same compliance filing in docket 44280 (PSC document 227071), so this version begins 2026-06-01, the date Schedule R's bills show the new base rates took effect by calendar day.",
      "urpx:effectiveDateTime": "2026-06-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "gpc:pll-2026-06-01-data-source-reference",
        "urpx:fileName": "pll.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.georgiapower.com/content/dam/georgia-power/pdfs/tariffs/pll.pdf",
        "urpx:dateRetrieved": "2026-10-16",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 3
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "gpc:pll-2026-06-01-er-eligibility",
          "urpx:name": "Eligibility for Schedule PLL Power and Light Large",
          "urpx:description": "Throughout the Company's service area from existing lines of adequate capacity. To all electric service of one standard voltage required on the customer's premises, delivered at one point and metered at or compensated to that voltage for any customer with a demand, as determined under the Special Applicability Provisions, of 500 kW or greater: the greater of 60 percent of the current or previous eleven months' winter or off-peak demands, or 95 percent of the current or previous eleven months' summer or on-peak demands. Customers with an expected total peak demand of 100 MW or greater at one or more premises located on one tract or contiguous tracts of land may only take service under this tariff if they contracted for such service prior to February 1, 2025. Single or three phase, 60 hertz, at a standard voltage.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "gpc:pll-2026-06-01-cx-eligibility",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "gpc:pll-2026-06-01-cn-eligibility",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:pll-2026-06-01-cn-eligibility-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:hasCustomerKind"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:pll-2026-06-01-cn-eligibility-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:nonResidentialKind"
                }
              }
            }
          }
        }
      ],
      "urpx:hasPlanElements": {
        "@type": "urpx:PlanElements",
        "@id": "gpc:pll-2026-06-01-plan-elements",
        "urpx:hasMetricInput": [
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:pll-2026-06-01-mi-energy",
            "urpx:name": "kWh Energy Consumption Prices",
            "urpx:metricInputType": {
              "@id": "urpx:measuredMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:pll-2026-06-01-ms-energy",
              "urpx:measurementKind": {
                "@id": "urpx:energy"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kWh"
              }
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:pll-2026-06-01-mi-meter-count",
            "urpx:name": "Per Meter Prices",
            "urpx:metricInputType": {
              "@id": "urpx:profileMetricInput"
            },
            "urpx:profileMetricProperty": {
              "@id": "urpx:meterCount"
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:pll-2026-06-01-mi-demand",
            "urpx:name": "kW Demand (30-minute)",
            "urpx:metricInputType": {
              "@id": "urpx:measuredMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:pll-2026-06-01-ms-demand",
              "urpx:measurementKind": {
                "@id": "urpx:demand"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kW"
              },
              "urpx:intervalDuration": "PT30M",
              "urpx:intervalType": {
                "@id": "urpx:thirtyMinuteInterval"
              }
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:pll-2026-06-01-mi-billing-demand",
            "urpx:name": "Billing Demand (kW)",
            "urpx:description": "Billing Demand, from the customer's highest 30-minute kW measurement during the current month and the preceding eleven months. For the billing months June through September, the greatest of (1) the current actual demand, (2) 95 percent of the highest actual demand in any previous applicable summer month (June-September), or (3) 60 percent of the highest actual demand in any previous applicable winter month (October-May). For the billing months October through May, the greater of (1) 95 percent of the highest summer month or (2) 60 percent of the highest winter month, including the current month. A customer changing from a time of use tariff has, for its first eleven months, a minimum Billing Demand of the greater of 95 percent of the average of the four summer months' highest On-Peak kW or 60 percent of the average of the eight winter months' highest Off-Peak kW. In no case less than the greatest of the contract minimum, 50 percent of the total contract capacity, or 500 kW.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:pll-2026-06-01-ms-billing-demand",
              "urpx:measurementKind": {
                "@id": "urpx:demand"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kW"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "gpc:pll-2026-06-01-mi-billing-demand-calculation-method",
              "urpx:calculationFormula": "June-September: max(D, 0.95 * max(prior summer D), 0.60 * max(prior winter D)); October-May: max(0.95 * max(summer D), 0.60 * max(winter D including current)); over the current and preceding eleven months; floor max(contract minimum, 0.50 * contract capacity, 500 kW)",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "gpc:pll-2026-06-01-mi-demand"
                }
              ]
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:pll-2026-06-01-mi-energy-first-200-hours",
            "urpx:name": "kWh not greater than 200 hours times the Billing Demand",
            "urpx:description": "The month's kWh not greater than 200 hours times the Billing Demand, priced in blocks of kWh.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:pll-2026-06-01-ms-energy-first-200-hours",
              "urpx:measurementKind": {
                "@id": "urpx:energy"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kWh"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "gpc:pll-2026-06-01-mi-energy-first-200-hours-calculation-method",
              "urpx:calculationFormula": "min(kWh, 200 * BillingDemand)",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "gpc:pll-2026-06-01-mi-energy"
                },
                {
                  "@id": "gpc:pll-2026-06-01-mi-billing-demand"
                }
              ]
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:pll-2026-06-01-mi-energy-200-to-400-hours",
            "urpx:name": "kWh in excess of 200 hours and not greater than 400 hours times the Billing Demand",
            "urpx:description": "The month's kWh in excess of 200 hours and not greater than 400 hours times the Billing Demand.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:pll-2026-06-01-ms-energy-200-to-400-hours",
              "urpx:measurementKind": {
                "@id": "urpx:energy"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kWh"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "gpc:pll-2026-06-01-mi-energy-200-to-400-hours-calculation-method",
              "urpx:calculationFormula": "min(max(kWh - 200 * BillingDemand, 0), 200 * BillingDemand)",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "gpc:pll-2026-06-01-mi-energy"
                },
                {
                  "@id": "gpc:pll-2026-06-01-mi-billing-demand"
                }
              ]
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:pll-2026-06-01-mi-energy-400-to-600-hours",
            "urpx:name": "kWh in excess of 400 hours and not greater than 600 hours times the Billing Demand",
            "urpx:description": "The month's kWh in excess of 400 hours and not greater than 600 hours times the Billing Demand.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:pll-2026-06-01-ms-energy-400-to-600-hours",
              "urpx:measurementKind": {
                "@id": "urpx:energy"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kWh"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "gpc:pll-2026-06-01-mi-energy-400-to-600-hours-calculation-method",
              "urpx:calculationFormula": "min(max(kWh - 400 * BillingDemand, 0), 200 * BillingDemand)",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "gpc:pll-2026-06-01-mi-energy"
                },
                {
                  "@id": "gpc:pll-2026-06-01-mi-billing-demand"
                }
              ]
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:pll-2026-06-01-mi-energy-over-600-hours",
            "urpx:name": "kWh in excess of 600 hours times the Billing Demand",
            "urpx:description": "The month's kWh in excess of 600 hours times the Billing Demand.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:pll-2026-06-01-ms-energy-over-600-hours",
              "urpx:measurementKind": {
                "@id": "urpx:energy"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kWh"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "gpc:pll-2026-06-01-mi-energy-over-600-hours-calculation-method",
              "urpx:calculationFormula": "max(kWh - 600 * BillingDemand, 0)",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "gpc:pll-2026-06-01-mi-energy"
                },
                {
                  "@id": "gpc:pll-2026-06-01-mi-billing-demand"
                }
              ]
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:pll-2026-06-01-mi-reactive-demand",
            "urpx:name": "kVAR Reactive Demand (30-minute)",
            "urpx:metricInputType": {
              "@id": "urpx:measuredMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:pll-2026-06-01-ms-reactive-demand",
              "urpx:measurementKind": {
                "@id": "urpx:reactivePower"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kVAr"
              },
              "urpx:intervalDuration": "PT30M",
              "urpx:intervalType": {
                "@id": "urpx:thirtyMinuteInterval"
              }
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:pll-2026-06-01-mi-excess-reactive-demand",
            "urpx:name": "Excess Reactive Demand (kVAR)",
            "urpx:description": "Excess Reactive Demand: the highest 30-minute kVAR measured during the month in excess of one-third of the measured actual kW in the current month. Measured only where there is an indication of a power factor of less than 95 percent lagging and the Company, at its option, installs metering equipment.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:pll-2026-06-01-ms-excess-reactive-demand",
              "urpx:measurementKind": {
                "@id": "urpx:reactivePower"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kVAr"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "gpc:pll-2026-06-01-mi-excess-reactive-demand-calculation-method",
              "urpx:calculationFormula": "max(max kVAR - max kW / 3, 0)",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "gpc:pll-2026-06-01-mi-reactive-demand"
                },
                {
                  "@id": "gpc:pll-2026-06-01-mi-demand"
                }
              ]
            }
          }
        ],
        "urpx:hasProfileAlternatives": {
          "@type": "urpx:ProfileAlternatives",
          "@id": "gpc:pll-2026-06-01-pa-voltage-level-franchise-fee-location",
          "urpx:name": "Fuel Cost Recovery voltage level and Municipal Franchise Fee location",
          "urpx:hasAlternativeDimensions": {
            "@type": "urpx:AlternativeDimensions",
            "@id": "gpc:pll-2026-06-01-pa-voltage-level-franchise-fee-location-alternative-dimensions",
            "urpx:hasAlternativeDimension": [
              {
                "@type": "urpx:AlternativeDimension",
                "@id": "gpc:pll-2026-06-01-ad-voltage-level",
                "urpx:dimensionProperty": "https://urpx.org/ns/ontology/voltageLevel",
                "urpx:dimensionDisplayName": "Service voltage level (FCR-27)",
                "urpx:hasPossibleValues": [
                  {
                    "@list": [
                      {
                        "@id": "urpx:secondaryVoltage"
                      },
                      {
                        "@id": "urpx:primaryVoltage"
                      },
                      {
                        "@id": "urpx:transmissionVoltage"
                      }
                    ]
                  }
                ]
              },
              {
                "@type": "urpx:AlternativeDimension",
                "@id": "gpc:pll-2026-06-01-ad-franchise-fee-location",
                "urpx:customDimensionProperty": "franchiseFeeLocation",
                "urpx:dimensionDisplayName": "Municipal Franchise Fee location",
                "urpx:hasPossibleValues": [
                  {
                    "@list": [
                      {
                        "@type": "xsd:string",
                        "@value": "Inside City Limits"
                      },
                      {
                        "@type": "xsd:string",
                        "@value": "Outside City Limits"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "urpx:hasProfileAlternative": [
            {
              "@type": "urpx:ProfileAlternative",
              "@id": "gpc:pll-2026-06-01-pa-secondary-inside-city-limits",
              "urpx:name": "Secondary Distribution customer, inside city limits",
              "urpx:hasConditionExpression": {
                "@type": "urpx:ConditionExpression",
                "@id": "gpc:pll-2026-06-01-cx-pa-secondary-inside-city-limits",
                "urpx:rootNode": {
                  "@type": "urpx:BooleanOperationNode",
                  "@id": "gpc:pll-2026-06-01-bn-pa-secondary-inside-city-limits",
                  "urpx:operator": {
                    "@id": "urpx:andOperator"
                  },
                  "urpx:operandNodes": [
                    {
                      "@type": "urpx:ComparisonNode",
                      "@id": "gpc:pll-2026-06-01-cn-pa-secondary-inside-city-limits-voltage-level",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:ObjectOperandNode",
                        "@id": "gpc:pll-2026-06-01-cn-pa-secondary-inside-city-limits-voltage-level-left-operand",
                        "urpx:conditionProperty": {
                          "@id": "urpx:voltageLevel"
                        }
                      },
                      "urpx:rightOperand": {
                        "@type": "urpx:ObjectOperandNode",
                        "@id": "gpc:pll-2026-06-01-cn-pa-secondary-inside-city-limits-voltage-level-right-operand",
                        "urpx:referencesValue": {
                          "@id": "urpx:secondaryVoltage"
                        }
                      }
                    },
                    {
                      "@type": "urpx:ComparisonNode",
                      "@id": "gpc:pll-2026-06-01-cn-pa-secondary-inside-city-limits-franchise-fee-location",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:CustomOperandNode",
                        "@id": "gpc:pll-2026-06-01-cn-pa-secondary-inside-city-limits-franchise-fee-location-left-operand",
                        "urpx:customConditionProperty": "franchiseFeeLocation"
                      },
                      "urpx:rightOperand": {
                        "@type": "urpx:CustomOperandNode",
                        "@id": "gpc:pll-2026-06-01-cn-pa-secondary-inside-city-limits-franchise-fee-location-right-operand",
                        "urpx:stringValue": "Inside City Limits"
                      }
                    }
                  ],
                  "urpx:logicExpression": "voltageLevel = secondaryVoltage AND franchiseFeeLocation = 'Inside City Limits'"
                }
              }
            },
            {
              "@type": "urpx:ProfileAlternative",
              "@id": "gpc:pll-2026-06-01-pa-secondary-outside-city-limits",
              "urpx:name": "Secondary Distribution customer, outside city limits",
              "urpx:hasConditionExpression": {
                "@type": "urpx:ConditionExpression",
                "@id": "gpc:pll-2026-06-01-cx-pa-secondary-outside-city-limits",
                "urpx:rootNode": {
                  "@type": "urpx:BooleanOperationNode",
                  "@id": "gpc:pll-2026-06-01-bn-pa-secondary-outside-city-limits",
                  "urpx:operator": {
                    "@id": "urpx:andOperator"
                  },
                  "urpx:operandNodes": [
                    {
                      "@type": "urpx:ComparisonNode",
                      "@id": "gpc:pll-2026-06-01-cn-pa-secondary-outside-city-limits-voltage-level",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:ObjectOperandNode",

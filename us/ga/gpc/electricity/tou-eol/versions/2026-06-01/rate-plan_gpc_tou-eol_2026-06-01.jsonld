        },
        "urpx:accessURL": "https://www.georgiapower.com/content/dam/georgia-power/pdfs/tariffs/tou-eol.pdf",
        "urpx:dateRetrieved": "2026-10-16",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 2
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "gpc:tou-eol-2026-06-01-er-eligibility",
          "urpx:name": "Eligibility for Schedule TOU-EOL Time of Use - Energy for Outdoor Lighting Service (Pilot)",
          "urpx:description": "Throughout the Company's service area from existing lines of adequate capacity. Applicable to all Company-owned outdoor lighting at a single premise with Company-owned Smart Lighting Control devices installed; for the pilot, all lighting services leased by a single governmental entity may be considered a single premise. The pilot is limited to a maximum of 100 customer accounts selected at the Company's discretion.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "gpc:tou-eol-2026-06-01-cx-eligibility",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "gpc:tou-eol-2026-06-01-cn-eligibility",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:tou-eol-2026-06-01-cn-eligibility-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:hasCustomerKind"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:tou-eol-2026-06-01-cn-eligibility-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:nonResidentialKind"
                }
              }
            }
          }
        }
      ],

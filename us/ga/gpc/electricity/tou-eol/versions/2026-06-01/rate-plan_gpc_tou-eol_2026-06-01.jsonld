  "@type": "urpx:URPXPackage",
  "@id": "gpc:doc-tou-eol-2026-06-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "gpc:tou-eol",
    "urpx:name": "Schedule TOU-EOL Time of Use - Energy for Outdoor Lighting Service (Pilot)",
    "urpx:ratePlanUniqueIdentifier": "TOU-EOL",
    "urpx:initialEffectiveDate": "2026-06-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "gpc:tou-eol-2026-06-01",
      "urpx:description": "Georgia Power's time of use energy schedule for Company-owned outdoor lighting with Smart Lighting Control devices, TOU-EOL-11, a pilot of up to 100 accounts. It prices the energy of the lighting, which the lighting rate schedules bill separately, at 13.8221 cents per On-Peak kWh, 12.6828 cents per Off-Peak kWh and 5.1723 cents per Super Off-Peak kWh. On-Peak is 2:00 p.m. to 7:00 p.m. Monday through Friday in the calendar months June through September, except on the days Independence Day and Labor Day are observed. Super Off-Peak is 11:00 p.m. to 7:00 a.m. every day of the year. Off-Peak is every other hour: 7:00 a.m. to 11:00 p.m. on weekends, holidays and in October through May, and 7:00 a.m. to 2:00 p.m. and 7:00 p.m. to 11:00 p.m. on weekdays in June through September. The sheet has no Basic Service Charge. The holiday calendar observes Independence Day on the nearest weekday, the federal rule of 5 U.S.C. 6103(b) that Georgia law adopts, since the sheet states none. The riders the sheet applies are carried as Prices here rather than as modifiers, because every customer on the schedule pays them: Fuel Cost Recovery FCR-27 per kWh, by voltage level (Secondary Distribution 3.8069 cents June through September and 3.8561 cents October through May, Primary Distribution 3.7387 and 3.7871 cents, Transmission 3.7126 and 3.7607 cents); Environmental Compliance Cost Recovery ECCR-15 (13.0205 percent) and Demand Side Management Commercial DSM-C-15 (1.2676 percent) of the base bill, each as one multiplier over the energy subtotal and one over each non-energy charge; and the Municipal Franchise Fee MFF-11, 3.0843 percent inside city limits or 1.1995 percent outside them (also for a city with which the Company has no franchise fee agreement), as multipliers over the energy-and-fuel subtotal and each non-energy charge. One ProfileAlternatives set crosses the three voltage levels with the two franchise fee locations, and each of its six alternatives carries that voltage level's fuel prices and that location's franchise fee. Dating: the sheet and its riders are effective \"With Bills Rendered for the Billing Month of June, 2026\" (MFF-11 for January 2025). TOU-EOL-11 was filed with Schedule R-31 in the same compliance filing in docket 44280 (PSC document 227071), so this version begins 2026-06-01, the date Schedule R's bills show the new base rates took effect by calendar day.",
      "urpx:effectiveDateTime": "2026-06-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "gpc:tou-eol-2026-06-01-data-source-reference",

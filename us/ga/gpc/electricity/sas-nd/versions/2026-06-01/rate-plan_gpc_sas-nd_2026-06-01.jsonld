                          "@id": "urpx:transmissionVoltage"
                        }
                      }
                    },
                    {
                      "@type": "urpx:ComparisonNode",
                      "@id": "gpc:sas-nd-2026-06-01-cn-pa-transmission-outside-city-limits-franchise-fee-location",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:CustomOperandNode",
                        "@id": "gpc:sas-nd-2026-06-01-cn-pa-transmission-outside-city-limits-franchise-fee-location-left-operand",

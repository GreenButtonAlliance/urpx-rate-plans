  "@type": "urpx:URPXPackage",
  "@id": "gpc:doc-sas-2026-06-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "gpc:sas",
    "urpx:name": "Schedule SAS Seasonal Agricultural Service",
    "urpx:ratePlanUniqueIdentifier": "SAS",
    "urpx:initialEffectiveDate": "2026-06-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "gpc:sas-2026-06-01",
      "urpx:description": "Georgia Power's seasonal agricultural service schedule, SAS-17, for agricultural customers using at least 80 percent of their annual kWh in six consecutive months, with an actual demand under 500 kW. A Basic Service Charge of $43.72 per month. Energy, including the demand charge, is priced in two hours-use bands of the Billing Demand, the highest 30-minute kW in the current month: kWh not greater than 200 hours times the Billing Demand at 17.1077 cents for the first 3,000 kWh, 15.6291 cents for the next 2,000 kWh and 1.7360 cents over 5,000 kWh; and kWh in excess of 200 hours times the Billing Demand at 1.7360 cents. Each band's kWh is a calculated MetricInput whose formula is stated in its CalculationMethod. Every On-Peak kWh also takes a surcharge of 25.3761 cents; On-Peak is 2:00 p.m. to 7:00 p.m. Monday through Friday in June through September, except on the days Memorial Day, Independence Day and Labor Day are observed, carried as a TOU schedule on the kWh. The holiday calendar observes Independence Day on the nearest weekday, the federal rule of 5 U.S.C. 6103(b) that Georgia law adopts, since the sheet states none. The riders the sheet applies are carried as Prices here rather than as modifiers, because every customer on the schedule pays them: Fuel Cost Recovery FCR-27 per kWh, by voltage level (Secondary Distribution 3.8069 cents June through September and 3.8561 cents October through May, Primary Distribution 3.7387 and 3.7871 cents, Transmission 3.7126 and 3.7607 cents); Environmental Compliance Cost Recovery ECCR-15 (13.0205 percent) and Demand Side Management Commercial DSM-C-15 (1.2676 percent) of the base bill, each as one multiplier over the energy subtotal and one over each non-energy charge; and the Municipal Franchise Fee MFF-11, 3.0843 percent inside city limits or 1.1995 percent outside them (also for a city with which the Company has no franchise fee agreement), as multipliers over the energy-and-fuel subtotal and each non-energy charge. One ProfileAlternatives set crosses the three voltage levels with the two franchise fee locations, and each of its six alternatives carries that voltage level's fuel prices and that location's franchise fee. Dating: the sheet and its riders are effective \"With Bills Rendered for the Billing Month of June, 2026\" (MFF-11 for January 2025). SAS-17 was filed with Schedule R-31 in the same compliance filing in docket 44280 (PSC document 227071), so this version begins 2026-06-01, the date Schedule R's bills show the new base rates took effect by calendar day.",
      "urpx:effectiveDateTime": "2026-06-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "gpc:sas-2026-06-01-data-source-reference",
        "urpx:fileName": "sas.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.georgiapower.com/content/dam/georgia-power/pdfs/tariffs/sas.pdf",
        "urpx:dateRetrieved": "2026-10-16",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 2
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "gpc:sas-2026-06-01-er-eligibility",
          "urpx:name": "Eligibility for Schedule SAS Seasonal Agricultural Service",
          "urpx:description": "Throughout the Company's service area from existing lines of adequate capacity. Applicable to agricultural production including storage, drying, curing, handling, grain mill and oil mill operations and other agricultural related applications where at least 80 percent of the annual kWh consumption occurs in any six consecutive month period, for any customer with an actual demand of less than 500 kW. The customer will be responsible to the Company for any additional cost of installing and removing any equipment required to control, meter or deliver this service. This electric service shall be delivered at one point, at one standard voltage and metered at or compensated to that voltage. Single or three phase, 60 hertz, at a standard voltage.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "gpc:sas-2026-06-01-cx-eligibility",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "gpc:sas-2026-06-01-cn-eligibility",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:sas-2026-06-01-cn-eligibility-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:hasCustomerKind"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:sas-2026-06-01-cn-eligibility-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:nonResidentialKind"
                }
              }
            }
          }
        }
      ],
      "urpx:hasPlanElements": {
        "@type": "urpx:PlanElements",
        "@id": "gpc:sas-2026-06-01-plan-elements",
        "urpx:hasSeasons": [
          {
            "@type": "urpx:Season",
            "@id": "gpc:sas-2026-06-01-season-summer",

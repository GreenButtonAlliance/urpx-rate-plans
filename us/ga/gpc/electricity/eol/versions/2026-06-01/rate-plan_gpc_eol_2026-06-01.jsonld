  "@type": "urpx:URPXPackage",
  "@id": "gpc:doc-eol-2026-06-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "gpc:eol",
    "urpx:name": "Schedule EOL Energy for Outdoor Lighting Service",
    "urpx:ratePlanUniqueIdentifier": "EOL",
    "urpx:initialEffectiveDate": "2026-06-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "gpc:eol-2026-06-01",
      "urpx:description": "Georgia Power's energy schedule for unmetered outdoor lighting, EOL-19, which prices the energy of Company-owned and customer-owned lighting. A monthly energy rate per fixture by nominal lamp wattage, for Photo Controlled fixtures (360 hours a month at 7.5150 cents per kWh) and Continuous Burning fixtures (720 hours a month at 8.6122 cents per kWh), from $0.90 for a 13 W photo controlled lamp to $102.23 for a 1,500 W continuous burning one; each of the 46 rates is a Price on a count of such fixtures. The riders the sheet applies are carried as Prices here rather than as modifiers, because every customer on the schedule pays them: Environmental Compliance Cost Recovery ECCR-15 (13.0205 percent) and Demand Side Management Commercial DSM-C-15 (1.2676 percent) of the base bill, each as a multiplier over every fixtures charge's Price; Fuel Cost Recovery FCR-27 per kWh of the fixtures' monthly kWh at the Secondary Distribution rates, 3.8069 cents June through September and 3.8561 cents October through May, the kWh a calculated MetricInput whose formula sums each fixture's count times its monthly kWh; and the Municipal Franchise Fee MFF-11, 3.0843 percent inside city limits or 1.1995 percent outside them (also for a city with which the Company has no franchise fee agreement), chosen by a ProfileAlternative, as a multiplier over every fixtures charge's Price and over the fuel subtotal. Dating: the sheet and its riders are effective \"With Bills Rendered for the Billing Month of June, 2026\" (MFF-11 for January 2025). EOL-19 was filed with Schedule R-31 in the same compliance filing in docket 44280 (PSC document 227071), so this version begins 2026-06-01, the date Schedule R's bills show the new base rates took effect by calendar day.",
      "urpx:effectiveDateTime": "2026-06-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "gpc:eol-2026-06-01-data-source-reference",
        "urpx:fileName": "eol.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.georgiapower.com/content/dam/georgia-power/pdfs/tariffs/eol.pdf",
        "urpx:dateRetrieved": "2026-10-16",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 3
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "gpc:eol-2026-06-01-er-eligibility",
          "urpx:name": "Eligibility for Schedule EOL Energy for Outdoor Lighting Service",
          "urpx:description": "Throughout the Company's service area from existing lines of adequate capacity. Applicable only to unmetered outdoor lighting with ballast or driver operated lamp fixtures (mercury vapor, high pressure sodium, metal halide, light emitting diode, induction, fluorescent, or any new technology lighting system approved by the Company) used to provide outdoor lighting, with poles which conform to Company specifications. Applicable to Company-owned and customer-owned systems. Service will be rendered only at locations that, solely in the opinion of the Company, are readily accessible for maintenance.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "gpc:eol-2026-06-01-cx-eligibility",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "gpc:eol-2026-06-01-cn-eligibility",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:eol-2026-06-01-cn-eligibility-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:endUse"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:eol-2026-06-01-cn-eligibility-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:lightingEndUse"
                }
              }
            }
          }
        }
      ],
      "urpx:hasPlanElements": {
        "@type": "urpx:PlanElements",
        "@id": "gpc:eol-2026-06-01-plan-elements",
        "urpx:hasMetricInput": [
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:eol-2026-06-01-mi-energy",
            "urpx:name": "kWh Energy Consumption Prices (the fixtures' monthly kWh)",
            "urpx:description": "The fixtures' monthly kWh: for each fixture, its Fixture Monthly kWh from EOL-19 Section A (photo controlled, 360 hours a month, or continuous burning, 720 hours a month, at the fixture input wattage), times the number of such fixtures.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:eol-2026-06-01-ms-energy",
              "urpx:measurementKind": {
                "@id": "urpx:energy"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kWh"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "gpc:eol-2026-06-01-mi-energy-calculation-method",
              "urpx:calculationFormula": "sum over fixtures of monthly kWh * count: 12 * N[13w-photo-controlled] + 23 * N[13w-continuous-burning] + 17 * N[26w-photo-controlled] + 34 * N[26w-continuous-burning] + 21 * N[35w-photo-controlled] + 41 * N[35w-continuous-burning] + 23 * N[50w-photo-controlled] + 45 * N[50w-continuous-burning] + 29 * N[55w-photo-controlled] + 58 * N[55w-continuous-burning] + 32 * N[70w-photo-controlled] + 63 * N[70w-continuous-burning] + 40 * N[75w-photo-controlled] + 79 * N[75w-continuous-burning] + 43 * N[85w-photo-controlled] + 86 * N[85w-continuous-burning] + 45 * N[100w-photo-controlled] + 91 * N[100w-continuous-burning] + 67 * N[150w-photo-controlled] + 134 * N[150w-continuous-burning] + 72 * N[165w-photo-controlled] + 143 * N[165w-continuous-burning] + 74 * N[175w-photo-controlled] + 148 * N[175w-continuous-burning] + 86 * N[200w-photo-controlled] + 172 * N[200w-continuous-burning] + 110 * N[250w-photo-controlled] + 220 * N[250w-continuous-burning] + 126 * N[310w-photo-controlled] + 253 * N[310w-continuous-burning] + 132 * N[320w-photo-controlled] + 265 * N[320w-continuous-burning] + 140 * N[350w-photo-controlled] + 280 * N[350w-continuous-burning] + 144 * N[360w-photo-controlled] + 288 * N[360w-continuous-burning] + 170 * N[400w-photo-controlled] + 341 * N[400w-continuous-burning] + 265 * N[700w-photo-controlled] + 530 * N[700w-continuous-burning] + 295 * N[750w-photo-controlled] + 590 * N[750w-continuous-burning] + 388 * N[1000w-photo-controlled] + 775 * N[1000w-continuous-burning] + 593 * N[1500w-photo-controlled] + 1187 * N[1500w-continuous-burning]",
              "urpx:calculatedBasedOn": [
                {

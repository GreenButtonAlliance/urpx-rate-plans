  "@type": "urpx:URPXPackage",
  "@id": "gpc:doc-gs-2026-06-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "gpc:gs",
    "urpx:name": "Schedule GS General Service",
    "urpx:ratePlanUniqueIdentifier": "GS",
    "urpx:initialEffectiveDate": "2026-06-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "gpc:gs-2026-06-01",
      "urpx:description": "Georgia Power's general service schedule, GS-18, for customers using less than 3,000 kWh a month with a maximum 30-minute demand under 30 kW. A Basic Service Charge of $36.00 per month, which includes the first 25 kWh; energy over 25 kWh at 14.1726 cents per kWh. The riders the sheet applies are carried as Prices here rather than as modifiers, because every customer on the schedule pays them: Fuel Cost Recovery FCR-27 per kWh, by voltage level (Secondary Distribution 3.8069 cents June through September and 3.8561 cents October through May, Primary Distribution 3.7387 and 3.7871 cents, Transmission 3.7126 and 3.7607 cents); Environmental Compliance Cost Recovery ECCR-15 (13.0205 percent) and Demand Side Management Commercial DSM-C-15 (1.2676 percent) of the base bill, each as one multiplier over the energy subtotal and one over each non-energy charge; and the Municipal Franchise Fee MFF-11, 3.0843 percent inside city limits or 1.1995 percent outside them (also for a city with which the Company has no franchise fee agreement), as multipliers over the energy-and-fuel subtotal and each non-energy charge. One ProfileAlternatives set crosses the three voltage levels with the two franchise fee locations, and each of its six alternatives carries that voltage level's fuel prices and that location's franchise fee. Dating: the sheet and its riders are effective \"With Bills Rendered for the Billing Month of June, 2026\" (MFF-11 for January 2025). GS-18 was filed with Schedule R-31 in the same compliance filing in docket 44280 (PSC document 227071), so this version begins 2026-06-01, the date Schedule R's bills show the new base rates took effect by calendar day.",
      "urpx:effectiveDateTime": "2026-06-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "gpc:gs-2026-06-01-data-source-reference",
        "urpx:fileName": "gs.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.georgiapower.com/content/dam/georgia-power/pdfs/tariffs/gs.pdf",
        "urpx:dateRetrieved": "2026-10-16",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 2
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "gpc:gs-2026-06-01-er-eligibility",
          "urpx:name": "Eligibility for Schedule GS General Service",
          "urpx:description": "Throughout the Company's service area from existing lines of adequate capacity. To all electric service of one standard voltage required by any customer receiving electric service at one point and metered at or compensated to that voltage who uses less than 3,000 kWh monthly and who would have a maximum 30-minute measured demand of less than 30 kW. Single or three phase, 60 hertz, at a standard voltage.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "gpc:gs-2026-06-01-cx-eligibility",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "gpc:gs-2026-06-01-cn-eligibility",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:gs-2026-06-01-cn-eligibility-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:hasCustomerKind"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:gs-2026-06-01-cn-eligibility-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:nonResidentialKind"
                }
              }
            }
          }
        }
      ],
      "urpx:hasPlanElements": {
        "@type": "urpx:PlanElements",
        "@id": "gpc:gs-2026-06-01-plan-elements",
        "urpx:hasMetricInput": [

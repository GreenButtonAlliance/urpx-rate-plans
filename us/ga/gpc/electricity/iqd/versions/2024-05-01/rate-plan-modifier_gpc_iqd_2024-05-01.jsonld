          "urpx:hasEligibilityRule": [
            {
              "@type": "urpx:EligibilityRule",
              "@id": "gpc:iqd-2024-05-01-er-eligible",
              "urpx:name": "IQD-certified residential customer",
              "urpx:description": "Residential customer the Company has certified for the Income Qualified Discount. APPLICABILITY: \"Qualifying customers certified by the Company will be eligible for a monthly bill discount up to the amounts listed below at their primary residence provided that the electric service account is individually metered and in said customer's name.\" \"Eligible customers must meet at least one of the following qualifications: (a) at least 65 years of age and live in a household with a combined income that is less than or equal to 200% of the federal poverty level, adjusted for household size; (b) receive Social Security Disability Income assistance or Supplemental Security Income; or (c) participate in the federal Housing Choice Voucher Program (HUD Section 8).\"",

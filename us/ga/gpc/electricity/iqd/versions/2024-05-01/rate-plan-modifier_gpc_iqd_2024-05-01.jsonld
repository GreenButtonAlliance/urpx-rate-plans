      "urpx:hasRatePlanModifier": {
        "@type": "urpx:RatePlanModifier",
        "@id": "gpc:iqd",
        "urpx:name": "Income Qualified Discount Service Rider",
        "urpx:modifierUniqueIdentifier": "IQD",
        "urpx:initialEffectiveDate": "2024-05-01",
        "urpx:timezoneIdentifier": "America/New_York",
        "urpx:hasRatePlanModifierVersion": {
          "@type": "urpx:RatePlanModifierVersion",
          "@id": "gpc:iqd-2024-05-01",
          "urpx:version": "2024-05-01",
          "urpx:modifierVersionNumber": "2024-05-01",
          "urpx:changeReason": {
            "@id": "urpx:initial"
          },
          "urpx:description": "Georgia Power's Income Qualified Discount service rider, IQD-1, a monthly bill discount for customers the Company certifies: a Non-fuel Discount of $24.00 and a Fuel Discount of $9.50, each \"up to the amounts listed\", at the customer's primary residence where the account is individually metered and in the customer's name. \"Monthly credits shall not result in a negative balance, nor shall any unused credits be carried over to future billing.\" Eligible customers are at least 65 years of age in a household with combined income at or below 200 percent of the federal poverty level adjusted for household size, or receive Social Security Disability Income or Supplemental Security Income, or participate in the federal Housing Choice Voucher Program (HUD Section 8). The sheet makes it available on Schedules R, FLAT, TOU-REO, TOU-OA, TOU-RD, PPS and PBD; of those this corpus holds Schedules R, TOU-REO, TOU-OA and TOU-RD, which urpx:applicableToRatePlan names. Each discount is carried as a flat monthly credit of its full amount. Dating: the sheet, page 10.35, Original, is effective \"With Bills Rendered for the Billing Month of May, 2024\", so this version begins 2024-05-01, and as the original sheet it is also the rider's first introduction.",
          "urpx:effectiveDateTime": "2024-05-01T00:00:00",
          "urpx:priceCurrency": "USD",
          "urpx:commodity": {
            "@id": "urpx:electricity"
          },

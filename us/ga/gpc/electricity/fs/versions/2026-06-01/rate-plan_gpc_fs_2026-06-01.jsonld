                        "@id": "gpc:fs-2026-06-01-cn-pa-transmission-inside-city-limits-franchise-fee-location-right-operand",
                        "urpx:stringValue": "Inside City Limits"
                      }
                    }
                  ],
                  "urpx:logicExpression": "voltageLevel = transmissionVoltage AND franchiseFeeLocation = 'Inside City Limits'"
                }
              }
            },
            {
              "@type": "urpx:ProfileAlternative",
              "@id": "gpc:fs-2026-06-01-pa-transmission-outside-city-limits",
              "urpx:name": "Transmission customer, outside city limits",
              "urpx:hasConditionExpression": {
                "@type": "urpx:ConditionExpression",
                "@id": "gpc:fs-2026-06-01-cx-pa-transmission-outside-city-limits",
                "urpx:rootNode": {
                  "@type": "urpx:BooleanOperationNode",
                  "@id": "gpc:fs-2026-06-01-bn-pa-transmission-outside-city-limits",
                  "urpx:operator": {
                    "@id": "urpx:andOperator"
                  },
                  "urpx:operandNodes": [
                    {
                      "@type": "urpx:ComparisonNode",
                      "@id": "gpc:fs-2026-06-01-cn-pa-transmission-outside-city-limits-voltage-level",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:ObjectOperandNode",
                        "@id": "gpc:fs-2026-06-01-cn-pa-transmission-outside-city-limits-voltage-level-left-operand",
                        "urpx:conditionProperty": {
                          "@id": "urpx:voltageLevel"
                        }
                      },
                      "urpx:rightOperand": {
                        "@type": "urpx:ObjectOperandNode",
                        "@id": "gpc:fs-2026-06-01-cn-pa-transmission-outside-city-limits-voltage-level-right-operand",
                        "urpx:referencesValue": {
                          "@id": "urpx:transmissionVoltage"
                        }
                      }
                    },
                    {
                      "@type": "urpx:ComparisonNode",
                      "@id": "gpc:fs-2026-06-01-cn-pa-transmission-outside-city-limits-franchise-fee-location",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:CustomOperandNode",
                        "@id": "gpc:fs-2026-06-01-cn-pa-transmission-outside-city-limits-franchise-fee-location-left-operand",
                        "urpx:customConditionProperty": "franchiseFeeLocation"
                      },
                      "urpx:rightOperand": {
                        "@type": "urpx:CustomOperandNode",
                        "@id": "gpc:fs-2026-06-01-cn-pa-transmission-outside-city-limits-franchise-fee-location-right-operand",
                        "urpx:stringValue": "Outside City Limits"
                      }
                    }
                  ],
                  "urpx:logicExpression": "voltageLevel = transmissionVoltage AND franchiseFeeLocation = 'Outside City Limits'"
                }
              }
            }
          ]

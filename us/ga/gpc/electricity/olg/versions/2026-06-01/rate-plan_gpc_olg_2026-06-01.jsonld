      "urpx:offeredBy": {
        "@type": "urpx:UtilityOperator",
        "@id": "org:utility-gpc",
        "urpx:legalName": "Georgia Power Company",
        "urpx:organizationType": {
          "@id": "urpx:utilityOrganization"
        },
        "urpx:hasIdentity": {
          "@id": "org:utility-gpc-identity",
          "@type": "urpx:OrganizationIdentity",
          "urpx:hasName": {
            "@id": "org:utility-gpc-name",
            "@type": "urpx:OrganizationName",
            "urpx:name": "Georgia Power Company"
          },
          "urpx:hasIdentifier": {
            "@id": "org:utility-gpc-eia",
            "@type": "urpx:OrganizationIdentifier",
            "urpx:scheme": {
              "@id": "urpx:eiaScheme"
            },
            "skos:notation": "7140"
          }
        }
      },
      "urpx:forRatePlan": {
        "@id": "gpc:olg"
      },
      "urpx:hasCoverageClaim": {
        "@id": "gpc:cc-olg-2026-06-01",
        "@type": "urpx:CoverageClaim",
        "urpx:completenessResult": {
          "@id": "urpx:partial"
        },
        "urpx:selfContained": true,
        "urpx:explainedBy": {
          "@type": "urpx:Evaluation",
          "@id": "gpc:cc-olg-2026-06-01-evaluation",
          "urpx:evaluationKind": {
            "@id": "urpx:coverageEvaluation"
          },
          "urpx:description": "This filing does not carry everything its source document states. 7 parts are deferred, listed here in the same words as the filing's tariff.toml [modeling].deferrals so the two records cannot drift. (1) Lights counts. Each light charge is priced per light of one kind. URPX v0.5.1 names no profile property for a count of lights of a kind, so each light's MetricInput is a urpx:profileMetricInput that names no urpx:profileMetricProperty and states the kind in its name, in the pattern of Jackson EMC's Schedule S-26; a consumer supplies the counts. (2) Fuel seasons by billing month. FCR-27 prices June through September and October through May, which Schedule R's bills show is read by the billing month a bill is rendered in. The JSON-LD gates the fuel PriceDefinitions on calendar months, so usage in the weeks a billing period runs ahead of its billing month takes the other season's fuel price. (3) Fuel Cost Recovery voltage levels. FCR-27 also prices Primary Distribution and Transmission customers. Only the Secondary Distribution rates are carried, as Prices with no condition, so they apply to every customer on the schedule. (4) Municipal Franchise Fee base. MFF-11 applies to the total revenues of each bill, which include the ECCR-15 and DSM-C-15 amounts. Its multiplier Prices here are based on each light charge's Price and on the fuel subtotal, not on the ECCR and DSM-C multiplier Prices, so the franchise fee on those two amounts, about 0.44 percent of the base bill inside city limits, is not carried. (5) Fixture kWh. FCR-27 is carried per kWh on a calculated MetricInput that sums each light's count times the Photo Controlled Fixture Monthly kWh EOL-19 gives for its nominal lamp wattage, its formula text in its CalculationMethod. OLG-16 says the energy component of each rate is calculated on EOL-19 but does not state each light's kWh or burn hours, so reading the photo controlled column is an assumption, and a light billed on other hours has its fuel off by the difference. (6) Pole and construction charges. Section B prices standard poles from $418.16 to $1,936.93 as a non-refundable Contribution In Aid of Construction paid before construction; a customer may pay $50.00 for each luminaire removed when the Company replaces a Company-owned system, $2.49 per foot of excess underground trench over 80 feet per pole, a CIAC for taller poles or relocation, and a CIAC for spending above five times the estimated annual base revenue, and may reimburse maintenance from vandalism; tree trimming is the customer's. None is a monthly charge and none is carried. (7) Customer-owned systems and Term of Contract. Part II bills customer-owned systems on EOL-19, which has its own filing. The term is at least five years and thereafter until terminated on 30 days' written notice, and may require an advance payment of up to half the estimated annual revenue. Neither is priced here and neither is carried.",
          "urpx:evaluatedOn": "2026-10-19T00:00:00"
        }
      }
    }
  }
}

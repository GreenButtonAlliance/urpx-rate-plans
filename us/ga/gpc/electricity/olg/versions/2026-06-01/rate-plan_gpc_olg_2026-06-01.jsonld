  "@type": "urpx:URPXPackage",
  "@id": "gpc:doc-olg-2026-06-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "gpc:olg",
    "urpx:name": "Schedule OLG Outdoor Lighting Service Governmental Customers",
    "urpx:ratePlanUniqueIdentifier": "OLG",
    "urpx:initialEffectiveDate": "2026-06-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "gpc:olg-2026-06-01",
      "urpx:description": "Georgia Power's outdoor lighting schedule for governmental customers, OLG-16, closed to new installations after December 31, 2019. A monthly rate per Company-owned and maintained light by lamp type, wattage and fixture, from $9.73 for a 70 W high pressure sodium cobrahead to $57.14 for a 1,000 W metal halide directional flood; each of the 30 rates is a Price on a count of such lights, and the rates include energy. Customer-owned systems are billed on EOL-19. The riders the sheet applies are carried as Prices here rather than as modifiers, because every customer on the schedule pays them: Environmental Compliance Cost Recovery ECCR-15 (13.0205 percent) and Demand Side Management Commercial DSM-C-15 (1.2676 percent) of the base bill, each as a multiplier over every lights charge's Price; Fuel Cost Recovery FCR-27 per kWh of the lights' monthly kWh at the Secondary Distribution rates, 3.8069 cents June through September and 3.8561 cents October through May, the kWh a calculated MetricInput whose formula sums each light's count times its monthly kWh; and the Municipal Franchise Fee MFF-11, 3.0843 percent inside city limits or 1.1995 percent outside them (also for a city with which the Company has no franchise fee agreement), chosen by a ProfileAlternative, as a multiplier over every lights charge's Price and over the fuel subtotal. Dating: the sheet and its riders are effective \"With Bills Rendered for the Billing Month of June, 2026\" (MFF-11 for January 2025). OLG-16 was filed with Schedule R-31 in the same compliance filing in docket 44280 (PSC document 227071), so this version begins 2026-06-01, the date Schedule R's bills show the new base rates took effect by calendar day.",
      "urpx:effectiveDateTime": "2026-06-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "gpc:olg-2026-06-01-data-source-reference",
        "urpx:fileName": "olg.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.georgiapower.com/content/dam/georgia-power/pdfs/tariffs/olg.pdf",
        "urpx:dateRetrieved": "2026-10-16",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 5
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "gpc:olg-2026-06-01-er-eligibility",
          "urpx:name": "Eligibility for Schedule OLG Outdoor Lighting Service Governmental Customers",
          "urpx:description": "Throughout the Company's service area from existing lines of adequate capacity. Outdoor lighting service for only Federal, State or a local government or any of their agencies. Applicable only to outdoor lighting ballast-operated vapor lamp fixtures, either mercury vapor (MV), high pressure sodium (HPS) or metal halide (MH), and poles conforming to Company specifications, at locations that, solely in the opinion of the Company, are readily accessible for maintenance. After December 31, 2019, the OLG tariff is not available for new installations; existing fixture replacement is at the Company's discretion based on availability.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "gpc:olg-2026-06-01-cx-eligibility",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "gpc:olg-2026-06-01-cn-eligibility",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:olg-2026-06-01-cn-eligibility-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:endUse"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:olg-2026-06-01-cn-eligibility-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:lightingEndUse"
                }
              }
            }
          }
        }
      ],
      "urpx:hasPlanElements": {
        "@type": "urpx:PlanElements",
        "@id": "gpc:olg-2026-06-01-plan-elements",
        "urpx:hasMetricInput": [
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:olg-2026-06-01-mi-energy",
            "urpx:name": "kWh Energy Consumption Prices (the fixtures' monthly kWh)",
            "urpx:description": "The lights' monthly kWh: for each light, the Photo Controlled Fixture Monthly kWh EOL-19 Section A gives for its nominal lamp wattage, since the energy component of each OLG-16 rate is calculated on EOL-19, times the number of such lights.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:olg-2026-06-01-ms-energy",
              "urpx:measurementKind": {
                "@id": "urpx:energy"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kWh"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "gpc:olg-2026-06-01-mi-energy-calculation-method",
              "urpx:calculationFormula": "sum over fixtures of monthly kWh * count: 32 * N[hps-70w-cobrahead] + 45 * N[hps-100w-cobrahead] + 67 * N[hps-150w-cobrahead] + 110 * N[hps-250w-cobrahead] + 170 * N[hps-400w-cobrahead] + 67 * N[hps-150w-directional-flood] + 170 * N[hps-400w-directional-flood] + 45 * N[hps-100w-post-top] + 67 * N[hps-150w-post-top] + 67 * N[hps-150w-wall-pack] + 140 * N[mh-350w-directional-flood] + 388 * N[mh-1000w-directional-flood] + 74 * N[mv-175w-cobrahead-open-bottom] + 170 * N[mv-400w-cobrahead] + 388 * N[mv-1000w-cobrahead] + 45 * N[mv-100w-post-top] + 74 * N[mv-175w-post-top] + 110 * N[mv-250w-wall-pack] + 45 * N[hps-100w-bronze-cobrahead] + 67 * N[hps-150w-bronze-cobrahead] + 110 * N[hps-250w-bronze-cobrahead] + 67 * N[mh-150w-cobrahead] + 67 * N[mh-150w-post-top] + 67 * N[mh-150w-directional-flood] + 67 * N[mh-150w-shoebox] + 74 * N[mh-175w-cobrahead] + 74 * N[mh-175w-post-top] + 74 * N[mh-175w-directional-flood] + 74 * N[mh-175w-shoebox] + 170 * N[mh-400w-directional-flood]",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "gpc:olg-2026-06-01-mi-hps-70w-cobrahead"
                },
                {
                  "@id": "gpc:olg-2026-06-01-mi-hps-100w-cobrahead"

      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "gpc:lt-1975-06-17-er-eligibility",
          "urpx:name": "Eligibility for Schedule LT Local Tax Adjustment",
          "urpx:description": "Applicable as a modification of each filed rate of the Company, to the customers within a political subdivision of the state or taxing district that collects or receives from the Company a payment for the use of its streets, alleys or public places, or for any license, privilege, inspection, franchise tax, fee, charge or other imposition, except ad valorem taxes, license taxes on the sales of appliances, special benefit assessments, and franchise payments the sheet's provisos (a) to (c) exclude.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "gpc:lt-1975-06-17-cx-eligibility",

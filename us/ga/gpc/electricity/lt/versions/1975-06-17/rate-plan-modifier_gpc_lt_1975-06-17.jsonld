  "urpx:hasRatePlanModifier": {
    "@type": "urpx:RatePlanModifier",
    "@id": "gpc:lt",
    "urpx:name": "Schedule LT Local Tax Adjustment",
    "urpx:modifierUniqueIdentifier": "LT",
    "urpx:initialEffectiveDate": "1975-06-17",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "gpc:lt-1975-06-17",
      "urpx:version": "1975-06-17",
      "urpx:modifierVersionNumber": "1975-06-17",
      "urpx:changeReason": {
        "@id": "urpx:changeReasonOther"
      },
      "urpx:description": "Georgia Power's local tax adjustment, LT-1, a modification of each of the Company's filed rates. Where a political subdivision of the state or a taxing district collects or receives from the Company any payment, in money, service or other thing of value, for the use of its streets, alleys or public places, or for any license, privilege, inspection, franchise tax, fee, charge or other imposition, the aggregate of those payments is billed, insofar as practicable, pro rata to the customers within it, allocated by the revenue the Company derives from each. It does not apply to ad valorem taxes, license taxes on the sales of appliances, or special benefit assessments such as sidewalks and street paving; nor to a political subdivision's sums under (a) a franchise that remains in effect unchanged, (b) a franchise coming into existence after June 17, 1975, up to 4 percent of residential and commercial sales of electricity annually, or (c) such a franchise of at least thirty-five years' term, up to 4 percent of residential, commercial and industrial sales. No amount is published, so the JSON-LD defines the adjustment as a monthly PriceDefinition with no Price. urpx:applicableToRatePlan names every Georgia Power schedule in this corpus. Dating: the sheet, page 10.70, Sixth revision, is effective \"With Service Rendered on or After June 17, 1975\", so this version begins 1975-06-17.",
      "urpx:effectiveDateTime": "1975-06-17T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },

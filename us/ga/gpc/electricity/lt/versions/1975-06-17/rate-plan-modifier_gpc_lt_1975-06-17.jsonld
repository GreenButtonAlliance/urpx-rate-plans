      "urpx:forRatePlanModifier": {
        "@id": "gpc:lt"
      },
      "urpx:hasCoverageClaim": {
        "@id": "gpc:cc-lt-1975-06-17",
        "@type": "urpx:CoverageClaim",
        "urpx:completenessResult": {
          "@id": "urpx:partial"
        },
        "urpx:selfContained": true,
        "urpx:explainedBy": {
          "@type": "urpx:Evaluation",
          "@id": "gpc:cc-lt-1975-06-17-evaluation",
          "urpx:evaluationKind": {
            "@id": "urpx:coverageEvaluation"
          },
          "urpx:description": "This filing does not carry everything its source document states. 2 parts are deferred, listed here in the same words as the filing's tariff.toml [modeling].deferrals so the two records cannot drift. (1) Pass-through amount. The adjustment is the customer's revenue-weighted share of the payments its political subdivision or taxing district collects from the Company, which the Company does not publish. The JSON-LD defines it as a monthly PriceDefinition with no Price, so a modeled bill omits it. (2) Jurisdiction. Whether a customer is within a subdivision whose payments LT-1 passes through is a custom condition, localTaxJurisdiction, that a consumer supplies; the sheet's exclusions of ad valorem taxes, appliance sales license taxes, special benefit assessments and franchise payments under provisos (a) to (c) are stated in the description.",
          "urpx:evaluatedOn": "2026-10-19T00:00:00"
        }
      }
    }

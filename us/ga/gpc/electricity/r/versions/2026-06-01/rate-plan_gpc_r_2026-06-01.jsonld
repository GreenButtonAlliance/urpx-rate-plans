  "@id": "gpc:doc-r-2026-06-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "gpc:r",
    "urpx:name": "Schedule R Residential Service",
    "urpx:ratePlanUniqueIdentifier": "R",
    "urpx:initialEffectiveDate": "2026-06-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "gpc:r-2026-06-01",
      "urpx:description": "Georgia Power's standard residential schedule, R-31, with the riders every Schedule R customer pays. A Basic Service Charge of $0.4603 per day in both seasons. Winter (Billing Months October through May) prices all kWh at 8.2116 cents; summer (Billing Months June through September) prices the first 650 kWh at 8.7738 cents, the next 350 kWh at 14.5738 cents and kWh over 1000 at 15.0828 cents. The winter rate is carried at all three tiers so one tier ladder serves both seasons. The riders the sheet applies are carried as Prices here rather than as modifiers, because every customer on the schedule pays them: Fuel Cost Recovery FCR-27 per kWh (Secondary Distribution, 3.8069 cents June through September and 3.8561 cents October through May); Environmental Compliance Cost Recovery ECCR-15 (13.0205 percent) and Demand Side Management Residential DSM-R-16 (1.1969 percent) of the base bill, each as one multiplier over the energy subtotal and one over the Basic Service Charge Price; and the Municipal Franchise Fee MFF-11, 3.0843 percent inside city limits or 1.1995 percent outside them (also for a city with which the Company has no franchise fee agreement), chosen by a ProfileAlternative, as multipliers over the energy-and-fuel subtotal and over the Basic Service Charge Price. The Income Qualified Discount is a separate rider for certified customers and is not carried here. Dating: each sheet is effective \"With Bills Rendered for the Billing Month of June, 2026\" (MFF-11 for January 2025). The new base rates, ECCR-15 and DSM-R-16 took effect on June 1, 2026 by calendar day: Georgia Power prorated the June billing month at June 1 and billed usage from June 1 until the sheets were implemented as R-30 plus a 1.6554 percent Temporary Base Rate Adjustment Rider (docket 44280, PSC document 226753), which prices energy 0.22 percent below R-31 and the Basic Service Charge 1.66 percent above it, so this version begins 2026-06-01. FCR-27 replaced FCR-26 from the June billing month, without proration.",
      "urpx:effectiveDateTime": "2026-06-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": true,

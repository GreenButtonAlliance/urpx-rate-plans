  "@type": "urpx:URPXPackage",
  "@id": "gpc:doc-slm-2026-06-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "gpc:slm",
    "urpx:name": "Schedule SLM School Load Management",
    "urpx:ratePlanUniqueIdentifier": "SLM",
    "urpx:initialEffectiveDate": "2026-06-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "gpc:slm-2026-06-01",
      "urpx:description": "Georgia Power's school load management schedule, SLM-22, for schools in buildings first connected on or after January 1, 1986 or reconstructed. A Basic Service Charge of $119.97 per month. Energy, including the demand charge, is priced in hours-use bands of the Billing Demand: kWh not greater than 150 hours times the Billing Demand at 21.9601 cents for the first 3,000 kWh, 19.4084 cents for the next 7,000 kWh and 11.5486 cents over 10,000 kWh; kWh in excess of 150 and not greater than 300 hours times the Billing Demand at 1.9858 cents; in excess of 300 and not greater than 500 hours at 1.1377 cents; and in excess of 500 hours at 0.9241 cents. Each band's kWh is a calculated MetricInput whose formula is stated in its CalculationMethod, as is the Billing Demand, which weighs the 30-minute demands in the summer Full-Load, Load-Management and Off-Peak periods, with floors of 50 kW in summer and 150 kW in winter. Excess reactive demand, kVAR above one-third of the measured kW where the Company meters it, is billed at $0.43 per kVAR. The riders the sheet applies are carried as Prices here rather than as modifiers, because every customer on the schedule pays them: Fuel Cost Recovery FCR-27 per kWh, by voltage level (Secondary Distribution 3.8069 cents June through September and 3.8561 cents October through May, Primary Distribution 3.7387 and 3.7871 cents, Transmission 3.7126 and 3.7607 cents); Environmental Compliance Cost Recovery ECCR-15 (13.0205 percent) and Demand Side Management Commercial DSM-C-15 (1.2676 percent) of the base bill, each as one multiplier over the energy subtotal and one over each non-energy charge; and the Municipal Franchise Fee MFF-11, 3.0843 percent inside city limits or 1.1995 percent outside them (also for a city with which the Company has no franchise fee agreement), as multipliers over the energy-and-fuel subtotal and each non-energy charge. One ProfileAlternatives set crosses the three voltage levels with the two franchise fee locations, and each of its six alternatives carries that voltage level's fuel prices and that location's franchise fee. Dating: the sheet and its riders are effective \"With Bills Rendered for the Billing Month of June, 2026\" (MFF-11 for January 2025). SLM-22 was filed with Schedule R-31 in the same compliance filing in docket 44280 (PSC document 227071), so this version begins 2026-06-01, the date Schedule R's bills show the new base rates took effect by calendar day.",
      "urpx:effectiveDateTime": "2026-06-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "gpc:slm-2026-06-01-data-source-reference",
        "urpx:fileName": "slm.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.georgiapower.com/content/dam/georgia-power/pdfs/tariffs/slm.pdf",
        "urpx:dateRetrieved": "2026-10-16",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 3
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "gpc:slm-2026-06-01-er-eligibility",
          "urpx:name": "Eligibility for Schedule SLM School Load Management",
          "urpx:description": "Throughout the Company's service area from existing lines of adequate capacity. For load management purposes, to all full use electric service to public or private academic institutions where regular elementary, middle, high school or college courses are conducted, provided that this service is supplied at a single delivery point through a single meter. Available only at newly constructed buildings with an initial connection date on or after January 1, 1986, or at reconstructed buildings, as the Georgia Public Service Commission determines after a public hearing. Single or three phase, 60 hertz, at a standard voltage.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "gpc:slm-2026-06-01-cx-eligibility",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "gpc:slm-2026-06-01-cn-eligibility",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:slm-2026-06-01-cn-eligibility-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:hasCustomerKind"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:slm-2026-06-01-cn-eligibility-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:nonResidentialKind"
                }
              }
            }
          }
        }
      ],
      "urpx:hasPlanElements": {
        "@type": "urpx:PlanElements",
        "@id": "gpc:slm-2026-06-01-plan-elements",
        "urpx:hasMetricInput": [
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:slm-2026-06-01-mi-energy",
            "urpx:name": "kWh Energy Consumption Prices",
            "urpx:metricInputType": {
              "@id": "urpx:measuredMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:slm-2026-06-01-ms-energy",
              "urpx:measurementKind": {
                "@id": "urpx:energy"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kWh"
              }
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:slm-2026-06-01-mi-meter-count",
            "urpx:name": "Per Meter Prices",
            "urpx:metricInputType": {
              "@id": "urpx:profileMetricInput"
            },
            "urpx:profileMetricProperty": {
              "@id": "urpx:meterCount"
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:slm-2026-06-01-mi-demand",
            "urpx:name": "kW Demand (30-minute)",
            "urpx:metricInputType": {
              "@id": "urpx:measuredMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:slm-2026-06-01-ms-demand",
              "urpx:measurementKind": {
                "@id": "urpx:demand"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kW"
              },
              "urpx:intervalDuration": "PT30M",
              "urpx:intervalType": {
                "@id": "urpx:thirtyMinuteInterval"
              }
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:slm-2026-06-01-mi-billing-demand",
            "urpx:name": "Billing Demand (kW)",
            "urpx:description": "Billing Demand, from the customer's highest 30-minute kW measurements in the Full-Load, Load-Management and Off-Peak periods during the current month and the preceding eleven months. Full-Load is 7 a.m. to 3 p.m. and Load-Management 3 p.m. to 10 p.m., Monday through Friday in the billing months June through September; Off-Peak is all other hours, all of October through May, all weekends and the observed Memorial Day, Independence Day and Labor Day. For the billing months June through September, the greatest of (1) 100 percent of the current month's Load-Management Demand, (2) 70 percent of the current month's Full-Load Demand, or (3) 40 percent of the current month's Off-Peak Demand. For the billing months October through May, the greatest of (1) 40 percent of the Off-Peak Demand in the current or preceding eleven months, (2) 70 percent of the Full-Load Demand in the previous summer billing months, or (3) 70 percent of the Load-Management Demand in the previous summer billing months. A customer changing from a time of use tariff has, for October through May of its first eleven months, a minimum Billing Demand of the greater of 70 percent of the average of the four summer months' highest On-Peak kW or 40 percent of the average of the previous winter months' highest Off-Peak kW. In no case less than 150 kW for October through May or 50 kW for June through September.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:slm-2026-06-01-ms-billing-demand",
              "urpx:measurementKind": {
                "@id": "urpx:demand"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kW"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "gpc:slm-2026-06-01-mi-billing-demand-calculation-method",
              "urpx:calculationFormula": "June-September: max(DLM, 0.70 * DFL, 0.40 * DOP, 50 kW) for the current month; October-May: max(0.40 * max(DOP, current and preceding eleven months), 0.70 * max(prior summer DFL), 0.70 * max(prior summer DLM), 150 kW); DFL, DLM, DOP the 30-minute kW in the Full-Load, Load-Management and Off-Peak periods",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "gpc:slm-2026-06-01-mi-demand"
                }
              ]
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:slm-2026-06-01-mi-energy-first-150-hours",
            "urpx:name": "kWh not greater than 150 hours times the Billing Demand",
            "urpx:description": "The month's kWh not greater than 150 hours times the Billing Demand, priced in blocks of kWh.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:slm-2026-06-01-ms-energy-first-150-hours",
              "urpx:measurementKind": {
                "@id": "urpx:energy"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kWh"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "gpc:slm-2026-06-01-mi-energy-first-150-hours-calculation-method",
              "urpx:calculationFormula": "min(kWh, 150 * BillingDemand)",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "gpc:slm-2026-06-01-mi-energy"
                },
                {
                  "@id": "gpc:slm-2026-06-01-mi-billing-demand"
                }
              ]
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:slm-2026-06-01-mi-energy-150-to-300-hours",
            "urpx:name": "kWh in excess of 150 hours and not greater than 300 hours times the Billing Demand",
            "urpx:description": "The month's kWh in excess of 150 hours and not greater than 300 hours times the Billing Demand.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:slm-2026-06-01-ms-energy-150-to-300-hours",
              "urpx:measurementKind": {
                "@id": "urpx:energy"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kWh"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "gpc:slm-2026-06-01-mi-energy-150-to-300-hours-calculation-method",
              "urpx:calculationFormula": "min(max(kWh - 150 * BillingDemand, 0), 150 * BillingDemand)",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "gpc:slm-2026-06-01-mi-energy"
                },
                {
                  "@id": "gpc:slm-2026-06-01-mi-billing-demand"
                }
              ]
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:slm-2026-06-01-mi-energy-300-to-500-hours",
            "urpx:name": "kWh in excess of 300 hours and not greater than 500 hours times the Billing Demand",
            "urpx:description": "The month's kWh in excess of 300 hours and not greater than 500 hours times the Billing Demand.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:slm-2026-06-01-ms-energy-300-to-500-hours",
              "urpx:measurementKind": {
                "@id": "urpx:energy"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kWh"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "gpc:slm-2026-06-01-mi-energy-300-to-500-hours-calculation-method",
              "urpx:calculationFormula": "min(max(kWh - 300 * BillingDemand, 0), 200 * BillingDemand)",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "gpc:slm-2026-06-01-mi-energy"
                },
                {
                  "@id": "gpc:slm-2026-06-01-mi-billing-demand"
                }
              ]
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:slm-2026-06-01-mi-energy-over-500-hours",
            "urpx:name": "kWh in excess of 500 hours times the Billing Demand",
            "urpx:description": "The month's kWh in excess of 500 hours times the Billing Demand.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:slm-2026-06-01-ms-energy-over-500-hours",
              "urpx:measurementKind": {
                "@id": "urpx:energy"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kWh"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "gpc:slm-2026-06-01-mi-energy-over-500-hours-calculation-method",
              "urpx:calculationFormula": "max(kWh - 500 * BillingDemand, 0)",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "gpc:slm-2026-06-01-mi-energy"
                },
                {
                  "@id": "gpc:slm-2026-06-01-mi-billing-demand"
                }
              ]
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:slm-2026-06-01-mi-reactive-demand",
            "urpx:name": "kVAR Reactive Demand (30-minute)",
            "urpx:metricInputType": {
              "@id": "urpx:measuredMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:slm-2026-06-01-ms-reactive-demand",
              "urpx:measurementKind": {
                "@id": "urpx:reactivePower"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kVAr"
              },
              "urpx:intervalDuration": "PT30M",
              "urpx:intervalType": {
                "@id": "urpx:thirtyMinuteInterval"
              }
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:slm-2026-06-01-mi-excess-reactive-demand",
            "urpx:name": "Excess Reactive Demand (kVAR)",
            "urpx:description": "Excess Reactive Demand: the highest 30-minute kVAR measured during the month in excess of one-third of the measured actual kW in the current month. Measured only where there is an indication of a power factor of less than 95 percent lagging and the Company, at its option, installs metering equipment.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:slm-2026-06-01-ms-excess-reactive-demand",
              "urpx:measurementKind": {
                "@id": "urpx:reactivePower"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kVAr"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "gpc:slm-2026-06-01-mi-excess-reactive-demand-calculation-method",
              "urpx:calculationFormula": "max(max kVAR - max kW / 3, 0)",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "gpc:slm-2026-06-01-mi-reactive-demand"
                },
                {
                  "@id": "gpc:slm-2026-06-01-mi-demand"
                }
              ]
            }
          }
        ],
        "urpx:hasProfileAlternatives": {
          "@type": "urpx:ProfileAlternatives",
          "@id": "gpc:slm-2026-06-01-pa-voltage-level-franchise-fee-location",
          "urpx:name": "Fuel Cost Recovery voltage level and Municipal Franchise Fee location",
          "urpx:hasAlternativeDimensions": {
            "@type": "urpx:AlternativeDimensions",
            "@id": "gpc:slm-2026-06-01-pa-voltage-level-franchise-fee-location-alternative-dimensions",
            "urpx:hasAlternativeDimension": [
              {
                "@type": "urpx:AlternativeDimension",
                "@id": "gpc:slm-2026-06-01-ad-voltage-level",
                "urpx:dimensionProperty": "https://urpx.org/ns/ontology/voltageLevel",
                "urpx:dimensionDisplayName": "Service voltage level (FCR-27)",
                "urpx:hasPossibleValues": [
                  {
                    "@list": [
                      {
                        "@id": "urpx:secondaryVoltage"
                      },
                      {
                        "@id": "urpx:primaryVoltage"
                      },
                      {
                        "@id": "urpx:transmissionVoltage"
                      }
                    ]
                  }
                ]
              },
              {
                "@type": "urpx:AlternativeDimension",
                "@id": "gpc:slm-2026-06-01-ad-franchise-fee-location",
                "urpx:customDimensionProperty": "franchiseFeeLocation",
                "urpx:dimensionDisplayName": "Municipal Franchise Fee location",
                "urpx:hasPossibleValues": [
                  {
                    "@list": [
                      {
                        "@type": "xsd:string",
                        "@value": "Inside City Limits"
                      },
                      {
                        "@type": "xsd:string",
                        "@value": "Outside City Limits"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "urpx:hasProfileAlternative": [
            {
              "@type": "urpx:ProfileAlternative",
              "@id": "gpc:slm-2026-06-01-pa-secondary-inside-city-limits",
              "urpx:name": "Secondary Distribution customer, inside city limits",
              "urpx:hasConditionExpression": {
                "@type": "urpx:ConditionExpression",
                "@id": "gpc:slm-2026-06-01-cx-pa-secondary-inside-city-limits",
                "urpx:rootNode": {
                  "@type": "urpx:BooleanOperationNode",
                  "@id": "gpc:slm-2026-06-01-bn-pa-secondary-inside-city-limits",
                  "urpx:operator": {
                    "@id": "urpx:andOperator"
                  },
                  "urpx:operandNodes": [
                    {
                      "@type": "urpx:ComparisonNode",
                      "@id": "gpc:slm-2026-06-01-cn-pa-secondary-inside-city-limits-voltage-level",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:ObjectOperandNode",
                        "@id": "gpc:slm-2026-06-01-cn-pa-secondary-inside-city-limits-voltage-level-left-operand",
                        "urpx:conditionProperty": {
                          "@id": "urpx:voltageLevel"
                        }
                      },
                      "urpx:rightOperand": {
                        "@type": "urpx:ObjectOperandNode",
                        "@id": "gpc:slm-2026-06-01-cn-pa-secondary-inside-city-limits-voltage-level-right-operand",
                        "urpx:referencesValue": {
                          "@id": "urpx:secondaryVoltage"
                        }
                      }
                    },
                    {
                      "@type": "urpx:ComparisonNode",
                      "@id": "gpc:slm-2026-06-01-cn-pa-secondary-inside-city-limits-franchise-fee-location",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:CustomOperandNode",
                        "@id": "gpc:slm-2026-06-01-cn-pa-secondary-inside-city-limits-franchise-fee-location-left-operand",
                        "urpx:customConditionProperty": "franchiseFeeLocation"
                      },
                      "urpx:rightOperand": {
                        "@type": "urpx:CustomOperandNode",
                        "@id": "gpc:slm-2026-06-01-cn-pa-secondary-inside-city-limits-franchise-fee-location-right-operand",
                        "urpx:stringValue": "Inside City Limits"
                      }
                    }
                  ],
                  "urpx:logicExpression": "voltageLevel = secondaryVoltage AND franchiseFeeLocation = 'Inside City Limits'"
                }
              }
            },
            {
              "@type": "urpx:ProfileAlternative",
              "@id": "gpc:slm-2026-06-01-pa-secondary-outside-city-limits",
              "urpx:name": "Secondary Distribution customer, outside city limits",
              "urpx:hasConditionExpression": {
                "@type": "urpx:ConditionExpression",
                "@id": "gpc:slm-2026-06-01-cx-pa-secondary-outside-city-limits",
                "urpx:rootNode": {
                  "@type": "urpx:BooleanOperationNode",

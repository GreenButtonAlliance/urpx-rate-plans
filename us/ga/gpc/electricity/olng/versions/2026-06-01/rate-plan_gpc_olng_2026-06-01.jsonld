                },
                {
                  "@id": "gpc:olng-2026-06-01-mi-hps-150w-bronze-cobrahead-fiberglass-pole"
                },
                {
                  "@id": "gpc:olng-2026-06-01-mi-hps-250w-bronze-cobrahead-fiberglass-pole"

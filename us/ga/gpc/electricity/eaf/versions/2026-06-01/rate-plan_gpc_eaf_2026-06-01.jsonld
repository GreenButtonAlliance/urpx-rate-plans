  "@type": "urpx:URPXPackage",
  "@id": "gpc:doc-eaf-2026-06-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "gpc:eaf",
    "urpx:name": "Schedule EAF Electric Arc Furnace",
    "urpx:ratePlanUniqueIdentifier": "EAF",
    "urpx:initialEffectiveDate": "2026-06-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "gpc:eaf-2026-06-01",
      "urpx:description": "Georgia Power's electric arc furnace schedule, EAF-13, for industrial customers on the Fixed Pricing Alternative who run an electric arc furnace of at least 50 MW and hold it near 0 kW in summer on-peak hours. A Basic Service Charge of $245.03 per month; Off-Peak energy at a customer-specific rate; and On-Peak energy at the hourly Real Time Pricing - Day Ahead (RTP-DA) price, made available by 4:00 p.m. the day before. Neither energy rate is published, so the JSON-LD defines each as a PriceDefinition with no Price. On-Peak is 2:00 p.m. to 7:00 p.m. Monday through Friday in the calendar months June through September, except on the days Independence Day and Labor Day are observed; every other hour is Off-Peak, including all weekends and all of October through May. Excess reactive demand, kVAR above one-third of the measured kW where the Company meters it, is billed at $0.43 per kVAR. ECCR-15 applies to 65 percent of EAF's base bill calculations, as its sheet states. The holiday calendar observes Independence Day on the nearest weekday, the federal rule of 5 U.S.C. 6103(b) that Georgia law adopts, since the sheet states none. The riders the sheet applies are carried as Prices here rather than as modifiers, because every customer on the schedule pays them: Environmental Compliance Cost Recovery ECCR-15 (13.0205 percent of 65 percent of the base bill), as a multiplier over the Basic Service Charge and the Excess Reactive Demand charge; and the Municipal Franchise Fee MFF-11, 3.0843 percent inside city limits or 1.1995 percent outside them (also for a city with which the Company has no franchise fee agreement), chosen by a ProfileAlternative, as multipliers over the same charges. The sheet names a Demand Side Management schedule only in its minimum bill, and DSM-C-15 applies to Commercial customers, so none is carried. Fuel is not priced: the On-Peak RTP-DA price recovers fuel at the hourly average marginal fuel cost, and the Off-Peak amount is increased under \"the Company's effective FCR Schedules in the manner ordered by the Georgia Public Service Commission\", which the sheet does not name. Dating: the sheet and its riders are effective \"With Bills Rendered for the Billing Month of June, 2026\" (MFF-11 for January 2025). EAF-13 was filed with Schedule R-31 in the same compliance filing in docket 44280 (PSC document 227071), so this version begins 2026-06-01, the date Schedule R's bills show the new base rates took effect by calendar day.",
      "urpx:effectiveDateTime": "2026-06-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "gpc:eaf-2026-06-01-data-source-reference",
        "urpx:fileName": "eaf.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.georgiapower.com/content/dam/georgia-power/pdfs/tariffs/eaf.pdf",
        "urpx:dateRetrieved": "2026-10-16",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 3
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "gpc:eaf-2026-06-01-er-eligibility",
          "urpx:name": "Eligibility for Schedule EAF Electric Arc Furnace",
          "urpx:description": "Throughout the Company's service area from lines of adequate capacity. Applicable to all Industrial customers who operate an Electric Arc Furnace, are currently on a Fixed Pricing Alternative (FPA), control electric arc furnace loads to minimum levels (near 0 kW) during previous summer on-peak periods, meet a monthly minimum actual electric arc furnace demand of at least 50 MW, and take service at one standard voltage required on the customer's premises, delivered at one point and metered at or compensated to that voltage. Firm service, single or three phase, 60 hertz, at a standard voltage.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "gpc:eaf-2026-06-01-cx-eligibility",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "gpc:eaf-2026-06-01-cn-eligibility",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:eaf-2026-06-01-cn-eligibility-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:hasCustomerKind"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:eaf-2026-06-01-cn-eligibility-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:nonResidentialKind"
                }
              }
            }
          }
        }
      ],

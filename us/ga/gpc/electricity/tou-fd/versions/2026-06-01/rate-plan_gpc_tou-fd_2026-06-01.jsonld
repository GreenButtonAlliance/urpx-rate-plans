  "@type": "urpx:URPXPackage",
  "@id": "gpc:doc-tou-fd-2026-06-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "gpc:tou-fd",
    "urpx:name": "Schedule TOU-FD Time of Use - Food and Drink",
    "urpx:ratePlanUniqueIdentifier": "TOU-FD",
    "urpx:initialEffectiveDate": "2026-06-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "gpc:tou-fd-2026-06-01",
      "urpx:description": "Georgia Power's time of use schedule for food services and drinking places, TOU-FD-15, for commercial customers with an annual peak demand of 30 to 250 kW. A Basic Service Charge of $123.02 per month; energy at 30.6452 cents per On-Peak kWh, 6.9099 cents per Off-Peak kWh and 1.4757 cents per Super Off-Peak kWh. On-Peak is 2:00 p.m. to 7:00 p.m. Monday through Friday in the calendar months June through September, except on the days Independence Day and Labor Day are observed. Super Off-Peak is 11:00 p.m. to 7:00 a.m. every day of the year. Off-Peak is every other hour: 7:00 a.m. to 11:00 p.m. on weekends, holidays and in October through May, and 7:00 a.m. to 2:00 p.m. and 7:00 p.m. to 11:00 p.m. on weekdays in June through September. Excess reactive demand, kVAR above one-third of the measured kW where the Company meters it, is billed at $0.43 per kVAR. The holiday calendar observes Independence Day on the nearest weekday, the federal rule of 5 U.S.C. 6103(b) that Georgia law adopts, since the sheet states none. The riders the sheet applies are carried as Prices here rather than as modifiers, because every customer on the schedule pays them: Time of Use Fuel Cost Recovery Three-Part TOU-FCR-TP-5 per kWh, by voltage level and over the same On-Peak, Off-Peak and Super Off-Peak periods (Secondary Distribution 5.2269, 3.8690 and 3.4747 cents, Primary Distribution 5.1334, 3.7997 and 3.4125 cents, Transmission 5.0975, 3.7732 and 3.3887 cents); Environmental Compliance Cost Recovery ECCR-15 (13.0205 percent) and Demand Side Management Commercial DSM-C-15 (1.2676 percent) of the base bill, each as one multiplier over the energy subtotal and one over each non-energy charge; and the Municipal Franchise Fee MFF-11, 3.0843 percent inside city limits or 1.1995 percent outside them (also for a city with which the Company has no franchise fee agreement), as multipliers over the energy-and-fuel subtotal and each non-energy charge. One ProfileAlternatives set crosses the three voltage levels with the two franchise fee locations, and each of its 6 alternatives carries that voltage level's fuel prices and that location's franchise fee. Dating: the sheet and its riders are effective \"With Bills Rendered for the Billing Month of June, 2026\" (MFF-11 for January 2025). TOU-FD-15 was filed with Schedule R-31 in the same compliance filing in docket 44280 (PSC document 227071), so this version begins 2026-06-01, the date Schedule R's bills show the new base rates took effect by calendar day.",
      "urpx:effectiveDateTime": "2026-06-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "gpc:tou-fd-2026-06-01-data-source-reference",
        "urpx:fileName": "tou-fd.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.georgiapower.com/content/dam/georgia-power/pdfs/tariffs/tou-fd.pdf",
        "urpx:dateRetrieved": "2026-10-16",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 2
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "gpc:tou-fd-2026-06-01-er-eligibility",
          "urpx:name": "Eligibility for Schedule TOU-FD Time of Use - Food and Drink",
          "urpx:description": "Throughout the Company's service area from existing lines of adequate capacity. Applicable to all electric service for Commercial customers, at one standard voltage required on the customer's premises, delivered at one point and metered at or compensated to that voltage. Customers must have an annual actual peak demand of not less than 30 kW and no more than 250 kW and either (1) are defined under the North American Industry Classification System (NAICS) as 722 Food Services and Drinking Places, or (2) were served on the Time of Use - Multiple Business (TOU-MB-7) tariff as of December 31, 2019 and have been continuously served on TOU-FD since January 1, 2020. Qualifying accounts were accepted on a first come, first allowed basis until the number of accounts equals 6,000 or until December 31, 2025, whichever came first. Not usable as the base rate in the Customer Base Line portion of the Real Time Pricing tariffs. Single or three phase, 60 hertz, at a standard voltage.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "gpc:tou-fd-2026-06-01-cx-eligibility",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "gpc:tou-fd-2026-06-01-cn-eligibility",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:tou-fd-2026-06-01-cn-eligibility-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:hasCustomerKind"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:tou-fd-2026-06-01-cn-eligibility-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:nonResidentialKind"
                }
              }
            }
          }
        }
      ],

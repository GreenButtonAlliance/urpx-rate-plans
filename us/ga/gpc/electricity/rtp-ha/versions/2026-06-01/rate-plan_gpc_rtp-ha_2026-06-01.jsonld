            "urpx:description": "Each hour's actual load less the customer's Customer Baseline Load (CBL) for that hour, positive or negative, which the hourly price applies to.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:rtp-ha-2026-06-01-ms-incremental-energy",
              "urpx:measurementKind": {
                "@id": "urpx:energy"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kWh"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "gpc:rtp-ha-2026-06-01-mi-incremental-energy-calculation-method",
              "urpx:calculationFormula": "Load[h] - CBL[h], for each hour h of the billing period",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "gpc:rtp-ha-2026-06-01-mi-energy"
                }
              ]
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:rtp-ha-2026-06-01-mi-reactive-demand",
            "urpx:name": "kVAR Reactive Demand (30-minute)",
            "urpx:metricInputType": {
              "@id": "urpx:measuredMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:rtp-ha-2026-06-01-ms-reactive-demand",
              "urpx:measurementKind": {
                "@id": "urpx:reactivePower"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kVAr"
              },
              "urpx:intervalDuration": "PT30M",
              "urpx:intervalType": {

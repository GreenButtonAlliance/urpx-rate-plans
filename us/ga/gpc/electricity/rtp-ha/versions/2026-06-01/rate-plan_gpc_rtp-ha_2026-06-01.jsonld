  "@type": "urpx:URPXPackage",
  "@id": "gpc:doc-rtp-ha-2026-06-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "gpc:rtp-ha",
    "urpx:name": "Schedule RTP-HA Real Time Pricing - Hour Ahead",
    "urpx:ratePlanUniqueIdentifier": "RTP-HA",
    "urpx:initialEffectiveDate": "2026-06-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "gpc:rtp-ha-2026-06-01",
      "urpx:description": "Georgia Power's real time pricing schedule with hour ahead prices, RTP-HA-13, for commercial and industrial customers with a peak demand of at least 5,000 kW, who are notified each day of forecast prices for each hour of the next day and of each hour's price sixty minutes before it takes effect. An Administrative Charge of $850 per month. The bill is a Standard Bill plus the sum over every hour of the hourly price times the difference between the customer's actual load and its Customer Baseline Load (CBL) in that hour. The Standard Bill applies the appropriate firm non-RTP tariff, ECCR, the appropriate DSM schedule and FCR to the CBL, a load shape agreed with the customer that represents its normal operation on its conventional tariff, so the Standard Bill does not vary with RTP usage and the bill differs from the conventional one only as usage departs from the CBL. Hourly prices are based on projections of the hourly running cost of incremental generation (including approved environmental costs), losses, hourly transmission costs and reliability capacity costs, plus a 3 mill per kWh recovery factor; fuel on incremental kWh is recovered at the hourly average marginal fuel cost. Neither the Standard Bill nor the hourly prices are published, so the JSON-LD defines each as a PriceDefinition with no Price, the incremental kWh a calculated MetricInput. Excess reactive demand, kVAR above one-third of the measured kW where the Company meters it, is billed at $0.43 per kVAR, and the Municipal Franchise Fee MFF-11, 3.0843 percent inside city limits or 1.1995 percent outside them, is a multiplier over the Administrative Charge and the kVAR charge, chosen by a ProfileAlternative. Dating: the sheet is effective \"With Bills Rendered for the Billing Month of June, 2026\" and was filed with Schedule R-31 in the same compliance filing in docket 44280 (PSC document 227071), so this version begins 2026-06-01.",
      "urpx:effectiveDateTime": "2026-06-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "gpc:rtp-ha-2026-06-01-data-source-reference",
        "urpx:fileName": "rtp-ha.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.georgiapower.com/content/dam/georgia-power/pdfs/tariffs/rtp-ha.pdf",
        "urpx:dateRetrieved": "2026-10-16",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 5
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "gpc:rtp-ha-2026-06-01-er-eligibility",
          "urpx:name": "Eligibility for Schedule RTP-HA Real Time Pricing - Hour Ahead",
          "urpx:description": "Throughout the Company's service area from existing lines of adequate capacity to both new and existing Commercial and Industrial customers, who must be able to benefit from hourly price signals furnished at least 60 minutes in advance and maintain a peak 30-minute demand not less than 5,000 kW each month. Customers may elect to be interruptible under the Demand Plus Energy Credit (DPEC) rider, and are responsible for any additional cost of providing service on this tariff. Mutual agreement on the Customer Baseline Load is a precondition. Three phase, 60 hertz, at a standard voltage.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "gpc:rtp-ha-2026-06-01-cx-eligibility",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "gpc:rtp-ha-2026-06-01-cn-eligibility",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:rtp-ha-2026-06-01-cn-eligibility-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:hasCustomerKind"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:rtp-ha-2026-06-01-cn-eligibility-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:nonResidentialKind"
                }
              }
            }
          }
        }
      ],

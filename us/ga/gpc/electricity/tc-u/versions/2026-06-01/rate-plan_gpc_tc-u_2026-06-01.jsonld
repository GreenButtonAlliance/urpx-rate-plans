  "@type": "urpx:URPXPackage",
  "@id": "gpc:doc-tc-u-2026-06-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "gpc:tc-u",
    "urpx:name": "Schedule TC-U Traffic Control Unmetered Service",
    "urpx:ratePlanUniqueIdentifier": "TC-U",
    "urpx:initialEffectiveDate": "2026-06-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "gpc:tc-u-2026-06-01",
      "urpx:description": "Georgia Power's traffic control unmetered service schedule, TC-U-31, closed to new premises after December 31, 2019. A monthly Basic Service Charge per device, which includes its first 60 watts of demand, of $9.29 for a Traffic Device, $6.93 for a Traffic Flasher and $6.55 for a School Flasher, and $0.18, $0.37 and $0.70 for each additional increment of 60 watts of demand; each rate is a Price on a count of devices or of increments. The riders the sheet applies are carried as Prices here rather than as modifiers, because every customer on the schedule pays them: Environmental Compliance Cost Recovery ECCR-15 (13.0205 percent) and Demand Side Management Commercial DSM-C-15 (1.2676 percent) of the base bill, each as a multiplier over every devices charge's Price; Fuel Cost Recovery FCR-27 per kWh at the Secondary Distribution rates, 3.8069 cents June through September and 3.8561 cents October through May, on the kWh the Company estimates; and the Municipal Franchise Fee MFF-11, 3.0843 percent inside city limits or 1.1995 percent outside them (also for a city with which the Company has no franchise fee agreement), chosen by a ProfileAlternative, as a multiplier over every devices charge's Price and over the fuel subtotal. Dating: the sheet and its riders are effective \"With Bills Rendered for the Billing Month of June, 2026\" (MFF-11 for January 2025). TC-U-31 was filed with Schedule R-31 in the same compliance filing in docket 44280 (PSC document 227071), so this version begins 2026-06-01, the date Schedule R's bills show the new base rates took effect by calendar day.",
      "urpx:effectiveDateTime": "2026-06-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "gpc:tc-u-2026-06-01-data-source-reference",
        "urpx:fileName": "tc-u.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.georgiapower.com/content/dam/georgia-power/pdfs/tariffs/tc-u.pdf",
        "urpx:dateRetrieved": "2026-10-16",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 2
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "gpc:tc-u-2026-06-01-er-eligibility",
          "urpx:name": "Eligibility for Schedule TC-U Traffic Control Unmetered Service",
          "urpx:description": "Throughout the Company's service area from existing lines of adequate capacity. Applicable to electric service for the operation of traffic control devices owned and operated by a municipality or government agency and located on a public street or highway. After December 31, 2019, TC-U is not available for new premises. A School Flasher is a yellow flashing signal light in a school zone; a Traffic Flasher a red or yellow flashing signal light; a Traffic Device any traffic control related equipment that is neither.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "gpc:tc-u-2026-06-01-cx-eligibility",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "gpc:tc-u-2026-06-01-cn-eligibility",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:tc-u-2026-06-01-cn-eligibility-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:endUse"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:tc-u-2026-06-01-cn-eligibility-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:municipalEndUse"
                }
              }
            }
          }
        }
      ],

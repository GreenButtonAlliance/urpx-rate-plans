  "@type": "urpx:URPXPackage",
  "@id": "gpc:doc-tou-sc-2026-06-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "gpc:tou-sc",
    "urpx:name": "Schedule TOU-SC Time of Use - Supplier Choice",
    "urpx:ratePlanUniqueIdentifier": "TOU-SC",
    "urpx:initialEffectiveDate": "2026-06-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "gpc:tou-sc-2026-06-01",
      "urpx:description": "Georgia Power's time of use supplier choice schedule, TOU-SC-16, for customers eligible to choose an electric supplier under the Georgia Territorial Electric Service Act, or with an expected peak demand of 100 MW or greater. Its Standard Price Option is carried: a Basic Service Charge of $174.88 per month and energy at 16.8803 cents per On-Peak kWh, with a customer-specific Off-Peak rate the Company computes from the cost to serve the customer's load and location, defined here as a PriceDefinition with no Price. On-Peak is 2:00 p.m. to 7:00 p.m. Monday through Friday in the calendar months June through September, except on the days Independence Day and Labor Day are observed; every other hour is Off-Peak, including all weekends and all of October through May. Excess reactive demand, kVAR above one-third of the measured kW where the Company meters it, is billed at $0.43 per kVAR. The Flat Price Option and the Monthly Access Charge Option are customer-specific and are deferrals. The holiday calendar observes Independence Day on the nearest weekday, the federal rule of 5 U.S.C. 6103(b) that Georgia law adopts, since the sheet states none. The riders the sheet applies are carried as Prices here rather than as modifiers, because every customer on the schedule pays them: Time of Use Fuel Cost Recovery TOU-FCR-7 per kWh, by voltage level and over the same On-Peak and Off-Peak periods (Secondary Distribution 5.2269 cents On-Peak and 3.7441 cents Off-Peak, Primary Distribution 5.1334 and 3.6771 cents, Transmission 5.0975 and 3.6514 cents); Environmental Compliance Cost Recovery ECCR-15 (13.0205 percent) and Demand Side Management Commercial DSM-C-15 (1.2676 percent) of the base bill, each as one multiplier over the energy subtotal and one over each non-energy charge; and the Municipal Franchise Fee MFF-11, 3.0843 percent inside city limits or 1.1995 percent outside them (also for a city with which the Company has no franchise fee agreement), as multipliers over the energy-and-fuel subtotal and each non-energy charge. One ProfileAlternatives set crosses the three voltage levels with the two franchise fee locations, and each of its 6 alternatives carries that voltage level's fuel prices and that location's franchise fee. Dating: the sheet and its riders are effective \"With Bills Rendered for the Billing Month of June, 2026\" (MFF-11 for January 2025). TOU-SC-16 was filed with Schedule R-31 in the same compliance filing in docket 44280 (PSC document 227071), so this version begins 2026-06-01, the date Schedule R's bills show the new base rates took effect by calendar day.",
      "urpx:effectiveDateTime": "2026-06-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "gpc:tou-sc-2026-06-01-data-source-reference",
        "urpx:fileName": "tou-sc.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.georgiapower.com/content/dam/georgia-power/pdfs/tariffs/tou-sc.pdf",
        "urpx:dateRetrieved": "2026-10-16",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 3
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "gpc:tou-sc-2026-06-01-er-eligibility",
          "urpx:name": "Eligibility for Schedule TOU-SC Time of Use - Supplier Choice",
          "urpx:description": "Throughout the Company's service area from existing lines of adequate capacity. Applicable to new customers who are eligible to choose an electric service provider under the Georgia Territorial Electric Service Act of 1973, or new or existing customers with an expected total peak demand of 100 MW or greater at one or more premises located on one tract or contiguous tracts of land; such customers may only take service under the Standard Price Option if they contracted for it prior to February 1, 2025. Applicable to all electric service at one standard voltage required on the customer's premises, delivered at one point and metered at or compensated to that voltage. Not usable as a base rate in the Customer Baseline Load portion of the Real Time Pricing tariffs. Single or three phase, 60 hertz, at a standard voltage.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "gpc:tou-sc-2026-06-01-cx-eligibility",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "gpc:tou-sc-2026-06-01-cn-eligibility",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:tou-sc-2026-06-01-cn-eligibility-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:hasCustomerKind"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:tou-sc-2026-06-01-cn-eligibility-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:nonResidentialKind"
                }
              }
            }
          }
        }
      ],
      "urpx:hasPlanElements": {
        "@type": "urpx:PlanElements",
        "@id": "gpc:tou-sc-2026-06-01-plan-elements",

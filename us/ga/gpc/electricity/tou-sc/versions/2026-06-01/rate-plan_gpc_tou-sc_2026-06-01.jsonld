                "@id": "urpx:energy"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kWh"
              }
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:tou-sc-2026-06-01-mi-meter-count",
            "urpx:name": "Per Meter Prices",
            "urpx:metricInputType": {
              "@id": "urpx:profileMetricInput"
            },
            "urpx:profileMetricProperty": {
              "@id": "urpx:meterCount"
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:tou-sc-2026-06-01-mi-demand",
            "urpx:name": "kW Demand (30-minute)",
            "urpx:metricInputType": {
              "@id": "urpx:measuredMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:tou-sc-2026-06-01-ms-demand",
              "urpx:measurementKind": {
                "@id": "urpx:demand"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kW"
              },
              "urpx:intervalDuration": "PT30M",
              "urpx:intervalType": {
                "@id": "urpx:thirtyMinuteInterval"
              }
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:tou-sc-2026-06-01-mi-reactive-demand",
            "urpx:name": "kVAR Reactive Demand (30-minute)",
            "urpx:metricInputType": {
              "@id": "urpx:measuredMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:tou-sc-2026-06-01-ms-reactive-demand",
              "urpx:measurementKind": {
                "@id": "urpx:reactivePower"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kVAr"
              },
              "urpx:intervalDuration": "PT30M",
              "urpx:intervalType": {
                "@id": "urpx:thirtyMinuteInterval"
              }
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:tou-sc-2026-06-01-mi-excess-reactive-demand",
            "urpx:name": "Excess Reactive Demand (kVAR)",
            "urpx:description": "Excess Reactive Demand: the highest 30-minute kVAR measured during the month in excess of one-third of the measured actual kW in the current month. Measured only where there is an indication of a power factor of less than 95 percent lagging and the Company, at its option, installs metering equipment.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:tou-sc-2026-06-01-ms-excess-reactive-demand",
              "urpx:measurementKind": {
                "@id": "urpx:reactivePower"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kVAr"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "gpc:tou-sc-2026-06-01-mi-excess-reactive-demand-calculation-method",
              "urpx:calculationFormula": "max(max kVAR - max kW / 3, 0)",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "gpc:tou-sc-2026-06-01-mi-reactive-demand"
                },
                {
                  "@id": "gpc:tou-sc-2026-06-01-mi-demand"
                }
              ]
            }
          }
        ],
        "urpx:hasProfileAlternatives": {

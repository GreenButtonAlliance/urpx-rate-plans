              "urpx:name": "Secondary Distribution customer, inside city limits",
              "urpx:hasConditionExpression": {
                "@type": "urpx:ConditionExpression",
                "@id": "gpc:tou-sc-2026-06-01-cx-pa-secondary-inside-city-limits",
                "urpx:rootNode": {
                  "@type": "urpx:BooleanOperationNode",
                  "@id": "gpc:tou-sc-2026-06-01-bn-pa-secondary-inside-city-limits",
                  "urpx:operator": {
                    "@id": "urpx:andOperator"
                  },
                  "urpx:operandNodes": [

              "@type": "urpx:ProfileAlternative",
              "@id": "gpc:opt-2026-06-01-pa-residential-inside-city-limits",
              "urpx:name": "Residential customer, inside city limits",
              "urpx:hasConditionExpression": {
                "@type": "urpx:ConditionExpression",
                "@id": "gpc:opt-2026-06-01-cx-pa-residential-inside-city-limits",
                "urpx:rootNode": {
                  "@type": "urpx:BooleanOperationNode",
                  "@id": "gpc:opt-2026-06-01-bn-pa-residential-inside-city-limits",
                  "urpx:operator": {
                    "@id": "urpx:andOperator"
                  },
                  "urpx:operandNodes": [
                    {
                      "@type": "urpx:ComparisonNode",
                      "@id": "gpc:opt-2026-06-01-cn-pa-residential-inside-city-limits-customer-kind",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {

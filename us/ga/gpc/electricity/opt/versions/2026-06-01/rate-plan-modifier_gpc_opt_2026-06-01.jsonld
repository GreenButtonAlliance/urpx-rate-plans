  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlanModifier": {
    "@type": "urpx:RatePlanModifier",
    "@id": "gpc:opt",
    "urpx:name": "Schedule OPT AMI Meter Opt Out",
    "urpx:modifierUniqueIdentifier": "OPT",
    "urpx:initialEffectiveDate": "2026-06-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "gpc:opt-2026-06-01",
      "urpx:version": "2026-06-01",
      "urpx:modifierVersionNumber": "2026-06-01",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:description": "Georgia Power's AMI meter opt out schedule, OPT-8, for customers who keep a meter without radio frequency instead of an Advanced Metering Infrastructure meter. An additional charge of $25.45 per month added to the Basic Service Charge of the customer's rate, increased by Environmental Compliance Cost Recovery ECCR-15 (13.0205 percent), by the Demand Side Management Residential DSM-R-16 (1.1969 percent) or Commercial DSM-C-15 (1.2676 percent) schedule, and by the Municipal Franchise Fee MFF-11 (3.0843 percent inside city limits, 1.1995 percent outside), each a multiplier over the $25.45 Price. A ProfileAlternatives set crosses the customer's kind, which chooses the DSM schedule, with the franchise fee location. The charge applies as long as the customer keeps the meter without radio frequency; when it needs replacement, or access to read, maintain or test it is denied, it is replaced with an AMI meter and the charge ends. urpx:applicableToRatePlan names every metered Georgia Power schedule in this corpus, since the sheet applies to all metered service of one standard voltage. Dating: the sheet is effective \"With Bills Rendered for the Billing Month of June, 2026\" and was filed with Schedule R-31 in the same compliance filing in docket 44280 (PSC document 227071), so this version begins 2026-06-01.",
      "urpx:effectiveDateTime": "2026-06-01T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },

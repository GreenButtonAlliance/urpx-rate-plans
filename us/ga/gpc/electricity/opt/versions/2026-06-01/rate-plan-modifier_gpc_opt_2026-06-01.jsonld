                        "urpx:conditionProperty": {
                          "@id": "urpx:hasCustomerKind"
                        }
                      },
                      "urpx:rightOperand": {
                        "@type": "urpx:ObjectOperandNode",
                        "@id": "gpc:opt-2026-06-01-cn-pa-residential-inside-city-limits-customer-kind-right-operand",
                        "urpx:referencesValue": {

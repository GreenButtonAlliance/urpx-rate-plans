  "@type": "urpx:URPXPackage",
  "@id": "gpc:doc-tou-oa-2026-06-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "gpc:tou-oa",
    "urpx:name": "Schedule TOU-OA Time of Use - Overnight Advantage",
    "urpx:ratePlanUniqueIdentifier": "TOU-OA",
    "urpx:initialEffectiveDate": "2026-06-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "gpc:tou-oa-2026-06-01",
      "urpx:description": "Georgia Power's residential overnight time-of-use schedule, TOU-OA-15, with the riders every Schedule TOU-OA customer pays. A Basic Service Charge of $0.4603 per day, and energy at 30.3495 cents per On-Peak kWh, 10.3598 cents per Off-Peak kWh and 2.2272 cents per Super Off-Peak kWh. On-Peak is 2:00 p.m. to 7:00 p.m. Monday through Friday in the calendar months June through September, except on the days Independence Day and Labor Day are observed. Super Off-Peak is 11:00 p.m. to 7:00 a.m. every day of every month. Off-Peak is every other hour: 7:00 a.m. to 11:00 p.m. on weekends, the two holidays and every day of October through May, and 7:00 a.m. to 2:00 p.m. and 7:00 p.m. to 11:00 p.m. on summer weekdays. The holiday calendar observes Independence Day on the nearest weekday, the federal rule of 5 U.S.C. 6103(b) that Georgia law adopts, since the sheet states none. The riders the sheet applies are carried as Prices here rather than as modifiers, because every customer on the schedule pays them: Time of Use Fuel Cost Recovery Three-Part TOU-FCR-TP-5 per kWh (Secondary Distribution, 5.2269 cents On-Peak, 3.8690 cents Off-Peak and 3.4747 cents Super Off-Peak, over the same periods); Environmental Compliance Cost Recovery ECCR-15 (13.0205 percent) and Demand Side Management Residential DSM-R-16 (1.1969 percent) of the base bill, each as one multiplier over the energy subtotal and one over the Basic Service Charge Price; and the Municipal Franchise Fee MFF-11, 3.0843 percent inside city limits or 1.1995 percent outside them (also for a city with which the Company has no franchise fee agreement), chosen by a ProfileAlternative, as multipliers over the energy-and-fuel subtotal and over the Basic Service Charge Price. The Income Qualified Discount is a separate rider for certified customers and is not carried here. Dating: each sheet is effective \"With Bills Rendered for the Billing Month of June, 2026\" (MFF-11 for January 2025). TOU-OA-15 was filed with R-31 in the same compliance filing in docket 44280 (PSC document 227071), so this version begins 2026-06-01, the date Schedule R's bills show the new base rates took effect by calendar day.",
      "urpx:effectiveDateTime": "2026-06-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",

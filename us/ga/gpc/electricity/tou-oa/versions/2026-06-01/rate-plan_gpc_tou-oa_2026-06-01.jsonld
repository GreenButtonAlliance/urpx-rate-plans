          "urpx:name": "Eligibility for Schedule TOU-OA",
          "urpx:description": "For all domestic uses of a Residential Customer in a separately metered dwelling unit, as the Company's Rules and Regulations for Electric Service define a Residential Customer. Available throughout the Company's service area from existing lines of adequate capacity; single or three phase, 60 hertz, at a standard voltage.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "gpc:tou-oa-2026-06-01-cx-residential",
            "urpx:rootNode": {

                  },
                  "urpx:operandNodes": [
                    {
                      "@type": "urpx:ComparisonNode",
                      "@id": "gpc:ud-2026-06-01-cn-pa-secondary-outside-city-limits-voltage-level",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:ObjectOperandNode",
                        "@id": "gpc:ud-2026-06-01-cn-pa-secondary-outside-city-limits-voltage-level-left-operand",
                        "urpx:conditionProperty": {
                          "@id": "urpx:voltageLevel"
                        }
                      },
                      "urpx:rightOperand": {
                        "@type": "urpx:ObjectOperandNode",
                        "@id": "gpc:ud-2026-06-01-cn-pa-secondary-outside-city-limits-voltage-level-right-operand",
                        "urpx:referencesValue": {
                          "@id": "urpx:secondaryVoltage"
                        }
                      }
                    },
                    {
                      "@type": "urpx:ComparisonNode",
                      "@id": "gpc:ud-2026-06-01-cn-pa-secondary-outside-city-limits-franchise-fee-location",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:CustomOperandNode",
                        "@id": "gpc:ud-2026-06-01-cn-pa-secondary-outside-city-limits-franchise-fee-location-left-operand",
                        "urpx:customConditionProperty": "franchiseFeeLocation"
                      },
                      "urpx:rightOperand": {
                        "@type": "urpx:CustomOperandNode",
                        "@id": "gpc:ud-2026-06-01-cn-pa-secondary-outside-city-limits-franchise-fee-location-right-operand",
                        "urpx:stringValue": "Outside City Limits"
                      }
                    }
                  ],
                  "urpx:logicExpression": "voltageLevel = secondaryVoltage AND franchiseFeeLocation = 'Outside City Limits'"
                }
              }
            }
          ]
        },

  "@type": "urpx:URPXPackage",
  "@id": "gpc:doc-ud-2026-06-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "gpc:ud",
    "urpx:name": "Schedule UD Unmetered Devices",
    "urpx:ratePlanUniqueIdentifier": "UD",
    "urpx:initialEffectiveDate": "2026-06-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "gpc:ud-2026-06-01",
      "urpx:description": "Georgia Power's unmetered devices schedule, UD-18, for unmetered broadcasting, telecommunications, data processing and outdoor surveillance equipment using less than 3,000 kWh a month, whose energy the Company estimates. A Basic Service Charge of $18.00 per month, which includes the first 25 kWh; energy over 25 kWh at 14.5916 cents per kWh. The riders the sheet applies are carried as Prices here rather than as modifiers, because every customer on the schedule pays them: Fuel Cost Recovery FCR-27 per kWh at the Secondary Distribution rate, 3.8069 cents June through September and 3.8561 cents October through May, since service at 120 or 240 volts is never Primary Distribution or Transmission; Environmental Compliance Cost Recovery ECCR-15 (13.0205 percent) and Demand Side Management Commercial DSM-C-15 (1.2676 percent) of the base bill, each as one multiplier over the energy subtotal and one over each non-energy charge; and the Municipal Franchise Fee MFF-11, 3.0843 percent inside city limits or 1.1995 percent outside them (also for a city with which the Company has no franchise fee agreement), as multipliers over the energy-and-fuel subtotal and each non-energy charge. One ProfileAlternatives set chooses the franchise fee location, and each of its two alternatives carries the fuel prices and that location's franchise fee. Dating: the sheet and its riders are effective \"With Bills Rendered for the Billing Month of June, 2026\" (MFF-11 for January 2025). UD-18 was filed with Schedule R-31 in the same compliance filing in docket 44280 (PSC document 227071), so this version begins 2026-06-01, the date Schedule R's bills show the new base rates took effect by calendar day.",
      "urpx:effectiveDateTime": "2026-06-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "gpc:ud-2026-06-01-data-source-reference",
        "urpx:fileName": "ud.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.georgiapower.com/content/dam/georgia-power/pdfs/tariffs/ud.pdf",
        "urpx:dateRetrieved": "2026-10-16",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 2
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "gpc:ud-2026-06-01-er-eligibility",
          "urpx:name": "Eligibility for Schedule UD Unmetered Devices",
          "urpx:description": "Throughout the Company's service area from existing lines of adequate capacity. Applicable to all electric service at one standard voltage received at one point for customers whose primary usage is broadcasting (NAICS 515), telecommunications (NAICS 517), internet service providers, web search portals and data processing services (NAICS 518), or equipment for outdoor surveillance. Accounts must use less than 3,000 kWh monthly, have a maximum 30-minute measured demand of less than 30 kW and not require the installation of metering equipment and service drops; the monthly energy and demand are estimated by the Company. Single phase, 60 hertz, at 120V and 240V.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "gpc:ud-2026-06-01-cx-eligibility",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "gpc:ud-2026-06-01-cn-eligibility",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:ud-2026-06-01-cn-eligibility-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:hasCustomerKind"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:ud-2026-06-01-cn-eligibility-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:nonResidentialKind"
                }
              }
            }
          }
        }
      ],
      "urpx:hasPlanElements": {
        "@type": "urpx:PlanElements",
        "@id": "gpc:ud-2026-06-01-plan-elements",
        "urpx:hasMetricInput": [
          {

                  }
                ]
              },
              {
                "@type": "urpx:AlternativeDimension",
                "@id": "gpc:ud-2026-06-01-ad-franchise-fee-location",
                "urpx:customDimensionProperty": "franchiseFeeLocation",
                "urpx:dimensionDisplayName": "Municipal Franchise Fee location",
                "urpx:hasPossibleValues": [
                  {
                    "@list": [
                      {
                        "@type": "xsd:string",
                        "@value": "Inside City Limits"
                      },
                      {
                        "@type": "xsd:string",
                        "@value": "Outside City Limits"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "urpx:hasProfileAlternative": [
            {
              "@type": "urpx:ProfileAlternative",
              "@id": "gpc:ud-2026-06-01-pa-secondary-inside-city-limits",
              "urpx:name": "Secondary Distribution customer, inside city limits",
              "urpx:hasConditionExpression": {
                "@type": "urpx:ConditionExpression",
                "@id": "gpc:ud-2026-06-01-cx-pa-secondary-inside-city-limits",
                "urpx:rootNode": {
                  "@type": "urpx:BooleanOperationNode",
                  "@id": "gpc:ud-2026-06-01-bn-pa-secondary-inside-city-limits",
                  "urpx:operator": {
                    "@id": "urpx:andOperator"
                  },
                  "urpx:operandNodes": [
                    {
                      "@type": "urpx:ComparisonNode",
                      "@id": "gpc:ud-2026-06-01-cn-pa-secondary-inside-city-limits-voltage-level",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:ObjectOperandNode",
                        "@id": "gpc:ud-2026-06-01-cn-pa-secondary-inside-city-limits-voltage-level-left-operand",
                        "urpx:conditionProperty": {
                          "@id": "urpx:voltageLevel"
                        }
                      },
                      "urpx:rightOperand": {
                        "@type": "urpx:ObjectOperandNode",
                        "@id": "gpc:ud-2026-06-01-cn-pa-secondary-inside-city-limits-voltage-level-right-operand",
                        "urpx:referencesValue": {
                          "@id": "urpx:secondaryVoltage"
                        }
                      }
                    },
                    {
                      "@type": "urpx:ComparisonNode",
                      "@id": "gpc:ud-2026-06-01-cn-pa-secondary-inside-city-limits-franchise-fee-location",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:CustomOperandNode",
                        "@id": "gpc:ud-2026-06-01-cn-pa-secondary-inside-city-limits-franchise-fee-location-left-operand",
                        "urpx:customConditionProperty": "franchiseFeeLocation"
                      },
                      "urpx:rightOperand": {
                        "@type": "urpx:CustomOperandNode",
                        "@id": "gpc:ud-2026-06-01-cn-pa-secondary-inside-city-limits-franchise-fee-location-right-operand",
                        "urpx:stringValue": "Inside City Limits"
                      }
                    }
                  ],
                  "urpx:logicExpression": "voltageLevel = secondaryVoltage AND franchiseFeeLocation = 'Inside City Limits'"
                }
              }
            },
            {
              "@type": "urpx:ProfileAlternative",
              "@id": "gpc:ud-2026-06-01-pa-secondary-outside-city-limits",
              "urpx:name": "Secondary Distribution customer, outside city limits",
              "urpx:hasConditionExpression": {
                "@type": "urpx:ConditionExpression",
                "@id": "gpc:ud-2026-06-01-cx-pa-secondary-outside-city-limits",
                "urpx:rootNode": {
                  "@type": "urpx:BooleanOperationNode",
                  "@id": "gpc:ud-2026-06-01-bn-pa-secondary-outside-city-limits",
                  "urpx:operator": {

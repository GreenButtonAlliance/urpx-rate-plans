          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.georgiapower.com/content/dam/georgia-power/pdfs/tariffs/rlg.pdf",
        "urpx:dateRetrieved": "2026-10-16",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 3
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "gpc:rlg-2026-06-01-er-eligibility",
          "urpx:name": "Eligibility for Schedule RLG Roadway Lighting Governmental",
          "urpx:description": "Throughout the Company's service area from existing lines of adequate capacity. Applicable to all Company-owned lighting for Federal, State or local government or any of their agencies for roadway lighting requirements including streets, alleys, highways, bridges, and other public thoroughfares, with poles or other structures conforming to Company specifications, at locations that, solely in the opinion of the Company, are readily accessible for maintenance.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "gpc:rlg-2026-06-01-cx-eligibility",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "gpc:rlg-2026-06-01-cn-eligibility",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:rlg-2026-06-01-cn-eligibility-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:endUse"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:rlg-2026-06-01-cn-eligibility-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:streetLightingEndUse"
                }
              }
            }
          }
        }
      ],

  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "gpc:rlg",
    "urpx:name": "Schedule RLG Roadway Lighting Governmental",
    "urpx:ratePlanUniqueIdentifier": "RLG",
    "urpx:initialEffectiveDate": "2026-06-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "gpc:rlg-2026-06-01",
      "urpx:description": "Georgia Power's roadway lighting schedule for governmental customers, RLG-9, for Company-owned LED roadway, post top and wall pack lights. A monthly rate per light by minimum fixture lumens and type, from $10.14 for a 5,000 lumen roadway light to $24.57 for an 8,500 lumen wall pack; each of the 7 rates is a Price on a count of such lights. The rates do not include energy, which the customer contracts for on EOL-19 or TOU-EOL-11, so no fuel is carried here. The riders the sheet applies are carried as Prices here rather than as modifiers, because every customer on the schedule pays them: Environmental Compliance Cost Recovery ECCR-15 (13.0205 percent) and Demand Side Management Commercial DSM-C-15 (1.2676 percent) of the base bill, each as a multiplier over every lights charge's Price; and the Municipal Franchise Fee MFF-11, 3.0843 percent inside city limits or 1.1995 percent outside them (also for a city with which the Company has no franchise fee agreement), chosen by a ProfileAlternative, as a multiplier over every lights charge's Price. Dating: the sheet and its riders are effective \"With Bills Rendered for the Billing Month of June, 2026\" (MFF-11 for January 2025). RLG-9 was filed with Schedule R-31 in the same compliance filing in docket 44280 (PSC document 227071), so this version begins 2026-06-01, the date Schedule R's bills show the new base rates took effect by calendar day.",
      "urpx:effectiveDateTime": "2026-06-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",

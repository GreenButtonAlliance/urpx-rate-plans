  "@type": "urpx:URPXPackage",
  "@id": "gpc:doc-iop-2026-06-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "gpc:iop",
    "urpx:name": "Schedule IOP Irrigation Off-Peak Service",
    "urpx:ratePlanUniqueIdentifier": "IOP",
    "urpx:initialEffectiveDate": "2026-06-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "gpc:iop-2026-06-01",
      "urpx:description": "Georgia Power's irrigation off-peak service schedule, IOP-22, for commercial and industrial irrigation during the Off-Peak period. A Basic Service Charge of $43.72 per month. Energy, including the demand charge, is priced in two hours-use bands of the Billing Demand: kWh not greater than 200 hours times the Billing Demand at 17.3609 cents for the first 3,000 kWh, 15.7231 cents for the next 2,000 kWh and 1.7705 cents over 5,000 kWh; and kWh in excess of 200 hours times the Billing Demand at 1.7705 cents. Each band's kWh is a calculated MetricInput whose formula is stated in its CalculationMethod, as is the Billing Demand, which ratchets on the On-Peak and Off-Peak 30-minute demands over the current and preceding eleven months, with a floor of 5 kW. Consumption in the On-Peak period (noon to 8:00 p.m. on weekdays in the billing months June through September, except the observed holidays) adds a surcharge of 25 percent of the bill, which is a deferral here. Excess reactive demand, kVAR above one-third of the measured kW where the Company meters it, is billed at $0.43 per kVAR. The riders the sheet applies are carried as Prices here rather than as modifiers, because every customer on the schedule pays them: Fuel Cost Recovery FCR-27 per kWh, by voltage level (Secondary Distribution 3.8069 cents June through September and 3.8561 cents October through May, Primary Distribution 3.7387 and 3.7871 cents, Transmission 3.7126 and 3.7607 cents); Environmental Compliance Cost Recovery ECCR-15 (13.0205 percent) and Demand Side Management Commercial DSM-C-15 (1.2676 percent) of the base bill, each as one multiplier over the energy subtotal and one over each non-energy charge; and the Municipal Franchise Fee MFF-11, 3.0843 percent inside city limits or 1.1995 percent outside them (also for a city with which the Company has no franchise fee agreement), as multipliers over the energy-and-fuel subtotal and each non-energy charge. One ProfileAlternatives set crosses the three voltage levels with the two franchise fee locations, and each of its six alternatives carries that voltage level's fuel prices and that location's franchise fee. Dating: the sheet and its riders are effective \"With Bills Rendered for the Billing Month of June, 2026\" (MFF-11 for January 2025). IOP-22 was filed with Schedule R-31 in the same compliance filing in docket 44280 (PSC document 227071), so this version begins 2026-06-01, the date Schedule R's bills show the new base rates took effect by calendar day.",
      "urpx:effectiveDateTime": "2026-06-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "gpc:iop-2026-06-01-data-source-reference",
        "urpx:fileName": "iop.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.georgiapower.com/content/dam/georgia-power/pdfs/tariffs/iop.pdf",
        "urpx:dateRetrieved": "2026-10-16",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 3
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "gpc:iop-2026-06-01-er-eligibility",
          "urpx:name": "Eligibility for Schedule IOP Irrigation Off-Peak Service",
          "urpx:description": "Throughout the Company's service area from existing lines of adequate capacity. To all Commercial and Industrial electric service of one standard voltage required on the customer's premises, delivered at one point and metered at or compensated to that voltage for irrigation purposes during the Off-Peak period. The customer may be responsible to the Company for any additional cost of installing and removing any equipment required to control, meter or deliver this service. Single or three phase, 60 hertz, at a standard voltage.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "gpc:iop-2026-06-01-cx-eligibility",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "gpc:iop-2026-06-01-cn-eligibility",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:iop-2026-06-01-cn-eligibility-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:hasCustomerKind"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:iop-2026-06-01-cn-eligibility-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:nonResidentialKind"
                }
              }
            }
          }
        }
      ],
      "urpx:hasPlanElements": {
        "@type": "urpx:PlanElements",
        "@id": "gpc:iop-2026-06-01-plan-elements",
        "urpx:hasHolidayCalendar": {
          "@type": "urpx:HolidayCalendar",
          "@id": "gpc:iop-2026-06-01-holidays",
          "urpx:hasHoliday": [
            {
              "@type": "urpx:Holiday",
              "@id": "gpc:iop-2026-06-01-holiday-memorial-day",
              "urpx:holidayName": "Memorial Day",
              "urpx:holidayRule": "Last Monday in May"
            },
            {
              "@type": "urpx:Holiday",
              "@id": "gpc:iop-2026-06-01-holiday-independence-day",
              "urpx:holidayName": "Independence Day",
              "urpx:holidayRule": "July 4",
              "urpx:observanceRule": {
                "@id": "urpx:nearestWeekdayObservance"
              }
            },
            {
              "@type": "urpx:Holiday",
              "@id": "gpc:iop-2026-06-01-holiday-labor-day",
              "urpx:holidayName": "Labor Day",
              "urpx:holidayRule": "First Monday in September"
            }
          ]
        },
        "urpx:hasMetricInput": [
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:iop-2026-06-01-mi-energy",
            "urpx:name": "kWh Energy Consumption Prices",
            "urpx:metricInputType": {
              "@id": "urpx:measuredMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:iop-2026-06-01-ms-energy",
              "urpx:measurementKind": {
                "@id": "urpx:energy"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kWh"
              }
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:iop-2026-06-01-mi-meter-count",
            "urpx:name": "Per Meter Prices",
            "urpx:metricInputType": {
              "@id": "urpx:profileMetricInput"
            },
            "urpx:profileMetricProperty": {
              "@id": "urpx:meterCount"
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:iop-2026-06-01-mi-demand",
            "urpx:name": "kW Demand (30-minute)",
            "urpx:metricInputType": {
              "@id": "urpx:measuredMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:iop-2026-06-01-ms-demand",
              "urpx:measurementKind": {
                "@id": "urpx:demand"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kW"
              },
              "urpx:intervalDuration": "PT30M",
              "urpx:intervalType": {
                "@id": "urpx:thirtyMinuteInterval"
              }
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:iop-2026-06-01-mi-billing-demand",
            "urpx:name": "Billing Demand (kW)",
            "urpx:description": "Billing Demand, from the highest On-Peak and Off-Peak 30-minute kW measurements during the current month and the preceding eleven months: the greatest of (1) the current month's actual demand in the On-Peak period, (2) 95 percent of the highest actual On-Peak demand in the previous eleven months, or (3) 60 percent of the highest actual Off-Peak demand in the current or preceding eleven months. Off-Peak is any time during the billing months October through May, all weekends, all observed holidays (Memorial Day, Independence Day and Labor Day), and 8:00 p.m. to noon on weekdays during the billing months June through September; all other hours are On-Peak. A customer changing from a time of use tariff has, for its first eleven months, a minimum Billing Demand of the greater of 95 percent of the average of the four summer months' highest On-Peak kW or 60 percent of the average of the eight winter months' highest Off-Peak kW. In no case less than the greatest of the contract minimum, 50 percent of the total contract capacity, or 5 kW.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:iop-2026-06-01-ms-billing-demand",
              "urpx:measurementKind": {
                "@id": "urpx:demand"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kW"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "gpc:iop-2026-06-01-mi-billing-demand-calculation-method",
              "urpx:calculationFormula": "max(Don current month, 0.95 * max(Don, previous eleven months), 0.60 * max(Doff, current and preceding eleven months), contract minimum, 0.50 * contract capacity, 5 kW); Don, Doff the 30-minute kW in the On-Peak and Off-Peak periods",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "gpc:iop-2026-06-01-mi-demand"
                }
              ]
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:iop-2026-06-01-mi-energy-first-200-hours",
            "urpx:name": "kWh not greater than 200 hours times the Billing Demand",
            "urpx:description": "The month's kWh not greater than 200 hours times the Billing Demand, priced in blocks of kWh.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:iop-2026-06-01-ms-energy-first-200-hours",
              "urpx:measurementKind": {
                "@id": "urpx:energy"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kWh"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "gpc:iop-2026-06-01-mi-energy-first-200-hours-calculation-method",
              "urpx:calculationFormula": "min(kWh, 200 * BillingDemand)",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "gpc:iop-2026-06-01-mi-energy"
                },
                {
                  "@id": "gpc:iop-2026-06-01-mi-billing-demand"
                }
              ]
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:iop-2026-06-01-mi-energy-over-200-hours",
            "urpx:name": "kWh in excess of 200 hours times the Billing Demand",
            "urpx:description": "The month's kWh in excess of 200 hours times the Billing Demand.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:iop-2026-06-01-ms-energy-over-200-hours",
              "urpx:measurementKind": {
                "@id": "urpx:energy"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kWh"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "gpc:iop-2026-06-01-mi-energy-over-200-hours-calculation-method",
              "urpx:calculationFormula": "max(kWh - 200 * BillingDemand, 0)",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "gpc:iop-2026-06-01-mi-energy"
                },
                {
                  "@id": "gpc:iop-2026-06-01-mi-billing-demand"
                }
              ]
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:iop-2026-06-01-mi-reactive-demand",
            "urpx:name": "kVAR Reactive Demand (30-minute)",
            "urpx:metricInputType": {
              "@id": "urpx:measuredMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:iop-2026-06-01-ms-reactive-demand",
              "urpx:measurementKind": {
                "@id": "urpx:reactivePower"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kVAr"
              },
              "urpx:intervalDuration": "PT30M",
              "urpx:intervalType": {
                "@id": "urpx:thirtyMinuteInterval"
              }
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "gpc:iop-2026-06-01-mi-excess-reactive-demand",
            "urpx:name": "Excess Reactive Demand (kVAR)",
            "urpx:description": "Excess Reactive Demand: the highest 30-minute kVAR measured during the month in excess of one-third of the measured actual kW in the current month. Measured only where there is an indication of a power factor of less than 95 percent lagging and the Company, at its option, installs metering equipment.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "gpc:iop-2026-06-01-ms-excess-reactive-demand",
              "urpx:measurementKind": {
                "@id": "urpx:reactivePower"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kVAr"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "gpc:iop-2026-06-01-mi-excess-reactive-demand-calculation-method",
              "urpx:calculationFormula": "max(max kVAR - max kW / 3, 0)",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "gpc:iop-2026-06-01-mi-reactive-demand"
                },
                {
                  "@id": "gpc:iop-2026-06-01-mi-demand"
                }
              ]
            }
          }
        ],
        "urpx:hasProfileAlternatives": {
          "@type": "urpx:ProfileAlternatives",
          "@id": "gpc:iop-2026-06-01-pa-voltage-level-franchise-fee-location",
          "urpx:name": "Fuel Cost Recovery voltage level and Municipal Franchise Fee location",
          "urpx:hasAlternativeDimensions": {
            "@type": "urpx:AlternativeDimensions",
            "@id": "gpc:iop-2026-06-01-pa-voltage-level-franchise-fee-location-alternative-dimensions",
            "urpx:hasAlternativeDimension": [
              {
                "@type": "urpx:AlternativeDimension",
                "@id": "gpc:iop-2026-06-01-ad-voltage-level",
                "urpx:dimensionProperty": "https://urpx.org/ns/ontology/voltageLevel",
                "urpx:dimensionDisplayName": "Service voltage level (FCR-27)",
                "urpx:hasPossibleValues": [
                  {
                    "@list": [
                      {
                        "@id": "urpx:secondaryVoltage"
                      },
                      {
                        "@id": "urpx:primaryVoltage"
                      },
                      {
                        "@id": "urpx:transmissionVoltage"
                      }
                    ]
                  }
                ]
              },
              {
                "@type": "urpx:AlternativeDimension",
                "@id": "gpc:iop-2026-06-01-ad-franchise-fee-location",
                "urpx:customDimensionProperty": "franchiseFeeLocation",
                "urpx:dimensionDisplayName": "Municipal Franchise Fee location",
                "urpx:hasPossibleValues": [
                  {
                    "@list": [
                      {
                        "@type": "xsd:string",
                        "@value": "Inside City Limits"
                      },
                      {
                        "@type": "xsd:string",
                        "@value": "Outside City Limits"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "urpx:hasProfileAlternative": [
            {
              "@type": "urpx:ProfileAlternative",
              "@id": "gpc:iop-2026-06-01-pa-secondary-inside-city-limits",
              "urpx:name": "Secondary Distribution customer, inside city limits",
              "urpx:hasConditionExpression": {
                "@type": "urpx:ConditionExpression",
                "@id": "gpc:iop-2026-06-01-cx-pa-secondary-inside-city-limits",
                "urpx:rootNode": {
                  "@type": "urpx:BooleanOperationNode",
                  "@id": "gpc:iop-2026-06-01-bn-pa-secondary-inside-city-limits",
                  "urpx:operator": {
                    "@id": "urpx:andOperator"
                  },
                  "urpx:operandNodes": [
                    {
                      "@type": "urpx:ComparisonNode",
                      "@id": "gpc:iop-2026-06-01-cn-pa-secondary-inside-city-limits-voltage-level",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:ObjectOperandNode",
                        "@id": "gpc:iop-2026-06-01-cn-pa-secondary-inside-city-limits-voltage-level-left-operand",
                        "urpx:conditionProperty": {
                          "@id": "urpx:voltageLevel"
                        }
                      },
                      "urpx:rightOperand": {
                        "@type": "urpx:ObjectOperandNode",
                        "@id": "gpc:iop-2026-06-01-cn-pa-secondary-inside-city-limits-voltage-level-right-operand",
                        "urpx:referencesValue": {
                          "@id": "urpx:secondaryVoltage"
                        }
                      }
                    },
                    {
                      "@type": "urpx:ComparisonNode",
                      "@id": "gpc:iop-2026-06-01-cn-pa-secondary-inside-city-limits-franchise-fee-location",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:CustomOperandNode",
                        "@id": "gpc:iop-2026-06-01-cn-pa-secondary-inside-city-limits-franchise-fee-location-left-operand",
                        "urpx:customConditionProperty": "franchiseFeeLocation"
                      },
                      "urpx:rightOperand": {
                        "@type": "urpx:CustomOperandNode",
                        "@id": "gpc:iop-2026-06-01-cn-pa-secondary-inside-city-limits-franchise-fee-location-right-operand",
                        "urpx:stringValue": "Inside City Limits"
                      }
                    }
                  ],
                  "urpx:logicExpression": "voltageLevel = secondaryVoltage AND franchiseFeeLocation = 'Inside City Limits'"
                }
              }
            },
            {
              "@type": "urpx:ProfileAlternative",
              "@id": "gpc:iop-2026-06-01-pa-secondary-outside-city-limits",
              "urpx:name": "Secondary Distribution customer, outside city limits",
              "urpx:hasConditionExpression": {
                "@type": "urpx:ConditionExpression",
                "@id": "gpc:iop-2026-06-01-cx-pa-secondary-outside-city-limits",
                "urpx:rootNode": {
                  "@type": "urpx:BooleanOperationNode",
                  "@id": "gpc:iop-2026-06-01-bn-pa-secondary-outside-city-limits",
                  "urpx:operator": {
                    "@id": "urpx:andOperator"
                  },
                  "urpx:operandNodes": [
                    {
                      "@type": "urpx:ComparisonNode",
                      "@id": "gpc:iop-2026-06-01-cn-pa-secondary-outside-city-limits-voltage-level",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:ObjectOperandNode",
                        "@id": "gpc:iop-2026-06-01-cn-pa-secondary-outside-city-limits-voltage-level-left-operand",
                        "urpx:conditionProperty": {
                          "@id": "urpx:voltageLevel"
                        }
                      },
                      "urpx:rightOperand": {
                        "@type": "urpx:ObjectOperandNode",
                        "@id": "gpc:iop-2026-06-01-cn-pa-secondary-outside-city-limits-voltage-level-right-operand",
                        "urpx:referencesValue": {
                          "@id": "urpx:secondaryVoltage"
                        }
                      }
                    },
                    {
                      "@type": "urpx:ComparisonNode",
                      "@id": "gpc:iop-2026-06-01-cn-pa-secondary-outside-city-limits-franchise-fee-location",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:CustomOperandNode",
                        "@id": "gpc:iop-2026-06-01-cn-pa-secondary-outside-city-limits-franchise-fee-location-left-operand",
                        "urpx:customConditionProperty": "franchiseFeeLocation"
                      },
                      "urpx:rightOperand": {
                        "@type": "urpx:CustomOperandNode",
                        "@id": "gpc:iop-2026-06-01-cn-pa-secondary-outside-city-limits-franchise-fee-location-right-operand",
                        "urpx:stringValue": "Outside City Limits"
                      }
                    }
                  ],
                  "urpx:logicExpression": "voltageLevel = secondaryVoltage AND franchiseFeeLocation = 'Outside City Limits'"
                }
              }
            },
            {
              "@type": "urpx:ProfileAlternative",
              "@id": "gpc:iop-2026-06-01-pa-primary-inside-city-limits",
              "urpx:name": "Primary Distribution customer, inside city limits",
              "urpx:hasConditionExpression": {

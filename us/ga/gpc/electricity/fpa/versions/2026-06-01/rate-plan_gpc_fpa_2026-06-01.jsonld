  "@type": "urpx:URPXPackage",
  "@id": "gpc:doc-fpa-2026-06-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "gpc:fpa",
    "urpx:name": "Schedule FPA Fixed Pricing Alternative",
    "urpx:ratePlanUniqueIdentifier": "FPA",
    "urpx:initialEffectiveDate": "2026-06-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "gpc:fpa-2026-06-01",
      "urpx:description": "Georgia Power's fixed pricing alternative, FPA-17, for commercial and industrial customers long on its predecessor FPA-3 or on Real Time Pricing. A Basic Service Charge of $245.03 per month and energy at 17.7544 cents per On-Peak kWh. The Off-Peak rate is customer-specific: (Off-Peak Charges - Basic Service Charge x 12) / Off-Peak kWh, where Off-Peak Charges are Total Charges less the On-Peak kWh at the On-Peak rate, and Total Charges are the firm tariff and riders applied to the customer's Customer Baseline Load plus forecasted RTP prices on its expected incremental consumption, less the forecasted hourly average marginal fuel cost. The JSON-LD defines Off-Peak energy as a PriceDefinition with no Price. On-Peak is 2:00 p.m. to 7:00 p.m. Monday through Friday in the calendar months June through September, except on the days Independence Day and Labor Day are observed; every other hour is Off-Peak, including all weekends and all of October through May. Excess reactive demand, kVAR above one-third of the measured kW where the Company meters it, is billed at $0.43 per kVAR. ECCR-15 and DSM-C-15 apply to 65 percent of FPA's base bill calculations, as both sheets state. The holiday calendar observes Independence Day on the nearest weekday, the federal rule of 5 U.S.C. 6103(b) that Georgia law adopts, since the sheet states none. The riders the sheet applies are carried as Prices here rather than as modifiers, because every customer on the schedule pays them: Time of Use Fuel Cost Recovery TOU-FCR-7 per kWh, by voltage level and over the same On-Peak and Off-Peak periods (Secondary Distribution 5.2269 cents On-Peak and 3.7441 cents Off-Peak, Primary Distribution 5.1334 and 3.6771 cents, Transmission 5.0975 and 3.6514 cents); Environmental Compliance Cost Recovery ECCR-15 (13.0205 percent) and Demand Side Management Commercial DSM-C-15 (1.2676 percent) of the base bill, each as one multiplier over the energy subtotal and one over each non-energy charge; and the Municipal Franchise Fee MFF-11, 3.0843 percent inside city limits or 1.1995 percent outside them (also for a city with which the Company has no franchise fee agreement), as multipliers over the energy-and-fuel subtotal and each non-energy charge. One ProfileAlternatives set crosses the three voltage levels with the two franchise fee locations, and each of its 6 alternatives carries that voltage level's fuel prices and that location's franchise fee. Dating: the sheet and its riders are effective \"With Bills Rendered for the Billing Month of June, 2026\" (MFF-11 for January 2025). FPA-17 was filed with Schedule R-31 in the same compliance filing in docket 44280 (PSC document 227071), so this version begins 2026-06-01, the date Schedule R's bills show the new base rates took effect by calendar day.",
      "urpx:effectiveDateTime": "2026-06-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "gpc:fpa-2026-06-01-data-source-reference",
        "urpx:fileName": "fpa.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.georgiapower.com/content/dam/georgia-power/pdfs/tariffs/fpa.pdf",
        "urpx:dateRetrieved": "2026-10-16",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 2
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "gpc:fpa-2026-06-01-er-eligibility",
          "urpx:name": "Eligibility for Schedule FPA Fixed Pricing Alternative",
          "urpx:description": "Throughout the Company's service area from existing lines of adequate capacity. Applicable to all electric service for Commercial and Industrial customers, at one standard voltage required on the customer's premises, delivered at one point and metered at or compensated to that voltage, who either (1) were served on the FPA-3 tariff, Part 1 as of December 2010 and have been continuously served on the FPA tariff since January 2011, or (2) have received service for at least three consecutive years on a Real Time Pricing (RTP) tariff. The Demand Plus Energy Credit (DPEC) tariff is not applicable to customers on this tariff. FPA is offered periodically, as determined by the Company, to eligible customers. Not applicable to customers with an expected total peak demand of 100 MW or greater at one or more premises located on one tract or contiguous tracts of land. Firm service, single or three phase, 60 hertz, at a standard voltage.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "gpc:fpa-2026-06-01-cx-eligibility",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "gpc:fpa-2026-06-01-cn-eligibility",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:fpa-2026-06-01-cn-eligibility-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:hasCustomerKind"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "gpc:fpa-2026-06-01-cn-eligibility-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:nonResidentialKind"
                }
              }
            }
          }
        }
      ],

                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "jemc:gs-2026-01-01-cn-pa-three-phase-left-operand",
                    "urpx:customConditionProperty": "servicePhase"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "jemc:gs-2026-01-01-cn-pa-three-phase-right-operand",
                    "urpx:stringValue": "Three Phase"
                  }
                }
              }
            }
          ]
        },
        "urpx:hasBillingModel": {
          "@type": "urpx:BillingModel",
          "@id": "jemc:gs-2026-01-01-plan-elements-billing-model",
          "urpx:hasServiceTiers": {
            "@type": "urpx:ServiceTiers",
            "@id": "jemc:gs-2026-01-01-tiers",
            "urpx:referencesMetricInput": {
              "@id": "jemc:gs-2026-01-01-mi-energy-first-200-hours"
            },
            "urpx:hasServiceTier": [
              {
                "@type": "urpx:ServiceTier",
                "@id": "jemc:gs-2026-01-01-tier-1",
                "urpx:name": "First 15,000 kWh",
                "urpx:serviceTierNumber": 1,
                "urpx:hasServiceBracket": {
                  "@type": "urpx:ServiceBracket",
                  "@id": "jemc:gs-2026-01-01-tier-1-bracket",
                  "urpx:lowerBound": "0",
                  "urpx:lowerBoundOperator": {
                    "@id": "urpx:greaterThanOrEqualOperator"
                  },
                  "urpx:upperBound": "15000",
                  "urpx:upperBoundOperator": {
                    "@id": "urpx:lessThanOrEqualOperator"
                  }
                }
              },
              {
                "@type": "urpx:ServiceTier",
                "@id": "jemc:gs-2026-01-01-tier-2",
                "urpx:name": "Next 185,000 kWh (15,001-200,000 kWh)",
                "urpx:serviceTierNumber": 2,
                "urpx:hasServiceBracket": {
                  "@type": "urpx:ServiceBracket",
                  "@id": "jemc:gs-2026-01-01-tier-2-bracket",
                  "urpx:lowerBound": "15000",
                  "urpx:lowerBoundOperator": {
                    "@id": "urpx:greaterThanOperator"
                  },
                  "urpx:upperBound": "200000",
                  "urpx:upperBoundOperator": {
                    "@id": "urpx:lessThanOrEqualOperator"
                  }
                }
              },
              {
                "@type": "urpx:ServiceTier",
                "@id": "jemc:gs-2026-01-01-tier-3",
                "urpx:name": "Over 200,000 kWh",
                "urpx:serviceTierNumber": 3,
                "urpx:hasServiceBracket": {
                  "@type": "urpx:ServiceBracket",
                  "@id": "jemc:gs-2026-01-01-tier-3-bracket",
                  "urpx:lowerBound": "200000",
                  "urpx:lowerBoundOperator": {
                    "@id": "urpx:greaterThanOperator"
                  }
                }
              }
            ]
          },
          "urpx:hasLedger": [
            {
              "@type": "urpx:Ledger",
              "@id": "jemc:gs-2026-01-01-ledger-service-charge",
              "urpx:name": "Service Charge",
              "urpx:ledgerType": {
                "@id": "urpx:bundledLedger"
              },
              "urpx:referencesMetricInput": {
                "@id": "jemc:gs-2026-01-01-mi-meter-count"
              }
            },
            {
              "@type": "urpx:Ledger",
              "@id": "jemc:gs-2026-01-01-ledger-energy-first-200-hours",
              "urpx:name": "Energy Charges, kWh up to 200 hours times the Billing Demand",
              "urpx:ledgerType": {
                "@id": "urpx:bundledLedger"
              },
              "urpx:referencesMetricInput": {
                "@id": "jemc:gs-2026-01-01-mi-energy-first-200-hours"
              }
            },

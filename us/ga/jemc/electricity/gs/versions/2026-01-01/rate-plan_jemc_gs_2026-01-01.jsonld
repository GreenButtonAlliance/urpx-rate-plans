  "@type": "urpx:URPXPackage",
  "@id": "jemc:doc-gs-2026-01-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "jemc:gs",
    "urpx:name": "Schedule GS General Service",
    "urpx:ratePlanUniqueIdentifier": "GS",
    "urpx:initialEffectiveDate": "2026-01-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "jemc:gs-2026-01-01",
      "urpx:description": "Jackson EMC's general service schedule, GS-26, for commercial service of one standard voltage at one point. A Service Charge of $50.00 per month for single-phase or $78.00 for three-phase customers, chosen by a ProfileAlternative. Energy is priced in hours-use blocks of the Billing Demand: kWh up to 200 hours times the Billing Demand at 13.61 cents for the first 15,000 kWh, 11.13 cents for the next 185,000 kWh and 9.80 cents over 200,000 kWh; kWh in excess of 200 and not greater than 400 hours times the Billing Demand at 5.80 cents; in excess of 400 and not greater than 600 hours at 4.74 cents; and in excess of 600 hours at 4.52 cents. Each band's kWh is a calculated MetricInput whose formula is stated in its CalculationMethod, as is the Billing Demand, a 30-minute demand with summer and winter ratchets over the current and preceding eleven months and a floor of 5 kW. Excess reactive demand, kVAR above one-third of the measured kW where the Cooperative meters it, is billed at $0.30 per kVAR. Every bill is also increased or decreased by Schedule P-22's Wholesale Power Cost Adjustment, a per-kWh factor the Cooperative computes each month and does not publish, defined here as a per-kWh PriceDefinition with no Price. Load Management Adjustment Rider (LM) credits are for participating customers and are not carried here. Rates are set by the Cooperative's board, not the Georgia Public Service Commission; the sheet is effective January 1, 2026.",
      "urpx:effectiveDateTime": "2026-01-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:changeReasonOther"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": true,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "jemc:gs-2026-01-01-data-source-reference",
        "urpx:fileName": "GS-26.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.jacksonemc.com/assets/uploads/pdfs/rates/2026/GS-26.pdf",
        "urpx:dateRetrieved": "2026-10-18",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 2
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "jemc:gs-2026-01-01-er-eligibility",
          "urpx:name": "Eligibility for Schedule GS General Service",
          "urpx:description": "To all electric service of one standard voltage required on the customer's premises, delivered at one point and metered at or compensated to that voltage. No service may be resold or transmitted to other premises without the Cooperative's express consent. Available to all qualified customers in the area served by the Cooperative.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "jemc:gs-2026-01-01-cx-eligibility",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "jemc:gs-2026-01-01-cn-non-residential",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "jemc:gs-2026-01-01-cn-non-residential-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:hasCustomerKind"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "jemc:gs-2026-01-01-cn-non-residential-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:nonResidentialKind"
                }
              }
            }
          }
        }
      ],
      "urpx:hasPlanElements": {
        "@type": "urpx:PlanElements",
        "@id": "jemc:gs-2026-01-01-plan-elements",
        "urpx:hasMetricInput": [
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:gs-2026-01-01-mi-energy",
            "urpx:name": "kWh Energy Consumption Prices",
            "urpx:metricInputType": {
              "@id": "urpx:measuredMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "jemc:gs-2026-01-01-ms-energy",
              "urpx:measurementKind": {
                "@id": "urpx:energy"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kWh"
              }
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:gs-2026-01-01-mi-meter-count",
            "urpx:name": "Per Meter Prices",
            "urpx:metricInputType": {
              "@id": "urpx:profileMetricInput"
            },
            "urpx:profileMetricProperty": {
              "@id": "urpx:meterCount"
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:gs-2026-01-01-mi-demand",
            "urpx:name": "kW Demand (30-minute)",
            "urpx:metricInputType": {
              "@id": "urpx:measuredMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "jemc:gs-2026-01-01-ms-demand",
              "urpx:measurementKind": {
                "@id": "urpx:demand"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kW"
              },
              "urpx:intervalDuration": "PT30M",
              "urpx:intervalType": {
                "@id": "urpx:thirtyMinuteInterval"
              }
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:gs-2026-01-01-mi-billing-demand",
            "urpx:name": "Billing Demand (kW)",
            "urpx:description": "Billing Demand, from the customer's highest 30-minute kW demand during the current month and the preceding eleven months. For the billing months June through September, the greatest of (1) the current actual demand, (2) 90 percent of the highest actual demand in any previous applicable summer month, or (3) 65 percent of the highest actual demand in any previous applicable winter month (October-May). For the billing months October through May, the greater of (1) 90 percent of the highest summer month (June-September) or (2) 65 percent of the highest winter month, including the current month. In no case less than the greater of the contract minimum or 5 kW. For school service, Billing Demand for the usage months June through August is the higher of the current actual demand or 5 kW.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "jemc:gs-2026-01-01-ms-billing-demand",
              "urpx:measurementKind": {
                "@id": "urpx:demand"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kW"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "jemc:gs-2026-01-01-mi-billing-demand-calculation-method",
              "urpx:calculationFormula": "June-September: max(D, 0.90 * max(prior summer D), 0.65 * max(prior winter D)); October-May: max(0.90 * max(summer D), 0.65 * max(winter D including current)); over the current and preceding eleven months; floor max(contract minimum, 5 kW)",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "jemc:gs-2026-01-01-mi-demand"
                }
              ]
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:gs-2026-01-01-mi-energy-first-200-hours",
            "urpx:name": "kWh up to 200 hours times the Billing Demand",
            "urpx:description": "The month's kWh up to 200 hours times the Billing Demand, priced in three blocks of kWh.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "jemc:gs-2026-01-01-ms-energy-first-200-hours",
              "urpx:measurementKind": {
                "@id": "urpx:energy"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kWh"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "jemc:gs-2026-01-01-mi-energy-first-200-hours-calculation-method",
              "urpx:calculationFormula": "min(kWh, 200 * BillingDemand)",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "jemc:gs-2026-01-01-mi-energy"
                },
                {
                  "@id": "jemc:gs-2026-01-01-mi-billing-demand"
                }
              ]
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:gs-2026-01-01-mi-energy-200-to-400-hours",
            "urpx:name": "kWh in excess of 200 hours and not greater than 400 hours times the Billing Demand",
            "urpx:description": "The month's kWh in excess of 200 hours and not greater than 400 hours times the Billing Demand.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "jemc:gs-2026-01-01-ms-energy-200-to-400-hours",
              "urpx:measurementKind": {
                "@id": "urpx:energy"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kWh"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "jemc:gs-2026-01-01-mi-energy-200-to-400-hours-calculation-method",
              "urpx:calculationFormula": "min(max(kWh - 200 * BillingDemand, 0), 200 * BillingDemand)",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "jemc:gs-2026-01-01-mi-energy"
                },
                {
                  "@id": "jemc:gs-2026-01-01-mi-billing-demand"
                }
              ]
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:gs-2026-01-01-mi-energy-400-to-600-hours",
            "urpx:name": "kWh in excess of 400 hours and not greater than 600 hours times the Billing Demand",
            "urpx:description": "The month's kWh in excess of 400 hours and not greater than 600 hours times the Billing Demand.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "jemc:gs-2026-01-01-ms-energy-400-to-600-hours",
              "urpx:measurementKind": {
                "@id": "urpx:energy"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kWh"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "jemc:gs-2026-01-01-mi-energy-400-to-600-hours-calculation-method",
              "urpx:calculationFormula": "min(max(kWh - 400 * BillingDemand, 0), 200 * BillingDemand)",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "jemc:gs-2026-01-01-mi-energy"
                },
                {
                  "@id": "jemc:gs-2026-01-01-mi-billing-demand"
                }
              ]
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:gs-2026-01-01-mi-energy-over-600-hours",
            "urpx:name": "kWh in excess of 600 hours times the Billing Demand",
            "urpx:description": "The month's kWh in excess of 600 hours times the Billing Demand.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "jemc:gs-2026-01-01-ms-energy-over-600-hours",
              "urpx:measurementKind": {
                "@id": "urpx:energy"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kWh"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "jemc:gs-2026-01-01-mi-energy-over-600-hours-calculation-method",
              "urpx:calculationFormula": "max(kWh - 600 * BillingDemand, 0)",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "jemc:gs-2026-01-01-mi-energy"
                },
                {
                  "@id": "jemc:gs-2026-01-01-mi-billing-demand"
                }
              ]
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:gs-2026-01-01-mi-reactive-demand",
            "urpx:name": "kVAR Reactive Demand (30-minute)",
            "urpx:metricInputType": {
              "@id": "urpx:measuredMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "jemc:gs-2026-01-01-ms-reactive-demand",
              "urpx:measurementKind": {
                "@id": "urpx:reactivePower"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kVAr"
              },
              "urpx:intervalDuration": "PT30M",
              "urpx:intervalType": {
                "@id": "urpx:thirtyMinuteInterval"
              }
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:gs-2026-01-01-mi-excess-reactive-demand",
            "urpx:name": "Excess Reactive Demand (kVAR)",
            "urpx:description": "Excess Reactive Demand: the highest 30-minute kVAR measured during the month in excess of one-third of the measured actual kW in the current month. Measured only where there is an indication of a power factor of less than 95 percent lagging and the Cooperative, at its option, installs metering equipment.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "jemc:gs-2026-01-01-ms-excess-reactive-demand",
              "urpx:measurementKind": {
                "@id": "urpx:reactivePower"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kVAr"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "jemc:gs-2026-01-01-mi-excess-reactive-demand-calculation-method",
              "urpx:calculationFormula": "max(max kVAR - max kW / 3, 0)",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "jemc:gs-2026-01-01-mi-reactive-demand"
                },
                {
                  "@id": "jemc:gs-2026-01-01-mi-demand"
                }
              ]
            }
          }
        ],
        "urpx:hasProfileAlternatives": {
          "@type": "urpx:ProfileAlternatives",
          "@id": "jemc:gs-2026-01-01-pa-service-phase",
          "urpx:name": "Service phase: single-phase or three-phase",
          "urpx:hasAlternativeDimensions": {
            "@type": "urpx:AlternativeDimensions",
            "@id": "jemc:gs-2026-01-01-pa-service-phase-alternative-dimensions",

  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "jemc:lms",
    "urpx:name": "Schedule LMS Load Management Service",
    "urpx:ratePlanUniqueIdentifier": "LMS",
    "urpx:initialEffectiveDate": "2026-01-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "jemc:lms-2026-01-01",
      "urpx:description": "Jackson EMC's load management service schedule, LMS-26, which prices transmission-coincident demand. A Service Charge of $299.00 per month; a Demand Charge of $3.00 per kW of Non-Coincident Billing Demand, a 60-minute demand with summer and winter ratchets over the current and preceding eleven months, and $13.40 per kW of Coincident Peak Billing Demand, the greater of the customer's average demand at Georgia Transmission Corporation's 5 highest peak-notification-hour demands in the 12 months ending September 30 of the previous year or 20 percent of the customer's highest demand in those months; and energy at 5.11 cents per kWh. Both billing demands are calculated MetricInputs whose rules are stated in their CalculationMethods. Excess reactive demand, kVAR above one-third of the measured kW where the Cooperative meters it, is billed at $0.30 per kVAR. Every bill is also increased or decreased by Schedule P-22's Wholesale Power Cost Adjustment, a per-kWh factor the Cooperative computes each month and does not publish, defined here as a per-kWh PriceDefinition with no Price. Rates are set by the Cooperative's board, not the Georgia Public Service Commission; the sheet is effective January 1, 2026.",
      "urpx:effectiveDateTime": "2026-01-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:changeReasonOther"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "jemc:lms-2026-01-01-data-source-reference",
        "urpx:fileName": "LMS-26.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.jacksonemc.com/assets/uploads/pdfs/rates/2026/LMS-26.pdf",
        "urpx:dateRetrieved": "2026-10-18",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 2
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "jemc:lms-2026-01-01-er-eligibility",
          "urpx:name": "Eligibility for Schedule LMS Load Management Service",
          "urpx:description": "Applicable to all electric service of one standard voltage required on the customer's premises at one point and metered at or compensated to that voltage. No service may be resold or transmitted to other premises without the Cooperative's express consent. Available to all qualified customers in the area served by the Cooperative.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "jemc:lms-2026-01-01-cx-eligibility",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "jemc:lms-2026-01-01-cn-non-residential",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "jemc:lms-2026-01-01-cn-non-residential-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:hasCustomerKind"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "jemc:lms-2026-01-01-cn-non-residential-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:nonResidentialKind"
                }
              }
            }
          }
        }
      ],
      "urpx:hasPlanElements": {
        "@type": "urpx:PlanElements",
        "@id": "jemc:lms-2026-01-01-plan-elements",
        "urpx:hasMetricInput": [
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:lms-2026-01-01-mi-energy",
            "urpx:name": "kWh Energy Consumption Prices",
            "urpx:metricInputType": {
              "@id": "urpx:measuredMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "jemc:lms-2026-01-01-ms-energy",
              "urpx:measurementKind": {
                "@id": "urpx:energy"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kWh"
              }
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:lms-2026-01-01-mi-meter-count",
            "urpx:name": "Per Meter Prices",
            "urpx:metricInputType": {
              "@id": "urpx:profileMetricInput"
            },
            "urpx:profileMetricProperty": {
              "@id": "urpx:meterCount"
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:lms-2026-01-01-mi-demand",
            "urpx:name": "kW Demand (60-minute)",
            "urpx:metricInputType": {
              "@id": "urpx:measuredMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "jemc:lms-2026-01-01-ms-demand",
              "urpx:measurementKind": {
                "@id": "urpx:demand"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kW"
              },
              "urpx:intervalDuration": "PT1H",
              "urpx:intervalType": {
                "@id": "urpx:hourlyInterval"
              }
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:lms-2026-01-01-mi-ncp-billing-demand",
            "urpx:name": "Non-Coincident Billing Demand (kW)",
            "urpx:description": "Non-Coincident Billing Demand, from the customer's highest 60-minute kW demand during the current month and the preceding eleven months. For the billing months June through September, the greatest of (1) the current actual demand, (2) 90 percent of the highest actual demand in any previous applicable summer month (June-September), or (3) 65 percent of the highest actual demand in any previous applicable winter month (October-May). For the billing months October through May, the greater of (1) 90 percent of the highest summer month (June-September) or (2) 65 percent of the highest winter month (October-May, including the current month).",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "jemc:lms-2026-01-01-ms-ncp-billing-demand",
              "urpx:measurementKind": {
                "@id": "urpx:demand"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kW"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "jemc:lms-2026-01-01-mi-ncp-billing-demand-calculation-method",
              "urpx:calculationFormula": "June-September: max(D, 0.90 * max(prior summer D), 0.65 * max(prior winter D)); October-May: max(0.90 * max(summer D), 0.65 * max(winter D including current)); over the current and preceding eleven months",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "jemc:lms-2026-01-01-mi-demand"
                }
              ]
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:lms-2026-01-01-mi-cp-billing-demand",
            "urpx:name": "Coincident Peak Billing Demand (kW)",
            "urpx:description": "Coincident Peak Billing Demand, for monthly billings from January through the following December, the greater of (1) the average of the customer's sixty-minute demands measured coincident with Georgia Transmission Corporation's 5 highest demands during peak period notification hours occurring during the 12 months ending September 30 of the previous year, or (2) 20 percent of the customer's highest demand occurring during the 12 months ending September 30 of the previous year. For existing customers not previously metered on an hourly basis, based on estimates developed by the Cooperative.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "jemc:lms-2026-01-01-ms-cp-billing-demand",
              "urpx:measurementKind": {
                "@id": "urpx:demand"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kW"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "jemc:lms-2026-01-01-mi-cp-billing-demand-calculation-method",
              "urpx:calculationFormula": "max(mean(D at GTC's 5 highest peak-notification-hour demands, Oct 1-Sep 30 of the previous year), 0.20 * max(D, same 12 months))",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "jemc:lms-2026-01-01-mi-demand"
                }
              ]
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:lms-2026-01-01-mi-reactive-demand",
            "urpx:name": "kVAR Reactive Demand (60-minute)",
            "urpx:metricInputType": {
              "@id": "urpx:measuredMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "jemc:lms-2026-01-01-ms-reactive-demand",
              "urpx:measurementKind": {
                "@id": "urpx:reactivePower"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kVAr"
              },
              "urpx:intervalDuration": "PT1H",
              "urpx:intervalType": {
                "@id": "urpx:hourlyInterval"
              }
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:lms-2026-01-01-mi-excess-reactive-demand",
            "urpx:name": "Excess Reactive Demand (kVAR)",
            "urpx:description": "Excess Reactive Demand: the highest 60-minute kVAR measured during the month in excess of one-third of the measured actual kW in the current month. Measured only where there is an indication of a power factor of less than 95 percent lagging and the Cooperative, at its option, installs metering equipment.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "jemc:lms-2026-01-01-ms-excess-reactive-demand",
              "urpx:measurementKind": {
                "@id": "urpx:reactivePower"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kVAr"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "jemc:lms-2026-01-01-mi-excess-reactive-demand-calculation-method",
              "urpx:calculationFormula": "max(max kVAR - max kW / 3, 0)",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "jemc:lms-2026-01-01-mi-reactive-demand"
                },
                {
                  "@id": "jemc:lms-2026-01-01-mi-demand"
                }
              ]
            }
          }
        ],
        "urpx:hasBillingModel": {

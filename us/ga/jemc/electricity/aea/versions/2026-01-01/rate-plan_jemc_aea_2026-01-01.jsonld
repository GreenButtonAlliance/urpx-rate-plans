  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "jemc:aea",
    "urpx:name": "Schedule AEA Residential Energy Advantage Service",
    "urpx:ratePlanUniqueIdentifier": "AEA",
    "urpx:initialEffectiveDate": "2026-01-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "jemc:aea-2026-01-01",
      "urpx:description": "Jackson EMC's residential energy advantage schedule, AEA-26, for homes that meet the Cooperative's Right Choice, Comfort Home or Good Cents program qualifications. A Service Charge of $31.00 per month, and energy in three blocks of monthly usage: in the Summer months May through September, 8.37 cents for the first 650 kWh, 10.11 cents for the next 350 kWh and 11.11 cents over 1,000 kWh; in the Winter months October through April, 8.37, 7.33 and 7.63 cents for the same blocks. The minimum monthly charge is the Service Charge. Every bill is also increased or decreased by Schedule P-22's Wholesale Power Cost Adjustment, a per-kWh factor the Cooperative computes each month and does not publish, defined here as a PriceDefinition with no Price. The Senior Citizen - Low Income credit of $12.50 and the Load Management Adjustment Rider (LM) are for qualifying customers and are not carried here. Rates are set by the Cooperative's board; the sheet is effective January 1, 2026.",
      "urpx:effectiveDateTime": "2026-01-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:changeReasonOther"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },

  "@type": "urpx:URPXPackage",
  "@id": "jemc:doc-s-2026-01-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "jemc:s",
    "urpx:name": "Schedule S Outdoor Lighting Service",
    "urpx:ratePlanUniqueIdentifier": "S",
    "urpx:initialEffectiveDate": "2026-01-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "jemc:s-2026-01-01",
      "urpx:description": "Jackson EMC's outdoor lighting schedule, S-26, for outdoor lighting on customer property and public street lighting. Cooperative-owned and maintained lights are billed a monthly charge per lamp for all-night service, which includes maintenance, lamp renewal and energy, and depends on the lamp, the fixture and whether it is mounted on a wood or a non-wood pole: LED lights from $11.25 (100 watt equivalent, open bottom) to $63.50 (1,000 watt equivalent, shoebox/decashield on a non-wood pole), and high pressure sodium, pulse metal halide, metal halide and mercury vapor lights, which are no longer offered for new installations as of January 1, 2020, from $11.25 to $63.50. Each of the 77 lamp and fixture combinations the sheet prices has its own PriceDefinition, counted by its own MetricInput. Customer-owned and maintained signboards, CATV amplifiers and traffic signals are billed a Service Charge of $13.00 per month and energy at 7.74 cents per kWh for photocell-controlled systems or 8.09 cents per kWh for 24-hour service, on a monthly kWh of the connected watts times 0.35 or 0.75; the minimum monthly bill is the Service Charge. A ProfileAlternative chooses between Cooperative-owned lights, a customer-owned photocell-controlled system and a customer-owned 24-hour system. Every bill is also increased or decreased by Schedule P-22's Wholesale Power Cost Adjustment, a per-kWh factor the Cooperative computes each month, billed for Cooperative-owned lights on an assumed monthly usage per light by installed watts; the sheet publishes the formula and not the factor, so the adjustment is defined here as a per-kWh PriceDefinition with no Price. Rates are set by the Cooperative's board, not the Georgia Public Service Commission; the sheet is effective January 1, 2026.",
      "urpx:effectiveDateTime": "2026-01-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:changeReasonOther"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:mandatoryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "jemc:s-2026-01-01-data-source-reference",
        "urpx:fileName": "S-26.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.jacksonemc.com/assets/uploads/pdfs/rates/2026/S-26.pdf",
        "urpx:dateRetrieved": "2026-10-18",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 4
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "jemc:s-2026-01-01-er-lighting",
          "urpx:name": "Eligibility for Schedule S Outdoor Lighting Service",
          "urpx:description": "Applicable to outdoor lighting on customer property or public street lighting by means of standard mercury, sodium vapor, light emitting diode or metal halide luminaires, on poles and fixtures conforming to the Cooperative's specifications, and to customer-owned and maintained signboards, CATV amplifiers and traffic signals. Available throughout the Cooperative's service area from existing lines of adequate capacity, and only at locations that, solely in the Cooperative's opinion, its trucks can reach for servicing.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "jemc:s-2026-01-01-cx-lighting",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "jemc:s-2026-01-01-cn-lighting",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "jemc:s-2026-01-01-cn-lighting-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:endUse"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "jemc:s-2026-01-01-cn-lighting-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:lightingEndUse"
                }
              }
            }
          }
        }
      ],

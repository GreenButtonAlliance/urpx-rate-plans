  "@id": "jemc:doc-a-2026-01-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "jemc:a",
    "urpx:name": "Schedule A Residential Service",
    "urpx:ratePlanUniqueIdentifier": "A",
    "urpx:initialEffectiveDate": "2026-01-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "jemc:a-2026-01-01",
      "urpx:description": "Jackson EMC's residential service schedule, A-26, the cooperative's standard residential rate. A Service Charge of $31.00 per month, and energy in three blocks of monthly usage: in the Summer months May through September, 8.81 cents for the first 650 kWh, 11.06 cents for the next 350 kWh and 11.66 cents over 1,000 kWh; in the Winter months October through April, 8.81, 8.16 and 8.06 cents for the same blocks. The minimum monthly charge is the Service Charge. Every bill is also increased or decreased by Schedule P-22's Wholesale Power Cost Adjustment, a per-kWh factor the Cooperative computes each month from its estimated purchased-power costs and sales against a base power cost of $0.0781 per kWh; the sheet publishes the formula and not the factor, so the adjustment is defined here as a per-kWh PriceDefinition with no Price. The Senior Citizen - Low Income credit of $12.50 and the Load Management Adjustment Rider (LM) are for qualifying customers and are not carried here. Rates are set by the Cooperative's board, not the Georgia Public Service Commission; the sheet is effective January 1, 2026.",
      "urpx:effectiveDateTime": "2026-01-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:changeReasonOther"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },

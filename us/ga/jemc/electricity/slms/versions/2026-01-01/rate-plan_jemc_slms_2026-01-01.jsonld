              }
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:slms-2026-01-01-mi-meter-count",
            "urpx:name": "Per Meter Prices",
            "urpx:metricInputType": {
              "@id": "urpx:profileMetricInput"
            },
            "urpx:profileMetricProperty": {
              "@id": "urpx:meterCount"
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:slms-2026-01-01-mi-demand",
            "urpx:name": "kW Demand (60-minute)",
            "urpx:metricInputType": {
              "@id": "urpx:measuredMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "jemc:slms-2026-01-01-ms-demand",
              "urpx:measurementKind": {
                "@id": "urpx:demand"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kW"
              },
              "urpx:intervalDuration": "PT1H",
              "urpx:intervalType": {
                "@id": "urpx:hourlyInterval"
              }
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:slms-2026-01-01-mi-cp-billing-demand",
            "urpx:name": "Coincident Peak Billing Demand (kW)",
            "urpx:description": "Coincident Peak Billing Demand, for monthly billings from January through the following December, the average of the customer's sixty-minute demands measured coincident with Georgia Transmission Corporation's 5 highest demands during peak period notification hours occurring during the 12 months ending September 30 of the previous year. For existing customers not previously metered on an hourly basis, based on estimates developed by the Cooperative.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "jemc:slms-2026-01-01-ms-cp-billing-demand",
              "urpx:measurementKind": {
                "@id": "urpx:demand"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kW"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "jemc:slms-2026-01-01-mi-cp-billing-demand-calculation-method",
              "urpx:calculationFormula": "mean(D at GTC's 5 highest peak-notification-hour demands, Oct 1-Sep 30 of the previous year)",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "jemc:slms-2026-01-01-mi-demand"
                }
              ]
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:slms-2026-01-01-mi-reactive-demand",
            "urpx:name": "kVAR Reactive Demand (60-minute)",
            "urpx:metricInputType": {
              "@id": "urpx:measuredMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "jemc:slms-2026-01-01-ms-reactive-demand",
              "urpx:measurementKind": {
                "@id": "urpx:reactivePower"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kVAr"
              },
              "urpx:intervalDuration": "PT1H",
              "urpx:intervalType": {
                "@id": "urpx:hourlyInterval"
              }
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:slms-2026-01-01-mi-excess-reactive-demand",
            "urpx:name": "Excess Reactive Demand (kVAR)",
            "urpx:description": "Excess Reactive Demand: the highest 60-minute kVAR measured during the month in excess of one-third of the measured actual kW in the current month. Measured only where there is an indication of a power factor of less than 95 percent lagging and the Cooperative, at its option, installs metering equipment.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "jemc:slms-2026-01-01-ms-excess-reactive-demand",
              "urpx:measurementKind": {
                "@id": "urpx:reactivePower"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kVAr"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "jemc:slms-2026-01-01-mi-excess-reactive-demand-calculation-method",
              "urpx:calculationFormula": "max(max kVAR - max kW / 3, 0)",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "jemc:slms-2026-01-01-mi-reactive-demand"
                },
                {
                  "@id": "jemc:slms-2026-01-01-mi-demand"
                }
              ]
            }
          }
        ],
        "urpx:hasBillingModel": {

  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "jemc:slms",
    "urpx:name": "Schedule SLMS School Load Management Service",
    "urpx:ratePlanUniqueIdentifier": "SLMS",
    "urpx:initialEffectiveDate": "2026-01-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "jemc:slms-2026-01-01",
      "urpx:description": "Jackson EMC's school load management service schedule, SLMS-26, for state, county, city and private schools. A Service Charge of $299.00 per month; a Demand Charge of $3.00 per kW of Non-Coincident Billing Demand, the customer's highest 60-minute kW in the current month, and $13.40 per kW of Coincident Peak Billing Demand, the customer's average demand at Georgia Transmission Corporation's 5 highest peak-notification-hour demands in the 12 months ending September 30 of the previous year, a calculated MetricInput whose rule is stated in its CalculationMethod; and energy at 4.81 cents per kWh. Excess reactive demand, kVAR above one-third of the measured kW where the Cooperative meters it, is billed at $0.30 per kVAR. Every bill is also increased or decreased by Schedule P-22's Wholesale Power Cost Adjustment, a per-kWh factor the Cooperative computes each month and does not publish, defined here as a per-kWh PriceDefinition with no Price. Rates are set by the Cooperative's board, not the Georgia Public Service Commission; the sheet is effective January 1, 2026.",
      "urpx:effectiveDateTime": "2026-01-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:changeReasonOther"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "jemc:slms-2026-01-01-data-source-reference",
        "urpx:fileName": "SLMS-26.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.jacksonemc.com/assets/uploads/pdfs/rates/2026/SLMS-26.pdf",
        "urpx:dateRetrieved": "2026-10-18",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 2
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "jemc:slms-2026-01-01-er-eligibility",
          "urpx:name": "Eligibility for Schedule SLMS School Load Management Service",
          "urpx:description": "Applicable to all electric service for state, county, city and private schools which offer regular elementary, middle, high school or college courses, of one standard voltage required on the customer's premises at one point and metered at or compensated to that voltage. No service may be resold or transmitted to other premises without the Cooperative's express consent. Available to all qualified customers in the area served by the Cooperative.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "jemc:slms-2026-01-01-cx-eligibility",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "jemc:slms-2026-01-01-cn-non-residential",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "jemc:slms-2026-01-01-cn-non-residential-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:hasCustomerKind"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "jemc:slms-2026-01-01-cn-non-residential-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:nonResidentialKind"
                }
              }
            }
          }
        }
      ],

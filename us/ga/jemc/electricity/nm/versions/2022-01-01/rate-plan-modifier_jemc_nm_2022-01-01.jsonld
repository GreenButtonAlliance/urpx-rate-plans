  "@graph": [
    {
      "@type": "urpx:URPXPackage",
      "@id": "jemc:doc-nm-2022-01-01",
      "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
      "urpx:hasRatePlanModifier": {
        "@type": "urpx:RatePlanModifier",
        "@id": "jemc:nm",
        "urpx:name": "Net Metering Rider",
        "urpx:modifierUniqueIdentifier": "NM",
        "urpx:initialEffectiveDate": "2022-01-01",
        "urpx:timezoneIdentifier": "America/New_York",
        "urpx:hasRatePlanModifierVersion": {
          "@type": "urpx:RatePlanModifierVersion",
          "@id": "jemc:nm-2022-01-01",
          "urpx:version": "2022-01-01",
          "urpx:modifierVersionNumber": "2022-01-01",
          "urpx:changeReason": {
            "@id": "urpx:changeReasonOther"
          },
          "urpx:description": "Jackson EMC's Rider NM, Net Metering Rider, for customers with solar photovoltaic, fuel cell or wind generation of not more than 10 kW (residential) connected after January 1, 2016 and eligible under the Georgia Cogeneration and Distributed Generation Act of 2001; of the Cooperative's schedules, this corpus holds the six residential ones, which urpx:applicableToRatePlan names. The customer pays Incremental Service Costs of $10.00 per month. Electricity the Cooperative supplies is billed under the customer's tariff; whenever the customer's generation exceeds its consumption, the excess is credited at the Avoided Energy Cost, the base charge at the generator plus transmission line loss avoided costs at the substation plus distribution line loss at the customer. A credit balance is applied to the next month's bill, and each December any credit balance is paid to the customer by check. The Incremental Service Costs are carried as a monthly charge, and the excess-generation credit as a per-kWh PriceDefinition with no Price, since the rider states a formula and no value. Dating: the rider is effective January 1, 2022, so this version begins 2022-01-01; it states no date of first introduction.",
          "urpx:effectiveDateTime": "2022-01-01T00:00:00",
          "urpx:priceCurrency": "USD",
          "urpx:commodity": {
            "@id": "urpx:electricity"
          },
          "urpx:serviceRole": {
            "@id": "urpx:bundledServiceRole"
          },

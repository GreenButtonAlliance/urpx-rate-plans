            ]
          },
          "urpx:offeredBy": {
            "@type": "urpx:UtilityOperator",
            "@id": "org:utility-jemc",
            "urpx:legalName": "Jackson Electric Membership Corporation",
            "urpx:organizationType": {
              "@id": "urpx:cooperativeOrganization"
            },
            "urpx:hasIdentity": {
              "@id": "org:utility-jemc-identity",
              "@type": "urpx:OrganizationIdentity",
              "urpx:hasName": {
                "@id": "org:utility-jemc-name",
                "@type": "urpx:OrganizationName",
                "urpx:name": "Jackson Electric Membership Corporation"
              },
              "urpx:hasIdentifier": {
                "@id": "org:utility-jemc-eia",
                "@type": "urpx:OrganizationIdentifier",
                "urpx:scheme": {
                  "@id": "urpx:eiaScheme"
                },
                "skos:notation": "9601"

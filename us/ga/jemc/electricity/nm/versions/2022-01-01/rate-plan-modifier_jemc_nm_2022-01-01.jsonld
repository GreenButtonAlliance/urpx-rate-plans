              "@id": "jemc:aphf"
            },
            {
              "@id": "jemc:atou"
            },
            {
              "@id": "jemc:apev"
            }
          ],
          "urpx:hasDataSourceReference": {
            "@type": "urpx:DataSourceReference",
            "@id": "jemc:nm-2022-01-01-data-source-reference",
            "urpx:fileName": "NM.pdf",

        },
        "urpx:accessURL": "https://www.jacksonemc.com/assets/uploads/pdfs/rates/2026/MBS-22.pdf",
        "urpx:dateRetrieved": "2026-10-18",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 2
      },

              }
            },
            {
              "@type": "urpx:PriceDefinition",
              "@id": "jemc:mbs-2022-01-01-pd-margin-cost",
              "urpx:name": "Margin Cost (MC): 3.0 percent of the first $15,000 of TC = EC + FC, 2.5 percent of the next $35,000 and 2.0 percent over $50,000",
              "urpx:chargeType": {
                "@id": "urpx:contractMisc"
              },
              "urpx:chargeCategory": {
                "@id": "urpx:serviceCharge"
              },
              "urpx:billPortion": {
                "@id": "urpx:bundledPortion"
              },
              "urpx:baseQuantity": "1",
              "urpx:hasCalculationMethod": {
                "@type": "urpx:CalculationMethod",
                "@id": "jemc:mbs-2022-01-01-pd-margin-cost-calculation-method",
                "urpx:intervalDuration": "P1M"
              },
              "urpx:referencesLedger": {

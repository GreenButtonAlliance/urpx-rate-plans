  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "jemc:mbs",
    "urpx:name": "Schedule MBS Market Based Service",
    "urpx:ratePlanUniqueIdentifier": "MBS",
    "urpx:initialEffectiveDate": "2022-01-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "jemc:mbs-2022-01-01",
      "urpx:description": "Jackson EMC's market based service schedule, MBS-22, for customers over 900 kW of connected demand, priced case by case. The monthly charge is the sum of an Energy Charge (EC), made up of a kWh charge, a transmission charge, a fixed cost recovery charge, a substation charge and a line loss charge, each determined case by case at the Cooperative's discretion subject to market prices, availability, contract terms, load characteristics and type of service; a Facilities Charge (FC), one-twelfth of the annual allocated cost of providing service (operation and maintenance, customer accounting, customer service, sales, administrative and general, taxes, and allocated and direct plant capital costs); and a Margin Cost (MC) on their Total Charge TC = EC + FC of 3.0 percent of the first $15,000, 2.5 percent of the next $35,000 and 2.0 percent over $50,000. No part of EC or FC is published, so the JSON-LD defines each as a PriceDefinition with no Price, and the Margin Cost, which is a percentage of them, as a PriceDefinition with no Price whose percentages are stated in its description. Rates are set by the Cooperative's board, not the Georgia Public Service Commission; the sheet is effective January 1, 2022.",
      "urpx:effectiveDateTime": "2022-01-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:changeReasonOther"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,

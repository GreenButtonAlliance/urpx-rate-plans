  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "jemc:ts",
    "urpx:name": "Schedule TS Temporary Service",
    "urpx:ratePlanUniqueIdentifier": "TS",
    "urpx:initialEffectiveDate": "2026-01-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "jemc:ts-2026-01-01",
      "urpx:description": "Jackson EMC's temporary service schedule, TS-26, for service that is temporary or seasonal in nature. A Service Charge of $50.00 per month for single-phase or $78.00 for three-phase customers, chosen by a ProfileAlternative, and energy at 13.61 cents for the first 15,000 kWh, 11.13 cents for the next 185,000 kWh and 9.80 cents over 200,000 kWh, plus a surcharge of 25 percent of the total so calculated, carried as one multiplier over the energy subtotal and one over the Service Charge. The minimum monthly charge is the Service Charge. Every bill is also increased or decreased by Schedule P-22's Wholesale Power Cost Adjustment, a per-kWh factor the Cooperative computes each month and does not publish, defined here as a per-kWh PriceDefinition with no Price. Rates are set by the Cooperative's board, not the Georgia Public Service Commission; the sheet is effective January 1, 2026.",
      "urpx:effectiveDateTime": "2026-01-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:changeReasonOther"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,

    {
      "@type": "urpx:URPXPackage",
      "@id": "jemc:doc-cs-2022-06-01",
      "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
      "urpx:hasRatePlanModifier": {
        "@type": "urpx:RatePlanModifier",
        "@id": "jemc:cs",
        "urpx:name": "Cooperative Solar Rider",
        "urpx:modifierUniqueIdentifier": "CS",
        "urpx:initialEffectiveDate": "2022-06-01",
        "urpx:timezoneIdentifier": "America/New_York",
        "urpx:hasRatePlanModifierVersion": {
          "@type": "urpx:RatePlanModifierVersion",
          "@id": "jemc:cs-2022-06-01",
          "urpx:version": "2022-06-01",
          "urpx:modifierVersionNumber": "2022-06-01",
          "urpx:changeReason": {
            "@id": "urpx:changeReasonOther"
          },
          "urpx:description": "Jackson EMC's Rider CS, Cooperative Solar Rider, for customers on the Cooperative's residential rate schedules other than the Time-of-Use and Plug-In Electric Vehicle rates: A-26, AEA-26, AM-26 and APHF-26, which urpx:applicableToRatePlan names. Cooperative Solar is sold in blocks of one kW at $23.00 per block per month, \"in addition to all the costs pursuant to the customer's existing residential tariff\", and the Cooperative may limit a customer to three blocks. Each month the total generation of the Cooperative's solar units is divided by the total blocks in the program, and the customer's consumption for billing is offset by its blocks' pro rata share; generation beyond the month's consumption is credited at the Avoided Energy Cost defined in Rider NM, and a credit balance is applied to the next month's bill. The block charge is carried as a monthly charge chosen by a profile alternative for one, two or three blocks; the generation offset and the excess credit are deferred. Dating: the rider is effective June 1, 2022, so this version begins 2022-06-01; it states no date of first introduction.",
          "urpx:effectiveDateTime": "2022-06-01T00:00:00",
          "urpx:priceCurrency": "USD",
          "urpx:commodity": {
            "@id": "urpx:electricity"
          },
          "urpx:serviceRole": {
            "@id": "urpx:bundledServiceRole"
          },

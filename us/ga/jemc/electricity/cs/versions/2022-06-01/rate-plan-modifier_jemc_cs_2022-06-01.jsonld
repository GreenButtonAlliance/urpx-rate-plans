          "urpx:forRatePlanModifier": {
            "@id": "jemc:cs"
          },
          "urpx:hasCoverageClaim": {
            "@id": "jemc:cc-cs-2022-06-01",
            "@type": "urpx:CoverageClaim",
            "urpx:completenessResult": {
              "@id": "urpx:partial"
            },
            "urpx:selfContained": true,
            "urpx:explainedBy": {
              "@type": "urpx:Evaluation",
              "@id": "jemc:cc-cs-2022-06-01-evaluation",
              "urpx:evaluationKind": {
                "@id": "urpx:coverageEvaluation"
              },
              "urpx:description": "This filing does not carry everything its source document states. 4 parts are deferred, listed here in the same words as the filing's tariff.toml [modeling].deferrals so the two records cannot drift. (1) Generation offset. Each month the Cooperative divides its solar units' total generation by the total blocks in the program, and the customer's consumption for billing is offset by its blocks' pro rata share. The share varies month to month and is not published, so the JSON-LD carries no offset: a modeled bill charges the base schedule's energy charges on the customer's whole consumption, high by the energy charges on the blocks' share. (2) Excess generation credit. When the blocks' share exceeds the month's consumption, the excess is credited at the Avoided Energy Cost defined in Rider NM, a formula the Cooperative publishes no value for, and a credit balance is applied to the next month's bill. The JSON-LD carries neither the credit nor the carryover. (3) More than three blocks. The Cooperative \"reserves the right to limit the number of solar blocks for a customer to no more than three\" and considers more case by case. The ProfileAlternatives offer one, two and three blocks only. (4) Exclusions and program terms. The rider excludes customers on Rider NM and members on the PrePay or Budget Billing programs, limits blocks to availability on a first-come basis, imposes a twelve-month wait to re-enroll after exiting, and allows a subscription to transfer to a new premises. The EligibilityRule carries residential customer kind and enrollment in jemc:program-cs; the rest is in its description, and the exclusion of Rider NM is not expressed between the two modifiers.",
              "urpx:evaluatedOn": "2026-10-18T00:00:00"
            }
          }

                  "@type": "urpx:PriceDefinition",
                  "@id": "jemc:dr-2025-06-01-pd-smart-thermostat-credit",
                  "urpx:name": "Sync to Save smart thermostat credit, on the November bill",
                  "urpx:chargeType": {
                    "@id": "urpx:creditTariffRider"
                  },
                  "urpx:chargeCategory": {
                    "@id": "urpx:discount"
                  },

                  "@id": "jemc:dr-2025-06-01-pd-smart-thermostat-credit"
                },
                "urpx:name": "Smart thermostat credit",
                "urpx:startDate": "2025-06-01",
                "urpx:unitPrice": "-25.00"
              }
            ]
          },
          "urpx:offeredBy": {

          "urpx:forRatePlanModifier": {
            "@id": "jemc:dr"
          },
          "urpx:hasCoverageClaim": {
            "@id": "jemc:cc-dr-2025-06-01",
            "@type": "urpx:CoverageClaim",
            "urpx:completenessResult": {
              "@id": "urpx:partial"
            },
            "urpx:selfContained": true,
            "urpx:explainedBy": {
              "@type": "urpx:Evaluation",
              "@id": "jemc:cc-dr-2025-06-01-evaluation",
              "urpx:evaluationKind": {
                "@id": "urpx:coverageEvaluation"
              },
              "urpx:description": "This filing does not carry everything its source document states. 2 parts are deferred, listed here in the same words as the filing's tariff.toml [modeling].deferrals so the two records cannot drift. (1) November bill. The rider grants the credit \"on their November bill\". The JSON-LD gates it on the calendar month of November; if the Cooperative grants it by billing month, the modeled credit falls on a different set of days than the bill that carries it. (2) Enrollment window, account activity and tampering. The thermostat must be enrolled and connected by July 1, the account active July 1 through September 30 of the credit year, and the credit is forfeited if control or connection is disrupted by tampering; eligible devices are at the Cooperative's discretion. The EligibilityRule carries residential customer kind and enrollment in jemc:program-sync-to-save; these conditions are in its description only.",
              "urpx:evaluatedOn": "2026-10-18T00:00:00"
            }
          }
        }

            {
              "@id": "jemc:a"
            },
            {
              "@id": "jemc:aea"
            },
            {
              "@id": "jemc:am"
            },
            {
              "@id": "jemc:aphf"
            },
            {
              "@id": "jemc:atou"
            },
            {
              "@id": "jemc:apev"
            }
          ],
          "urpx:hasDataSourceReference": {
            "@type": "urpx:DataSourceReference",
            "@id": "jemc:dr-2025-06-01-data-source-reference",
            "urpx:fileName": "jemc-demanresponserider.pdf",
            "urpx:mediaType": {
              "@id": "urpx:applicationPdf"
            },
            "urpx:accessURL": "https://www.jacksonemc.com/assets/uploads/pdfs/jemc-demanresponserider.pdf",
            "urpx:dateRetrieved": "2026-10-18",
            "urpx:dataSourceType": {
              "@id": "urpx:utilityWebsiteSource"
            },
            "urpx:pageStart": 1,
            "urpx:pageEnd": 1
          },
          "urpx:hasEligibilityRule": [
            {
              "@type": "urpx:EligibilityRule",
              "@id": "jemc:dr-2025-06-01-er-eligible",
              "urpx:name": "Sync to Save participant with a connected smart thermostat",
              "urpx:description": "Residential customer participating in the Cooperative's Sync to Save program with a connected, eligible smart thermostat. \"The smart thermostat must be enrolled in the Sync To Save program and connected by July 1 of the calendar year to be eligible for that year's credit. Credit will be given only to those customers whose accounts are active July 1 - September 30 of the credit year. Credit will be forfeited if control or connection of thermostat is disrupted due to tampering during the applicable period.\" ELIGIBLE DEVICES: \"Eligible devices will be determined at the sole discretion of the Cooperative.\"",
              "urpx:hasConditionExpression": {
                "@type": "urpx:ConditionExpression",
                "@id": "jemc:dr-2025-06-01-cx-eligible",
                "urpx:rootNode": {
                  "@type": "urpx:BooleanOperationNode",
                  "@id": "jemc:dr-2025-06-01-bn-residential-and-enrolled",
                  "urpx:operator": {
                    "@id": "urpx:andOperator"
                  },
                  "urpx:operandNodes": [
                    {
                      "@type": "urpx:ComparisonNode",
                      "@id": "jemc:dr-2025-06-01-cn-residential",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:ObjectOperandNode",
                        "@id": "jemc:dr-2025-06-01-cn-residential-left-operand",
                        "urpx:conditionProperty": {
                          "@id": "urpx:hasCustomerKind"
                        }
                      },
                      "urpx:rightOperand": {
                        "@type": "urpx:ObjectOperandNode",
                        "@id": "jemc:dr-2025-06-01-cn-residential-right-operand",
                        "urpx:referencesValue": {
                          "@id": "urpx:residentialKind"
                        }
                      }
                    },
                    {
                      "@type": "urpx:ComparisonNode",
                      "@id": "jemc:dr-2025-06-01-cn-program-enrollment",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:ObjectOperandNode",
                        "@id": "jemc:dr-2025-06-01-cn-program-enrollment-left-operand",
                        "urpx:conditionProperty": {
                          "@id": "urpx:hasProgramEnrollment"
                        }
                      },
                      "urpx:rightOperand": {
                        "@type": "urpx:ObjectOperandNode",
                        "@id": "jemc:dr-2025-06-01-cn-program-enrollment-right-operand",
                        "urpx:referencesValue": {
                          "@id": "jemc:program-sync-to-save"
                        }
                      }
                    }
                  ]
                }
              }
            }
          ],

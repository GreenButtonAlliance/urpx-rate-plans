  "@graph": [
    {
      "@type": "urpx:URPXPackage",
      "@id": "jemc:doc-dr-2025-06-01",
      "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
      "urpx:hasRatePlanModifier": {
        "@type": "urpx:RatePlanModifier",
        "@id": "jemc:dr",
        "urpx:name": "Demand Response Rider",
        "urpx:modifierUniqueIdentifier": "DR",
        "urpx:initialEffectiveDate": "2025-06-01",
        "urpx:timezoneIdentifier": "America/New_York",
        "urpx:hasRatePlanModifierVersion": {
          "@type": "urpx:RatePlanModifierVersion",
          "@id": "jemc:dr-2025-06-01",
          "urpx:version": "2025-06-01",
          "urpx:modifierVersionNumber": "2025-06-01",
          "urpx:changeReason": {
            "@id": "urpx:changeReasonOther"
          },
          "urpx:description": "Jackson EMC's Rider DR, Demand Response Rider, an experimental rider \"evaluated on an annual basis\" for customers on the Cooperative's residential rate schedules, all six of which urpx:applicableToRatePlan names. Members who participate in the Sync to Save program with a connected smart thermostat receive a $25 credit on their November bill, if the thermostat is enrolled and connected by July 1 and the account is active July 1 through September 30 of that year; the credit is forfeited if control or connection is disrupted by tampering. The credit is carried as a $25.00 monthly credit gated to November. Dating: the rider is effective June 1, 2025, so this version begins 2025-06-01; it states no date of first introduction.",
          "urpx:effectiveDateTime": "2025-06-01T00:00:00",
          "urpx:priceCurrency": "USD",
          "urpx:commodity": {
            "@id": "urpx:electricity"
          },
          "urpx:serviceRole": {
            "@id": "urpx:bundledServiceRole"
          },

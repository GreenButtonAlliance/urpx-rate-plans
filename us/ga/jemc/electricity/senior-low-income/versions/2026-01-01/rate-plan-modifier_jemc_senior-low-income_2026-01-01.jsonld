            {
              "@id": "jemc:a"
            },
            {
              "@id": "jemc:aea"
            },
            {
              "@id": "jemc:am"
            },
            {
              "@id": "jemc:aphf"
            },
            {
              "@id": "jemc:atou"
            },
            {
              "@id": "jemc:apev"
            }
          ],
          "urpx:hasDataSourceReference": {
            "@type": "urpx:DataSourceReference",
            "@id": "jemc:senior-low-income-2026-01-01-data-source-reference",
            "urpx:fileName": "A-26.pdf",

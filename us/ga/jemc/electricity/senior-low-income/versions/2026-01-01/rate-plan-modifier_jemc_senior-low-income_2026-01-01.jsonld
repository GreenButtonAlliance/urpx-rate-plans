  "@graph": [
    {
      "@type": "urpx:URPXPackage",
      "@id": "jemc:doc-senior-low-income-2026-01-01",
      "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
      "urpx:hasRatePlanModifier": {
        "@type": "urpx:RatePlanModifier",
        "@id": "jemc:senior-low-income",
        "urpx:name": "Senior Citizen - Low Income Assistance",
        "urpx:modifierUniqueIdentifier": "SENIOR-LOW-INCOME",
        "urpx:initialEffectiveDate": "2026-01-01",
        "urpx:timezoneIdentifier": "America/New_York",
        "urpx:hasRatePlanModifierVersion": {
          "@type": "urpx:RatePlanModifierVersion",
          "@id": "jemc:senior-low-income-2026-01-01",
          "urpx:version": "2026-01-01",
          "urpx:modifierVersionNumber": "2026-01-01",
          "urpx:changeReason": {
            "@id": "urpx:changeReasonOther"
          },
          "urpx:description": "Jackson EMC's Senior Citizen - Low Income Assistance, a $12.50 monthly credit \"to be applied to the service charge or minimum monthly charge\" for customers the Cooperative certifies who are 62 years of age or older with total household income at or below 100 percent of the current year's Federal Poverty Guidelines for a family size of two, at their principal place of residence, individually metered and in the customer's name. The Cooperative publishes no separate sheet for it: the same provision is printed on each of its residential schedules, A-26, AEA-26, AM-26, APHF-26, ATOU-26 and APEV-26, which urpx:applicableToRatePlan names, and this filing reads it from Schedule A-26, page 2. Every one of those schedules has a Service Charge above $12.50 ($31.00, or $34.00 on ATOU and APEV), so the credit is carried as a flat monthly credit of its full amount. Dating: the sheets are effective January 1, 2026, so this version begins 2026-01-01; they state no date of first introduction.",
          "urpx:effectiveDateTime": "2026-01-01T00:00:00",
          "urpx:priceCurrency": "USD",
          "urpx:commodity": {
            "@id": "urpx:electricity"
          },
          "urpx:serviceRole": {
            "@id": "urpx:bundledServiceRole"
          },

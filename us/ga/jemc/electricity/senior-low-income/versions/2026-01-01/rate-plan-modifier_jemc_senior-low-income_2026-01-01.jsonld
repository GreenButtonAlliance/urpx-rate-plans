          "urpx:hasCoverageClaim": {
            "@id": "jemc:cc-senior-low-income-2026-01-01",
            "@type": "urpx:CoverageClaim",
            "urpx:completenessResult": {
              "@id": "urpx:partial"
            },
            "urpx:selfContained": true,
            "urpx:explainedBy": {
              "@type": "urpx:Evaluation",
              "@id": "jemc:cc-senior-low-income-2026-01-01-evaluation",
              "urpx:evaluationKind": {
                "@id": "urpx:coverageEvaluation"
              },
              "urpx:description": "This filing does not carry everything its source document states. 1 parts are deferred, listed here in the same words as the filing's tariff.toml [modeling].deferrals so the two records cannot drift. (1) Certification and qualifications. The sheets limit the credit to customers the Cooperative certifies who are 62 years of age or older with total household income at or below 100 percent of the current year's Federal Poverty Guidelines for a family size of two, at their principal place of residence, individually metered and in the customer's name. The EligibilityRule carries residential customer kind and enrollment in jemc:program-senior-low-income; the qualifications are in its description only.",

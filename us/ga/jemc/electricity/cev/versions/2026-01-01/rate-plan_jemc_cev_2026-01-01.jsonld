  "@type": "urpx:URPXPackage",
  "@id": "jemc:doc-cev-2026-01-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "jemc:cev",
    "urpx:name": "Schedule CEV Commercial Plug-in Electric Vehicle Service",
    "urpx:ratePlanUniqueIdentifier": "CEV",
    "urpx:initialEffectiveDate": "2026-01-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "jemc:cev-2026-01-01",
      "urpx:description": "Jackson EMC's commercial electric vehicle charging schedule, CEV-26, for service exclusively serving the customer's electric vehicle chargers. A Service Charge of $53.00 per month for single-phase or $81.00 for three-phase customers, chosen by a ProfileAlternative, and energy at 34.35 cents per kWh On-Peak, 12:00 p.m. to 8:00 p.m. Monday through Friday in every month, and 15.00 cents per kWh Off-Peak at all other hours. The sheet names no holidays, so the On-Peak period carries none. The minimum monthly charge is the Service Charge. Every bill is also increased or decreased by Schedule P-22's Wholesale Power Cost Adjustment, a per-kWh factor the Cooperative computes each month and does not publish, defined here as a per-kWh PriceDefinition with no Price. The schedule is experimental. Rates are set by the Cooperative's board, not the Georgia Public Service Commission; the sheet is effective January 1, 2026.",
      "urpx:effectiveDateTime": "2026-01-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:changeReasonOther"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "jemc:cev-2026-01-01-data-source-reference",
        "urpx:fileName": "CEV-26.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.jacksonemc.com/assets/uploads/pdfs/rates/2026/CEV-26.pdf",
        "urpx:dateRetrieved": "2026-10-18",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 2
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "jemc:cev-2026-01-01-er-eligibility",
          "urpx:name": "Eligibility for Schedule CEV Commercial Plug-in Electric Vehicle Service",
          "urpx:description": "Service exclusively serving electric vehicle chargers owned by the customer, for permanent year-round service, available upon request and case by case at the Cooperative's sole discretion to customers who document possession of qualified plug-in electric vehicle chargers (a qualified plug-in electric vehicle is manufactured primarily for use on public streets, roads and highways; electric scooters, electric bicycles, golf carts and motorized electric wheelchairs do not qualify). Charging stations must be on a dedicated circuit breaker, follow all applicable codes and regulations, and be no more than 1 MW of connected load (beyond 1 MW at the Cooperative's discretion). Service is provided for a minimum of twelve consecutive months. The schedule is experimental and may be modified or discontinued by the Cooperative after sixty days' written notice.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "jemc:cev-2026-01-01-cx-eligibility",
            "urpx:rootNode": {
              "@type": "urpx:BooleanOperationNode",
              "@id": "jemc:cev-2026-01-01-bn-eligibility",
              "urpx:operator": {
                "@id": "urpx:andOperator"
              },
              "urpx:operandNodes": [
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "jemc:cev-2026-01-01-cn-non-residential",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "jemc:cev-2026-01-01-cn-non-residential-left-operand",
                    "urpx:conditionProperty": {
                      "@id": "urpx:hasCustomerKind"
                    }
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "jemc:cev-2026-01-01-cn-non-residential-right-operand",
                    "urpx:referencesValue": {
                      "@id": "urpx:nonResidentialKind"
                    }
                  }
                },
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "jemc:cev-2026-01-01-cn-ev-charging",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "jemc:cev-2026-01-01-cn-ev-charging-left-operand",
                    "urpx:conditionProperty": {
                      "@id": "urpx:derType"
                    }
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "jemc:cev-2026-01-01-cn-ev-charging-right-operand",
                    "urpx:referencesValue": {
                      "@id": "urpx:evChargingDER"
                    }
                  }
                }
              ],
              "urpx:logicExpression": "hasCustomerKind = nonResidentialKind AND derType = evChargingDER"
            }
          }
        }
      ],

  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "jemc:atou",
    "urpx:name": "Schedule ATOU Residential Time-Of-Use Service",
    "urpx:ratePlanUniqueIdentifier": "ATOU",
    "urpx:initialEffectiveDate": "2026-01-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "jemc:atou-2026-01-01",
      "urpx:description": "Jackson EMC's residential time-of-use schedule, ATOU-26. A Service Charge of $34.00 per month, and energy at 34.35 cents per On-Peak kWh and 7.35 cents per Off-Peak kWh. On-Peak is 3:00 p.m. to 8:00 p.m. Monday through Friday from June 1 through September 15, excluding the observed Juneteenth, Independence Day and Labor Day holidays; every other hour is Off-Peak. The JSON-LD carries On-Peak for the whole of June through September, because a Season here recurs by calendar month and the sheet's season ends on the fifteenth: weekday afternoons from September 16 through 30 take the On-Peak price where the sheet charges Off-Peak. The holiday calendar observes Juneteenth and Independence Day on the nearest weekday, the federal rule of 5 U.S.C. 6103(b), since the sheet says \"observed\" and states no rule. The minimum monthly charge is the Service Charge. Every bill is also increased or decreased by Schedule P-22's Wholesale Power Cost Adjustment, a per-kWh factor the Cooperative computes each month and does not publish, defined here as a PriceDefinition with no Price. The Senior Citizen - Low Income credit of $12.50 and the Load Management Adjustment Rider (LM) are for qualifying customers and are not carried here. Rates are set by the Cooperative's board; the sheet is effective January 1, 2026.",
      "urpx:effectiveDateTime": "2026-01-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:changeReasonOther"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"

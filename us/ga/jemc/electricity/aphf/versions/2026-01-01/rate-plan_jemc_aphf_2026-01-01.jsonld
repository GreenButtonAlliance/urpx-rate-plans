      "urpx:forRatePlan": {
        "@id": "jemc:aphf"
      },
      "urpx:hasCoverageClaim": {
        "@id": "jemc:cc-aphf-2026-01-01",
        "@type": "urpx:CoverageClaim",
        "urpx:completenessResult": {
          "@id": "urpx:partial"
        },
        "urpx:selfContained": true,
        "urpx:explainedBy": {
          "@type": "urpx:Evaluation",
          "@id": "jemc:cc-aphf-2026-01-01-evaluation",
          "urpx:evaluationKind": {
            "@id": "urpx:coverageEvaluation"
          },
          "urpx:description": "This filing does not carry everything its source document states. 3 parts are deferred, listed here in the same words as the filing's tariff.toml [modeling].deferrals so the two records cannot drift. (1) Wholesale Power Cost Adjustment factor. Schedule P-22 increases or decreases every bill by a per-kWh factor the Cooperative computes each month from its estimated purchased-power costs and sales, and publishes no factor. The JSON-LD defines the adjustment as a per-kWh PriceDefinition with no Price, so a modeled bill carries the base energy and Service Charges only, high or low by the month's factor times its kWh. (2) Poultry houses and farm facilities. The sheet serves individually owned poultry houses and farm facilities, not hatcheries, poultry processing or entities selling goods or services to the ultimate customer, and its application is at the Cooperative's discretion. The Cooperative lists it among its residential schedules, and the EligibilityRule carries residential customer kind, which URPX defines as domestic household service; URPX states no agricultural customer kind. The conditions are in the rule's description only. (3) Terms of Payment and Contract Period. The sheet adds a late fee and disconnection charges under the Cooperative's Service Rules and Regulations, makes all charges subject to applicable taxes, and sets a one-year contract. None is priced on the sheet and none is carried.",
          "urpx:evaluatedOn": "2026-10-18T00:00:00"
        }
      }

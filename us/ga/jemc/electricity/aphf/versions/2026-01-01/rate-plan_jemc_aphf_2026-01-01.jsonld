  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "jemc:aphf",
    "urpx:name": "Schedule APHF Residential Poultry and Farm Service",
    "urpx:ratePlanUniqueIdentifier": "APHF",
    "urpx:initialEffectiveDate": "2026-01-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "jemc:aphf-2026-01-01",
      "urpx:description": "Jackson EMC's residential poultry and farm schedule, APHF-26, for single-phase service to individually owned poultry houses and farm facilities. A Service Charge of $31.00 per month, and energy in two blocks of monthly usage the year round: 10.13 cents for the first 1,000 kWh and 9.13 cents over 1,000 kWh. The minimum monthly charge is the Service Charge. Every bill is also increased or decreased by Schedule P-22's Wholesale Power Cost Adjustment, a per-kWh factor the Cooperative computes each month and does not publish, defined here as a PriceDefinition with no Price. The Senior Citizen - Low Income credit of $12.50 is for qualifying customers and is not carried here. Rates are set by the Cooperative's board; the sheet is effective January 1, 2026.",
      "urpx:effectiveDateTime": "2026-01-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:changeReasonOther"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,

        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.jacksonemc.com/assets/uploads/pdfs/rates/2026/APHF-26.pdf",
        "urpx:dateRetrieved": "2026-10-18",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 2
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "jemc:aphf-2026-01-01-er-residential",
          "urpx:name": "Eligibility for Schedule APHF Residential Poultry and Farm Service",
          "urpx:description": "Single-phase service at one delivery point through a single meter to individually owned poultry houses and farm facilities. Not applicable to hatchery or poultry processing operations, or to any entity selling goods or services to the ultimate customer; interpretations of applicability are at the sole discretion of the Cooperative. No service may be resold or transmitted to other premises without the Cooperative's express consent. Available to all qualified customers in the area served by the Cooperative.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "jemc:aphf-2026-01-01-cx-residential",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "jemc:aphf-2026-01-01-cn-residential",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {

      "urpx:forRatePlan": {
        "@id": "jemc:qf"
      },
      "urpx:hasCoverageClaim": {
        "@id": "jemc:cc-qf-2022-01-01",
        "@type": "urpx:CoverageClaim",
        "urpx:completenessResult": {
          "@id": "urpx:partial"
        },
        "urpx:selfContained": true,
        "urpx:explainedBy": {
          "@type": "urpx:Evaluation",
          "@id": "jemc:cc-qf-2022-01-01-evaluation",
          "urpx:evaluationKind": {
            "@id": "urpx:coverageEvaluation"
          },
          "urpx:description": "This filing does not carry everything its source document states. 3 parts are deferred, listed here in the same words as the filing's tariff.toml [modeling].deferrals so the two records cannot drift. (1) Energy Charge and Facilities Charge. The Energy Charge is the customer's total wholesale power costs, including base rate and delivery, and the Facilities Charge is one-twelfth of the annual allocated cost of serving the customer. Neither is published, so each is a PriceDefinition with no Price and a modeled bill carries nothing for them. (2) Margin Cost percentage. The Margin Cost is 4.5 percent of TC = EC + FC plus $50. The $50 is a monthly Price; a multiplier Price applies to Prices, and EC and FC have none, so the 4.5 percent is a PriceDefinition with no Price. (3) Terms of Payment and Contract Period. The sheet adds a late fee and disconnection charges under the Service Rules and Regulations, makes all charges subject to applicable taxes, and sets the contract period in the Agreement for Electric Service. None is carried.",
          "urpx:evaluatedOn": "2026-10-18T00:00:00"
        }
      }
    }

      "@type": "urpx:URPXPackage",
      "@id": "jemc:doc-gp-2023-01-01",
      "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
      "urpx:hasRatePlanModifier": {
        "@type": "urpx:RatePlanModifier",
        "@id": "jemc:gp",
        "urpx:name": "Green Power Rider",
        "urpx:modifierUniqueIdentifier": "GP",
        "urpx:initialEffectiveDate": "2023-01-01",
        "urpx:timezoneIdentifier": "America/New_York",
        "urpx:hasRatePlanModifierVersion": {
          "@type": "urpx:RatePlanModifierVersion",
          "@id": "jemc:gp-2023-01-01",
          "urpx:version": "2023-01-01",
          "urpx:modifierVersionNumber": "2023-01-01",
          "urpx:changeReason": {
            "@id": "urpx:changeReasonOther"
          },
          "urpx:description": "Jackson EMC's Rider GP, Green Power Rider, for customers on the Cooperative's residential and commercial rate schedules: the six residential schedules and the nine commercial ones (GS-26, GSAE-26, GSTOU-26, LMS-26, SLMS-26, TS-26, CEV-26, MBS-22 and QF-22), which urpx:applicableToRatePlan names. Schedule S-26, Outdoor Lighting Service, is listed among the commercial rates but bills lights per lamp, and is not named. Customers nominate 25, 50, 75 or 100 percent of their monthly energy use to be provided by Green Power, and are charged a premium of $0.01 per kWh of Green Power purchased, in addition to all costs under their tariff, for a one-year, self-renewing term. The premium is carried as a price per kWh of total monthly use, chosen by a profile alternative for the nominated percentage: $0.0025, $0.0050, $0.0075 or $0.0100. Dating: the rider is effective January 1, 2023, so this version begins 2023-01-01; it states no date of first introduction.",
          "urpx:effectiveDateTime": "2023-01-01T00:00:00",
          "urpx:priceCurrency": "USD",
          "urpx:commodity": {
            "@id": "urpx:electricity"
          },

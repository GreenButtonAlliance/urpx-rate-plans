              "urpx:hasName": {
                "@id": "org:utility-jemc-name",
                "@type": "urpx:OrganizationName",
                "urpx:name": "Jackson Electric Membership Corporation"
              },
              "urpx:hasIdentifier": {
                "@id": "org:utility-jemc-eia",
                "@type": "urpx:OrganizationIdentifier",
                "urpx:scheme": {
                  "@id": "urpx:eiaScheme"

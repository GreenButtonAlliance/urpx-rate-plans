  "@graph": [
    {
      "@type": "urpx:URPXPackage",
      "@id": "jemc:doc-lm-2022-01-01",
      "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
      "urpx:hasRatePlanModifier": {
        "@type": "urpx:RatePlanModifier",
        "@id": "jemc:lm",
        "urpx:name": "Load Management Adjustment Rider",
        "urpx:modifierUniqueIdentifier": "LM",
        "urpx:initialEffectiveDate": "2022-01-01",
        "urpx:timezoneIdentifier": "America/New_York",
        "urpx:hasRatePlanModifierVersion": {
          "@type": "urpx:RatePlanModifierVersion",
          "@id": "jemc:lm-2022-01-01",
          "urpx:version": "2022-01-01",
          "urpx:modifierVersionNumber": "2022-01-01",
          "urpx:changeReason": {
            "@id": "urpx:changeReasonOther"
          },
          "urpx:description": "Jackson EMC's Rider LM, Load Management Adjustment Rider, part of each retail rate schedule that refers to it: of the residential schedules, A-26, AEA-26, AM-26, ATOU-26 and APEV-26, which urpx:applicableToRatePlan names. Active customers in the Cooperative's Load Management Program who have switches on their central air conditioning unit(s) or electric water heater(s) \"may receive a credit on the June through September bill\", the kW controlled times $0.875 on air conditioning units and $0.20 on electric water heating. The switch must have been in place for the full usage period credited, and the account active when the bill is rendered. Each credit is carried as a monthly per-kW credit gated to June through September. Dating: the rider is effective January 1, 2022, so this version begins 2022-01-01; it states no date of first introduction.",
          "urpx:effectiveDateTime": "2022-01-01T00:00:00",
          "urpx:priceCurrency": "USD",
          "urpx:commodity": {
            "@id": "urpx:electricity"
          },
          "urpx:serviceRole": {
            "@id": "urpx:bundledServiceRole"
          },

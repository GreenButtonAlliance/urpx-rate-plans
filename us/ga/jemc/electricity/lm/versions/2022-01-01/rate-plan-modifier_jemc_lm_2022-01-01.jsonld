              "@id": "jemc:aea"
            },
            {
              "@id": "jemc:am"
            },
            {
              "@id": "jemc:atou"
            },
            {
              "@id": "jemc:apev"
            }
          ],
          "urpx:hasDataSourceReference": {
            "@type": "urpx:DataSourceReference",
            "@id": "jemc:lm-2022-01-01-data-source-reference",
            "urpx:fileName": "LM.pdf",

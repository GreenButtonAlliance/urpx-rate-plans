                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:ObjectOperandNode",
                        "@id": "jemc:lm-2022-01-01-cn-residential-left-operand",
                        "urpx:conditionProperty": {
                          "@id": "urpx:hasCustomerKind"
                        }
                      },
                      "urpx:rightOperand": {

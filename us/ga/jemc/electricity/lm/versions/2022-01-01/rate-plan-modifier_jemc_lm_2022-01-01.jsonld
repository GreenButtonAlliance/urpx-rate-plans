            },
            "urpx:accessURL": "https://www.jacksonemc.com/assets/uploads/pdfs/rates/2026/LM.pdf",
            "urpx:dateRetrieved": "2026-10-18",
            "urpx:dataSourceType": {
              "@id": "urpx:utilityWebsiteSource"
            },
            "urpx:pageStart": 1,
            "urpx:pageEnd": 1
          },
          "urpx:hasEligibilityRule": [
            {
              "@type": "urpx:EligibilityRule",
              "@id": "jemc:lm-2022-01-01-er-eligible",
              "urpx:name": "Active Load Management Program participant",
              "urpx:description": "Residential customer participating in the Cooperative's Load Management Program. \"All active customers participating in the Cooperative's Load Management Program who have switches on their central air conditioning unit(s) and/or electric water heater(s) may receive a credit on the June through September bill.\" \"The load management switch must have been in place during the full usage period for which the load management credit is given. Credit will be given only to those customers whose accounts are active at the time the bill is rendered.\" ELIGIBLE INSTALLATIONS: \"Load management switches will be provided at locations which solely in the opinion of the Cooperative are accessible for installation and maintenance and are appropriate for load management purposes.\"",
              "urpx:hasConditionExpression": {
                "@type": "urpx:ConditionExpression",
                "@id": "jemc:lm-2022-01-01-cx-eligible",
                "urpx:rootNode": {
                  "@type": "urpx:BooleanOperationNode",
                  "@id": "jemc:lm-2022-01-01-bn-residential-and-enrolled",
                  "urpx:operator": {

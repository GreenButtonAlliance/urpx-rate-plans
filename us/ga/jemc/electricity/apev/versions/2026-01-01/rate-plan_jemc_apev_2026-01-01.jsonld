  "@type": "urpx:URPXPackage",
  "@id": "jemc:doc-apev-2026-01-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "jemc:apev",
    "urpx:name": "Schedule APEV Residential Plug-In Electric Vehicle Service",
    "urpx:ratePlanUniqueIdentifier": "APEV",
    "urpx:initialEffectiveDate": "2026-01-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "jemc:apev-2026-01-01",
      "urpx:description": "Jackson EMC's residential plug-in electric vehicle schedule, APEV-26, an experimental time-of-use rate for owners of a qualified plug-in electric vehicle. A Service Charge of $34.00 per month, and energy at 34.35 cents per On-Peak kWh, 7.56 cents per Off-Peak kWh and 6.34 cents per Super Off-Peak kWh. On-Peak is 3:00 p.m. to 8:00 p.m. Monday through Friday from June 1 through September 15, excluding the observed Juneteenth, Independence Day and Labor Day holidays. Super Off-Peak is 11:00 p.m. to 7:00 a.m. every day of the year. Off-Peak is every other hour: 7:00 a.m. to 3:00 p.m. and 8:00 p.m. to 11:00 p.m. on On-Peak weekdays, and 7:00 a.m. to 11:00 p.m. on weekends, holidays and from September 16 through May 31. The JSON-LD carries On-Peak for the whole of June through September, because a Season here recurs by calendar month and the sheet's season ends on the fifteenth: weekday afternoons from September 16 through 30 take the On-Peak price where the sheet charges Off-Peak. The holiday calendar observes Juneteenth and Independence Day on the nearest weekday, the federal rule of 5 U.S.C. 6103(b), since the sheet says \"observed\" and states no rule. The minimum monthly charge is the Service Charge. Every bill is also increased or decreased by Schedule P-22's Wholesale Power Cost Adjustment, a per-kWh factor the Cooperative computes each month and does not publish, defined here as a PriceDefinition with no Price. The Senior Citizen - Low Income credit of $12.50 and the Load Management Adjustment Rider (LM) are for qualifying customers and are not carried here. Rates are set by the Cooperative's board; the sheet is effective January 1, 2026.",
      "urpx:effectiveDateTime": "2026-01-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:changeReasonOther"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "jemc:apev-2026-01-01-data-source-reference",
        "urpx:fileName": "APEV-26.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.jacksonemc.com/assets/uploads/pdfs/rates/2026/APEV-26.pdf",
        "urpx:dateRetrieved": "2026-10-18",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 2
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "jemc:apev-2026-01-01-er-residential",
          "urpx:name": "Eligibility for Schedule APEV Residential Plug-In Electric Vehicle Service",
          "urpx:description": "Single-family dwelling units owned and occupied by the customer for permanent year-round service, available upon request to customers who document possession of a qualified plug-in electric vehicle, one manufactured primarily for use on public streets, roads and highways (electric scooters, electric bicycles, golf carts and motorized electric wheelchairs do not qualify). A charging station, if installed, must be single-phase, not exceed 7.8 kW, and be on a dedicated circuit breaker. Service is provided for a minimum of twelve consecutive months. The schedule is experimental and may be modified or discontinued by the Cooperative after sixty days' written notice.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "jemc:apev-2026-01-01-cx-residential",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "jemc:apev-2026-01-01-cn-residential",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {

            },
            "urpx:hasTOUTier": [
              {
                "@type": "urpx:TOUTier",
                "@id": "jemc:gstou-2026-01-01-tou-tier-on-peak",
                "urpx:tierSourceName": "On-Peak",
                "urpx:touTierStandardName": {
                  "@id": "urpx:peakTier"
                },
                "urpx:touTierNumber": 1,
                "urpx:hasTOUPeriod": [
                  {
                    "@type": "urpx:TOUPeriod",
                    "@id": "jemc:gstou-2026-01-01-tou-period-on-peak",
                    "urpx:name": "On-Peak (4:00 p.m. to 8:00 p.m. Monday through Friday, June through September, excluding the observed Juneteenth, Independence Day and Labor Day holidays)",
                    "urpx:touPeriodNumber": 1,
                    "urpx:hasTimeBracket": [
                      {
                        "@type": "urpx:TimeBracket",
                        "@id": "jemc:gstou-2026-01-01-time-bracket-summer-on-peak",
                        "urpx:startTime": "16:00:00",
                        "urpx:endTime": "20:00:00",
                        "urpx:appliesInSeason": {

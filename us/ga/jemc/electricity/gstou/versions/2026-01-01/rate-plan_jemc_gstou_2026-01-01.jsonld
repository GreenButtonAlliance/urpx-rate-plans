              "@id": "jemc:gstou-2026-01-01-holiday-labor-day",
              "urpx:holidayName": "Labor Day",
              "urpx:holidayRule": "First Monday in September"
            }
          ]
        },
        "urpx:hasMetricInput": [
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:gstou-2026-01-01-mi-energy",
            "urpx:name": "kWh Energy Consumption Prices",
            "urpx:metricInputType": {
              "@id": "urpx:measuredMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "jemc:gstou-2026-01-01-ms-energy",
              "urpx:measurementKind": {
                "@id": "urpx:energy"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kWh"
              }
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:gstou-2026-01-01-mi-meter-count",
            "urpx:name": "Per Meter Prices",
            "urpx:metricInputType": {
              "@id": "urpx:profileMetricInput"
            },
            "urpx:profileMetricProperty": {
              "@id": "urpx:meterCount"
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:gstou-2026-01-01-mi-demand",
            "urpx:name": "kW Demand (60-minute)",
            "urpx:metricInputType": {
              "@id": "urpx:measuredMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "jemc:gstou-2026-01-01-ms-demand",
              "urpx:measurementKind": {
                "@id": "urpx:demand"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kW"
              },
              "urpx:intervalDuration": "PT1H",
              "urpx:intervalType": {
                "@id": "urpx:hourlyInterval"
              }
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:gstou-2026-01-01-mi-ncp-billing-demand",
            "urpx:name": "Non-Coincident Billing Demand (kW)",
            "urpx:description": "Non-Coincident Billing Demand, from the customer's highest 60-minute kW demand during the current month and the preceding eleven months. For the billing months June through September, the greatest of (1) the current actual demand, (2) 90 percent of the highest actual demand in any previous applicable summer month (June-September), or (3) 65 percent of the highest actual demand in any previous applicable winter month (October-May). For the billing months October through May, the greater of (1) 90 percent of the highest summer month (June-September) or (2) 65 percent of the highest winter month (October-May, including the current month).",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "jemc:gstou-2026-01-01-ms-ncp-billing-demand",
              "urpx:measurementKind": {
                "@id": "urpx:demand"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kW"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "jemc:gstou-2026-01-01-mi-ncp-billing-demand-calculation-method",
              "urpx:calculationFormula": "June-September: max(D, 0.90 * max(prior summer D), 0.65 * max(prior winter D)); October-May: max(0.90 * max(summer D), 0.65 * max(winter D including current)); over the current and preceding eleven months",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "jemc:gstou-2026-01-01-mi-demand"
                }
              ]
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:gstou-2026-01-01-mi-on-peak-billing-demand",
            "urpx:name": "On-Peak Billing Demand (kW)",
            "urpx:description": "On-Peak Billing Demand, from the customer's highest 60-minute kW demand during the On-Peak period (4:00 p.m. to 8:00 p.m. Monday through Friday, June through September, excluding the observed Juneteenth, Independence Day and Labor Day holidays) for the current month and the preceding eleven months. For the billing months June through September, the greater of (1) the current actual demand or (2) 90 percent of the highest actual demand in any previous applicable summer month. For the billing months October through May, 90 percent of the highest actual demand in any previous applicable summer month (June-September).",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "jemc:gstou-2026-01-01-ms-on-peak-billing-demand",
              "urpx:measurementKind": {
                "@id": "urpx:demand"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kW"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "jemc:gstou-2026-01-01-mi-on-peak-billing-demand-calculation-method",
              "urpx:calculationFormula": "June-September: max(Don, 0.90 * max(prior summer Don)); October-May: 0.90 * max(prior summer Don); Don the 60-minute kW demand in On-Peak hours, over the current and preceding eleven months",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "jemc:gstou-2026-01-01-mi-demand"
                }
              ]
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:gstou-2026-01-01-mi-reactive-demand",
            "urpx:name": "kVAR Reactive Demand (60-minute)",
            "urpx:metricInputType": {
              "@id": "urpx:measuredMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "jemc:gstou-2026-01-01-ms-reactive-demand",
              "urpx:measurementKind": {
                "@id": "urpx:reactivePower"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kVAr"
              },
              "urpx:intervalDuration": "PT1H",
              "urpx:intervalType": {
                "@id": "urpx:hourlyInterval"
              }
            }
          },
          {
            "@type": "urpx:MetricInput",
            "@id": "jemc:gstou-2026-01-01-mi-excess-reactive-demand",
            "urpx:name": "Excess Reactive Demand (kVAR)",
            "urpx:description": "Excess Reactive Demand: the highest 60-minute kVAR measured during the month in excess of one-third of the measured actual kW in the current month. Measured only where there is an indication of a power factor of less than 95 percent lagging and the Cooperative, at its option, installs metering equipment.",
            "urpx:metricInputType": {
              "@id": "urpx:calculatedMetricInput"
            },
            "urpx:hasMetricSpecification": {
              "@type": "urpx:MetricSpecification",
              "@id": "jemc:gstou-2026-01-01-ms-excess-reactive-demand",
              "urpx:measurementKind": {
                "@id": "urpx:reactivePower"
              },
              "urpx:unitOfMeasure": {
                "@id": "urpx:kVAr"
              }
            },
            "urpx:hasCalculationMethod": {
              "@type": "urpx:CalculationMethod",
              "@id": "jemc:gstou-2026-01-01-mi-excess-reactive-demand-calculation-method",
              "urpx:calculationFormula": "max(max kVAR - max kW / 3, 0)",
              "urpx:calculatedBasedOn": [
                {
                  "@id": "jemc:gstou-2026-01-01-mi-reactive-demand"
                },
                {
                  "@id": "jemc:gstou-2026-01-01-mi-demand"
                }
              ]
            }
          }
        ],
        "urpx:hasProfileAlternatives": {
          "@type": "urpx:ProfileAlternatives",
          "@id": "jemc:gstou-2026-01-01-pa-service-phase",
          "urpx:name": "Service phase: single-phase or three-phase",

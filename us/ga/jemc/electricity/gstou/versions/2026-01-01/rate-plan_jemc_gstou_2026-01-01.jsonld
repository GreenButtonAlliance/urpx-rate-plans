  "@type": "urpx:URPXPackage",
  "@id": "jemc:doc-gstou-2026-01-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "jemc:gstou",
    "urpx:name": "Schedule GSTOU General Service Time-of-Use",
    "urpx:ratePlanUniqueIdentifier": "GSTOU",
    "urpx:initialEffectiveDate": "2026-01-01",
    "urpx:timezoneIdentifier": "America/New_York",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "jemc:gstou-2026-01-01",
      "urpx:description": "Jackson EMC's general service time-of-use schedule, GSTOU-26. A Service Charge of $53.00 per month for single-phase or $81.00 for three-phase customers, chosen by a ProfileAlternative; a Demand Charge of $3.00 per kW of Non-Coincident Billing Demand and $13.40 per kW of On-Peak Billing Demand; and energy at 5.71 cents per kWh at all hours. On-Peak is 4:00 p.m. to 8:00 p.m. Monday through Friday in June through September, excluding the observed Juneteenth, Independence Day and Labor Day holidays, and is carried as a TOU schedule on the demand MetricInput. Both billing demands are calculated MetricInputs whose ratchets over the current and preceding eleven months are stated in their CalculationMethods. Excess reactive demand, kVAR above one-third of the measured kW where the Cooperative meters it, is billed at $0.30 per kVAR. Every bill is also increased or decreased by Schedule P-22's Wholesale Power Cost Adjustment, a per-kWh factor the Cooperative computes each month and does not publish, defined here as a per-kWh PriceDefinition with no Price. Rates are set by the Cooperative's board, not the Georgia Public Service Commission; the sheet is effective January 1, 2026.",
      "urpx:effectiveDateTime": "2026-01-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:changeReasonOther"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "jemc:gstou-2026-01-01-data-source-reference",
        "urpx:fileName": "GSTOU-26.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.jacksonemc.com/assets/uploads/pdfs/rates/2026/GSTOU-26.pdf",
        "urpx:dateRetrieved": "2026-10-18",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 2
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "jemc:gstou-2026-01-01-er-eligibility",
          "urpx:name": "Eligibility for Schedule GSTOU General Service Time-of-Use",
          "urpx:description": "To all electric service of one standard voltage required on the customer's premises, delivered at one point and metered at or compensated to that voltage. No service may be resold or transmitted to other premises without the Cooperative's express consent. Available to all qualified customers in the area served by the Cooperative.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "jemc:gstou-2026-01-01-cx-eligibility",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "jemc:gstou-2026-01-01-cn-non-residential",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "jemc:gstou-2026-01-01-cn-non-residential-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:hasCustomerKind"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "jemc:gstou-2026-01-01-cn-non-residential-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:nonResidentialKind"
                }
              }
            }
          }
        }
      ],
      "urpx:hasPlanElements": {
        "@type": "urpx:PlanElements",
        "@id": "jemc:gstou-2026-01-01-plan-elements",
        "urpx:hasSeasons": [
          {
            "@type": "urpx:Season",
            "@id": "jemc:gstou-2026-01-01-season-summer",
            "urpx:seasonName": "Summer",
            "urpx:month": [

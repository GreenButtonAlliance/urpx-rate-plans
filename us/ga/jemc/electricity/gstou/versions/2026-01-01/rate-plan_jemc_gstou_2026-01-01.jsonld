            ]
          }
        ],
        "urpx:hasHolidayCalendar": {
          "@type": "urpx:HolidayCalendar",
          "@id": "jemc:gstou-2026-01-01-holidays",
          "urpx:hasHoliday": [
            {
              "@type": "urpx:Holiday",
              "@id": "jemc:gstou-2026-01-01-holiday-juneteenth",
              "urpx:holidayName": "Juneteenth",

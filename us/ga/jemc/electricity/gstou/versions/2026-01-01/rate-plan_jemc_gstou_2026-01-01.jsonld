                        },
                        "urpx:dayType": {
                          "@id": "urpx:weekdayDays"
                        },
                        "urpx:includeHolidays": false,
                        "urpx:includeNonHolidays": true
                      }
                    ]
                  }
                ]
              },
              {
                "@type": "urpx:TOUTier",
                "@id": "jemc:gstou-2026-01-01-tou-tier-off-peak",
                "urpx:tierSourceName": "Off-Peak",
                "urpx:touTierStandardName": {
                  "@id": "urpx:offPeakTier"
                },
                "urpx:touTierNumber": 2,
                "urpx:hasTOUPeriod": [
                  {
                    "@type": "urpx:TOUPeriod",
                    "@id": "jemc:gstou-2026-01-01-tou-period-off-peak",
                    "urpx:name": "Off-Peak (all hours other than On-Peak, including all weekend hours and all hours October through May)",
                    "urpx:touPeriodNumber": 2,
                    "urpx:hasTimeBracket": [
                      {
                        "@type": "urpx:TimeBracket",
                        "@id": "jemc:gstou-2026-01-01-time-bracket-summer-off-peak-weekday-morning",
                        "urpx:startTime": "00:00:00",
                        "urpx:endTime": "16:00:00",
                        "urpx:appliesInSeason": {
                          "@id": "jemc:gstou-2026-01-01-season-summer"
                        },
                        "urpx:dayType": {
                          "@id": "urpx:weekdayDays"
                        }
                      },
                      {
                        "@type": "urpx:TimeBracket",
                        "@id": "jemc:gstou-2026-01-01-time-bracket-summer-off-peak-weekday-evening",
                        "urpx:startTime": "20:00:00",
                        "urpx:endTime": "00:00:00",
                        "urpx:appliesInSeason": {
                          "@id": "jemc:gstou-2026-01-01-season-summer"
                        },
                        "urpx:dayType": {
                          "@id": "urpx:weekdayDays"
                        }
                      },
                      {
                        "@type": "urpx:TimeBracket",
                        "@id": "jemc:gstou-2026-01-01-time-bracket-summer-off-peak-weekday-holiday",
                        "urpx:startTime": "16:00:00",
                        "urpx:endTime": "20:00:00",
                        "urpx:appliesInSeason": {
                          "@id": "jemc:gstou-2026-01-01-season-summer"
                        },
                        "urpx:dayType": {
                          "@id": "urpx:weekdayDays"
                        },
                        "urpx:includeHolidays": true,
                        "urpx:includeNonHolidays": false
                      },
                      {
                        "@type": "urpx:TimeBracket",
                        "@id": "jemc:gstou-2026-01-01-time-bracket-summer-off-peak-weekend",
                        "urpx:startTime": "00:00:00",
                        "urpx:endTime": "00:00:00",
                        "urpx:appliesInSeason": {
                          "@id": "jemc:gstou-2026-01-01-season-summer"
                        },
                        "urpx:dayType": {
                          "@id": "urpx:weekendDays"
                        }
                      },
                      {

              "urpx:hasConditionExpression": {
                "@type": "urpx:ConditionExpression",
                "@id": "jemc:gstou-2026-01-01-cx-pa-three-phase",
                "urpx:rootNode": {
                  "@type": "urpx:ComparisonNode",
                  "@id": "jemc:gstou-2026-01-01-cn-pa-three-phase",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "jemc:gstou-2026-01-01-cn-pa-three-phase-left-operand",
                    "urpx:customConditionProperty": "servicePhase"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "jemc:gstou-2026-01-01-cn-pa-three-phase-right-operand",
                    "urpx:stringValue": "Three Phase"
                  }
                }
              }
            }
          ]
        },
        "urpx:hasBillingModel": {
          "@type": "urpx:BillingModel",
          "@id": "jemc:gstou-2026-01-01-plan-elements-billing-model",
          "urpx:hasTOUSchedule": {
            "@type": "urpx:TOUSchedule",
            "@id": "jemc:gstou-2026-01-01-tou",
            "urpx:referencesMetricInput": {

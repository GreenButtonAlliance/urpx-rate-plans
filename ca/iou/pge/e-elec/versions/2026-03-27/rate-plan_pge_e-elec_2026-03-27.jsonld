    {
      "@type": "urpx:RatePlan",
      "@id": "pge:e-elec",
      "urpx:name": "Residential Time-of-Use (Electric Home) Service",
      "urpx:initialEffectiveDate": "2022-12-01",
      "urpx:timezoneIdentifier": "America/Los_Angeles",
      "urpx:hasRatePlanVersion": {
        "@type": "urpx:RatePlanVersion",
        "@id": "pge:e-elec-2026-03-27",
        "urpx:publishedBy": {
          "@type": "urpx:Organization",
          "@id": "org:utility-pge",
          "urpx:legalName": "Pacific Gas & Electric Company",
          "urpx:organizationType": {
            "@id": "urpx:utilityOrganization"
          }
        },
        "urpx:description": "Optional residential TOU schedule for customers with qualifying electric technologies (EV charging, energy storage, electric heat pump) or NBT enrollment. Reissued under PG&E Advice Letter 7869-E (CPUC Decision D.26-03-013) effective 2026-03-27. Substantive change from the 2026-01-01 version: income-tiered base services charge introduced (CARE/FERA/Tier-3 with same values as E-TOU-C / E-TOU-D / EV2 / E-1); California Climate Credit removed; minor energy-rate updates per Sheet 2 + Sheet 3.",
        "urpx:effectiveDateTime": "2026-03-27T00:00:00",
        "urpx:changeReason": {
          "@id": "urpx:rateCase"
        },
        "urpx:priceCurrency": "USD",
        "urpx:commodity": {
          "@id": "urpx:electricity"
        },
        "urpx:serviceRole": {
          "@id": "urpx:bundledServiceRole"
        },
        "urpx:hasRateCase": {
          "@id": "pge:rc-d-26-03-013"
        },
        "urpx:hasDataSourceReference": {
          "@type": "urpx:DataSourceReference",
          "urpx:url": "file://./assets/PGE_E-ELEC_2026-01-01.pdf",
          "urpx:fileName": "ELEC_SCHEDS_E-ELEC.pdf",
          "urpx:mediaType": {
            "@id": "urpx:applicationPdf"
          },
          "urpx:accessURL": "https://www.pge.com/tariffs/assets/pdf/tariffbook/ELEC_SCHEDS_E-ELEC.pdf",
          "urpx:dateRetrieved": "2026-04-29",
          "urpx:dataSourceType": {
            "@id": "urpx:utilityWebsiteSource"
          },
          "urpx:hasTariffBookReference": {

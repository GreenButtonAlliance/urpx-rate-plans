                  "@type": "urpx:ObjectOperandNode",
                  "urpx:referencesValue": {
                    "@id": "urpx:residentialKind"
                  }
                }
              }
            }
          },
          {
            "@type": "urpx:EligibilityRule",
            "@id": "pge:er-qualifying-technology",
            "urpx:name": "Qualifying electric technology: storage, EV, heat pump, or NBT enrollment",
            "urpx:description": "Available to customers who have one or more of: a currently registered battery-electric vehicle (BEV) or plug-in hybrid (PHEV) — both map to urpx:evChargingDER since URPX's DERTypeValue enum does not distinguish them; energy storage (per Special Condition interconnection requirements); or an electric heat pump as primary water-heating or climate-control source. Customers billed on the Net Billing Tariff (NBT) must take service on E-ELEC and are not required to have any of the qualifying technologies above; the NBT condition is therefore included as a fourth OR-leaf.",
            "urpx:hasConditionExpression": {
              "@type": "urpx:ConditionExpression",
              "@id": "pge:cx-qualifying-technology",
              "urpx:rootNode": {
                "@type": "urpx:BooleanOperationNode",
                "@id": "pge:bn-qualifying-technology-or",
                "urpx:operator": {
                  "@id": "urpx:orOperator"
                },
                "urpx:operandNodes": [
                  {
                    "@type": "urpx:ComparisonNode",
                    "@id": "pge:cn-storage",
                    "urpx:operator": {
                      "@id": "urpx:equalsOperator"
                    },
                    "urpx:leftOperand": {
                      "@type": "urpx:ObjectOperandNode",
                      "urpx:conditionProperty": {
                        "@id": "urpx:derType"
                      }
                    },
                    "urpx:rightOperand": {
                      "@type": "urpx:ObjectOperandNode",
                      "urpx:referencesValue": {
                        "@id": "urpx:storageDER"
                      }
                    }
                  },
                  {
                    "@type": "urpx:ComparisonNode",
                    "@id": "pge:cn-ev-charging",
                    "urpx:operator": {
                      "@id": "urpx:equalsOperator"
                    },
                    "urpx:leftOperand": {
                      "@type": "urpx:ObjectOperandNode",
                      "urpx:conditionProperty": {
                        "@id": "urpx:derType"
                      }
                    },
                    "urpx:rightOperand": {
                      "@type": "urpx:ObjectOperandNode",
                      "urpx:referencesValue": {
                        "@id": "urpx:evChargingDER"
                      }
                    }
                  },
                  {
                    "@type": "urpx:ComparisonNode",
                    "@id": "pge:cn-heat-pump",
                    "urpx:operator": {
                      "@id": "urpx:equalsOperator"
                    },
                    "urpx:leftOperand": {
                      "@type": "urpx:ObjectOperandNode",
                      "urpx:conditionProperty": {
                        "@id": "urpx:hasHVAC"
                      }
                    },
                    "urpx:rightOperand": {

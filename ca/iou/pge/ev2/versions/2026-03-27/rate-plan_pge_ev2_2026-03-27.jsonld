                  { "@type": "urpx:PriceDefinition", "@id": "pge:pd-dist-winter-peak", "urpx:name": "Distribution Winter Peak", "urpx:chargeType": { "@id": "urpx:usageCharge" }, "urpx:chargeCategory": { "@id": "urpx:auxiliaryCharge" }, "urpx:billPortion": { "@id": "urpx:deliveryPortion" }, "urpx:touPeriodNumber": 2 },
                  { "@type": "urpx:PriceDefinition", "@id": "pge:pd-dist-winter-part-peak", "urpx:name": "Distribution Winter Part-Peak", "urpx:chargeType": { "@id": "urpx:usageCharge" }, "urpx:chargeCategory": { "@id": "urpx:auxiliaryCharge" }, "urpx:billPortion": { "@id": "urpx:deliveryPortion" }, "urpx:touPeriodNumber": 4 },

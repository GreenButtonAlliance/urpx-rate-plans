                  { "@type": "urpx:PriceDefinition", "@id": "pge:pd-recovery-bond-credit", "urpx:name": "Recovery Bond Credit", "urpx:chargeType": { "@id": "urpx:creditMisc" }, "urpx:chargeCategory": { "@id": "urpx:adjustment" }, "urpx:billPortion": { "@id": "urpx:bundledPortion" } }
                ]
              },
              {
                "@type": "urpx:Ledger",

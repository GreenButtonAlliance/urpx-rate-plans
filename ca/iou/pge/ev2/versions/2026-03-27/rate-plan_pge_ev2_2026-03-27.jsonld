  "@graph": [
    {
      "@type": "urpx:ProgramEnrollment",
      "@id": "pge:program-care",
      "urpx:programName": "California Alternate Rates for Energy (CARE)",
      "urpx:programType": { "@id": "urpx:lowIncomeProgram" }
    },
    {
      "@type": "urpx:ProgramEnrollment",
      "@id": "pge:program-fera",
      "urpx:programName": "Family Electric Rate Assistance (FERA)"
    },
    {
      "@type": "urpx:RatePlan",
      "@id": "pge:ev2",
      "urpx:ratePlanIdentifier": "EV2",
      "urpx:name": "Residential Time-Of-Use Service for Plug-In Electric Vehicle Customers",
      "urpx:initialEffectiveDate": "2018-01-01",
      "urpx:timezoneIdentifier": "America/Los_Angeles",
      "urpx:hasRatePlanVersion": {
        "@type": "urpx:RatePlanVersion",
        "@id": "pge:ev2-2026-03-27",
        "urpx:publishedBy": {
          "@type": "urpx:Organization",
          "@id": "org:utility-pge",
          "urpx:legalName": "Pacific Gas & Electric Company",
          "urpx:organizationType": { "@id": "urpx:utilityOrganization" }
        },
        "urpx:description": "Optional residential TOU schedule for customers with a registered battery-electric (BEV) or plug-in hybrid (PHEV) vehicle, customers with battery storage (pilot), or customers with electric heat pumps. Three TOU periods all year (peak 4-9 p.m., part-peak 3-4 p.m. and 9 p.m.-midnight, off-peak all other times) — every day including weekends and holidays. Customers pay a daily base services charge that varies by income tier (CARE / FERA / standard). No baseline credit, no Conservation Incentive Adjustment, no climate credit. Annual usage cap: 800% of baseline allowance over rolling 12 months; customers exceeding are defaulted to E-TOU-D. Vintage PCIA for CCA/DA/TBS customers is modeled as a sibling RatePlanModifier in this file. Customer-facing name is 'EV2-A' per PG&E.",
        "urpx:effectiveDateTime": "2026-03-27T00:00:00",
        "urpx:changeReason": { "@id": "urpx:rateCase" },
        "urpx:priceCurrency": "USD",
        "urpx:commodity": { "@id": "urpx:electricity" },
        "urpx:serviceRole": { "@id": "urpx:bundledServiceRole" },
        "urpx:hasDataSourceReference": {
          "@type": "urpx:DataSourceReference",
          "urpx:fileName": "ELEC_SCHEDS_EV2 (Sch).pdf",
          "urpx:mediaType": { "@id": "urpx:applicationPdf" },
          "urpx:accessURL": "https://www.pge.com/tariffs/assets/pdf/tariffbook/ELEC_SCHEDS_EV2%20(Sch).pdf",
          "urpx:dateRetrieved": "2026-04-27",
          "urpx:dataSourceType": { "@id": "urpx:utilityWebsiteSource" },
          "urpx:hasTariffBookReference": {
            "@type": "urpx:TariffBookReference",
            "urpx:pageStart": 1,
            "urpx:pageEnd": 7,
            "urpx:leafStart": "61255-E",
            "urpx:leafEnd": "61261-E"
          }
        },
        "urpx:hasEligibilityRule": [
          {
            "@type": "urpx:EligibilityRule",
            "@id": "pge:er-residential-ev2",
            "urpx:name": "Eligibility for EV2 Residential Service",
            "urpx:description": "Optional. Available to PG&E residential customers (Schedule E-1 eligible) who have a currently registered battery-electric vehicle (BEV), plug-in hybrid (PHEV), battery storage (pilot, capped at 30,000 customers), or electric heat pump as primary water-heating or climate-control source. Pure HEVs and low-speed EVs/electric motorcycles/bicycles are excluded. Annual usage cannot exceed 800% of baseline over rolling 12 months.",
            "urpx:hasCustomerProfile": {
              "@type": "urpx:CustomerProfile",
              "@id": "pge:cp-residential",
              "urpx:hasCustomerKind": { "@id": "urpx:residentialKind" }
            },
            "urpx:logicExpression": "pge:condition-bev OR pge:condition-phev OR pge:condition-storage OR pge:condition-heatpump",
            "urpx:hasCondition": [
              {
                "@type": "urpx:Condition",
                "@id": "pge:condition-bev",
                "urpx:conditionType": "derType",
                "urpx:operator": { "@id": "urpx:equalsOperator" },
                "urpx:conditionValue": "evChargingDER"
              },
              {
                "@type": "urpx:Condition",
                "@id": "pge:condition-phev",
                "urpx:conditionType": "vehicleType",
                "urpx:operator": { "@id": "urpx:equalsOperator" },
                "urpx:conditionValue": "Plug-in Hybrid Electric Vehicle (PHEV)"
              },
              {
                "@type": "urpx:Condition",
                "@id": "pge:condition-storage",
                "urpx:conditionType": "derType",
                "urpx:operator": { "@id": "urpx:equalsOperator" },
                "urpx:conditionValue": "storageDER"
              },
              {
                "@type": "urpx:Condition",
                "@id": "pge:condition-heatpump",
                "urpx:conditionType": "equipment",
                "urpx:operator": { "@id": "urpx:equalsOperator" },
                "urpx:conditionValue": "Electric heat pump for water heating or climate control"
              }
            ]
          },
          {
            "@type": "urpx:EligibilityRule",
            "@id": "pge:er-annual-usage-cap",
            "urpx:name": "Annual usage cap: 800% of baseline allowance over rolling 12 months",
            "urpx:description": "Customers taking service on this rate schedule cannot exceed 800% of their annual baseline allowance, measured as the total usage for the customer over the last 12 months divided by the total annual baseline allowance using the approved baseline allowances for those months. Customers at premises with total usage in excess of 800% of baseline over 12 consecutive months are removed from Schedule EV2 and prohibited from taking service on any electric vehicle rate schedule for 12 months. Such customers are defaulted to Schedule E-TOU-D. Modeled with informal conditionType 'annualUsageCapAsPercentOfBaseline' pending upstream URPX vocabulary for rolling-window aggregation and percent-of-baseline UoM.",
            "urpx:hasCustomerProfile": { "@id": "pge:cp-residential" },
            "urpx:hasCondition": [
              {
                "@type": "urpx:Condition",
                "@id": "pge:condition-annual-usage-cap",
                "urpx:conditionType": "annualUsageCapAsPercentOfBaseline",
                "urpx:operator": { "@id": "urpx:lessThanOrEqualOperator" },
                "urpx:conditionValue": "800",
                "urpx:hasMetricSpecification": { "@id": "pge:ms-energy" }
              }
            ]
          }
        ],

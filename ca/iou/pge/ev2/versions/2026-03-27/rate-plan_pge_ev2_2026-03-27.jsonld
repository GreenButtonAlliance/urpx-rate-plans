                  { "@type": "urpx:PriceDefinition", "@id": "pge:pd-gen-summer-part-peak", "urpx:name": "Generation Summer Part-Peak", "urpx:chargeType": { "@id": "urpx:usageCharge" }, "urpx:chargeCategory": { "@id": "urpx:auxiliaryCharge" }, "urpx:billPortion": { "@id": "urpx:supplyPortion" }, "urpx:touPeriodNumber": 3 },

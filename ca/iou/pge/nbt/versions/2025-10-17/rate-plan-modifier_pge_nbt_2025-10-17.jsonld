  "@type": "urpx:URPXDocument",
  "@id": "pge:doc-nbt-2025-10-17",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.2.0/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlanModifier": {
    "@type": "urpx:RatePlanModifier",
    "@id": "pge:nbt",
    "urpx:name": "Schedule NBT (Net Billing Tariff) Service",
    "urpx:modifierUniqueIdentifier": "NBT",
    "urpx:initialEffectiveDate": "2023-03-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "pge:nbt-2025-10-17",
      "urpx:version": "2025-10-17",
      "urpx:modifierVersionNumber": "2025-10-17",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:description": "Net Billing Tariff (NBT) per CPUC Decision 22-12-056, adopted Dec 2022, effective for new residential interconnection applications submitted on or after April 15, 2023. NBT replaces NEM-2 for new interconnections and compensates customer exports at Avoided Cost Calculator (ACC)-derived hourly Export Compensation Rates rather than at the retail rate. Customer-facing name: 'Solar Billing Plan'. Per Sheet 9 \u00a7A, residential customers taking NBT must take E-ELEC as their Otherwise Applicable Schedule (OAS) \u2014 modeled here as a urpx:RatePlanModifier overlay binding to pge:e-elec. Import-side charges remain governed by the base E-ELEC RatePlan (measured on the meter's Import Channel); this modifier handles only the export-side compensation (measured on the Export Channel; urpx:flowDirection urpx:reverse on the MetricSpecification). Import/export are independently recorded and not netted (Sheet 7). PriceDefinitions: (1) Export Compensation Rate Generation Component (system-wide; per-hour ACC values for the generation portion); (2) Export Compensation Rate Delivery Component (per-PG&E-climate-zone; per-hour ACC values for the delivery portion); (3) ACC Plus Residential adder ('Energy Export Bonus Credit'; per-vintage 2023-2027 declining schedule; 9-year lock-in from PTO date); (4) ACC Plus Low-Income adder (higher per-kWh value for CARE/FERA / disadvantaged-community-resident-owner / California-Indian-Country residents per Sheet 5). This initial filing scopes to canonical residential NBT-S (Sheet 13: solar/wind \u226430 kW Small Customer); sibling sub-schedule filings (NBT-EXP, NBT-EXP-OTR, NBT-MT, NBT-PS, NBTA) deferred. Per-cell Export Compensation Rate Price entities (576 cells per zone-vintage \u00d7 ~16 PG&E climate zones \u00d7 multiple vintages) deferred to a price-data-load follow-up sourcing from pge.com/energyexportcredit; this filing includes one illustrative Generation-Component Price and one illustrative Delivery-Component Price to exercise the TimeBracket + flowDirection=reverse vocabulary, plus the actual 2025-vintage ACC Plus values. Annual true-up settlement, Net Surplus Compensation (NSC), and bill-credit rollover deferred to consumer (price-server) responsibility \u2014 year-long-window calculations don't fit the per-bill modifier shape (same deferral pattern as SCE TOU-D-PRIME-CPP Bill Protection). Establishes the modeling pattern that URPXT-7kr.2 (SCE NBT) and URPXT-7kr.3 (SDG&E NBT) will reuse.",
      "urpx:effectiveDateTime": "2025-10-17T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:publishedBy": {
        "@type": "urpx:Organization",
        "@id": "org:utility-pge",
        "urpx:legalName": "Pacific Gas & Electric Company",
        "urpx:eiaId": "14328",
        "urpx:organizationType": {
          "@id": "urpx:utilityOrganization"
        }
      },
      "urpx:applicableToRatePlan": [
        {
          "@id": "pge:e-elec"
        }
      ],
      "urpx:hasDataSourceReference": {

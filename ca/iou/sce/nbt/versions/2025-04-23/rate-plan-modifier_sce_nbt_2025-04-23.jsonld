          "urpx:leafEnd": "87711-E"
        }
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "sce:nbt-2025-04-23-er-regf",
          "urpx:name": "Customer has Renewable Electrical Generating Facility (REGF)",
          "urpx:description": "Per Sheet 11 \u00a71.b, customer must operate an Eligible Renewable Electrical Generating Facility on the Customer's Premises, interconnected to SCE's electric system. Eligible technologies: biomass, solar thermal, photovoltaic, wind, geothermal, fuel cells using renewable fuels, small hydroelectric generation, digester gas, municipal solid waste conversion, landfill gas, ocean wave, ocean thermal, tidal current \u2014 per CEC RPS Eligibility Guidebook.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "sce:nbt-2025-04-23-cx-regf",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "sce:nbt-2025-04-23-cn-regf",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:CustomOperandNode",
                "urpx:customConditionProperty": "Has Eligible REGF"
              },
              "urpx:rightOperand": {
                "@type": "urpx:CustomOperandNode",
                "urpx:stringValue": "true"
              }
            }
          }
        },
        {
          "@type": "urpx:EligibilityRule",
          "@id": "sce:nbt-2025-04-23-er-interconnection-date",
          "urpx:name": "NBT interconnection application submitted on or after 2023-04-15",
          "urpx:description": "Per Sheet 1 / Sheet 13, Schedule NEM-ST closed for new interconnection applications after 2023-04-14. Customers submitting complete Interconnection Requests on or after 2023-04-15 take service on NBT. Customers with legacy NEM or NEM-ST whose 20-year transition period expires, or who voluntarily elect into NBT, or NBT Transition Customers are also eligible \u2014 those transition-state cases are handled in description prose and process state rather than as billing-time eligibility predicates.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "sce:nbt-2025-04-23-cx-interconnection-date",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "sce:nbt-2025-04-23-cn-interconnection-date",
              "urpx:operator": {
                "@id": "urpx:greaterThanOrEqualOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:CustomOperandNode",
                "urpx:customConditionProperty": "NBT Interconnection Application Date"
              },
              "urpx:rightOperand": {
                "@type": "urpx:CustomOperandNode",
                "urpx:stringValue": "2023-04-15"
              }
            }
          }
        }
      ],

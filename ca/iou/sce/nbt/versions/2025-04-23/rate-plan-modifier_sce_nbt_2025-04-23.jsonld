            "urpx:hasApplicabilityRule": {
              "@type": "urpx:ApplicabilityRule",
              "@id": "sce:nbt-2025-04-23-ar-acc-plus-equity-2025-vintage",
              "urpx:name": "Applies to Equity Customers with 2025-calendar-year NBT interconnection vintage. 2025-vintage Equity value is $0.056/kWh (Sheet 7 Table \u2014 roughly 2.3x the Non-Equity adder). Equity Customer definition per Sheet 17: (a) enrolled in CARE or FERA, OR (b) resident-owner of a single-family home in a disadvantaged community per D.18-06-027, OR (c) Residential Customer in California Indian Country per D.20-12-003. The Equity Customer predicate is consumer-side-evaluable; this Price encodes the conjunction with vintage-2025 via a BooleanOperationNode.",
              "urpx:hasConditionExpression": {
                "@type": "urpx:ConditionExpression",
                "@id": "sce:nbt-2025-04-23-cx-acc-plus-eq-2025-vintage",
                "urpx:rootNode": {
                  "@type": "urpx:BooleanOperationNode",
                  "@id": "sce:nbt-2025-04-23-bn-acc-plus-eq-2025-vintage",

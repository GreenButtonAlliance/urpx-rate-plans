  "urpx:hasRatePlanModifier": {
    "@type": "urpx:RatePlanModifier",
    "@id": "sce:cca-crs",
    "urpx:name": "Schedule CCA-CRS",
    "urpx:modifierUniqueIdentifier": "CCA-CRS",
    "urpx:initialEffectiveDate": "2023-07-27",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "sce:cca-crs-2026-03-20",
      "urpx:version": "2026-03-20",
      "urpx:modifierVersionNumber": "2026-03-20",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:description": "Schedule CCA-CRS — CCA Cost Responsibility Surcharge. Recovers stranded power-procurement costs allocated to residential customers served by a Community Choice Aggregator (CCA) instead of Bundled SCE service. Applied as an overlay to the customer's base SCE residential RatePlan (Schedule D, TOU-D-4-9PM, TOU-D-5-8PM, TOU-D-PRIME). Composed of four components for the Domestic customer class: WFC ($0.00591/kWh), CTC ($0.00014/kWh), FRC ($0.00619/kWh), and PCIA (vintage-discriminated, identical PCIA values to Schedule DA-CRS — 20 vintages from 2001 through 2026, ranging from $-0.00644 for 2025/2026 to $0.02624 for 2023). Per-Price hasApplicabilityRule on each PCIA vintage gates on customer's `CCA Vintage Year` CustomOperandNode property. Per the OAT reconciliation prose on TOU-D Sheet 18 SC 11 / Schedule D Sheet 6 SC 4, CCA customer's OAT charges apply EXCEPT the DWRBC component is subtracted from total Delivery Service; this OAT-side adjustment is NOT modeled here. CCA-CRS Sheet 3 has a richer customer-subgroup exemption table than DA-CRS — CCA customers on Medical Baseline are WFC-exempt; CCA customers on CARE are WFC-exempt + FRC-exempt; CCA customers on FERA are FRC-exempt; Continuous DA/CCA customers are WFC + PCIA-exempt; Returning Continuous DA customers are WFC-exempt. Only the default CCA Customers subgroup is captured by the Eligibility Rule here; the subgroup exemptions are stacking interactions with already-modeled CARE / FERA modifiers and are deferred to a follow-up issue.",
      "urpx:effectiveDateTime": "2026-03-20T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },

    "@type": "urpx:RatePlan",
    "@id": "sce:tou-d-5-8pm",
    "urpx:name": "Schedule TOU-D Time-Of-Use Domestic — Option 5-8 PM",
    "urpx:ratePlanUniqueIdentifier": "TOU-D-5-8PM",
    "urpx:initialEffectiveDate": "2019-03-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "sce:tou-d-5-8pm-2026-03-20",
      "urpx:publishedBy": {
        "@type": "urpx:Organization",
        "@id": "org:utility-sce",
        "urpx:legalName": "Southern California Edison Company",
        "urpx:eiaId": "17609",
        "urpx:organizationType": {
          "@id": "urpx:utilityOrganization"
        }
      },
      "urpx:description": "Voluntary residential time-of-use schedule with summer on-peak 5:00 p.m.-8:00 p.m. weekdays. Alternate CPUC mass-migration default — assigned to inland climate zones (where peak demand window aligns with later-evening loads). Replaces the prior Basic Charge + Minimum Charge structure with an income-graduated Base Services Charge (BSC) of $0.794/meter/day per Decision 24-05-028, with a Deed-Restricted discount of $(0.332)/meter/day available to customers in qualifying deed-restricted housing. CARE/FERA discounts (32.5% and 18% respectively) and the related BSC surcharge exemption + BSC discount adjustments are documented in Special Conditions and modeled separately as RatePlanModifiers at ca/iou/sce/care/ and ca/iou/sce/fera/; the Deed-Restricted discount referenced above is modeled at ca/iou/sce/deed-restricted/. Climate Credit ($-36.00/household, semi-annually) is applied per Special Conditions. Heat Pump Water Heater (HPWH) customers receive an additional baseline allocation per Preliminary Statement Part H (modeling deferred — baseline credit modifier not yet captured).",
      "urpx:effectiveDateTime": "2026-03-20T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },

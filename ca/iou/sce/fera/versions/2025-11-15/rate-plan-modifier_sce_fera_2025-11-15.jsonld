              "@type": "urpx:PriceDefinition",
              "@id": "sce:fera-pd-bsc-credit-adjustment",
              "urpx:name": "FERA Base Services Charge Credit Adjustment (additional reduction beyond the surcharge exemption)",
              "urpx:chargeType": {

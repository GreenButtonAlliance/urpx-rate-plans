        },
        "urpx:accessURL": "https://library.sce.com/content/dam/sce-doclib/public/regulatory/tariff/2025/electric/electric-schedules/ELECTRIC_SCHEDULES_TOU-D_2025.pdf",
        "urpx:dateRetrieved": "2026-04-30",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:hasTariffBookReference": {
          "@type": "urpx:TariffBookReference",
          "urpx:pageStart": 46,
          "urpx:pageEnd": 46,
          "urpx:leafStart": "Sheet 18",
          "urpx:leafEnd": "Sheet 18"
        }
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "sce:er-fera-eligible",
          "urpx:name": "FERA-eligible residential customer",
          "urpx:description": "Customer must be a residential customer enrolled in the FERA program per Schedule D-FERA eligibility requirements: household income at-or-below 250% of the Federal Poverty Guidelines AND a minimum of three or more persons residing in the household. Customers receiving the CARE Discount are not eligible for FERA simultaneously. Application + eligibility declaration required; SCE applies discount no later than one billing period after approval. Customers may be rebilled for periods when they did not meet eligibility requirements.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "sce:cx-fera-eligible",
            "urpx:rootNode": {
              "@type": "urpx:BooleanOperationNode",
              "@id": "sce:bn-fera-residential-and-enrolled",
              "urpx:operator": {
                "@id": "urpx:andOperator"
              },
              "urpx:operandNodes": [
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "sce:cn-fera-residential",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "urpx:conditionProperty": {
                      "@id": "urpx:hasCustomerKind"
                    }
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "urpx:referencesValue": {
                      "@id": "urpx:residentialKind"
                    }
                  }
                },
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "sce:cn-fera-program-enrollment",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "urpx:customConditionProperty": "Program Enrollment"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "urpx:stringValue": "Family Electric Rate Assistance (FERA)"
                  }
                }
              ]
            }
          }
        }
      ],
      "urpx:hasPlanElements": {

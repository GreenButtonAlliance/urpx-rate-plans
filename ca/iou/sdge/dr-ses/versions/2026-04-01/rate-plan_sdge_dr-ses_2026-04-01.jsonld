  "@type": "urpx:URPXDocument",
  "@id": "sdge:doc-dr-ses-2026-04-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.2.0/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "sdge:dr-ses",
    "urpx:name": "Schedule DR-SES Domestic Time-of-Use for Households with a Solar Energy System",
    "urpx:ratePlanUniqueIdentifier": "DR-SES",
    "urpx:initialEffectiveDate": "2008-07-24",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "sdge:dr-ses-2026-04-01",
      "urpx:publishedBy": {
        "@type": "urpx:Organization",
        "@id": "org:utility-sdge",
        "urpx:legalName": "San Diego Gas & Electric Company",
        "urpx:eiaId": "16609",
        "urpx:organizationType": {
          "@id": "urpx:utilityOrganization"
        }
      },
      "urpx:description": "SDG&E's electrification-targeted residential time-of-use schedule for individually-metered residential customers with an on-premises Solar Energy System (1 kW – 5 MW capacity per CA Public Resources Code §§ 25780–25782 / California Solar Initiative). Estimated ~5K customers — niche but high-signal for the price-server's solar-adopter audience. Schedule DR-SES + Schedule NEM are billed in combination if applicable (Special Condition 9). 'Individually metered' refers to one meter per residence (single-family dwellings + flats), not separate metering of the PV system. Three TOU periods (On-Peak / Off-Peak / Super Off-Peak); same TOU windows as TOU-DR1, EV-TOU-5, and TOU-ELEC (4-9pm peak all days; super-off-peak split midnight-6am + 10am-2pm weekdays / continuous midnight-2pm weekends/holidays). Bill structure: flat UDC like TOU-DR1 ($0.27299/kWh, decomposed into 7 sub-components — Trans/Distr/PPP/ND/CTC/LGC/RS — TRAC is structurally EXCLUDED by Special Condition (note on Sheet 2: 'The UDC Total Rate applicable to eligible customers taking service under Schedule DR-SES shall exclude the TRAC or its successor rate'); EECC values match EV-TOU-5 exactly (Summer On-Peak $0.47019, Off-Peak $0.17311, Super Off-Peak $0.08147; Winter $0.19990 / $0.14337 / $0.07410); DWR-BC $0; WF-NBC $0.00591. NO Baseline Adjustment Credit. Same Base Services Charge $0.79343/day for standard customers; CARE/FERA/DRAH variants modeled as RatePlanModifiers in the grid-coordination/urpx-tariffs#13 secondary epic. Special Condition 5 imposes a 12-month minimum-stay clause; current and future occupants of the premises must enter into a Rule 21 interconnection agreement. Special Condition 6 grants a 90-day opt-out window during the initial term of service. Special Condition 13 defines 'Solar Energy System' (1 kW – 5 MW AC, per CSI eligibility criteria). Customers may also qualify for semi-annual California Climate Credit ($-49.36 per Schedule GHG-ARR).",
      "urpx:effectiveDateTime": "2026-04-01T00:00:00",
      "urpx:minimumTenure": "P12M",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "urpx:fileName": "SCHEDULE_DR-SES.pdf",
        "urpx:mediaType": {

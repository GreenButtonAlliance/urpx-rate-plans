  "@type": "urpx:URPXDocument",
  "@id": "sdge:doc-care-2025-10-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.2.0/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlanModifier": {
    "@type": "urpx:RatePlanModifier",
    "@id": "sdge:care",
    "urpx:name": "Schedule E-CARE California Alternate Rates for Energy",
    "urpx:modifierUniqueIdentifier": "E-CARE",
    "urpx:initialEffectiveDate": "2001-08-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "sdge:care-2025-10-01",
      "urpx:version": "2025-10-01",
      "urpx:modifierVersionNumber": "2025-10-01",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:description": "California Alternate Rates for Energy (CARE) program — income-qualified bill discount applied as an overlay to any SDG&E residential base rate plan (Schedule DR, DR-SES, EV-TOU-5, TOU-DR1, TOU-DR2, TOU-ELEC). CPUC-mandated program; SDG&E's implementation is defined in Schedule E-CARE per Decision 24-05-028 (intended discount rate 35%). Eligibility: customer income at-or-below 200% of Federal Poverty Guidelines OR enrollment in qualifying public-assistance programs, per Schedule E-CARE Special Condition 4 (income table). CARE provides several distinct benefits: (1) a 35% line-item bill discount (NOT MODELED — URPX has no percentage-of-bill primitive, urpx-org/urpx#24 OPEN), (2) exemption from the California Wildfire Fund Charge (modeled as $-0.00591/kWh credit), (3) exemption from the Department of Water Resources Bond Charge (modeled as $-0.00000/kWh credit; currently zero but tracked for future use), (4) exemption from the CARE Surcharge that funds the program (modeled as $-0.00864/kWh credit, the 'All Other Residential CARE Schedules' rate per Sheet 2 — DM/EV-TOU customers are charged a different $0.01062/kWh CARE Surcharge but those bases aren't currently in this corpus), and (5) a Base Services Charge reduction from the standard $0.79343/day to $0.19713/day (modeled as $-0.59630/day BSC adjustment). Net per-kWh credit from line-item exemptions: $-0.01455/kWh. Net per-meter-per-day credit from BSC adjustment: $-0.59630/day. Bill calculation correctness with this modifier captures the line-item exemptions and BSC reduction but underrepresents the full CARE customer benefit by the 35% percentage discount that URPX cannot currently express. Customers receiving FERA discount are NOT eligible for CARE simultaneously (per Schedule FERA applicability statement). CARE Medical Baseline customers also receive Medical Baseline Program co-benefits via Schedule E-MEDICAL (NOT modeled — blocked on urpx-org/urpx#32 OPEN, additive baseline allowance vocabulary).",
      "urpx:effectiveDateTime": "2025-10-01T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },

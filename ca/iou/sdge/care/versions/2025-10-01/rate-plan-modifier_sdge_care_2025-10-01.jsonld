      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "sdge:care-2025-10-01-er-eligible",
          "urpx:name": "CARE-eligible residential customer",
          "urpx:description": "Customer must be a residential customer enrolled in the CARE program per Schedule E-CARE eligibility requirements (Special Condition 4): household income at-or-below 200% of the Federal Poverty Guidelines OR enrollment in qualifying public-assistance programs. Application + eligibility declaration required (Special Condition 2); SDG&E applies discount no later than one billing period after approval (Special Condition 3). Customers may be rebilled for periods when eligibility was not met. Customers receiving FERA discount are NOT eligible for CARE simultaneously.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "sdge:care-2025-10-01-cx-eligible",
            "urpx:rootNode": {
              "@type": "urpx:BooleanOperationNode",
              "@id": "sdge:care-2025-10-01-bn-residential-and-enrolled",
              "urpx:operator": {

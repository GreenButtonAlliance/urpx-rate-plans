  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "sdge:dr",
    "urpx:name": "Schedule DR Residential Service",
    "urpx:ratePlanUniqueIdentifier": "DR",
    "urpx:initialEffectiveDate": "1948-01-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "sdge:dr-2026-04-01",
      "urpx:publishedBy": {
        "@type": "urpx:Organization",
        "@id": "org:utility-sdge",
        "urpx:legalName": "San Diego Gas & Electric Company",
        "urpx:eiaId": "16609",
        "urpx:organizationType": {
          "@id": "urpx:utilityOrganization"
        }
      },
      "urpx:description": "SDG&E's standard non-TOU residential schedule. Optionally available — destination for residential customers who opted out of the CPUC TOU mass migration default (TOU-DR1) effective March 1, 2019. Estimated ~20% of SDG&E residential = ~280K customers; declining over time as opt-outs migrate to TOU. Two-tier inclining-block structure with the tier breakpoint at 130% of CPUC baseline allocation (Coastal/Inland/Mountain/Desert × Summer/Winter × Basic/All-Electric — see Special Condition 3 for the per-zone allowance table). Tier 1 (up to 130% of baseline) and Tier 2 (above 130%) differ only in the UDC delivery component: $0.23169/kWh for Tier 1 vs $0.34061/kWh for Tier 2 — a $0.10892/kWh delta exactly matching the Baseline Adjustment Credit in TOU-DR1. EECC (Generation) is FLAT $0.18274/kWh across both tiers and both seasons (no TOU, no season variation). DWR-BC + WF-NBC also flat. Base Services Charge $0.79343/day for standard customers (CARE/FERA/DRAH variants modeled as RatePlanModifiers in grid-coordination/urpx-tariffs#13 secondary epic). CCA-served customers pay UDC + DWR-BC + WF-NBC + their CCA's generation rate plus PCIA per Special Condition 11 (PCIA modeling deferred). Climate Zone determination is per service address (Coastal/Inland/Mountain/Desert per Territory Served Map No. 1).",
      "urpx:effectiveDateTime": "2026-04-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",

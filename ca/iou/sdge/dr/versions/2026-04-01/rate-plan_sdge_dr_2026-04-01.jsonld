          "@type": "urpx:EligibilityRule",
          "@id": "sdge:er-residential-dr",
          "urpx:name": "Eligibility for Schedule DR Residential Service",
          "urpx:description": "Optionally available to domestic service for lighting, heating, cooking, water heating, and power, in single-family dwellings, flats, and apartments separately metered by the utility; service used in common for residential purposes by tenants in multi-family dwellings under Special Condition 8; any approved combination of residential and nonresidential service on the same meter; and incidental farm service under Special Condition 7. Voluntary opt-in (or opt-out from the TOU-DR1 default).",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "sdge:cx-residential-dr",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "sdge:cn-residential-dr",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",

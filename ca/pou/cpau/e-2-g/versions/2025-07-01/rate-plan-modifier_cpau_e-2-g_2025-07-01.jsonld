  "urpx:hasRatePlanModifier": {
    "@type": "urpx:RatePlanModifier",
    "@id": "cpau:e-2-g",
    "urpx:name": "Palo Alto Green Program (E-2 base)",
    "urpx:modifierUniqueIdentifier": "CPAU-E-2-G",
    "urpx:initialEffectiveDate": "2025-07-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "cpau:e-2-g-2025-07-01",
      "urpx:version": "2025-07-01",
      "urpx:modifierVersionNumber": "2025-07-01",
      "urpx:effectiveDateTime": "2025-07-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:initial"
      },
      "urpx:description": "Palo Alto Green Program modifier on Schedule E-2 (Residential Master-Metered and Small Non-Residential Electric Service). Applies to E-2 customers participating in the Palo Alto Green Program under the 100% Renewable Option, adding a $0.0075/kWh Palo Alto Green Charge to all energy consumption. Eligibility per Section A of the published Schedule E-2-G: customers who qualify for E-2 Service AND who choose to participate in the Palo Alto Green Program. The 1000 kWh Block Purchase Option ($7.50/block) is also published in the same rate filing but is not modeled here — different metric shape (per-block discrete purchase vs continuous per-kWh consumption); tracked as a follow-up.",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:publishedBy": {
        "@type": "urpx:Organization",
        "@id": "org:utility-cpau",
        "urpx:legalName": "City of Palo Alto Utilities",
        "urpx:eiaId": "3203",
        "urpx:organizationType": {
          "@id": "urpx:municipalOrganization"
        }
      },
      "urpx:applicableToRatePlan": [
        {
          "@id": "cpau:e-2"
        }
      ],

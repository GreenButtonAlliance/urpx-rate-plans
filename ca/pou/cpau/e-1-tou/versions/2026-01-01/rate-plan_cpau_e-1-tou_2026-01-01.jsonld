  "@type": "urpx:RatePlan",
  "@id": "cpau:e-1-tou",
  "urpx:name": "Residential Electric Time of Use Service",
  "urpx:initialEffectiveDate": "2026-01-01",
  "urpx:timezoneIdentifier": "America/Los_Angeles",
  "urpx:hasRatePlanVersion": {
    "@type": "urpx:RatePlanVersion",
    "@id": "cpau:e-1-tou-2026-01-01",
    "urpx:version": "2026-01-01",
    "urpx:changeReason": {
      "@id": "urpx:initial"
    },
    "urpx:description": "This voluntary Rate Schedule applies to separately metered single-family residential dwellings receiving Electric Service from the City of Palo Alto Utilities (CPAU) who have an Advanced Metering Infrastructure meter installed. This Rate Schedule is not available to Net Energy Metered (NEM) customers and is provided at the sole discretion of CPAU.",
    "urpx:effectiveDateTime": "2026-01-01T00:00:00",
    "urpx:priceCurrency": "USD",
    "urpx:commodity": {
      "@id": "urpx:electricity"
    },
    "urpx:serviceRole": {
      "@id": "urpx:bundledServiceRole"
    },
    "urpx:publishedBy": {
      "@type": "urpx:Organization",
      "@id": "org:utility-cpau",
      "urpx:legalName": "City of Palo Alto Utilities",
      "urpx:eiaId": "3203",
      "urpx:organizationType": {
        "@id": "urpx:municipalOrganization"
      }
    },
    "urpx:hasDataSourceReference": {
      "@type": "urpx:DataSourceReference",
      "urpx:url": "file://./assets/CPAU_E-1-TOU_2026-01-01.pdf",
      "urpx:fileName": "CPAU_E-1-TOU_2026-01-01.pdf",
      "urpx:mediaType": {
        "@id": "urpx:applicationPdf"
      }
    },
    "urpx:hasEligibilityRule": [
      {
        "@type": "urpx:EligibilityRule",
        "@id": "cpau:er-residential-tou",
        "urpx:name": "Residential TOU eligibility",
        "urpx:description": "Voluntary residential TOU service. Eligibility: single-family dwelling, separately metered, equipped with AMI (advanced metering infrastructure) supporting time-of-use measurement.",
        "urpx:hasConditionExpression": {
          "@type": "urpx:ConditionExpression",
          "@id": "cpau:cx-residential-tou",
          "urpx:rootNode": {
            "@type": "urpx:BooleanOperationNode",
            "@id": "cpau:bn-residential-tou-and",
            "urpx:operator": {
              "@id": "urpx:andOperator"
            },
            "urpx:operandNodes": [
              {
                "@type": "urpx:ComparisonNode",
                "@id": "cpau:cn-residential",
                "urpx:operator": {
                  "@id": "urpx:equalsOperator"
                },
                "urpx:leftOperand": {
                  "@type": "urpx:ObjectOperandNode",
                  "urpx:conditionProperty": {
                    "@id": "urpx:hasCustomerKind"
                  }
                },
                "urpx:rightOperand": {
                  "@type": "urpx:ObjectOperandNode",
                  "urpx:referencesValue": {
                    "@id": "urpx:residentialKind"
                  }
                }
              },
              {
                "@type": "urpx:ComparisonNode",
                "@id": "cpau:cn-single-family",
                "urpx:operator": {
                  "@id": "urpx:equalsOperator"
                },
                "urpx:leftOperand": {
                  "@type": "urpx:CustomOperandNode",
                  "urpx:customConditionProperty": "dwellingType"
                },
                "urpx:rightOperand": {
                  "@type": "urpx:CustomOperandNode",
                  "urpx:stringValue": "Single-family dwelling"
                }
              },
              {
                "@type": "urpx:ComparisonNode",
                "@id": "cpau:cn-separately-metered",
                "urpx:operator": {
                  "@id": "urpx:equalsOperator"
                },
                "urpx:leftOperand": {
                  "@type": "urpx:CustomOperandNode",
                  "urpx:customConditionProperty": "metering"
                },
                "urpx:rightOperand": {
                  "@type": "urpx:CustomOperandNode",
                  "urpx:stringValue": "Separately metered"
                }
              },
              {
                "@type": "urpx:ComparisonNode",
                "@id": "cpau:cn-ami",
                "urpx:operator": {
                  "@id": "urpx:equalsOperator"
                },
                "urpx:leftOperand": {
                  "@type": "urpx:CustomOperandNode",
                  "urpx:customConditionProperty": "metering"
                },
                "urpx:rightOperand": {
                  "@type": "urpx:CustomOperandNode",
                  "urpx:stringValue": "AMI"
                }
              }
            ],
            "urpx:logicExpression": "hasCustomerKind = residentialKind AND dwellingType = 'Single-family dwelling' AND metering = 'Separately metered' AND has AMI meter"
          }
        }
      }
    ],

      },
      "urpx:modifierVersionNumber": "2025-09-01",
      "urpx:description": "Provides compensation for electricity exported to the grid by Customer-Generators not eligible for Net Energy Metering or electing this schedule. Applies in conjunction with the customer's otherwise applicable base rate schedule. Not applicable with Time-of-Use schedules. Requires a bidirectional meter.",

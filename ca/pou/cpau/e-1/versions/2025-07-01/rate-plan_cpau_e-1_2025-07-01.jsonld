    "urpx:hasEligibilityRule": [
      {
        "@type": "urpx:EligibilityRule",
        "@id": "cpau:er-residential-single-family",
        "urpx:name": "Residential single-family separately-metered service",
        "urpx:description": "Applies to all single-family residential electric service supplied through one meter at one point of delivery for domestic purposes in a single-family dwelling unit within the City of Palo Alto electric service area.",
        "urpx:hasConditionExpression": {
          "@type": "urpx:ConditionExpression",
          "@id": "cpau:cx-residential-single-family",
          "urpx:rootNode": {
            "@type": "urpx:BooleanOperationNode",
            "@id": "cpau:bn-residential-single-family-and",
            "urpx:operator": {
              "@id": "urpx:andOperator"
            },
            "urpx:operandNodes": [
              {
                "@type": "urpx:ComparisonNode",
                "@id": "cpau:cn-residential",
                "urpx:operator": {
                  "@id": "urpx:equalsOperator"
                },
                "urpx:leftOperand": {
                  "@type": "urpx:ObjectOperandNode",
                  "urpx:conditionProperty": {
                    "@id": "urpx:hasCustomerKind"
                  }
                },
                "urpx:rightOperand": {
                  "@type": "urpx:ObjectOperandNode",
                  "urpx:referencesValue": {
                    "@id": "urpx:residentialKind"
                  }
                }
              },
              {
                "@type": "urpx:ComparisonNode",
                "@id": "cpau:cn-single-family",
                "urpx:operator": {
                  "@id": "urpx:equalsOperator"
                },
                "urpx:leftOperand": {
                  "@type": "urpx:CustomOperandNode",
                  "urpx:customConditionProperty": "dwellingType"
                },
                "urpx:rightOperand": {
                  "@type": "urpx:CustomOperandNode",
                  "urpx:stringValue": "Single-family dwelling"
                }
              },
              {
                "@type": "urpx:ComparisonNode",
                "@id": "cpau:cn-separately-metered",
                "urpx:operator": {
                  "@id": "urpx:equalsOperator"
                },
                "urpx:leftOperand": {
                  "@type": "urpx:CustomOperandNode",
                  "urpx:customConditionProperty": "metering"
                },
                "urpx:rightOperand": {
                  "@type": "urpx:CustomOperandNode",
                  "urpx:stringValue": "Separately metered"
                }
              }
            ],
            "urpx:logicExpression": "hasCustomerKind = residentialKind AND dwellingType = 'Single-family dwelling' AND metering = 'Separately metered'"
          }
        }
      }
    ],

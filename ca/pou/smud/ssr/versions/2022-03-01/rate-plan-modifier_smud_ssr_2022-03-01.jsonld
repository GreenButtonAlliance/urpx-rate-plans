            "urpx:startDate": "2022-03-01",
            "urpx:name": "SSR Export Compensation Rate (effective March 1, 2022; next Board update cycle 2026, ±30% bound)",
            "urpx:unitPrice": "-0.07400"
          }
        ]
      }
    }
  }

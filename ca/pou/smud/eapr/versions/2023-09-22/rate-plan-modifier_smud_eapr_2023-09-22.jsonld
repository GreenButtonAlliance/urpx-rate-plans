      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "smud:eapr-2023-09-22-er-eligible",
          "urpx:name": "EAPR-eligible residential customer",
          "urpx:description": "Customer is a residential customer enrolled in the EAPR program per Schedule EAPR Sec II: (A) total gross household income conforms to Income Guidelines (typically 0-200% Federal Poverty Level — application-based determination); (B) customer is not claimed as a dependent on another person's tax return; (C) service address on application is the customer's primary residence. Stacks additively with MED.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "smud:eapr-2023-09-22-cx-eligible",
            "urpx:rootNode": {
              "@type": "urpx:BooleanOperationNode",
              "@id": "smud:eapr-2023-09-22-bn-residential-and-enrolled",
              "urpx:operator": {
                "@id": "urpx:andOperator"
              },
              "urpx:operandNodes": [
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "smud:eapr-2023-09-22-cn-residential",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },

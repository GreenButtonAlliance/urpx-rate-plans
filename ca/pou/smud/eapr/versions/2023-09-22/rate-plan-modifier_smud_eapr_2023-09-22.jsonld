  "@type": "urpx:URPXDocument",
  "@id": "smud:doc-eapr-2023-09-22",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.2.0/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlanModifier": {
    "@type": "urpx:RatePlanModifier",
    "@id": "smud:eapr",
    "urpx:name": "Schedule EAPR Energy Assistance Program Rate",
    "urpx:modifierUniqueIdentifier": "EAPR",
    "urpx:initialEffectiveDate": "2023-09-22",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "smud:eapr-2023-09-22",
      "urpx:version": "2023-09-22",
      "urpx:modifierVersionNumber": "2023-09-22",
      "urpx:changeReason": {
        "@id": "urpx:initial"
      },
      "urpx:description": "SMUD's Energy Assistance Program Rate (EAPR) — income-qualified bill discount applied as an overlay to any SMUD residential base RatePlan. Functionally analogous to the CPUC's CARE program at SCE/PG&E/SDG&E, though structurally different: SMUD's EAPR has TWO discount components — (1) a flat $10/month System Infrastructure Fixed Charge discount, and (2) a 100%-reduction-up-to-cap on electricity usage cost where the monthly cap varies by Federal Poverty Level (FPL) tier ($60 for 0-50% FPL, $32 for >50-100%, $10 for >100-150%, $0 for >150-200%). Adopted under SMUD Board Resolution 23-09-09 effective September 22, 2023. Eligibility (Sec II): residential customer income at-or-below 200% FPL, customer not claimed as dependent, primary residence. This filing models ONLY the $10/month BSC discount (as $-0.3289/day = $10/30.4 days). The cap-on-usage discount is NOT modeled — it's the URPX#24 cap-on-credit / computed-from-upstream-context territory that lacks a v0.2.0 primitive (modeling forward-compatible if URPX adds the vocabulary). For typical EAPR customers in higher-FPL tiers (150-200% where usage cap = $0), the BSC discount captured here is the ENTIRE EAPR benefit; for lower-FPL tiers, it's a fraction (~14% for 0-50% FPL with 500 kWh/month). The ERSF Additional Monthly Discount ($0-$35/month for 0-50% FPL only, year-by-year formulaic) is also NOT modeled. Stacks additively with MED (Schedule MED Sec III). Sec IV-VI cover Nonprofit Organization eligibility — out of scope for this residential-focused filing.",
      "urpx:effectiveDateTime": "2023-09-22T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:publishedBy": {
        "@type": "urpx:Organization",
        "@id": "org:utility-smud",
        "urpx:legalName": "Sacramento Municipal Utility District",
        "urpx:eiaId": "16534",
        "urpx:organizationType": {
          "@id": "urpx:utilityOrganization"
        }
      },
      "urpx:applicableToRatePlan": [
        {
          "@id": "smud:fixed"
        },
        {
          "@id": "smud:tod-5-8pm"
        },
        {
          "@id": "smud:tod-low-use"
        }
      ],

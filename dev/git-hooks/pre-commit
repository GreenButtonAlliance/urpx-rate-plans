#!/bin/bash
# Pre-commit hook: regenerate derived reports when tariff filings change.
#
# When any us/**/*.toml, us/**/*.jsonld or us/**/*.pdf is staged, re-runs the report
# generators (the list lives in dev/check_all.py) against the staged tree and
# stages any resulting reports/ or catalog/ changes into the same commit. Docs-only commits
# (README, LAYOUT, etc.) skip the hook and don't slow down.
#
# Install (one-time, per-checkout):
#
#   git config core.hooksPath dev/git-hooks
#
# Skip ad-hoc with `git commit --no-verify` if needed (e.g. revert commit
# that intentionally desyncs reports).
#
# The hook DOES block. It regenerates derived artifacts, stages them, and then
# runs dev/gate.sh --fast, which fails the commit on a regression.
#
# It did not block before, on the reasoning that blocking was CI's job. There is
# no CI in this repository: .github/ does not exist. So the hook was deferring to
# a fallback that was never there, which is how three NBT filings stayed broken
# and a generator output stayed uncommitted for months.
#
# Set URPXT_SKIP_REPORTS=1 to skip ONLY the regeneration and staging, while still
# running the gate. Use it when a commit is meant to be read as data (a migration
# wave) and regenerated reports would bury the diff. It does not disarm the gate;
# --no-verify does, and that is the point of having a narrower escape hatch.

set -euo pipefail

# Only run when tariff content is staged
# Any corpus data, or any dev script at all. This used to name each script
# individually, which is the same hand-maintained second list the comment above
# blames for backfill_modeling.py going uncommitted: every script added since has
# had to be remembered here, and fix_file_urls.py was already missing. Matching
# the whole directory cannot drift. The cost is that editing an unrelated dev
# script runs the gate, which is a couple of minutes and the safe direction.
# dev/baseline/ is matched explicitly: the old pattern only reached dev/*.py|sh|clj
# at one level, so a commit touching ONLY dev/baseline/marginal-rates.edn skipped
# the gate entirely. That is the one file whose whole purpose is to be compared
# against, so a re-record could land unverified.
# src/ is matched because the documents generated from it are checked against
# their committed files only here and in the gate.
# ACMRD, not ACMR: D is deletion. Removing a filing is a corpus change like any
# other, and under ACMR a commit that only deleted filings matched nothing here
# and skipped the gate outright.
if ! git diff --cached --name-only --diff-filter=ACMRD | grep -qE '^(us/.*\.(toml|jsonld|pdf)|src/.*\.clj|dev/[^/]+\.(py|sh|clj)|dev/baseline/.*\.(edn|json))$'; then
    exit 0
fi

REPO=$(git rev-parse --show-toplevel)
cd "$REPO"

# The Python scripts need dev/requirements.txt. Set URPX_RATE_PLANS_VENV to a
# virtualenv holding them to have it activated here; otherwise python3 on PATH
# must already have them.
if [ -n "${URPX_RATE_PLANS_VENV:-}" ]; then
    # shellcheck disable=SC1091
    source "$URPX_RATE_PLANS_VENV/bin/activate"
fi

if [ "${URPXT_SKIP_REPORTS:-0}" = "1" ]; then
    echo "pre-commit: URPXT_SKIP_REPORTS=1 - skipping report regeneration (gate still runs)"
else

echo "pre-commit: tariff filings staged → regenerating reports from the index..."

# Generate from what is being committed, not from the working tree. Running the
# generators in the checkout pulled unstaged edits to their inputs into reports
# staged with an unrelated commit. So the staged tree is checked out into a
# throwaway repository (borrowing this one's objects, so nothing is copied but
# the files), the generators run there, and only the reports/ and catalog/ paths they change
# are staged back. git rather than a bare directory, because
# list_rate_identifiers reads `git ls-files`.
tmp_root=${TMPDIR:-/tmp}
gen_root=$(mktemp -d "${tmp_root%/}/pre-commit-reports.XXXXXX")
trap 'rm -rf "$gen_root"' EXIT
index_tree=$(git write-tree)
objects="$(cd "$(git rev-parse --git-common-dir)" && pwd)/objects"
in_gen_root() {
    (
        # git exports these to hooks; they would point the throwaway
        # repository back at this one.
        unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_OBJECT_DIRECTORY
        cd "$gen_root" && "$@"
    )
}
in_gen_root git init -q .
echo "$objects" > "$gen_root/.git/objects/info/alternates"
in_gen_root git read-tree "$index_tree"
in_gen_root git checkout-index -a

# Defer to dev/check_all.py for WHICH generators run. Keeping a second list here
# is what let backfill_modeling.py go uncommitted: check_all ran it and the hook
# did not, so its output drifted and check_all exited 2 on a clean checkout.
if ! in_gen_root python3 dev/check_all.py --generators-only; then
    echo "pre-commit: one or more report generators failed - commit aborted."
    echo "pre-commit: re-stage and retry, or use 'git commit --no-verify' to bypass."
    exit 1
fi

# Stage each reports/ or catalog/ path the generators changed. The working copy is brought
# along only when it held exactly the staged version; a working copy with edits
# of its own is left alone, and only the index gets the regenerated file.
changes="$gen_root/.git/hook-changes"
in_gen_root git status --porcelain -z --untracked-files=all -- reports/ catalog/ > "$changes"
staged_any=0
while IFS= read -r -d '' entry; do
    st=${entry:0:2}
    path=${entry:3}
    if git ls-files --error-unmatch -- "$path" > /dev/null 2>&1; then
        git diff --quiet -- "$path" && in_sync=1 || in_sync=0
    elif [ ! -e "$path" ] || cmp -s "$gen_root/$path" "$path"; then
        in_sync=1
    else
        in_sync=0
    fi
    if [ "$st" = " D" ]; then
        git rm -q --cached -- "$path"
        [ "$in_sync" -eq 1 ] && rm -f "$path"
    elif [ "$in_sync" -eq 1 ]; then
        mkdir -p "$(dirname "$path")"
        cp "$gen_root/$path" "$path"
        git add -- "$path"
    else
        blob=$(git hash-object -w -- "$gen_root/$path")
        git update-index --add --cacheinfo "100644,$blob,$path"
        echo "pre-commit: $path has unstaged edits; staged the regenerated file and left the working copy as is"
    fi
    staged_any=1
done < "$changes"

if [ "$staged_any" -eq 1 ]; then
    echo "pre-commit: staged regenerated files in reports/ and catalog/"
else
    echo "pre-commit: reports/ and catalog/ already current — no changes to stage."
fi

fi

echo "pre-commit: running dev/gate.sh --fast..."
# Capture the status OUTSIDE the negation. Inside `if ! cmd; then`, $? is the
# status of the negated expression, which is 0 whenever the branch is taken, so
# the hook exited 0 and git committed anyway. It printed "gate failed (exit 0)"
# on every failure and the zero went unread. The hook could not block from the
# day it was written until 2026-09-21, which is the whole reason it exists.
gate_rc=0
tmp_root=${TMPDIR:-/tmp}
gate_log=$(mktemp "${tmp_root%/}/pre-commit-gate.XXXXXX")
dev/gate.sh --fast > "$gate_log" 2>&1 || gate_rc=$?
if [ "$gate_rc" -ne 0 ]; then
    cat "$gate_log"
    echo "pre-commit: gate failed (exit $gate_rc) - commit aborted. Gate output kept in $gate_log"
    echo "pre-commit: fix it, or bypass deliberately with 'git commit --no-verify'."
    exit "$gate_rc"
fi
tail -3 "$gate_log"
rm -f "$gate_log"

exit 0

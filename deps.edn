{:paths ["dev" "src"]

 :deps {energy.grid-coordination/clj-urpx
        {:mvn/version "0.44.0"}
        org.clojure/data.json {:mvn/version "2.5.1"}}

 :aliases
 {:validate {:main-opts ["-m" "validate-v020"]}

  :generate {:main-opts ["-m" "rate-plans.gen"]}

  :coverage {:main-opts ["-m" "lint-resolution-coverage"]}

  :nbt-export {:main-opts ["-m" "check-nbt-export"]}

  :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.6.0"}
                       cider/cider-nrepl {:mvn/version "0.50.3"}}
          :jvm-opts ["-Djdk.attach.allowAttachSelf"]
          :main-opts ["-m" "nrepl.cmdline"
                      "--middleware" "[cider.nrepl/cider-middleware]"]}}}
